# See man apt_preferences
#
# THIS IS A MACHINE GENERATED FILE. PLEASE DO NOT EDIT.
#   IF YOU CHANGE THIS FILE, IT MAY BE OVERWRITTEN BY A
#   FUTURE UPDATE OF THE 'kfocus-nvidia' PACKAGE.
#   KFOCUS_TEST_ID=1605,3600

# You may remove the package 'kfocus-nvidia' to remove this file;
#   however, doing so will adjust the mix of nvidia driver libs
#   which may prevent the deep-learning suite ('kfocus-conda'),
#   compute, and other ML tasks from working as expected.

# Priority < 1000 will not downgrade
# Priority = 1000 will downgrade IFF a higher priority (e.g. Ubuntu)
#   offers new version
# Priority > 1000 will downgrade even from lower-priority repo
#
# If more than one selector matches a package at the same priority, the
# the match nearest the top of this file wins.
# See https://askubuntu.com/questions/135339

# == Paired kfocus-nvidia Package =====================================
# Pair pinning with a specific kfocus-nvidia package version.
# IMPORTANT: This must be done so that the pinning package is
# installed first, then the supporting drivers are installed on the
# next upgrade.
# Although specified, the `Pin: release` is NOT honored.
#
Package: kfocus-nvidia-edge
# Pin: release o=LP-PPA-kfocus-team-release
Pin: version XXX_PKG_VER_XXX
Pin-Priority: 1006

# == Core Nvidia Packages =============================================
# 1st: Core nvidia packages from kfocus-team-release repo
# Although specified, the `Pin: version` is NOT honored.
#
Package: nvidia-* libnvidia-* xserver-xorg-video-nvidia-*
# Pin: version 595.84-0ubuntu0.24.04.1+kfocus1
Pin: release o=LP-PPA-kfocus-team-release
Pin-Priority: 1006

## BEGIN BETA SECTION - deleted from release packages
# 1st: Core nvidia packages from kfocus-team-package-testing repo
# Although specified, the `Pin: version` is NOT honored.
#
Package: nvidia-* libnvidia-* xserver-xorg-video-nvidia-*
# Pin: version 595.84-0ubuntu0.24.04.1+kfocus1
Pin: release o=LP-PPA-kfocus-team-package-testing
Pin-Priority: 1006
## . END BETA SECTION - deleted from release packages

# 2nd: Core nvidia packages version 595.84.* from highest-ranked repo
# Although specified, the `Pin: release` is NOT honored.
#
Package: nvidia-* libnvidia-* xserver-xorg-video-nvidia-*
# Pin: release o=LP-PPA-kfocus-team-release
Pin: version 595.84.*
Pin-Priority: 1005

# 3rd: Core nvidia packages version 595.* from highest-ranked repo
# Although specified, the `Pin: release` is NOT honored.
#
Package: nvidia-* libnvidia-* xserver-xorg-video-nvidia-*
# Pin: release o=LP-PPA-kfocus-team-release
Pin: version 595.*
Pin-Priority: 1004

# == Utility Nvidia Packages ==========================================
# Prefer versions of nvidia-settings, nvidia-modprobe, libxnvctrl0,
#   libxnvctrl-dev from kfocus or nvidia. These packages are frequently OOD in
#   Ubuntu repos. Use `apt-cache policy` to inspect the results.

# 1st: Utility nvidia packages from kfocus-team-release repo
# Although specified, the `Pin: version` is NOT honored.
#
Package: nvidia-settings nvidia-modprobe libxnvctrl0 libxnvctrl-dev
# Pin: version 595.84-0ubuntu0.24.04.1+kfocus1
Pin: release o=LP-PPA-kfocus-team-release
Pin-Priority: 1006

