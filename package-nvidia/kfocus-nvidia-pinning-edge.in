#   KFOCUS_TEST_ID=1605,3600

# You may remove the package 'kfocus-nvidia' to remove this file;
#   however, doing so will adjust the mix of nvidia driver libs
#   which may prevent the deep-learning suite ('kfocus-conda'),
#   compute, and other ML tasks from working as expected.

# Priority < 1000 will not downgrade
# Priority = 1000 will downgrade IFF a higher priority (e.g. Ubuntu)
#   offers new version
# Priority > 1000 will downgrade even from lower-priority repo

# == Paired kfocus-nvidia Package =====================================
# Pair pinning with a specific kfocus-nvidia package version.
# IMPORTANT: This must be done so that the pinning package is
# installed first, then the supporting drivers are installed on the
# next upgrade.
#
Package: kfocus-nvidia-edge
Pin: release l=Kubuntu Focus PPA, v=24.04, n=noble
Pin: version XXX_PKG_VER_XXX
Pin-Priority: 1006

# == Core Nvidia Packages =============================================
# 1st: Core nvidia packages from kfocus-team-package-release repo
# Although specified, v 570.169-0ubuntu0.24.04.1~kfocus1
#   is NOT honored.
Package: nvidia-* libnvidia-* xserver-xorg-video-nvidia-*
Pin: version 570.169-0ubuntu0.24.04.1~kfocus1
Pin: release o=LP-PPA-kfocus-team-package-release
Pin-Priority: 1006

# 2nd: Core nvidia packages from kfocus-team-package-testing repo
# Note: Although specified, v 570.169-0ubuntu0.24.04.1~kfocus1
#   is NOT honored.
Package: nvidia-* libnvidia-* xserver-xorg-video-nvidia-*
Pin: version 570.169-0ubuntu0.24.04.1~kfocus1
Pin: release o=LP-PPA-kfocus-team-package-testing
Pin-Priority: 1006

# 3rd: Core nvidia packages version 570.169* from highest-ranked repo
# Note: Although specified, kfocus-team-package-release repo constraint 
#    is NOT honored.
Package: nvidia-* libnvidia-* xserver-xorg-video-nvidia-*
Pin: release o=LP-PPA-kfocus-team-package-release
Pin: version 570.169*
Pin-Priority: 1005

