# See man apt_preferences
#
# THIS IS A MACHINE GENERATED FILE. PLEASE DO NOT EDIT.
#   IF YOU CHANGE THIS FILE, IT MAY BE OVERWRITTEN BY A
#   FUTURE UPDATE OF THE 'kfocus-nvidia' PACKAGE.
#   KFOCUS_TEST_ID=1605,3600

# You may remove the package 'kfocus-nvidia' to remove this file;
#   however, doing so will adjust the mix of nvidia driver libs
#   which may prevent the deep-learning suite ('kfocus-conda'),
#   compute, and other ML tasks from working as expected.

# Priority < 1000 will not downgrade
# Priority = 1000 will downgrade IFF a higher priority (e.g. Ubuntu)
#   offers new version
# Priority > 1000 will downgrade even from lower-priority repo

# == Paired kfocus-nvidia Package =====================================
# Pair pinning with a specific kfocus-nvidia package version.
# IMPORTANT: This must be done so that the pinning package is
# installed first, then the supporting drivers are installed on the
# next upgrade.
#
Package: kfocus-nvidia-edge
Pin: release l=Kubuntu Focus PPA, v=24.04, n=noble
Pin: version XXX_PKG_VER_XXX
Pin-Priority: 1006

Package: kfocus-nvidia
Pin: release l=Kubuntu Focus PPA, v=24.04, n=noble
Pin-Priority: -1

# == Core Nvidia Packages =============================================
# Prefer 570.153* core packages from kfocus repos
Package: nvidia-* libnvidia-* xserver-xorg-video-nvidia-*
Pin: release l=Kubuntu Focus PPA, v=24.04, n=noble
Pin: version 570.153*
Pin-Priority: 1006

# Fallback to 570.153* packages from ubuntu repos
Package: nvidia-* libnvidia-* xserver-xorg-video-nvidia-*
Pin: release l=Ubuntu, v=24.04, n=noble
Pin: version 570.153*
Pin-Priority: 1005

# == Utility Nvidia Packages ==========================================
# Prefer versions of nvidia-settings, nvidia-modrobe, and libnvctrl0
#   in a hierarchy. These packages are frequently OOD in Ubuntu repos.
#   Use `apt-cache policy nvidia-settings nvidia-modprobe libnvctrl0`

# Prefer 1st 570.153* utility packages from kfocus repos
Package: nvidia-settings nvidia-modprobe libxnvctrl0
Pin: release l=Kubuntu Focus PPA, v=24.04, n=noble
Pin: version 570.153*
Pin-Priority: 1006
#
# Prefer 2nd 570.153* utility packages from ubuntu repos
Package: nvidia-settings nvidia-modprobe libxnvctrl0
Pin: release l=Ubuntu, v=24.04, n=noble
Pin: version 570.153*
Pin-Priority: 1005

# Prefer 3nd 570.* utility packages from ubuntu repos
Package: nvidia-settings nvidia-modprobe libxnvctrl0
Pin: release l=Ubuntu, v=24.04, n=noble
Pin: version 570.*
Pin-Priority: 1004

# Prefer 4nd 570.154* utility packages from nvidia repos
Package: nvidia-settings nvidia-modprobe libxnvctrl0
Pin: release o=NVIDIA,l=NVIDIA CUDA
Pin: origin developer.download.nvidia.com
Pin: version 570.153*
Pin-Priority: 1003

# Prefer 5th 570.* utility packages from nvidia repos
Package: nvidia-settings nvidia-modprobe libxnvctrl0
Pin: release o=NVIDIA,l=NVIDIA CUDA
Pin: origin developer.download.nvidia.com
Pin: version 570.*
Pin-Priority: 1002

# BLACKLIST (alway ignore) other core and util packages from nvidia repos
Package: nvidia-* libnvidia-* xserver-xorg-video-nvidia-* libxnvctrl0
Pin: release o=NVIDIA,l=NVIDIA CUDA
Pin: origin developer.download.nvidia.com
Pin-Priority: -1

# == CUDA Nvidia Packages =============================================
# Pin cuda-drivers to use version 570.153.* first but not available on
#   2025-06-03 but will likely become available soon.
#   Fallback to 570.148.* which is available at this time.
#   cuda-drivers cuda-drivers-570 cuda*

# Prefer 1st 570.153.* CUDA packages from nvidia repos
Package: cuda*
Pin: release o=NVIDIA,l=NVIDIA CUDA
Pin: origin developer.download.nvidia.com
Pin: version 570.153.*
Pin-Priority: 1006

# Prefer 2nd 570.148.* CUDA packages from nvidia repos
Package: cuda*
Pin: release o=NVIDIA,l=NVIDIA CUDA
Pin: origin developer.download.nvidia.com
Pin: version 570.148.*
Pin-Priority: 1005

# BLACKLIST (alway ignore) other CUDA packages from the NVIDIA repos
Package: cuda*
Pin: release o=NVIDIA,l=NVIDIA CUDA
Pin: origin developer.download.nvidia.com
Pin-Priority: -1

