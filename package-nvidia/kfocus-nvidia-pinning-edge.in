# == CUDA Nvidia Packages =============================================
# The cuda-drivers package is no longer installable or advisable with the
# 595 drivers. Instead, it is redundant with nvidia-driver-595-open and
# it is disallowed with a pin-priority below.
Package: cuda-toolkit*
# Pin: release o=NVIDIA
Pin: version 12.*
Pin-Priority: 1006

Package: libnvinfer8
# Pin: release o=NVIDIA
Pin: version *cuda12.0
Pin-Priority: 1006

Package: libcudnn8
# Pin: release o=NVIDIA
Pin: version *cuda12.2
Pin-Priority: 1006

# BLACKLIST (always ignore) all other files not listed above
# A priority of 100 means packages will be overridden by other
# repos by default, while still allowing installation when needed.
#
Package: *
Pin: release o=NVIDIA
Pin-Priority: 100
