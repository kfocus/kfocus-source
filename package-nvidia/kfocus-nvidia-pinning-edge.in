Pin: release o=LP-PPA-kfocus-team-package-testing
Pin-Priority: 1006
## . END BETA SECTION - deleted from release packages

# 2nd: Core nvidia packages version 595.84.* from highest-ranked repo
# Although specified, the `Pin: release` is NOT honored.
#
Package: nvidia-* libnvidia-* xserver-xorg-video-nvidia-*
# Pin: release o=LP-PPA-kfocus-team-release
Pin: version 595.84.*
Pin-Priority: 1005

# 3rd: Core nvidia packages version 595.* from highest-ranked repo
