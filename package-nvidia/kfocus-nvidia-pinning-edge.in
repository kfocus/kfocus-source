# See man apt_preferences
#
# THIS IS A MACHINE GENERATED FILE. PLEASE DO NOT EDIT.
#   IF YOU CHANGE THIS FILE, IT MAY BE OVERWRITTEN BY A
#   FUTURE UPDATE OF THE 'kfocus-nvidia' PACKAGE.
#   KFOCUS_TEST_ID=1605,3600

# You may remove the package 'kfocus-nvidia' to remove this file;
#   however, doing so will adjust the mix of nvidia driver libs
#   which may prevent the deep-learning suite ('kfocus-conda'),
#   compute, and other ML tasks from working as expected.

# Priority < 1000 will not downgrade
# Priority = 1000 will downgrade IFF a higher priority (e.g. Ubuntu)
#   offers new version
# Priority > 1000 will downgrade even from lower-priority repo

# == Paired kfocus-nvidia Package =====================================
# Pair pinning with a specific kfocus-nvidia package version.
# IMPORTANT: This must be done so that the pinning package is
# installed first, then the supporting drivers are installed on the
# next upgrade.
#
Package: kfocus-nvidia
Pin: release l=Kubuntu Focus PPA, o=LP-PPA-kfocus-team-release, v=24.04, n=noble
Pin: version XXX_PKG_VER_XXX
Pin-Priority: 1002

# == Core Nvidia Packages =============================================
# BLACKLIST (alway ignore) nvidia-driver packages from the NVIDIA
#   repository (Priority -1). Specific exceptions are for packages like
#   nvidia-settings, nvidia-modprobe, libxnvctrl0 are handled below.
#
Package: nvidia-* libnvidia-* xserver-xorg-* libxnvctrl0
Pin: release o=NVIDIA,l=NVIDIA CUDA
Pin: origin developer.download.nvidia.com
Pin-Priority: -1

# Favor all nvidia-driver packages from the target release ('noble').
#   Priority 1001 causes a new version from this origin to be installed
#   unless there is the same version from a target release. Since this IS the
#   target release specification.
#
# Pin: release l=Ubuntu, v=24.04, n=noble
Package: nvidia-* libnvidia-* xserver-xorg-*
Pin: release l=Kubuntu Focus PPA, o=LP-PPA-kfocus-team-release, v=24.04, n=noble
Pin: version 570.153*
Pin-Priority: 1001

# Prefer Ubuntu supplied versions of nvidia-settings, nvidia-modrobe, and
#   libnvctrl0 if available from the 'noble' repository and correct version.
#   However, these packages are frequently OOD in Ubuntu repos.
#   Use `apt-cache policy nvidia-settings nvidia-modprobe libnvctrl0`
#   to see current Ubuntu versions.
#
# Pin: release l=Ubuntu, v=24.04, n=noble
# 570.153* is best version (1005)
Package: nvidia-settings nvidia-modprobe libxnvctrl0
Pin: release l=Ubuntu, v=24.04, n=noble
Pin: version 570.153*
Pin-Priority: 1005

# 570.* is fallback version (1004)
# Pin: release l=Ubuntu, v=24.04, n=noble
Package: nvidia-settings nvidia-modprobe libxnvctrl0
Pin: release l=Ubuntu, v=24.04, n=noble
Pin: version 570.*
Pin-Priority: 1004

# Use Nvidia supplied versions of nvidia-settings, nvidia-modrobe, and
#   libnvctrl0 if a 570 version is not found in ubuntu or kfocus repos.
#  
# 570.153* is next in stack (1003)
Package: nvidia-settings nvidia-modprobe libxnvctrl0
Pin: release o=NVIDIA,l=NVIDIA CUDA
Pin: origin developer.download.nvidia.com
Pin: version 570.153*
Pin-Priority: 1003

# 570.* is catch-all (1002)
Package: nvidia-settings nvidia-modprobe libxnvctrl0
Pin: release o=NVIDIA,l=NVIDIA CUDA
Pin: origin developer.download.nvidia.com
Pin: version 570.*
Pin-Priority: 1002

# == Cuda Nvidia Pakcages =============================================
# Pin cuda-drivers to use version 570.153.*. This meta package now depends on
#   the installed version of nvidia-drivers-570, which is pinned to come
#   from Ubuntu, therefore all required package versions should be resolved
#   correctly. The prior packages explicitly listed these components like
#   libnvidia-common-570, so the version had to match the latest found in Ubuntu.
# Priority 1002 causes a version to be installed even if it does not come from
#   the target release ('noble') and forces a downgrade if needed.
#
Package: cuda-drivers cuda-drivers-570
Pin: release o=NVIDIA,l=NVIDIA CUDA
Pin: origin developer.download.nvidia.com
Pin: version 570.153.*
Pin-Priority: 1002

# Prefer all cuda* 570 packages from NVIDIA over any Ubuntu packages of the
#   same name and version from any other respository. 
# Priority 1001 causes a version to be installed even if does not come from
#   the target release ('noble') and forces a downgrade if needed.
#
Package: cuda*
Pin: release o=NVIDIA,l=NVIDIA CUDA
Pin: origin developer.download.nvidia.com
Pin: version 570.153.*
Pin-Priority: 1001

