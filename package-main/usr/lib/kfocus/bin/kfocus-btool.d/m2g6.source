#!/bin/bash

# shellcheck source=../kfocus-btool
_minBiosVers='1.07.07S3min29';
_availBiosVers='1.07.07S3min29';
_biosDownloadUrl='https://f005.backblazeb2.com/file/kfocus-bios/m2g6_2025-08-12_X56xWNx_07S3min29.efi.zip';
_installStepsMsg="$(cat <<EOF
Now that you have prepared the USB Drive, follow these steps to upgrade
the BIOS. We recommend you print these instructions and then mark each
step off as you complete it.

* [ ] Power off the target M2 GEN 6 laptop you wish to upgrade.

* [ ] Plug the power coable into the laptop. Plug the freshly prepared
  thumb drive into a USB-A port of the laptop.

* [ ] Boot the laptop and tap F7 to get to the BIOS 'Boot Manager'
  screen. If you see the disk decrypt screen, the login screen, or the
  grub menu, you've missed it. Power off and try again.

* [ ] In the BIOS 'Boot Manager' option, press the down arrow to select
  the USB drive thumb drive. Then press return to boot using this drive.

*[ ] The system will boot into a text interface with white and colored text
  on a black background. Let it proceed to a second screen after around
  30 seconds. At the prompt, type 'flash' and press return to
  begin the upgrade process.

* [ ] Let the upgrade process complete. This may take up to 5 minutes.
  DO NOT press the power button, DO NOT remove the USB Drive, DO NOT
  unplug the power! The laptop will reboot by itself.

* [ ] Run this tool on the upgrade system to confirm the BIOS is
  up-to-date: 'sudo ${_binName}'
EOF
)";

_flashBiosFn () {
  _cm2EchoFn "Wipe and install to ${_targetUsbDev}";
  # See https://superuser.com/questions/332252
  {
    echo 'o'; # Create DOS partition table

    echo 'n'; # Create new partition
    echo 'p'; # Create new partition
    echo "1"; # PartID 1
    echo;     # Start sector (default)
    echo;     # End sector (default)

    echo 'a'; # Set bootable flag
    echo 'c'; # Set DOS compatibility flag
    echo 'w'; # Set DOS compatibility flag
  } | fdisk -walways -Walways "${_targetUsbDev}"                 || return 1;

  # Give the kernel time to refresh partition tables
  sleep 1;

  mkfs.fat -F32 "${_targetUsbDev}1"                              || return 1;
  _usbTmpMountDir="${_tmpDir}/usbMount";
  mkdir -p "${_usbTmpMountDir}"                                  || return 1;
  unzip -oP 'password' -d "${_usbTmpMountDir}" "${_tmpBiosFile}" || return 1;
  if ! (
    # Using 'exit' rather than return because we're in a subshell.
    cd "${_usbTmpMountDir}"                                      || exit 1;
    mkdir -p  'EFI/Insyde'                                       || exit 1;
    chmod 775 'EFI/Insyde'                                       || exit 1;
  ); then return 1; fi
  sync "${_usbTmpMountDir}"                                      || return 1;
  umount "${_usbTmpMountDir}"                                    || return 1;
  _cm2EchoFn "${_baseName}: Wrote M2 GEN 6 ${_availBiosVers} BIOS to USB";
  _cm2EchoFn "Device.";
}
