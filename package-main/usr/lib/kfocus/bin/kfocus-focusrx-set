set -u;

## BEGIN _importCommonFn {
# Purpose: Import the common library with _cm2* symbols
#
_importCommonFn() {
  declare _lib_file;
  _lib_file="${_baseDir}/lib/common.2.source";
  if [ -r "${_lib_file}" ]; then
    # shellcheck source=../lib/common.2.source
    source "${_lib_file}" || exit 202;
  else
    echo 1>&2 "${_baseName}: ABORT - Cannot source lib |${_lib_file}|";
    exit 202;
  fi
}
## . END _importCommonFn }

## BEGIN _updateKfocusPkgsFn {
# Purpose: Update all kfocus packages and dependencies only
# Returns: 0 - success; 1 - general failure; 2 - kfocus-main upgraded
#
_updateKfocusPkgsFn () {
  declare _installed_list _pre_vers_str _post_vers_str;
  _cm2SetMsgFn 'Update and upgrade kfocus packages';
  apt-get update || true;

  # Ensure dkms is installed with accommodation for existing config
  if ! _cm2ChkInstalledPkgFn 'dkms'; then
    if ! _cm2SmartInstallPkgsFn 'dkms'; then
      _cm2WarnStrFn 'dkms package could not be installed or updated.';
      _cm2WarnFn;
      return 1;
    fi
  fi

  readarray -t _installed_list < <(
    dpkg -l | awk '/^.i\s+kfocus-/{print $2}'
  );

  if (( "${#_installed_list[@]}" < 1 )); then
    _cm2WarnStrFn 'No kfocus packages found';
    _cm2WarnFn;
    return 1;
  fi

  _pre_vers_str="$(_cm2EchoInstalledVersFn 'kfocus-main')";
  if _cm2SmartInstallPkgsFn "${_installed_list[@]}"; then
    _cm2SucFn;
    _post_vers_str="$(_cm2EchoInstalledVersFn 'kfocus-main')";

    if [ "${_pre_vers_str}" != "${_post_vers_str}" ]; then
      return 2;
    fi
    return 0;
  else
    _cm2WarnFn;
    return 1;
  fi
}
## . END _updateKfocusPkgsFn }

## BEGIN _reconfigHwPkgFn {
# Purpose: Reconfigure the kfocus-hw package.
#   The caller must determine if this step is appropriate.
# IMPORTANT: dpkg-configure kfocus-hw runs update-initramfs, update-grub
#
_reconfigHwPkgFn () {
  declare _symlink _str;
  _cm2SetMsgFn 'Adjust for hardware';

  # Reset thunderbolt enable symlink (#5790)
  _symlink='/etc/default/grub.d/10_kfocus-tbt.cfg';
  if [ -f "${_symlink}" ] || [ -h "${_symlink}" ]; then
    rm -rf "${_symlink}";
  fi

  # Then reconfigure
  if _str="$(dpkg-reconfigure kfocus-hw 2>&1)"; then
    _cm2SucFn; else _cm2WarnStrFn "${_str}"; _cm2WarnFn; return 1;
  fi
}
## . END _reconfigHwPkgFn }

## BEGIN _installToolsPkgFn {
# Purpose: Install kfocus tool package specified in $1
#   The caller must provide the appropriate package.
#
_installToolsPkgFn () {
  declare _tools_pkg;
  _tools_pkg="${1:-}";
  _cm2SetMsgFn "Install Tools Package ${_tools_pkg}";
  if ! [[ "${_tools_pkg}" =~ ^kfocus-tools ]]; then
    _cm2WarnFn; return 1;
  fi

  if _cm2ReinstallPkgsFn "${_tools_pkg}"; then
    _cm2SucFn; else _cm2WarnFn; return 1;
  fi
}
## . END _installToolsPkgFn }

## BEGIN _installKbdIteFn {
# Purpose: Install kfocus-keyboard-ite package.
#
_installKbdIteFn () {
  _cm2SetMsgFn 'Install kfocus-keyboard-ite package';
  if _cm2ReinstallPkgsFn 'kfocus-keyboard-ite'; then
    _cm2SucFn; else _cm2WarnFn; return 1;
  fi
}
## . END _installKbdIteFn }

## BEGIN _purgeKbdIteFn {
# Purpose: Purge kfocus-keyboard-ite package.
#
_purgeKbdIteFn () {
  _cm2SetMsgFn 'Purge kfocus-keyboard-ite package';
  if apt-get purge -y 'kfocus-keyboard-ite'; then
    _cm2SucFn; else _cm2WarnFn; return 1;
  fi
}
## . END _purgeKbdIteFn }

## BEGIN _getNvSeriesStrFn {
# Purpose: Determine nvidia graphics card series
#
_getNvSeriesStrFn () {
  declare _nv_line;
  _nv_line=$(lspci |grep -i 'VGA compatible controller' |grep -i 'nvidia');

  if grep -q 'RTX 20' <<< "${_nv_line}"; then
    echo 'rtx20';
  elif grep -q 'RTX 30' <<< "${_nv_line}"; then
    echo 'rtx30';
  # GN21 = RTX 4090
  elif grep -qE '(RTX 40|GN21)' <<< "${_nv_line}"; then
    echo 'rtx40';
  elif grep -qE 'RTX 50' <<< "${_nv_line}"; then
    echo 'rtx50';
  else echo '';
  fi
}
## . END _getNvSeriesStrFn }

## BEGIN _installNvidiaFn {
# Purpose: Install kfocus nvidia packages.
#   The caller must determine if this step is appropriate.
#
_installNvidiaFn () {
  declare _dmi_hw_config_code _nv_pkg_suffix;

  # Use kfocus-nvidia-pinning-edge and kfocus-nvidia-edge for the latest hw
  _dmi_hw_config_code="$(_cm2EchoModelStrFn 'config_code')";
  _nv_pkg_suffix='';
  ## No edge drivers in 26.04 yet
  # if [[ "${_dmi_hw_config_code}" =~ ^(m2g6|zrg1)$ ]]; then
  #   _nv_pkg_suffix='-edge';
  # else
  #   _nv_series_str="$(_getNvSeriesStrFn)";
  #   if [ "${_nv_series_str}" = 'rtx50' ]; then
  #     _nv_pkg_suffix='-edge';
  #   fi
  # fi

  _cm2SetMsgFn 'Install NVIDIA Packages';
  if ! _cm2ReinstallPkgsFn "kfocus-nvidia-pinning${_nv_pkg_suffix}"; then
    _cm2WarnStrFn "Trouble installing nvidia-pinning${_nv_pkg_suffix}.";
    _cm2WarnFn; return 1;
  fi
  if ! apt-get update; then
    _cm2WarnStrFn 'Trouble updating apt package list.';
  fi
  if ! _cm2ReinstallPkgsFn "kfocus-nvidia${_nv_pkg_suffix}"; then
    _cm2WarnStrFn "Trouble installing kfocus-nvidia${_nv_pkg_suffix}.";
    _cm2WarnFn; return 1;
  fi
  _cm2SucFn;
}
## END _installNvidiaFn }

## BEGIN _installSynapticsFn {
# Purpose: Install xserver-xorg-input-synaptics package.
#
_installSynapticsFn () {
  _cm2SetMsgFn 'Install xserver-xorg-input-synaptics package';
  if _cm2ReinstallPkgsFn 'xserver-xorg-input-synaptics'; then
    _cm2SucFn; else _cm2WarnFn; return 1;
  fi
}
## . END _installSynapticsFn }

## BEGIN _purgeRollbackFn {
#
_purgeRollbackFn () {
  _cm2SetMsgFn 'Purge kfocus-rollback package';
  if apt-get purge -y 'kfocus-rollback'; then
    _cm2SucFn;
  else
    _cm2WarnFn;
    return 1;
  fi
}
## . END _purgeRollbackFn }

## BEGIN _chkBiosUpdateFn {
# Purpose: Return true if no BIOS is upgrade needed
#
_chkBiosUpdateFn () {
  declare _btool_check_str;
  if [ -z "${_btoolExe}" ]; then exit 0; fi
  _btool_check_str="$("${_btoolExe}" '-d')";
  if [ "${_btool_check_str}" = 'dl_bios_greater_required_upgrade' ] \
    || [ "${_btool_check_str}" = 'dl_bios_lesser_required_downgrade' ]; then
    exit 1;
  fi
  exit 0;
}
## . END _chkBiosUpdateFn }

## BEGIN _chkHwConfigFn {
# Purpose  : Check hw config components and return fixup steps in a
#   string. This string can be sent to _fixHwConfigFn using the
#   fix-hw-config directive.
#
# Arguments: $1 _do_force=(y/N)          Force reconfig flag
#            $2 _is_internet_chkd=(y/N)  Internet checked flag
#
_chkHwConfigFn () {
  declare _do_force _is_internet_chkd _is_hw_reconfig _reason_list \
    _dmi_hw_config_code _dmi_hw_model_code                  \
    _file_hw_config_code _file_hw_model_code                \
    _msg _report_str _tool_pkg_suffix _tool_pkg_name        \
    _is_nv_system _nv_pkg_suffix _btrfs_status _ret_code;

  _do_force='n';
  if [[ "${1:-}" =~ ^[Yy] ]]; then _do_force='y'; fi
  _is_internet_chkd='n';
  if [[ "${2:-}" =~ ^[Yy] ]]; then _is_internet_chkd='y'; fi

  _is_hw_reconfig='n';
  _reason_list=();
  _dmi_hw_config_code="$(_cm2EchoModelStrFn 'config_code')";
  _dmi_hw_model_code="$( _cm2EchoModelStrFn 'code')";
  _file_hw_config_code="$(cat "${_hwConfigCodeFile}" 2>/dev/null || echo '')";
  _file_hw_model_code="$( cat "${_hwModelCodeFile}"  2>/dev/null || echo '')";

  ## Begin Consider directive to reconfig hw pkg {
  #   This changes many config file, DPI, hints widget.
  #
  # Do it if the _do_force flag is set
  if [ "${_do_force}" = 'y' ]; then
    _msg='reconfig-hw;;Hardware reconfigure forced.';
    _reason_list+=( "${_msg}" );
    _is_hw_reconfig='y';
  # Do it if config_code does not match (set by kfocus-hw)
  elif [ "${_dmi_hw_config_code}" != "${_file_hw_config_code}" ]; then
    _msg='reconfig-hw;;Found hardware signature does not match expected: ';
    _msg+="${_dmi_hw_config_code} != ${_file_hw_config_code}";
    _reason_list+=( "${_msg}" );
    _is_hw_reconfig='y';
  # Do it if model code does not match (set by this code on completion)
  elif [ "${_dmi_hw_model_code}" != "${_file_hw_model_code}" ]; then
    _msg='reconfig-hw;;Found model signature does not match expected: ';
    _msg+="${_dmi_hw_model_code} != ${_file_hw_model_code}";
    _reason_list+=( "${_msg}" );
    _is_hw_reconfig='y';
  fi
  ## . End Consider directive to reconfig hw pkg }

  ## Begin Consider directives applied only on hw pkg reconfig {
  #   _do_force='y' OR mismatched hw-config-code OR hw-model-code sets
  #   this, so _do_force='y' is *NOT* guaranteed for this block!
  #
  if [ "${_is_hw_reconfig}" = 'y' ]; then
    # 6204 Clear config codes
    _file_hw_config_code=''; rm "${_hwConfigCodeFile}" 2>/dev/null || true;
    _file_hw_model_code='';  rm "${_hwModelCodeFile}"  2>/dev/null || true;

    # 6204 Request caller check for internet and try again
    if [ "${_is_internet_chkd}" = 'n' ]; then
      echo 'CHECK_INTERNET';
      return;
    fi

    # 6204 Update apt list and kfocus packages
    _report_str="$(_updateKfocusPkgsFn)";
    _ret_code="$?";
    if (( _ret_code == 2 )); then
      echo 'RERUN_REQUIRED';
      return;
    elif (( _ret_code > 0 )); then
      echo "CANNOT_UPGRADE: |${_report_str}|";
      return;
    fi

    ## Begin Consider directive to change tools pkg {
    #   Install pkg named like kfocus-tools<-model> (#3424)
    _tool_pkg_suffix='';
    case "${_dmi_hw_config_code}" in
      default|generic|m2g4|m2g5|xeg2) _tool_pkg_suffix='';;
      nxg1)   _tool_pkg_suffix='-nxg1';;
      m2g6)   _tool_pkg_suffix='-m2g6';;
      zrg1)   _tool_pkg_suffix='-m2g6';;
      ir1Xg3) _tool_pkg_suffix='-ir1xg3';;
      ir14g1|ir1Xg2|other|*) _tool_pkg_suffix='-other';;
    esac
    _tool_pkg_name="kfocus-tools${_tool_pkg_suffix}";

    if ! _cm2ChkPkgFn "${_tool_pkg_name}"; then
      _tool_pkg_name='kfocus-tools-other';
    fi

    if ! _cm2ChkInstalledPkgFn "${_tool_pkg_name}"; then
      _msg="install-hw-tools;${_tool_pkg_name};";
      _msg+="Package ${_tool_pkg_name} needs to be installed.";
      _reason_list+=( "${_msg}" );
    elif [ "${_do_force}" = 'y' ]; then
      _msg="install-hw-tools;${_tool_pkg_name};";
      _msg+="Package ${_tool_pkg_name} reinstall forced.";
      _reason_list+=( "${_msg}" );
    fi
    ## . End Consider directive to change tools pkg }

    ## Begin Consider directive to add or remove keyboard pkg {
    if [[ "${_dmi_hw_model_code}" =~ ^(m2g5p|zrg1) ]]; then
      if ! _cm2ChkInstalledPkgFn 'kfocus-keyboard-ite'; then
        _msg='install-kbd-ite;;';
        _msg+='Package kfocus-keyboard-ite needs to be installed.';
        _reason_list+=( "${_msg}" );
      elif [ "${_do_force}" = 'y' ]; then
        _msg='install-kbd-ite;;';
        _msg+='Package kfocus-keyboard-ite reinstall forced.';
        _reason_list+=( "${_msg}" );
      fi
    else
      if _cm2ChkInstalledPkgFn 'kfocus-keyboard-ite'; then
        _msg='purge-kbd-ite;;';
        _msg+='Package kfocus-keyboard-ite needs purge.';
        _reason_list+=( "${_msg}" );
      fi
    fi
    ## . End Consider directive to add or remove keyboard pkg }

    ## Begin Consider directive to adjust nvidia pkgs {
    _is_nv_system="$(_cm2EchoModelStrFn 'is_nv_sys')";
    _nv_pkg_suffix='';
    ## No edge drivers in 26.04 yet
    # if [ "${_is_nv_system}" = 'y' ]; then
    #   if [[ "${_dmi_hw_config_code}" =~ ^(m2g6|zrg1)$ ]]; then
    #     _nv_pkg_suffix='-edge';
    #   fi
    # else
    #   _nv_series_str="$(_getNvSeriesStrFn)";
    #   if [ -n "${_nv_series_str}" ]; then
    #     _is_nv_system='y';
    #     if [ "${_nv_series_str}" = 'rtx50' ]; then
    #       _nv_pkg_suffix='-edge';
    #     fi
    #   fi
    # fi

    # Add directive if nvidia libs should be installed
    if [ "${_is_nv_system}" = 'y' ]; then
      if ! _cm2ChkInstalledPkgFn "kfocus-nvidia${_nv_pkg_suffix}"; then
        _msg='install-nvidia;;Nvidia libraries needs to be installed.';
        _reason_list+=( "${_msg}" );
      elif [ "${_do_force}" = 'y' ]; then
        _msg='install-nvidia;;Nvidia libraries reinstall forced.';
        _reason_list+=( "${_msg}" );
      fi
    fi
    ## . End Consider directive to adjust nvidia pkgs }

    ## Begin Consider directive to add synaptics touchpad support {
    case "${_dmi_hw_config_code}" in
      default|generic|xeg2)  # For models m1g1, m2g1-3 | xeg1 | xeg2
        if ! _cm2ChkInstalledPkgFn 'xserver-xorg-input-synaptics'; then
          _msg='install-synaptics;;';
          _msg+='Synaptics touchpad driver needs to be installed.';
          _reason_list+=( "${_msg}" );
        elif [ "${_do_force}" = 'y' ]; then
          _msg='install-synaptics;;';
          _msg+='Synaptics touchpad driver forced re-installation.';
          _reason_list+=( "${_msg}" );
        fi
      ;;
      *) true;;
    esac
    ## . End Consider directive to add synaptics touchpad support }

    ## Begin Consider directive to purge rollback support {
    if [ -n "${_rollbackBackendExe}" ]; then
      _btrfs_status="$("${_rollbackBackendExe}" 'getBtrfsStatus')";
      if [ "${_btrfs_status}" = 'UNSUPPORTED' ] \
        || [ "${_btrfs_status}" = 'INCONSISTENT' ]; then
        _msg='purge-rollback;;';
        _reason_list+=( "${_msg}" );
      fi
    fi
    ## . End Consider directive to purge rollback support }
  fi
  ## . End Consider directives applied only on hw pkg reconfig }

  ( IFS=$'|'; echo "${_reason_list[*]}"; )
}
## . END _chkHwConfigFn }

## BEGIN _fixHwConfigFn {
# Purpose: Loop through hardware config steps and execute as needed.
#          On completion, writes the model code to a kfocus file.
# Output : stdout is a message intended for UI.
#
_fixHwConfigFn () {
  declare _reason_str _reason_list _loop_line \
    _bit_list _cmd_list _model_code;

  _reason_str="${1:-}";
  if [ -z "${_reason_str}" ]; then return 0; fi
  IFS='|' read -r -a _reason_list <<< "${_reason_str}";

  _cm2EchoFn '## BEGIN process hw-config directives';
  _cm2EchoFn "  >>>${_reason_str}<<<\n";
  for _loop_line in "${_reason_list[@]}"; do
    IFS=';' read -r -a _bit_list <<< "${_loop_line}";
    _cm2EchoFn "Process directive |${_bit_list[*]}|";
    case "${_bit_list[0]}" in
      'reconfig-hw'       ) _cmd_list=( '_reconfigHwPkgFn'    );;
      'install-hw-tools'  ) _cmd_list=( '_installToolsPkgFn'  );
        _cmd_list+=( "${_bit_list[1]:-}" );;
      'install-kbd-ite'   ) _cmd_list=( '_installKbdIteFn'    );;
      'install-nvidia'    ) _cmd_list=( '_installNvidiaFn'    );;
      #'install-synaptics' ) _cmd_list=( '_installSynapticsFn' );;
      'purge-kbd-ite'     ) _cmd_list=( '_purgeKbdIteFn'      );;
      'purge-rollback'    ) _cmd_list=( '_purgeRollbackFn'    );;
      *)
        echo 'Abort: Could not complete step:';
        echo "  Directive |${_bit_list[0]}| is not supported";
        echo "  Trouble with |${_loop_line}|";
        return 1;
        ;;
    esac
    if ! "${_cmd_list[@]}"; then
      echo 'Abort: Could not complete step:';
      echo "  Trouble with |${_loop_line}| |${_cmd_list[*]}|";
      return 1;
    fi
  done
  _cm2EchoFn '## . END process hw-config directives\n';

  # Indicate post-install (finalize) setup is complete
  _model_code="$(_cm2EchoModelStrFn 'code')" || return 1;
  mkdir -p "${_varLibDir}"                   || return 1;
  # This is set only on post-install configuration
  echo "${_model_code}" > "${_hwModelCodeFile}" || true;
}
## . END_fixHwConfigFn }

## BEGIN _prepareSnapshotFn {
_prepareSnapshotFn () {
  [ -z "${_rollbackBackendExe}" ] && return;
  "${_rollbackBackendExe}" 'prepareSystem';
}
## . END _prepareSnapshotFn }

## BEGIN _clearRestoreFn {
_clearRestoreFn () {
  [ -z "${_rollbackBackendExe}" ] && return;
  "${_rollbackBackendExe}" 'clearRestore';
}
## . END _clearRestoreFn }

## BEGIN _setKeyCodesFn {
# Purpose: Used to set keyboard codes per model.
# Typically, this is needed if a key code is undefined.
#
_setKeyCodesFn () {
  declare _model_code;
  _model_code="$(_cm2EchoModelStrFn 'code')" || return;

  case "${_model_code}" in
    zrg1|m2g5p) setkeycodes 6f 112 || true;;
    *) true;;
  esac
}
## . END _setKeyCodesFn }

## BEGIN _mainFn {
_mainFn () {
  declare _arg_str _report_str;
  _arg_str="${1:-}";
  case "${_arg_str}" in
    'chk-bios'        ) _chkBiosUpdateFn;;
    'chk-hw-config'   ) shift; _chkHwConfigFn "${@}";;
    'fix-hw-config'   ) shift;
      if ! _report_str="$(_fixHwConfigFn "${@}")"; then
        # Echo stdout for UI display
        echo "${_report_str:-Undeclared error}";
        exit 1;
       fi
       ;;
    'prep-snapshot'   ) _prepareSnapshotFn;;
    'clear-restore'   ) _clearRestoreFn;;
    'set-keycodes'    ) _setKeyCodesFn;;
    *) _cm2WarnStrFn "Unrecognized directive |${_arg_str}|";;
  esac
}
## . END _mainFn }

## BEGIN Declare global variables {
declare  _binName _binDir _baseName _assignList \
  _focusRxVersExe _rollbackBackendExe _btoolExe _hwConfigCodeFile \
  _hwModelCodeFile;

_varLibDir='/var/lib/kfocus';
_hwConfigCodeFile="${_varLibDir}/hw_config_code";
_hwModelCodeFile="${_varLibDir}/hw_model_code";
## . END Declare global variables }

## BEGIN Run main if the script is not sourced {
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  _binName="$(  readlink -f "$0"        )" || exit 101;
  _binDir="$(   dirname  "${_binName}"  )" || exit 101;
  _baseDir="$(  dirname  "${_binDir}"   )" || exit 101;
  _baseName="$( basename "${_binName}"  )" || exit 101;
  _importCommonFn;

  _assignList=(
    "_focusRxVersExe|${_binDir}/kfocus-rx-version"
    "_rollbackBackendExe|${_binDir}/kfocus-rollback-backend||optional"
    "_btoolExe|${_binDir}/kfocus-btool||optional"
  );
  if ! _cm2AssignExeVarsFn  "${_assignList[@]}"; then
    _cm2ErrStrFn 'Could not assign variable';
    exit 1;
  fi

  _mainFn "$@";
fi
## . END Run main if the script is not sourced }
