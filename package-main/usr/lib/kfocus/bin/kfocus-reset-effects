# Michael Mikowski, Erich Eickmeyer, Aaron Rainbolt
#
# Name   : kfocus-reset-effects
# Purpose: Reset KFocus desktop effects and keybindings.
#   This is also used for new user and system default initialization.
# License: GPL v2
# Run by : User
# Spec   : 2169
#
set -u;

## BEGIN _importCommonFn {
# Summary   : _importCommonFn
# Purpose   : Load common lib. See kfocus-example-app
#
_importCommonFn () {
  declare _lib_list _is_loaded _lib_file;
  _lib_list=(
    "${_baseDir}/lib/common.2.source"
    '/usr/lib/kfocus/lib/common.2.source'
  );
  _is_loaded='n';
  for _lib_file in "${_lib_list[@]}"; do
    if [ -r "${_lib_file}" ]; then
      # shellcheck source=../lib/common.2.source
      if source "${_lib_file}"; then
        _is_loaded='y';
        break;
      fi
    fi
  done

  if [ "${_is_loaded}" = 'n' ]; then
    echo 1>&2 "${_baseName}: ABORT - Cannot source common lib";
    exit 202;
  fi
}
## . END _importCommonFn }

## BEGIN _resetShortcutsFn {
# Due to KDE param handling, local writing of the default is required.
# The "do_clear_params" option is not used, but it may be useful in the
# future.
#
_resetShortcutsFn () {
  declare _do_clear_params _model_code _plasma_version _config_list \
    _line _bit_list _key _log_list _name_file _config_file \
    _opt_list _tab_char _value_str _group_list _sub_group;

  _do_clear_params='n';
  [ "${1:-}" = 'do_clear' ] && _do_clear_params='y';
  _model_code="$(_cm2EchoModelStrFn 'code')";
  _plasma_version="$(
    dpkg -l plasma-desktop |awk -F'[:-]' '/plasma-desktop\s/{print $3}'
  )";

  _config_list=(
    # Define desktops.
    'kwin|Desktops|Name_1|ONE'
    'kwin|Desktops|Name_2|TWO'
    'kwin|Desktops|Name_3|THREE'
    'kwin|Desktops|Name_4|FOUR'
    'kwin|Desktops|Number|4'
    'kwin|Desktops|Rows|4'

    # Configure overview.
    'kwin|Effect-overview|FilterWindows|'
    'kwin|Effect-overview|IgnoreMinimized|'
    'kwin|Effect-overview|OrganizedGrid|'
    'kwin|Effect-overview|BorderActivate|'

    # Disable Night Color by default as it can cause flickering on Intel.
    # Users also find it confusing.
    'kwin|NightColor|Active|false'

    # Enable transparent move, squash windows, wobbly effects.
    'kwin|Effect-translucency|MoveResize|75'
    'kwin|Effect-wobblywindows|AdvancedMode|true'
    'kwin|Effect-wobblywindows|Drag|85'
    'kwin|Effect-wobblywindows|Stiffness|10'
    'kwin|Effect-wobblywindows|MoveFactor|5'

    # Enable plugins
    'kwin|Plugins|overviewEnabled|true'
    'kwin|Plugins|translucencyEnabled|true'
    'kwin|Plugins|mouseclickEnabled|true'
    'kwin|Plugins|trackmouseEnabled|true'
    'kwin|Plugins|wobblywindowsEnabled|true'
    'kwin|Plugins|hidecursorEnabled|true'

    # Enforce default window borders
    'kwin|org.kde.kdecoration2|BorderSize|'
    'kwin|org.kde.kdecoration2|BorderSizeAuto|'

    # Enable Wrap-around navigation
    'kwin|Windows|RollOverDesktops|true'

    # Set Keyboard shortcuts
    'scut|kwin|Switch One Desktop Down|Meta+Ctrl+Down,Meta+Ctrl+Down,Switch One Desktop Down'
    'scut|kwin|Switch One Desktop Up|Meta+Ctrl+Up,Meta+Ctrl+Up,Switch One Desktop Up'
    'scut|kwin|Switch One Desktop to the Left|Meta+Ctrl+Left,Meta+Ctrl+Left,Switch One Desktop to the Left'
    'scut|kwin|Switch One Desktop to the Right|Meta+Ctrl+Right,Meta+Ctrl+Right,Switch One Desktop to the Right'
    'scut|kwin|Window Fullscreen|Meta+F,,Make Window Fullscreen'
    'scut|kwin|Grid View|Meta+G,Meta+G,Toggle Grid View'
    'scut|kwin|Switch to Desktop 1|Meta+F1\tCtrl+F1,Meta+F1\tCtrl+F1,Switch to Desktop 1'
    'scut|kwin|Switch to Desktop 2|Meta+F2\tCtrl+F2,Meta+F2\tCtrl+F2,Switch to Desktop 2'
    'scut|kwin|Switch to Desktop 3|Meta+F3\tCtrl+F3,Meta+F3\tCtrl+F3,Switch to Desktop 3'
    'scut|kwin|Switch to Desktop 4|Meta+F4\tCtrl+F4,Meta+F4\tCtrl+F4,Switch to Desktop 4'
    'scut|kwin|Walk Through Windows|Meta+Tab\tAlt+Tab,Meta+Tab\tAlt+Tab,Walk Through Windows'
    'scut|kwin|Walk Through Windows (Reverse)|Meta+Shift+Tab\tAlt+Shift+Tab,Meta+Shift+Tab\tAlt+Shift+Tab,Walk Through Windows (Reverse)'
    'scut|services!org.kde.krunner.desktop|_launch|Alt+F2\tAlt+Space\tSearch'
    'scut|kwin|Show Desktop|Meta+D,Meta+D,Peek at Desktop'
    'scut|kwin|view_actual_size|Meta+0,Meta+0,Zoom to Actual Size'
    'scut|kwin|view_zoom_in|Meta++\tMeta+=,Meta++\tMeta+=,Zoom In'
    'scut|kwin|view_zoom_out|Meta+-,Meta+-,Zoom Out'
    'scut|services!org.kde.plasma.emojier.desktop|_launch|Meta+.\tMeta+Ctrl+Alt+Shift+Space'
    'scut|ksmserver|Lock Session|Meta+L\tScreensaver,Meta+L\tScreensaver,Lock Session'
    'scut|kwin|Edit Tiles|Meta+T,Meta+T,Toggle Tiles Editor'
    'scut|kwin|Window Minimize|Meta+PgDown,Meta+PgDown,Minimize Window'
    'scut|kwin|Window Maximize|Meta+PgUp,Meta+PgUp,Maximize Window'
    'scut|kwin|Window Quick Tile Top|Meta+Up,Meta+Up,Quick Tile Window to the Top'
    'scut|kwin|Window Quick Tile Left|Meta+Left,Meta+Left,Quick Tile Window to the Left'
    'scut|kwin|Window Quick Tile Right|Meta+Right,Meta+Right,Quick Tile Window to the Right'
    'scut|kwin|Window Quick Tile Bottom|Meta+Down,Meta+Down,Quick Tile Window to the Bottom'
    'scut|services!org.kde.touchpadshortcuts.desktop|Toggle Touchpad|Meta+Space\tTouchpad Toggle,Touchpad Toggle,Toggle Touchpad'

    # Set the model-specific shortcuts.
    'scut|kwin|Window Minimize|Meta+Num+PgDown\tMeta+PgDown,Meta+PgDown,Minimize Window|ir16g2'
    'scut|kwin|Window Maximize|Meta+PgUp\tMeta+Num+PgUp,Meta+PgUp,Maximize Window|ir16g2'

    # Reset all things mouse tracking to defaults.
    'scut|kwin|TrackMouse|'
    'kwin|Effect-trackmouse|Alt|'
    'kwin|Effect-trackmouse|Control|'
    'kwin|Effect-trackmouse|Meta|'
    'kwin|Effect-trackmouse|Shift|'

    # Set cursorsize for all devices to 36.
    'inpu|Mouse|cursorSize|36'
    'inpu|Mouse|cursorTheme|breeze_cursors'

    # Prevent the plasma-welcome center from running alone.
    # It is presented in the first-run wizard.
    "plwc|General|LastSeenVersion|${_plasma_version:-6.6.4}"

    # Reset DPI per ticket 3521: Set the scale factor based on the device.
    #   First, clear prior values.
    'font|General|forceFontDPI|'
    'glob|KScreen|ScaleFactor|'
    'glob|KScreen|ScreenScaleFactors|'

    # Second, set desired values on devices where it matters.
    # Ticket 6374: These settings only affects X11, which is as desired.
    #   In Wayland, this is a no-op and per-display configs are stored in
    #   kwinoutputconfig.json. The values there are auto-calculated by
    #   Wayland using EDID data, and is generally good.
    'font|General|forceFontDPI|120|ir14g1'
    'font|General|forceFontDPI|120|ir14g2'
    'font|General|forceFontDPI|120|ir16g2'
    'font|General|forceFontDPI|144|ir14g3'
    'font|General|forceFontDPI|120|m2g4'
    'font|General|forceFontDPI|120|m2g5'
    'font|General|forceFontDPI|120|m2g5p'
    'font|General|forceFontDPI|120|m2g6'
    'font|General|forceFontDPI|120|zrg1'
  );

  _tab_char=$'\t';
  _log_list=();
  if [ "${_do_clear_params}" = 'y' ]; then
    _log_list+=("NOTICE: All config keys will be cleared.");
  fi

  for _line in "${_config_list[@]}"; do
    IFS='|' read -r -a _bit_list <<<"${_line}";
    _key="${_bit_list[0]:-}";
    if [ "${_do_clear_params}" = 'y' ]; then
      _bit_list[3]='';
    fi

    ## DEBUG: Skip keys
    # if [[ "${_key}" =~ ^(font|glob)$ ]];
    # then _cm2EchoFn "Process ${_line}";
    # else _cm2WarnStrFn "Skip ${_line}"; continue;
    # fi
    # DEBUG: delete all kwin keys
    # if [ "${_key}" = 'kwin' ]; then
    #   _bit_list[3]='';
    # fi

    _name_file="${_fileMap[$_key]}";
    if [ -z "${_name_file}" ]; then
      _log_list+=("WARN: Config key |${_key}| is not supported.");
      continue;
    fi

    _config_file="${_configDir}/${_name_file}";
    # If this is a symbolic link, remove it
    if [ -h "${_config_file}" ]; then rm "${_config_file}"; fi

    # Create a config file if it is missing
    if [ ! -f "${_config_file}" ]; then
      # Skip creating just to delete an attribute
      if [ -z "${_bit_list[3]:-}" ]; then continue; fi

      if touch "${_config_file}"; then
        _log_list+=("INFO: Created config file |${_config_file}|.");
      else
        _log_list+=("ERROR: Could not create config file |${_config_file}|.");
        continue;
      fi
    fi

    if [ -n "${_bit_list[4]:-}" ]; then
      if grep -q "^${_model_code}$" <<<"${_bit_list[4]:-}"; then
        _log_list+=("INFO: match model |${_bit_list[4]:-}|");
      else
        _log_list+=("INFO: SKIP no match model |${_bit_list[4]:-}|");
        continue
      fi
    fi

    _opt_list=( '--file' "${_config_file}" );
    IFS='!' read -r -a _group_list <<< "${_bit_list[1]}";
    for _sub_group in "${_group_list[@]}"; do
      _opt_list+=( '--group' "${_sub_group}" );
    done
    _opt_list+=( '--key' "${_bit_list[2]}" );

    if [ -n "${_bit_list[3]:-}" ]; then
      # Important: Must replace \t with real tab char for this to work
      _value_str="${_bit_list[3]//\\t/${_tab_char}}"
      _opt_list+=( "${_value_str}" );
      _log_list+=("INFO: Set |${_bit_list[@]:1:4}| in |${_config_file}|");
    else
      _opt_list+=('--delete');
      _log_list+=("INFO: Delete |${_bit_list[@]:1:3}| in |${_config_file}|");
    fi

    "${_kwriteconfig6Exe}" "${_opt_list[@]}";
  done

  ( IFS=$'\n'; echo "Reset values:"; echo "${_log_list[*]}" )
}
## . END _resetShortcutsFn }

## BEGIN _mainFn {
_mainFn () {
  declare _notify_str _prompt_msg _reply_str _power_file _mime_file;

  # Immediately apply effects and return if a "-d" option is provided.
  if [ "${1:-}" = '-d' ]; then
    if [ -n "${2:-}" ]; then
      _configDir="$(readlink -f "${2:-}")";
      if [ -d "${_configDir}" ]; then _resetShortcutsFn; fi
    fi
    return;
  fi

  # Bail if HOME is not set
  if [ -z "${HOME:-}" ]; then
    _cm2WarnStrFn 'SKIP: No HOME var set.';
    return;
  fi

  _configDir="${HOME:-}/.config";
  _notify_str='';
  if [ -n "${_settingsExe}" ] \
    && pgrep -xf "${_settingsExe}" > /dev/null; then
    _notify_str="$(cat <<_EOH00
${_cm2HtmPStr}Continuing will close <b>System Settings</b> to <br>
to minimize conflicts.</p>
_EOH00
    )";
  fi

  # Notify user
  _prompt_msg="$(cat <<_EOH01
${_cm2HtmBeginStr}
<h3 style="color:#f7941d">KFocus Reset Effects</h3>

${_cm2HtmPStr}This app resets keyboard shortcuts and desktop<br>
effects to Kubuntu Focus defaults.</p>
${_notify_str}

${_cm2HtmPStr}Continue with Reset?</p>
${_cm2HtmEndStr}
_EOH01
  )";

  _reply_str="$(_cm2PromptUserFn "${_prompt_msg}" "${_rootTitle}" 'a')";
  if [ "${_reply_str}" = 'n' ]; then exit 0; fi


  if [ -n "${_settingsExe}" ] \
    && pgrep -xf "${_settingsExe}" > /dev/null; then
    pkill -xf "${_settingsExe}" || true;
  fi

  # Request to reset effects and keyboard shortcuts
  _prompt_msg='Reset effects and keyboard shortcuts';
  _reply_str="$(_cm2PromptUserFn "${_prompt_msg}" "${_rootTitle}" 'a')";
  if [ "${_reply_str}" = 'y' ]; then _resetShortcutsFn 'keep'; fi

  # Request to reset power management
  _power_file="${_configDir}/powermanagementprofilesrc";
  if [ -f "${_power_file}" ]; then
    _prompt_msg='Reset power management to default';
    _reply_str="$(_cm2PromptUserFn "${_prompt_msg}" "${_rootTitle}" 'a')";
    if [ "${_reply_str}" = 'y' ]; then
      rm "${_power_file}" || true;
    fi
  fi

  # Request to reset mime handlers
  _mime_file="${_configDir}/mimeapps.list";
  if [ -f "${_mime_file}" ]; then
    _prompt_msg='Reset file associations to default';
    _reply_str="$(_cm2PromptUserFn "${_prompt_msg}" "${_rootTitle}" 'a')";
    if [ "${_reply_str}" = 'y' ]; then
      rm "${_mime_file}" || true;
    fi
  fi

  # Rebuild desktop cache
  kbuildsycoca6 || true;

  # OLD IMPLEMENTATION: Restart reconfigured applications without relog
  #   This has been disabled, because restarting kwin_wayland kills or
  #   confuses many apps, including Chrome.
#  # Confirm application of settings
#  # shellcheck disable=SC2181
#  _prompt_msg="$(cat <<_EOH02
#${_cm2HtmBeginStr}
#<h3 style="color:#f7941d">KFocus Reset Effects Finished</h3>
#${_cm2HtmPStr}To apply effects, press OK to reload plasma, <br>
#reload the window manager, and reset the keyboard <br>
#shortcuts.</p>
#
#${_cm2HtmPStr}This should apply most changes, but for all <br>
#to apply, you must log out and back in.<br></p>
#
#${_cm2HtmEndStr}
#_EOH02
#  )";
#  _cm2PromptUserFn "${_prompt_msg}" "${_rootTitle}";
#
#  # Reload global key mappings. The keyword "kglobalaccel" is NOT a typo.
#  # kglobalaccel now works in a weird way and this no longer works.
#  # kquitapp6 kglobalaccel && sleep 2 && kglobalaccel6 &
#  # # shellcheck disable=SC2181
#  # if [ "$?" = '0' ]; then disown "$!"; fi
#  # sleep 1;
#
#  # Replace plasma shell
#  nohup plasmashell --replace > /dev/null 2>&1 &
#  # shellcheck disable=SC2181
#  if [ "$?" = '0' ]; then disown "$!"; fi
#  sleep 2;
#
#  # Replace window manager
#  # kwin is now kwin_wayland for Wayland, and kwin_x11 for X11. Restarting
#  # kwin_wayland may result in data loss.
#  # nohup kwin --replace > /dev/null 2>&1 &
#  # # shellcheck disable=SC2181
#  # if [ "$?" = '0' ]; then disown "$!"; fi
#  # sleep 2;

  # NEW IMPLEMENTATION: Prompt user to log out and back in immediately. There
  #   is some risk of desktop components rewriting their configuration files
  #   before or during logout, which will result in an incomplete settings
  #   reset. See ticket ???? for details and other possible implementations.
  _prompt_msg="$(cat <<_EOH02
${_cm2HtmBeginStr}
<h3 style="color:#f7941d">KFocus Reset Effects Finished</h3>
${_cm2HtmPStr}To apply effects, log out and back in. This should be done <br>
as soon as possible, to prevent configuration changes from <br>
being undone.</p>
${_cm2HtmEndStr}
_EOH02
  )";
  _cm2PromptUserFn "${_prompt_msg}" "${_rootTitle}";
}
## . END _mainFn }

## BEGIN Declare and assign global vars {
declare _rootTitle _assignList _kwriteconfig6Exe _configDir _settingsExe;
declare -A _fileMap=(
  ['font']=kcmfonts
  ['glob']=kdeglobals
  ['kwin']=kwinrc
  ['plwc']=plasma-welcomerc
  ['scut']=kglobalshortcutsrc
  ['inpu']=kcminputrc
);
_configDir='';
_settingsExe="$(command -v systemsettings)";
_rootTitle='Kubuntu Focus Reset Effects';
## . END Declare and assign global vars }

## BEGIN Run main if the script is not sourced {
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  _binName="$(  readlink -f "$0"       )" || exit 101;
  _binDir="$(   dirname  "${_binName}" )" || exit 101;
  _baseDir="$(  dirname  "${_binDir}"  )" || exit 101;
  _baseName="$( basename "${_binName}" )" || exit 101;

  _importCommonFn;

  _assignList=(
    '_kwriteconfig6Exe|kwriteconfig6'
  );
  if ! _cm2AssignExeVarsFn "${_assignList[@]}"; then
    _cm2WarnStrFn 'Could not assign variables';
    exit 1;
  fi
  _mainFn "$@";
fi
## . END Run main if the script is not sourced }
