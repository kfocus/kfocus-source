# Test    : 01010_kfocusBtool
#
set -u;

## BEGIN _importCommonFn {
# Purpose: Import the common library with _cm2* symbols
#
_importCommonFn () {
  declare _lib_file;
  _lib_file="${_baseDir}/lib/common.2.source";
  if [ -r "${_lib_file}" ]; then
    # shellcheck source=../lib/common.2.source
    source "${_lib_file}" || exit 202;
  else
    echo 1>&2 "${_baseName}: ABORT - Cannot source lib |${_lib_file}|";
    exit 202;
  fi
}
## . END _importCommonFn }

## BEGIN _assignGlobalUiVarsFn {
_assignGlobalUiVarsFn () {
  _windowTitle='Focus BIOS Tool';

  # XX_SML_XX is a placeholder for "system model label".
  # XX_CURBIOS_XX is a placeholder for "current, installed bios".
  # It is the same length of model labels to minimize wrapping issues.
  _dlBiosNotAvailableMsg="$(cat <<EOF
The installed BIOS, version XX_CURBIOS_XX, is the latest available for
this XX_SML_XX system.
EOF
  )";

  _dlBiosMatchesMsg="$(cat <<EOF
The installed BIOS, version XX_CURBIOS_XX, is the latest available for
this XX_SML_XX system.

If you want to update the BIOS of another XX_SML_XX system, this tool
can download the recommended BIOS image, flash it onto a 1 GB or larger
USB drive, and show you the steps to complete the update.

Would you like to do this now?
EOF
  )";

  _dlBiosGreaterOptionalUpgradeMsg="$(cat <<EOF
The installed BIOS, version XX_CURBIOS_XX, is sufficiently up-to-date
for this XX_SML_XX system. A newer BIOS is available, but it is not
necessary to install it. If your system is working well, we recommend
leaving it alone.

XXX_UPGRADE_REASON_XXX

If you want to update the BIOS, this tool can download the recommended
BIOS image, flash it onto a 1 GB or larger USB drive, and show you the
steps to complete the update.

Would you like to do this now?
EOF
  )";

  _dlBiosGreaterRequiredUpgradeMsg="$(cat <<EOF
The installed BIOS, version XX_CURBIOS_XX, is NOT the latest available
for this XX_SML_XX system. A newer BIOS is available that will resolve
known issues.

XXX_UPGRADE_REASON_XXX

We STRONGLY recommend you update the BIOS. This tool can download the
recommended BIOS image, flash it onto a 1 GB or larger USB drive, and
show you the steps to complete the update.

Would you like to do this now?
EOF
  )";

  _dlBiosLesserRequiredDowngradeMsg="$(cat <<EOF
The installed BIOS, version XX_CURBIOS_XX, is NEWER than the recommended
version for this XX_SML_XX system.

XXX_UPGRADE_REASON_XXX

If you suspect the installed BIOS is causing issues, you may downgrade
it. This tool can download the recommended BIOS image, flash it onto a
1 GB or larger USB drive, and show you the steps to complete the update.

Would you like to do this now?
EOF
  )";

  _insertUsbMsg="$(cat <<EOF
Please insert an 1+ GB USB on which to install the BIOS update. Kubuntu
Focus systems come with a USB drive that can be used for this purpose.
IGNORE ANY OFFERS by the OS to 'mount' or 'open' any files or folders on
the drive.

IMPORTANT: THIS TOOL WILL REMOVE ALL DATA FROM THE USB DRIVE. As a
precaution, make sure to back up any data from the USB and system drives
before proceeding.

Please also ensure an active internet connection so this tool can
download the recommended BIOS image.

Press [ Enter ] to continue.
EOF
  )";

  _biosDownloadMsg='Downloading BIOS...';
  _biosDownloadEndMsg='BIOS download complete.';

  _biosFlashMsg='Flashing BIOS to USB drive...';
  _biosFlashEndMsg='Successfully flashed BIOS to USB drive.';
  _biosFlashErrMsg='Failed to flash BIOS to USB drive!';

  _cancelUpgradeMsg='BIOS update cancelled.';

  _toolEndMsg='The Focus BIOS Tool has finished running.';
  _toolEndErrMsg='The Focus BIOS Tool encountered errors and failed.';
}
## . END _assignGlobalUiVarsFn }

## BEGIN _trapExitFn {
_trapExitFn () {
  declare _msg;
  _msg="$(cat <<EOF
${_baseName}: Error encountered, operation was not successful!
EOF
  )";
  _cm2ErrStrFn "${_msg}";
  # The original exit value is returned to calling routine
  _cleanupFn;
}
## . END _trapExitFn }

## BEGIN _cleanupFn {
_cleanupFn () {
  if [ -n "${_tmpBiosFile}" ] && [ -f "${_tmpBiosFile}" ]; then
    2>/dev/null rm -f "${_tmpBiosFile}" || true;
  fi
  if [ -n "${_usbTmpMountDir}" ] && [ -d "${_usbTmpMountDir}" ]; then
    2>/dev/null umount "${_usbTmpMountDir}" || true;
    sleep 2;
    2>/dev/null rm -rf "${_usbTmpMountDir}" || true;
  fi
  if [ -n "${_tmpDir}" ] && [ -d "${_tmpDir}" ]; then
    2>/dev/null rm -rf "${_tmpDir}";
  fi
}
## . END _cleanupFn }

## BEGIN _exitCleanFn {
_exitCleanFn () {
  declare _int;
  _int="$(_cm2EchoIntFn "${1:-0}")";
  trap '' EXIT; # Ignore EXIT signal; 'trap - EXIT' reverts to default.
  _cleanupFn;
  exit "${_int}";
}
## . END _exitCleanFn }

## BEGIN _checkRootFn {
_checkRootFn () {
  declare _uid;

  _uid="$(id -u)";
  if [ "${_uid}" != '0' ]; then
    _cm2ErrStrFn 'This script must be run as root.';
    _exitCleanFn 1;
  fi
}
## . END _checkRootFn }

## BEGIN _echoHelpFn {
_echoHelpFn () {
  _cm2EchoFn "${_baseName}: Create a BIOS upgrade USB disk";
  _cm2EchoFn "  -h | --help:   Print this help message.";
  _cm2EchoFn "  -d | --detect: Detect and print the system's firmware status.";
  _cm2EchoFn "  -o | --offer:  Offer a BIOS upgrade if one is available.";
}
## . END _echoHelpFn }

## BEGIN _loadConfigFn {
_loadConfigFn () {
  declare _config_file;

  _modelCode="$(_cm2EchoModelStrFn 'code')";
  _modelLabel="$(_cm2EchoModelStrFn 'label')";
  _config_file="${_binDir}/kfocus-btool.d/${_modelCode}.source"

  # If no configuration found for this model, return and leave config-specific
  # globals empty
  if [ ! -f "${_config_file}" ]; then
    return;
  fi

  # shellcheck source=kfocus-btool.d/m2g6.source
  source "${_config_file}" || {
    _cm2ErrStrFn "Could not source config file for |${_modelCode}|!";
    exit 1;
  }
}
## . END _loadConfigFn }

## BEGIN _detectUpgradeStatusFn {
# Summary   : _detectUpgradeStatusFn
# Purpose   : Detects if an upgrade is available for the current system and if
#             the user needs to run the upgrade to fix common system issues.
# Example   : _detectUpgradeStatusFn
# Arguments : none
# Globals   : _dmiDecodeExe, _availBiosVers, _minBiosVers
# Outputs   : One of the following:
#   * dl_bios_not_available
#   * dl_bios_matches
#   * dl_bios_greater_optional_upgrade
#   * dl_bios_greater_required_upgrade
#   * dl_bios_lesser_required_downgrade
# Returns   : none
#
_detectUpgradeStatusFn () {
  if [ -z "${_availBiosVers}" ]; then
    echo 'dl_bios_not_available';
    return 0;
  fi

  if [ "${_currentBiosVers}" = "${_availBiosVers}" ]; then
    echo 'dl_bios_matches';
    return 0;
  fi

  # BIOS comparison is done in lowercase to ensure proper order.
  if _cm2TestVersFn "${_availBiosVers,,}" "${_currentBiosVers,,}"; then
    if [ "${_currentBiosVers}" = "${_minBiosVers}" ] \
      || _cm2TestVersFn "${_currentBiosVers,,}" "${_minBiosVers,,}"; then
      echo 'dl_bios_greater_optional_upgrade';
    else
      echo 'dl_bios_greater_required_upgrade';
    fi
    return 0;
  fi

  if _cm2TestVersFn "${_currentBiosVers,,}" "${_availBiosVers,,}"; then
    echo 'dl_bios_lesser_required_downgrade';
    return 0;
  fi

  _cm2ErrStrFn "Unreachable code hit in |_detectUpgradeStatusFn|!";
  _exitCleanFn 1;
}
## . END _detectUpgradeStatusFn }

## BEGIN _downloadBiosFn {
_downloadBiosFn () {
  _cm2EchoFn "${_biosDownloadMsg}";
  _tmpBiosFile="${_tmpDir}/kfocus-bios-download";
  wget "${_biosDownloadUrl}" -O "${_tmpBiosFile}" || return 1;
  _cm2EchoFn "${_biosDownloadEndMsg}\n\n";
}
## . END _downloadBiosFn }

## BEGIN _selectDiskFn {
# Returns: 0 on success, 1 on failure, 2 if the user cancels the upgrade
_selectDiskFn () {
  declare _found_list _mount_str _block_list _dev_file _byte_int _mib_int \
    _trans_key _match_str _example_str _msg _line _idx _bit_list _info_str \
    _reply _pick_idx;

  while true; do # begin scan-block
    _cm2EchoFn 'Scan USB Drives...';
    _found_list=();
    _mount_str="$(cat /proc/mounts)";
    mapfile -t _block_list < <(
      find /dev/ -maxdepth 1 -mindepth 1 -type b -name 'sd[a-z]' | sort
    );
    for _dev_file in "${_block_list[@]}"; do # begin dev-block
      _byte_int="$(blockdev --getsize64 "${_dev_file}")";
      _mib_int="$(( _byte_int / _mibBytes ))";
      _trans_key="$(lsblk -ndo tran "${_dev_file}")";
      if [ "${_trans_key}" != 'usb' ]; then continue; fi # on dev-block

      _cm2EchoFn "* Found USB Drive |${_dev_file}|";
      _match_str="$(
        grep "^${_dev_file}" <<< "${_mount_str}" | cut -f2 -d' '
      )";

      if [ "${_mib_int}" = '0' ]; then
        _cm2EchoFn '  Device has invalid size (0.00 GiB).';
        continue; # on dev-block
      fi

      if [ -n "${_match_str}" ]; then
        _cm2EchoFn "  Device is mounted at |${_match_str}|, cannot use";
        _example_str="      sudo umount ${_match_str}";
        _msg="$(cat <<EOF
  If you wish to use this device:
    A. IN ANOTHER TERMINAL, unmount the partition(s) like so:
${_example_str}
    B. If any partition cannot be unmounted because it is "busy", close
      any file manager or terminal that is using the file system and try
      again.
    C. Select "rescan" from the options below to proceed.
EOF
        )";
        _cm2EchoFn "${_msg}";
        continue;
      fi

      _found_list+=( "${_dev_file};${_mib_int}" );
    done # end dev-block

    _cm2EchoFn 'Scan complete.\n\n';

    _cm2EchoFn 'Choose an action:';
    _cm2EchoFn '=================';
    _idx=0;
    for _line in "${_found_list[@]}"; do
      IFS=';' read -r -a _bit_list <<< "${_line}";
      printf -v _info_str '%s %3.2f GB' "${_bit_list[0]}" "$(\
        bc <<< "scale=2; ${_bit_list[1]} / 1024"
      )";
      _cm2EchoFn "${_idx}. Install BIOS upgrade to ${_info_str}.";
      (( _idx++ )) || true;
    done
    _cm2EchoFn "${_idx}. Rescan USB storage devices.";
    (( _idx++ )) || true;
    _cm2EchoFn "${_idx}. Exit without changing anything.";
    _cm2EchoFn '';

    _cm2NechoFn "Enter action id (${_idx}): ";
    read -r _reply;
    _cm2EchoFn '--------------------------------';
    _pick_idx="$(_cm2EchoIntFn "${_reply:-${_idx}}")";

    if (( _pick_idx == _idx )); then
      _cm2EchoFn "${_cancelUpgradeMsg}";
      return 2;
    fi
    if (( _pick_idx == (_idx - 1) )); then continue; fi # on scan-block
    if (( _pick_idx < 0 || _pick_idx >= _idx )); then
      _cm2EchoFn "Please enter 0 through ${_idx}. Rescanning...";
      continue; # on scan-block
    fi

    IFS=';' read -r -a _bit_list <<< "${_found_list[${_pick_idx}]}";
    printf -v _info_str '%s %3.2f GB' "${_bit_list[0]}" "$(\
      bc <<< "scale=2; ${_bit_list[1]} / 1024"
    )";

    if (( _bit_list[1] > _32gibMibs )); then
      _msg="$(cat <<EOF
${_info_str} is larger than 32 GB. Are you sure you want to overwrite?
Please enter "overwrite" to confirm >
EOF
      )";
      _cm2NechoFn "${_msg} ";
      read -r _reply;
      _cm2EchoFn '';

      if [ "${_reply:-}" != 'overwrite' ]; then
        # TODO: Might be better to rescan rather than abort here
        _cm2EchoFn "${_cancelUpgradeMsg}";
        return 2;
      fi
    fi
    _msg="$(cat <<EOF
About to OVERWRITE USB drive ${_info_str} with the BIOS upgrade. All data
on this drive will be lost.

If this is correct, continue, otherwise press Ctrl+C to abort.
EOF
    )";
    _cm2PromptUserFn "${_msg}" "${_windowTitle}" 'p'
    break; # Exit scan-block, always
  done # End scan-block

  _targetUsbDev="${_bit_list[0]}";
}
## . END _selectDiskFn }

## BEGIN _beginUpgradeFn {
_beginUpgradeFn () {
  declare _return_int;
  _tmpDir="$(mktemp -d)";

  _cm2PromptUserFn "${_insertUsbMsg}" "${_windowTitle}" 'p';

  _downloadBiosFn || return 1;

  _selectDiskFn;
  _return_int="$?";
  if [ "${_return_int}" = '1' ]; then
    return 1;
  elif [ "${_return_int}" = '2' ]; then
    return 0;
  fi

  _cm2EchoFn "${_biosFlashMsg}";
  _flashBiosFn || {
    _cm2EchoFn "${_biosFlashErrMsg}\n\n"
    return 1;
  }
  _cm2EchoFn "Wrote ${_modelLabel} BIOS ${_availBiosVers} to ";
  _cm2EchoFn "USB drive ${_targetUsbDev}. It is now safe to remove.";
  _cm2EchoFn "${_biosFlashEndMsg}\n\n";

  _cm2EchoFn "${_installStepsMsg}\n\n";
}
## . END _beginUpgradeFn }

## BEGIN _tryOfferUpgradeFn {
_tryOfferUpgradeFn () {
  declare _msg _is_error_hit _reply _upgrade_status_str;

  _is_error_hit='n';
  _msg="$(cat <<EOF
 _____                      ____  _             _____           _
|  ___|__   ___ _   _ ___  | __ )(_) ___  ___  |_   _|__   ___ | |
| |_ / _ \ / __| | | / __| |  _ \| |/ _ \/ __|   | |/ _ \ / _ \| |
|  _| (_) | (__| |_| \__ \ | |_) | | (_) \__ \   | | (_) | (_) | |
|_|  \___/ \___|\__,_|___/ |____/|_|\___/|___/   |_|\___/ \___/|_|
EOF
  )";
  _cm2EchoFn "${_msg}";
  _cm2EchoFn '';

  _upgrade_status_str="$(_detectUpgradeStatusFn)";
  case "${_upgrade_status_str}" in
    'dl_bios_not_available')
      _msg="${_dlBiosNotAvailableMsg//XX_SML_XX/"${_modelLabel}"}";
      _msg="${_msg//XX_CURBIOS_XX/"${_currentBiosVers}"}";
      _cm2EchoFn "${_msg}";
      ;;
    'dl_bios_matches')
      _msg="${_dlBiosMatchesMsg//XX_SML_XX/"${_modelLabel}"}";
      _msg="${_msg//XX_CURBIOS_XX/"${_currentBiosVers}"}";
      _msg="${_msg//XXX_UPGRADE_REASON_XXX/"${_upgradeReasonMsg}"}";
      _reply="$(_cm2PromptUserFn "${_msg}" "${_windowTitle}" 'a')";
      if [ "${_reply}" = 'y' ]; then
        _beginUpgradeFn || _is_error_hit='y';
      fi
      ;;
    'dl_bios_greater_optional_upgrade')
      _msg="${_dlBiosGreaterOptionalUpgradeMsg//XX_SML_XX/"${_modelLabel}"}";
      _msg="${_msg//XX_CURBIOS_XX/"${_currentBiosVers}"}";
      _msg="${_msg//XXX_UPGRADE_REASON_XXX/"${_upgradeReasonMsg}"}";
      _reply="$(_cm2PromptUserFn "${_msg}" "${_windowTitle}" 'a')";
      if [ "${_reply}" = 'y' ] ; then
        _beginUpgradeFn || _is_error_hit='y';
      fi
      ;;
    'dl_bios_greater_required_upgrade')
      _msg="${_dlBiosGreaterRequiredUpgradeMsg//XX_SML_XX/"${_modelLabel}"}";
      _msg="${_msg//XX_CURBIOS_XX/"${_currentBiosVers}"}";
      _msg="${_msg//XXX_UPGRADE_REASON_XXX/"${_upgradeReasonMsg}"}";
      _reply="$(_cm2PromptUserFn "${_msg}" "${_windowTitle}" 'a')";
      if [ "${_reply}" = 'y' ] ; then
        _beginUpgradeFn || _is_error_hit='y';
      fi
      ;;
    'dl_bios_lesser_required_downgrade')
      _msg="${_dlBiosLesserRequiredDowngradeMsg//XX_SML_XX/"${_modelLabel}"}";
      _msg="${_msg//XX_CURBIOS_XX/"${_currentBiosVers}"}";
      _msg="${_msg//XXX_UPGRADE_REASON_XXX/"${_upgradeReasonMsg}"}";
      _reply="$(_cm2PromptUserFn "${_msg}" "${_windowTitle}" 'a')";
      if [ "${_reply}" = 'y' ] ; then
        _beginUpgradeFn || _is_error_hit='y';
      fi
      ;;
    *)
      _cm2ErrStrFn "Unexpected upgrade status |${_upgrade_status_str}| hit!";
      _is_error_hit='y';
      ;;
  esac

  if [ "${_is_error_hit}" = 'y' ]; then
    _cm2PromptUserFn "${_toolEndErrMsg}" "${_windowTitle}" 'p';
    _exitCleanFn 1;
  else
    _cm2PromptUserFn "${_toolEndMsg}" "${_windowTitle}" 'p';
    _exitCleanFn;
  fi
}
## . END _tryOfferUpgradeFn }

## BEGIN _mainFn {
_mainFn () {
  declare _arg_str;

  _arg_str="${1:-}";

  case "${_arg_str}" in
    -h|--help)   _echoHelpFn                                         ;;
    -d|--detect) _checkRootFn; _loadConfigFn; _detectUpgradeStatusFn ;;
    -o|--offer)  _checkRootFn; _loadConfigFn; _tryOfferUpgradeFn     ;;
    *)
      _cm2ErrStrFn "Invalid argument |${_arg_str}|.";
      _echoHelpFn;
      _exitCleanFn 1;
      ;;
  esac

  _exitCleanFn;
}
## . END _mainFn }

## BEGIN Declare global variables {
declare _binName _binDir _baseDir _baseName _tmpDir _tmpBiosFile \
  _usbTmpMountDir _modelCode _modelLabel _targetUsbDev _mibBytes _32gibMibs \
  _dmiDecodeExe _currentBiosVers _minBiosVers _availBiosVers \
  _biosDownloadUrl _upgradeReasonMsg _installStepsMsg _windowTitle \
  _dlBiosNotAvailableMsg _dlBiosMatchesMsg _dlBiosGreaterOptionalUpgradeMsg \
  _dlBiosGreaterRequiredUpgradeMsg _dlBiosLesserRequiredDowngradeMsg \
  _biosDownloadMsg _biosDownloadEndMsg _insertUsbMsg _biosFlashMsg \
  _biosFlashEndMsg _biosFlashErrMsg _cancelUpgradeMsg _toolEndMsg \
  _toolEndErrMsg;

_tmpDir='';
_tmpBiosFile='';
_usbTmpMountDir='';
_modelCode='';
_modelLabel='';
_targetUsbDev='';

_mibBytes=1048576;
_32gibMibs=32768;

# These variables will be filled in by the config scripts under kfocus-btool.d.
_minBiosVers='';
_availBiosVers='';
_biosDownloadUrl='';
_upgradeReasonMsg='';
_installStepsMsg='';
## . END Declare global variables }

## BEGIN Run main if the script is not sourced {
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  _binName="$(  readlink -f "$0"        )" || exit 101;
  _binDir="$(   dirname  "${_binName}"  )" || exit 101;
  _baseDir="$(  dirname  "${_binDir}"   )" || exit 101;
  _baseName="$( basename "${_binName}"  )" || exit 101;
  _importCommonFn;

  _assignList=( '_dmiDecodeExe|/usr/sbin/dmidecode' );
  if ! _cm2AssignExeVarsFn  "${_assignList[@]}"; then
    _cm2ErrStrFn 'Could not assign variable';
    exit 1;
  fi

  _assignGlobalUiVarsFn;
  _currentBiosVers="$("${_dmiDecodeExe}" -s 'bios-version')";

  # Only prompt using the terminal
  _cm2IsTty='y';

  _mainFn "$@";
fi
## . END Run main if the script is not sourced }
