#!/bin/bash
#
# Copyright 2022-2025 MindShare Inc.
# Written for the Kubuntu Focus by Michael Mikowski and Aaron Rainbolt
#
# Name    : kfocus-btool
# Purpose : Run-as-root utility to get and set bios tool values
# License : GPL v2
# Run By  : User
# Spec    : 2455,2506,5740
# Test    : 01010_kfocusBtool
#
set -u;

## BEGIN _importCommonFn {
# Purpose: Import the common library with _cm2* symbols
#
_importCommonFn () {
  declare _lib_file;
  _lib_file="${_baseDir}/lib/common.2.source";
  if [ -r "${_lib_file}" ]; then
    # shellcheck source=../lib/common.2.source
    source "${_lib_file}" || exit 202;
  else
    echo 1>&2 "${_baseName}: ABORT - Cannot source lib |${_lib_file}|";
    exit 202;
  fi
}
## . END _importCommonFn }

## BEGIN _assignGlobalUiVarsFn {
_assignGlobalUiVarsFn () {
  # TODO: Finish filling in UI vars.
  _noUpgradeAvailableMsg='No BIOS upgrades are available for this system.'
}
## . END _assignGlobalUiVarsFn }

## BEGIN _trapExitFn {
_trapExitFn () {
  declare _msg;
  _msg="$(cat <<EOF
${_baseName}: Error encountered, operation was not successful!
EOF
  )";
  _cm2ErrStrFn "${_msg}";
  _cleanupFn;
  # Original exit value is returned to calling routine
  # TODO: Does this prevent the script from exiting, or is this fine?
}
## . END _trapExitFn }

## BEGIN _cleanupFn {
_cleanupFn () {
  if [ -n "${_tmpBiosFile}" ] && [ -f "${_tmpBiosFile}" ]; then
    2>/dev/null rm -f "${_tmpBiosFile}" || true;
  fi
  if [ -n "${_usbTmpMountDir}" ] && [ -d "${_usbTmpMountDir}" ]; then
    2>/dev/null umount "${_usbTmpMountDir}" || true;
    sleep 2;
    2>/dev/null rm -rf "${_usbTmpMountDir}" || true;
  fi
  if [ -n "${_tmpDir}" ] && [ -d "${_tmpDir}" ]; then
    2>/dev/null rm -rf "${_tmpDir}";
  fi
}
## . END _cleanupFn }

## BEGIN _exitCleanFn {
_exitCleanFn () {
  declare _int;
  _int="$(_echoIntFn "${1:-0}")";
  trap '' EXIT; # Ignore EXIT signal. 'trap - EXIT' would revert to default.
  _cleanupFn;
  exit "${_int}";
}
## . END _exitCleanFn }

## BEGIN _testVersionFn {
# Summary   : _testVersionFn version1 version2
# Purpose   : Tests if version1 is newer than version 2.
# Example   : _testVersionFn '1.07.12MIN29' '1.07.07MIN29'
# Arguments : version1 and version2, both of which are strings.
# Globals   : none
# Outputs   : none
# Returns   : 0 if version1 sorts before version2 when using a version sort, 1
#             otherwise.
#
_testVersionFn () {
  declare _v1 _v2;
  _v1="${1:-}"; _v2="${2:-}";
  [ "$_v1" = "$_v2" ] && return 1;
  [ "$_v1" = "$(echo -e "$_v1\n$_v2" |sort -rV |head -n1)" ];
}
## . END _testVersionFn }

## BEGIN _checkRootFn {
_checkRootFn () {
  declare _uid;

  _uid="$(id -u)";
  if [ "${_uid}" != '0' ]; then
    _cm2ErrStrFn 'This script must be run as root.';
    _exitCleanFn 1;
  fi
}
## . END _checkRootFn }

## BEGIN _echoHelpFn {
_echoHelpFn () {
  _cm2EchoFn "${_baseName}: Create a BIOS upgrade USB disk";
  _cm2EchoFn "  -h | --help:   Print this help message.";
  _cm2EchoFn "  -d | --detect: Detect and print the system's firmware status.";
  _cm2EchoFn "  -o | --offer:  Offer a BIOS upgrade if one is available.";
}
## . END _echoHelpFn }

## BEGIN _loadConfigFn {
_loadConfigFn () {
  declare _model_str _config_file;

  _model_str="$(_cm2EchoModelStrFn 'code')";
  _config_file="${_binDir}/kfocus-btool.d/${_model_str}.source"

  # If no configuration found for this model, return and leave config-specific
  # globals empty
  if [ ! -f "${_config_file}" ]; then
    return;
  fi

  # shellcheck source=kfocus-btool.d/m2g6.source
  source "${_config_file}" || {
    _cm2ErrStrFn "Could not source config file for |${_model_str}|!";
    exit 1;
  }
}
## . END _loadConfigFn }

## BEGIN _detectUpgradeStatusFn {
# Summary   : _detectUpgradeStatusFn
# Purpose   : Detects if an upgrade is available for the current system, and if
#             the user needs to run the upgrade to fix common system issues.
# Example   : _detectUpgradeStatusFn
# Arguments : none
# Globals   : _dmiDecodeExe, _availBiosVersion, _minBiosVersion
# Outputs   : One of the following:
#   * dl_bios_not_available
#   * dl_bios_matches
#   * dl_bios_greater_optional_upgrade
#   * dl_bios_greater_required_upgrade
#   * dl_bios_lesser_required_downgrade
# Returns   : none
#
_detectUpgradeStatusFn () {
  declare _do_print _current_bios_version;

  _do_print="${1:-}";
  _current_bios_version="$("${_dmiDecodeExe}" 'bios-version')"

  if [ -z "${_availBiosVersion}" ]; then
    echo 'dl_bios_not_available';
    return 0;
  fi

  if [ "${_current_bios_version}" = "${_availBiosVersion}" ]; then
    echo 'dl_bios_matches';
    return 0;
  fi

  if _testVersionFn "${_availBiosVersion}" "${_current_bios_version}"; then
    if [ "${_currrent_bios_version}" = "${_minBiosVersion}" ] \
      || _testVersionFn "${_current_bios_version}" "${_minBiosVersion}"; then
      echo 'dl_bios_greater_optional_upgrade';
    else
      echo 'dl_bios_greater_required_upgrade';
    fi
    return 0;
  fi

  if _testVers "${_current_bios_version}" "${_availBiosVersion}"; then
    echo 'dl_bios_lesser_required_downgrade';
    return 0;
  fi

  _cm2ErrStrFn "Unreachable code hit in |_detectUpgradeStatusFn|!";
  _exitCleanFn 1;
}
## . END _detectUpgradeStatusFn }

## BEGIN _tryOfferUpgradeFn {
_tryOfferUpgradeFn () {
  true;
}
## . END _tryOfferUpgradeFn }

## BEGIN _mainFn {
_mainFn () {
  declare _arg_str;

  _arg_str="${1:-}";

  case "${_arg_str}" in
    -h|--help)   _echoHelpFn                                         ;;
    -d|--detect) _checkRootFn; _loadConfigFn; _detectUpgradeStatusFn ;;
    -o|--offer)  _checkRootFn; _loadConfigFn; _tryOfferUpgradeFn     ;;
    *)
      _cm2ErrStrFn "Invalid argument |${_arg_str}|.";
      _echoHelpFn;
      _exitCleanFn 1;
      ;;
  esac

  _exitCleanFn;
}
## . END _mainFn }

## BEGIN Declare global variables {
declare _binName _binDir _baseDir _baseName _tmpDir _tmpBiosFile \
  _usbTmpMountDir _dmiDecodeExe _minBiosVersion _availBiosVersion \
  _installStepsMsg _noUpgradeAvailableMsg;

_tmpDir='';
_tmpBiosFile='';
_usbTmpMountDir='';

# These variables will be filled in by the config scripts under kfocus-btool.d.
_minBiosVersion='';
_availBiosVersion='';
_installStepsMsg='';
## . END Declare global variables }

## BEGIN Run main if the script is not sourced {
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  _binName="$(  readlink -f "$0"        )" || exit 101;
  _binDir="$(   dirname  "${_binName}"  )" || exit 101;
  _baseDir="$(  dirname  "${_binDir}"   )" || exit 101;
  _baseName="$( basename "${_binName}"  )" || exit 101;
  _importCommonFn;

  _assignList=( '_dmiDecodeExe|/usr/sbin/dmidecode' );
  if ! _cm2AssignExeVarsFn  "${_assignList[@]}"; then
    _cm2ErrStrFn 'Could not assign variable';
    exit 1;
  fi

  _assignGlobalUiVarsFn;

  _mainFn "$@";
fi
## . END Run main if the script is not sourced }
