#!/bin/bash
#
# Enables OEM installation mode in Calamares.

_oemActiveFile='/etc/calamares/OEM_MODE_ACTIVATED';

if [ -f "${_oemActiveFile}" ]; then
  _oem_mode="$(cat "${_oemActiveFile}")";
  _msg="$(cat <<EOL
<h3 style="text-align: center; color: #f7941d">Kubuntu Focus OEM Installer</h3>

<p><b>The OEM installer was previously launched and the &quot;${_oem_mode}&quot; <br>
mode selected.</b> The installer will now launch in this mode again. To <br>
select a different mode, reboot the system and launch the OEM <br>
installer again.<br>
EOL
  )";
  _continue_label="Continue in \"${_oem_mode}\" mode";
  if ! kdialog --warningcontinuecancel "${_msg}" \
    --continue-label "${_continue_label}"; then
    exit 0;
  fi

  if [ "${_oem_mode}" = 'Partition, then install' ]; then
    su -p kubuntu -c partitionmanager;
  fi

  export BROWSER='sudo -H -u kubuntu firefox';
  calamares -D8;
  exit;
elif [ -e "${_oemActiveFile}" ]; then
  # Something other than a file exists here, bail out
  _msg="$(cat <<EOL
${_oemActiveFile} exists, but is not a file! Bailing out.
EOL
  )";
  kdialog --sorry "${_msg}";
  exit 1
fi

_msg="$(cat <<EOL
<h3 style="text-align: center; color: #f7941d">Kubuntu Focus OEM Installer</h3>

<p><b>You are about to install the OS in OEM mode.</b> This will prepare the <br>
system for distribution to an end user, providing them with an account <br>
setup wizard. This is useful if you are reinstalling the OS on a Kubuntu <br>
Focus system, preparing a system for someone else, or installing onto <br>
a system with multiple disks.</p>

<p>After installation, the included Multi-Disk Configuration Tool (MDCT) <br>
will help you set up any secondary disks or partitions.</p>

<p>Three different install methods are provided:</p>

<ul>
<li><b>Standard</b>: This is the normal installation mode. Use if you want <br>
the entire system disk to be dedicated to the root and boot <br>
partitions.</li>

<li><b>500 GB install</b>: Same as Standard, but limits the size of the root <br>
partition to 500 GB and allocates any remaining space on the <br>
system disk to a secondary partition. The MDCT will help you <br>
format and use this partition. <b style="color: #da4453">IMPORTANT: This will select <br>
the "Erase disk" option by default.</b></li>

<li><b>Partition, then install</b>: Launches KDE Partition Manager before <br>
launching the installer in Standard mode. This gives you the <br>
opportunity to delete the main and boot partitions of an old <br>
installation while preserving a home or data partition on the same <br>
disk. Use this mode if you are reinstalling Kubuntu and want to <br>
preserve a home or data partition on the system disk.</li>
</ul>

<p>You can enable encryption or disable the creation of a swap file if <br>
desired. Right-click and copy the following link into a browser to <br>
learn more: <br>
<a
href="https://kfocus.org/wf/reinstall.html#bkm_multi_disk_configuration">https://kfocus.org/wf/reinstall.html#bkm_multi_disk_configuration</a></p>

<p>Select the desired install method, then click "OK" to continue.</p>
EOL
)";
_optionList=(
  'Standard' '500 GB install' 'Partition, then install' 'Cancel'
);

_ans="$(kdialog --combobox "${_msg}" "${_optionList[@]}")";
case "${_ans}" in
  'Standard')
    true;
    ;;
  '500 GB install')
    # Restrict root partition size to 500 GB
    sed -i 's/size: 100%/size: 500G/' /etc/calamares/modules/partition.conf
    # Allocate the rest of the main disk to a secondary partition
    sed -i "/size: 500G$/a \ \ \ \ - name: 'kfocus_data'\n      filesystem: unformatted\n      noEncrypt: true\n      size: 100%" /etc/calamares/modules/partition.conf
    # Select "Erase disk" by default and disallow manual partitioning
    sed -i "/initialSwapChoice: file/a initialPartitioningChoice: erase\nallowManualPartitioning: false" /etc/calamares/modules/partition.conf
    ;;
  'Partition, then install')
    su -p kubuntu -c partitionmanager;
    ;;
  *)
    kdialog --msgbox "The OEM installation process has been cancelled.";
    exit 0;
    ;;
esac

# Tweak branding to make it clear that OEM installation mode is active
cp /etc/calamares/branding/kubuntu/welcome-oem.png /etc/calamares/branding/kubuntu/welcome.png;

# Don't remove Calamares from the installed system.
sed -i '/- calamares$/d' /etc/calamares/modules/packages.conf;

# Swap around the position of the kfocus-prep-user module
sed -i "/- shellprocess@kfocus-prep-user/d" /etc/calamares/settings.conf;
sed -i "/- packages$/a \ \ - shellprocess@kfocus-prep-user" /etc/calamares/settings.conf;

# Enable oemid module, backslashes are needed for proper indentation
sed -i "/- welcome$/a \ \ - oemid" /etc/calamares/settings.conf;

# Enable OEM prep module
sed -i "/- packages$/a \ \ - shellprocess@oemprep" /etc/calamares/settings.conf;

# Fix OEM UID
sed -i "/- shellprocess@oemprep$/a \ \ - shellprocess@fix-oem-uid" /etc/calamares/settings.conf;

# Force the use of an OEM configuration user
cp /etc/calamares/modules/users.conf.oem /etc/calamares/modules/users.conf;

# Drop a file so that it can be seen that OEM installation mode is already
# active, save the selected mode from earlier
echo "${_ans}" > "${_oemActiveFile}";

# Launch Calamares
export BROWSER='sudo -H -u kubuntu firefox'
calamares -D8;
