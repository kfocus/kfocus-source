# This does not desktop-file-validate because of $VARS
# similar to org.kde.ksystemlog.desktop and # software-properties-qt.desktop.
# The important thing is this works.
[Desktop Entry]
Categories=System;X-Kubuntu-Focus;
Comment=Configure a secondary disk
Exec=/usr/lib/kfocus/bin/kfocus-chain-helper-launch
Icon=kfocus-bug-tools
Keywords=multi-disk;multi disk;secondary disk
Name=Multi-Disk Configuration Tool
StartupNotify=true
Terminal=false
Type=Application
StartupWMClass=KFocus

