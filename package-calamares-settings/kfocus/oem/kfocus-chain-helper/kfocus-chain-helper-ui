## BEGIN _getDevSizeFn {
# Summary   : _getDevSizeFn <dev_tgt>
# Purpose   : Gets the size of a device in bytes. Does not require root.
# Example   : _getDevSizeFn /dev/nvme0n1p4
# Arguments : dev_tgt - The device to get the size of.
# Globals   : none
# Outputs   : Device size in bytes
# Returns   : 0 on success, 1 on error or if an invalid argument is passed
#
_getDevSizeFn () {
  declare _dev_tgt _dev_size_int;

  # Process arguments
  _dev_tgt="${1:-}"
  [ -z "${_dev_tgt}" ] && return 1;
  [ -b "${_dev_tgt}" ] || return 1;

  # Get device size
  _dev_size_int="$(lsblk -b --raw --paths --output=NAME,SIZE \
    | grep "^${_dev_tgt} " \
    | cut -d' ' -f2)";
  [ -z "${_dev_size_int}" ] && return 1;

  echo "${_dev_size_int}";
}
## . END _getDevSizeFn }

## BEGIN _checkDevAndEchoMbFn {
# Summary   : _checkDevAndEchoMbFn <dev_file> <is_partition>
# Purpose   : Check if a device is suitable for use as a secondary disk or
#   partition, and print its size
# Example   : _checkDevAndEchoMbFn '/dev/nvme1n1' 'n'
# Arguments :
#   dev_file - The device to check.
#   is_partition - Whether the device is a partition or not.
# Globals   : none
# Outputs   : If the device is suitable, outputs the size of the device
#   int megabytes.
# Returns   : 0 if the device is suitable, 1 otherwise or if the provided
#   arguments are invalid
#
_checkDevAndEchoMbFn () {
  declare _byte_int _mib_int _trans_key _dev_file _disk_basename \
    _disk_part_list _disk_part _disk_part_path _is_partition _holders_dir;

  # Process arguments
  _dev_file="${1:-}";
  _is_partition="${2:-}";
  [ -z "${_dev_file}" ] && return 1;
  [ -z "${_is_partition}" ] && return 1;
  [ "${_is_partition}" != 'y' ] && [ "${_is_partition}" != 'n' ] && return 1;

  # Get disk/partition info
  _byte_int="$(_getDevSizeFn "${_dev_file}")";
  _mib_int=$(( _byte_int / 1048576 ));
  _trans_key="$(lsblk -ndo tran "${_dev_file}")";

  # Ensure the device is part of an internal drive
  # TODO: Add the _trans_key used by Xen virtual disk devices
  if ! [[ "${_trans_key}" =~ ^(sata|nvme|virtio)$ ]]; then
    return 1;
  fi

  # Ensure the device is at least 64 GB in size
  (( "${_mib_int}" < 65536 )) && return 1;

  # For partitions, ensure the partition is not mounted or open as a
  #   device-mapper device
  # For whole disks, ensure neither the disk nor any partition on the disk is
  #   mounted or open as a device-mapper device
  if findmnt "${_dev_file}" >/dev/null 2>&1; then
    return 1;
  fi
  if [ "${_is_partition}" = 'y' ]; then
    _disk_part="$(basename "${_dev_file}")";
    if [[ "${_disk_part}" =~ ^(sd[a-z]+|vd[a-z]+|xvd[a-z]+)[0-9]+$ ]]; then
      _disk_basename="${BASH_REMATCH[1]}";
    elif [[ "${_disk_part}" =~ ^nvme[0-9]+n[0-9]+p[0-9]+$ ]]; then
      _disk_basename="${_disk_part%p*}";
    else
      return 1;
    fi
    _holders_dir="/sys/block/${_disk_basename}/${_disk_part}/holders";
    [ -d "${_holders_dir}" ] || return 1;
    [ -n "$(_cm2LsFn "${_holders_dir}")" ] && return 1;
  else
    _disk_basename="$(basename "${_dev_file}")"
    _holders_dir="/sys/block/${_disk_basename}/holders";
    [ -d "${_holders_dir}" ] || return 1;
    [ -n "$(_cm2LsFn "${_holders_dir}")" ] && return 1;
    readarray -t _disk_part_list < <(find "${_dev_file}"* \
      | grep -v "^${_dev_file}$");
    for _disk_part_path in "${_disk_part_list[@]}"; do
      if findmnt "${_disk_part_path}" >/dev/null 2>&1; then
        return 1;
      fi
      _disk_part="$(basename "${_disk_part_path}")";
      _holders_dir="/sys/block/${_disk_basename}/${_disk_part}/holders";
      [ -d "${_holders_dir}" ] || return 1;
      [ -n "$(_cm2LsFn "${_holders_dir}")" ] && return 1;
    done
  fi

  # Output the size of the device in megabytes if it passes all checks
  echo "${_mib_int}";
  return 0;
}
## . END _checkDevAndEchoMbFn }

## BEGIN _populatePartInfoListFn {
# Summary   : _populatePartInfoListFn
# Purpose   : Finds all locations a secondary partition can be placed, and
#   places info about these locations in _partInfoList.
# Example   : _populatePartInfoListFn
# Arguments : none
# Globals   : _partInfoList
# Outputs   : none
# Returns   : none
#
_populatePartInfoListFn () {
  declare _root_part_str _extra_part_info _mount_str _block_list _dev_file \
    _mib_int;

  # Prepare variables
  _root_part_str="${1:-}"
  [ -z "${_root_part_str}" ] && return 1;
  _mount_str="$(cat /proc/mounts)";
  IFS=$'\n' read -r -d '' -a _block_list <<< "$(
    find /dev/ -maxdepth 1 -type b \
      | grep -E '^/dev/(sd[a-z]+|nvme[0-9]+n[0-9]+|vd[a-z]+|xvd[a-z]+)$' \
      | sort
  )";

  # Search for an extra partition on the system disk
  if _extra_part_info="$(_findSystemDiskExtraPartFn \
    "${_root_part_str}")"; then
    _partInfoList+=( "${_extra_part_info}|y" );
  fi

  # Find suitable disks and retrieve their sizes
  for _dev_file in "${_block_list[@]}"; do
    _mib_int="$(_checkDevAndEchoMbFn "${_dev_file}" 'n')" || continue;
    if [[ "${_dev_file}" =~ ^(sd[a-z]+|vd[a-z]+|xvd[a-z]+)$ ]]; then
      _dev_file="${_dev_file}1";
    else
      _dev_file="${_dev_file}p1";
    fi
    _partInfoList+=( "${_dev_file}|${_mib_int}|n" );
  done
}
## . END _populatePartInfoListFn }

## BEGIN _getDataPartPathFn {
# Summary   : _getDataPartPathFn
# Purpose   : Echoes the path where the next /srv/data* partition should
#   be mounted.
# Example   : _getDataPartPathFn
# Arguments : none
# Globals   : none
# Outputs   : A directory path such as /srv/data, /srv/data2, etc.
# Returns   : none
#
_getDataPartPathFn () {
  declare _line _mount_path _return_path _found_avail_path _part_idx;

  # Prepare variables
  _return_path='/srv/data'
  _part_idx='1';

  # BEGIN Loop to find unused /srv/data* path
  while true; do
    # Check if _return_path is configured in fstab
    _found_avail_path='y';
    while read -r _line; do
      _mount_path="$(awk '{print $2}' <<< "${_line}")";
      if [ "${_mount_path}" = "${_return_path}" ]; then
        _found_avail_path='n';
        break;
      fi
    done < /etc/fstab;

    # Break if _return_path was not in fstab, try a different _return_path
    #   otherwise
    if [ "${_found_avail_path}" = 'y' ]; then
      break;
    fi
    (( _part_idx++ )) || true;
    _return_path="/srv/data${_part_idx}";
  done
  # END Loop to find unused /srv/data* path

  echo "${_return_path}";
}
## . END _getDataPartPathFn }

## BEGIN _insertPrevMountsInfoFn {
# Summary   : _insertPrevMountsInfoFn <msg>
# Purpose   : Inserts information about set-up-and-mounted partitions in a
#   message string.
# Example   : _insertPrevMountsInfoFn "${_msg}";
# Arguments : msg - The message to insert info into.
# Globals   : _donePartList
# Outputs   : The msg argument, with data about previous mounts inserted in
#   place of XXX_PART_TABLE_XXX and XXX_THIS_MOUNT_XXX placeholders.
# Returns   : none
#
_insertPrevMountsInfoFn () {
  declare _msg _done_table_str;

  # Process arguments
  _msg="${1:-}";
  [ -z "${_msg}" ] && return 1;

  # Embed information about already-set-up disks into the provided message
  _done_table_str="$(_cm2EchoTableFn 'Mounted Partitions' 'Mount|Partition' \
    "${_donePartList[@]}")";
  _msg="${_msg//XXX_PART_TABLE_XXX/"${_done_table_str}"}";
  if (( ${#_donePartList[@]} > 1 )); then
    _msg="${_msg//XXX_THIS_MOUNT_XXX/'these mounts'}";
  else
    _msg="${_msg//XXX_THIS_MOUNT_XXX/'this mount'}";
  fi

  echo "${_msg}";
}
## . END _insertPrevMountsInfoFn }

