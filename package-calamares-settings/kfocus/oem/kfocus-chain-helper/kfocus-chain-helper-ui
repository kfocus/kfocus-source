# Outputs   : If the user selects a partition, outputs an item from
#   _partInfoList corresponding to the selected partition. Otherwise, outputs
#   nothing.
# Returns   : none
#
_selectDiskFn () {
  declare _option_list _onoff_state _idx _bit_list _msg _ans_str;

  # Check if there are any candidate partitions to set up
  if [ "${#_partInfoList[@]}" = '0' ]; then
    if [ "${_quietExitStr}" = 'quietExit' ]; then
      return;
    fi
    if [ "${#_donePartList[@]}" = '0' ]; then
      _msg="${_noMoreDisksMsg}";
    else
      _msg="$(_insertPrevMountsInfoFn "${_noMoreDisksWithPrevMountsMsg}")";
    fi
    _cm2PromptUserFn "${_msg}" "${_winTitle}";
    return;
  fi

  # Generate list of disks for UI combo box
  _option_list=();
  for _idx in "${!_partInfoList[@]}"; do
    if [ "${_idx}" = '0' ]; then
      _onoff_state='on';
    else
      _onoff_state='off';
    fi
    IFS='|' read -r -a _bit_list <<< "${_partInfoList[_idx]}";
    _option_list+=(
      "${_idx}"
      "Disk: ${_bit_list[0]} - Size: ${_bit_list[1]} MiB"
      "${_onoff_state}"
    );
  done

  # Prompt the user to choose a disk to prepare
  if [ "${#_donePartList[@]}" = '0' ]; then
    _msg="${_chooseDiskMsg}";
  else
    _msg="$(_insertPrevMountsInfoFn "${_chooseDiskWithPrevMountsMsg}")";
  fi
  _ans_str="$(_cm2PromptUserFn "${_msg}" "${_winTitle}" 'd' \
    "${_option_list[@]}")";

  # Echo the selected disk, if any
  if [ -n "${_ans_str}" ]; then
    echo "${_partInfoList[_ans_str]}";
  fi
}
## . END _selectDiskFn }

## BEGIN _getPartSizeStr {
# Summary   : _getPartSizeStr
# Purpose   : Echos a string that says how much space is used on the partition
#   mounted at /part_scan.
# Example   : _getPartSizeStr;
# Arguments : none
# Globals   : none
# Outputs   : A string for display to the end user.
# Returns   : none
#
_getPartSizeStr () {
  declare _df_str _disk_size_kib _disk_used_kib _disk_size_gib _disk_used_gib;

  _df_str="$(LC_ALL='C' df '/part_scan' | tail -n1)";
  _disk_size_kib="$(awk '{ print $2 }' <<< "${_df_str}")";
  _disk_used_kib="$(awk '{ print $3 }' <<< "${_df_str}")";
  _disk_size_gib="$(bc <<< "scale=2; ${_disk_size_kib}/1024/1024")";
  _disk_used_gib="$(bc <<< "scale=2; ${_disk_used_kib}/1024/1024")";

  echo "The entire disk has ${_disk_used_gib} of ${_disk_size_gib} GiB used.";
}
## . END _getPartSizeStr }

## BEGIN _getPartContentStrFn {
# Summary   : _getPartContentsStrFn
# Purpose   : Mounts a partition at /part_scan, echos a brief summary of its
#   contents, and unmounts it.
# Example   : _getPartContentStrFn;
# Arguments : none
# Globals   : _cryptsetupExe, _mountExe, _umountExe
# Outputs   : The summary of the partition's contents.
# Returns   : 0 on success, 1 on failure, 2 if the partition appears to be
#   blank (i.e. the partition cannot be mounted).
#
# Shellcheck doesn't understand that I need full regex capability in the sed
# commands here, which ${variable//search/replace} does not provide.
#
# shellcheck disable=SC2001
_getPartContentStrFn () {
  declare _part_tgt _crypt_passphrase_str _dev_str _crypt_name \
    _item_list_str _item_list_count _threshold_val _part_size_str \
    _max_main_count _output_str _disk_crypt_id _msg _dev_fs_str \
    _fs_warn_str;

  # Avoid cluttering up the user interface when fstab has changed before this
  #   function runs
  systemctl daemon-reload;

  # Process arguments
  _part_tgt="${1:-}";
  [ -z "${_part_tgt}" ] && return 1;
  _crypt_passphrase_str="${2:-}";

  # Output format:
  # item1 <br>
  # item2 <br>
  # itemN <br> # up to 10 items can be shown
  # ... (list truncated)
  # X directories, Y files
  # Z.A Gib of B.C GiB used.

  # Prepare to list partition contents
  _output_str='';
  mkdir -p '/part_scan'

  # Decrypt disk if needed
  if [ -n "${_crypt_passphrase_str}" ]; then
    # Try to use the volume UUID if possible, fall back to the device name
    #   if needed
    _disk_crypt_id="$(blkid -s UUID -o value "${_part_tgt}")";
    [ -z "${_disk_crypt_id}" ] && _disk_crypt_id="$(basename "${_part_tgt}")";
    _crypt_name="luks-${_disk_crypt_id}";
    echo "${_crypt_passphrase_str}" | "${_cryptsetupExe}" luksOpen \
      "${_part_tgt}" "${_crypt_name}" || {
      rmdir '/part_scan';
      return 1;
    }
    _dev_str="/dev/mapper/${_crypt_name}";
  else
    _dev_str="${_part_tgt}";
  fi

  # Bail if volume contains no filesystem
  _dev_fs_str="$(lsblk -no fstype "${_dev_str}")"
  if [ -z "${_dev_fs_str}" ]; then
    if [ -n "${_crypt_passphrase_str}" ]; then
      # Give the kernel some breathing room before closing the volume
      sleep 1;
      "${_cryptsetupExe}" luksClose "/dev/mapper/${_crypt_name}";
    fi
    rmdir '/part_scan';
    return 2;
  fi

  # Create a warning if the filesystem is anything other than ext4
  if [ "${_dev_fs_str}" != 'ext4' ]; then
    _fs_warn_str="${_fsWarnStr//XXX_FS_STR_XXX/${_dev_fs_str}}";
  else
    _fs_warn_str='';
  fi

  # Get files, directories, and size info from volume, bail if the volume
  #   cannot be mounted
  "${_mountExe}" "${_dev_str}" '/part_scan' || {
    if [ -n "${_crypt_passphrase_str}" ]; then
      # Give the kernel some breathing room before closing the volume
      sleep 1;
      "${_cryptsetupExe}" luksClose "/dev/mapper/${_crypt_name}";
    fi
    rmdir '/part_scan';
    return 2;
  }
  cd '/part_scan' || return 1;
  _item_list_str="$(LC_ALL='C' tree -L 1)";
  # If there are only three lines in the list string, no non-hidden files or
  # directories exist.
  if [ "$(wc -l <<< "${_item_list_str}")" = '3' ]; then
    _item_list_str="$(LC_ALL='C' tree -a -L 1)";
  fi
  _part_size_str="$(_getPartSizeStr)";

  # Pre-process file and directory list
  _threshold_val=13; # ten items plus header and footer of tree
  _max_main_count=11; # ten items plus header of tree
  _item_list_count="$(wc -l <<< "${_item_list_str}")";
  if (( _item_list_count < _threshold_val )); then
    (( _max_main_count -= (_threshold_val - _item_list_count) )) || true;
  fi
  _item_list_str="$(sed 's/$/ <br>/' <<< "${_item_list_str}")";

  # Unmount volume and clean up
  cd '/' || return 1;
  "${_umountExe}" '/part_scan' || return 1;
  rmdir '/part_scan' || return 1;
  [ -n "${_crypt_passphrase_str}" ] && {
    # Give the kernel some breathing room before closing the volume
    sleep 1;
    "${_cryptsetupExe}" 'luksClose' "/dev/mapper/${_crypt_name}";
  }

  # Format the output string
  _output_str="$(head "-n${_max_main_count}" <<< "${_item_list_str}" \
    | tail "-n+2")";
  # Trim the last `<br>` from the string, note this does not remove `<br>`s
  # from the middle of the string
  _output_str="$(sed '$ s/ <br>//' <<< "${_output_str}")";
  if (( _item_list_count > _threshold_val )); then
    _output_str+="$(echo -e ' <br>\n... (list truncated)')";
  fi
  if [ -z "${_output_str}" ]; then
    _output_str='No files or directories.';
  fi

  _msg="${_chooseReusePartMsg//XXX_SELECTED_PART_XXX/"${_part_tgt}"}";
  _msg="${_msg//XXX_FS_WARN_XXX/${_fs_warn_str}}";
  _msg="${_msg//XXX_PART_USAGE_XXX/"${_part_size_str}"}";
  _msg="${_msg//XXX_CONTENT_LIST_XXX/"${_output_str}"}";
  echo "${_msg}";
}
## . END _getPartContentStrFn }

## BEGIN _getDiskFromPartitionFn {
# Summary   : _getDiskFromPartitionFn <part_str>
# Purpose   : Strips off the partition ID from a device path.
# Example   : _getDiskFromPartitionFn '/dev/nvme0n1p1';
# Arguments : part_str - A device path pointing to a partition.
# Globals   : none
# Outputs   : A device path pointing to a whole disk.
# Returns   : 0 on success, 1 on failure
#
_getDiskFromPartitionFn () {
  declare _part_str _calc_str;

  # Process arguments
  _part_str="${1:-}";
  [ -z "${_part_str}" ] && return 1;

  # Remove the partition ID from the argument
  if [[ "${_part_str}" =~ ^/dev/(sd[a-z]+|vd[a-z]+|xvd[a-z]+)[0-9]+ ]]; then
    _calc_str="/dev/${BASH_REMATCH[1]}";
  elif [[ "${_part_str}" =~ ^/dev/nvme[0-9]+n[0-9]+p[0-9]+$ ]]; then
    _calc_str="${_part_str%p*}";
  else
    return 1;
  fi

  echo "${_calc_str}";
}
## . END _getDiskFromPartitionFn }

## BEGIN _findSystemDiskExtraPartFn {
# Summary   : _findSystemDiskExtraPartFn <root_part_str>
# Purpose   : Checks if the disk containing the root partition has an extra
#   partition that can be set up as a secondary volume.
# Example   : _findSystemDiskExtraPartFn '/dev/nvme0n1p3'
# Arguments : root_part_str - The device path the root filesystem is mounted
#   from. This may be a partition device, or a device-mapper device mapped
#   from a partition device.
# Globals   : none
# Outputs   : If an extra partition is found, outputs a pipe-separated string
#   formatted as 'partition_path|partition_mib'.
# Returns   : 0 on success, 1 if an argument is invalid or an extra partition
#   cannot be found
#
_findSystemDiskExtraPartFn () {
  declare _root_part_str _dm_id_str _slave_dev_str _main_dev_str \
    _main_dev_part_list _main_dev_part _free_part _mib_int;

  # Process arguments
  _root_part_str="${1:-}";
  [ -z "${_root_part_str}" ] && return 1;

  # If the root device is a device-mapper device, find the underlying
  #   hardware device
  if [[ "${_root_part_str}" =~ ^/dev/mapper/ ]]; then
    _root_part_str="$(readlink -f "${_root_part_str}")";
  fi
  if [[ "${_root_part_str}" =~ ^/dev/dm- ]]; then
    _dm_id_str="$(basename "${_root_part_str}")";
    _slave_dev_str="$(_cm2LsFn "/sys/block/${_dm_id_str}/slaves")";
    # Root devices with more than one underlying device are not supported
    if [ "$(wc -l <<< "${_slave_dev_str}")" != '1' ]; then
      return 1;
    fi
    _root_part_str="/dev/${_slave_dev_str}";
  fi

  # Get the disk device underlying the root partition device
  _main_dev_str="$(_getDiskFromPartitionFn "${_root_part_str}")";
  [ -b "${_main_dev_str}" ] || return 1;

  # Bail if the main disk device has more than four partitions (we only
  #   support three partitions for the OS + one data partition)
  readarray -t _main_dev_part_list < <(find "${_main_dev_str}"* \
    | grep -v "^${_main_dev_str}$");
  if [ "${#_main_dev_part_list[@]}" != '4' ]; then
    return 1;
  fi

  # Check if one and only one partition on the main disk is unused and
  #   suitable as a data partition
  _free_part='';
  for _main_dev_part in "${_main_dev_part_list[@]}"; do
    if _mib_int="$(_checkDevAndEchoMbFn "${_main_dev_part}" 'y')"; then
      if [ -z "${_free_part}" ]; then
        _free_part="${_main_dev_part}";
      else
        # Multiple free partitions aren't expected, bail
        return 1;
      fi
    fi
  done

  # If there are no suitable partitions, bail
  if [ -z "${_free_part}" ]; then
    return 1;
  fi

  # Output partition path and size
  echo "${_free_part}|${_mib_int}";
}
## . END _findSystemDiskExtraPartFn }

## BEGIN _isHomeSetUpFn {
# Summary   : _isHomeSetUpFn
# Purpose   : Check if an extra partition has already been configured to mount
#   on /home.
# Example   : _isHomeSetUpFn;
# Arguments : none
# Globals   : none
# Outputs   : none
# Returns   : 0 if /home is set up, 1 otherwise
#
_isHomeSetUpFn () {
  if grep '^# KFOCUS Replaced /home btrfs with extra disk$' \
    /etc/fstab; then
    return 0;
  fi
  return 1;
}
## . END _isHomeSetUpFn }

## BEGIN _selectAndSetupDiskFn {
# Summary   : _selectAndSetupDiskFn
# Purpose   : Walks the user through the process of setting up a secondary
#   disk or partition. Exits the application if an error occurs or if there
#   is no secondary disk or partition to set up.
# Example   : _selectAndSetupDiskFn;
# Arguments : none
# Globals   : UI message variables, _partInfoList, _donePartList
# Outputs   : none
# Returns   : None, but may exit the script
#
_selectAndSetupDiskFn () {
  declare _dev_info_str _target_mount_point _part_count _full_prepare_yn \
    _selected_part _part_incompat_yn _encrypted_yn _crypt_passphrase_str \
    _confirm_str _prompt_msg _exit_code _bit_list _setup_opt_list \
    _part_info_idx _is_dev_secondary_part _dev_disk_name_str \
    _next_data_part_path _reuse_part_msg;

  # Prep variables
  _encrypted_yn='n';
  _crypt_passphrase_str='';
  _dev_info_str='';
  _dev_disk_name_str='';
  _selected_part='';

  # Look for candidate extra disks
  _dev_info_str="$(_selectDiskFn)";
  [ -z "${_dev_info_str}" ] && exit;
  IFS='|' read -r -a _bit_list <<< "${_dev_info_str}";
  _selected_part="${_bit_list[0]}";
  # We don't need the device size here.
  _is_dev_secondary_part="${_bit_list[2]}";
  if [ "${_is_dev_secondary_part}" = 'y' ]; then
    # Signal to later code that we're setting up a secondary partition on the
    #   main disk.
    _part_count=1;
  else
    # Get count of partitions on selected disk
    _dev_disk_name_str="$(_getDiskFromPartitionFn "${_selected_part}")";
    _part_count="$(lsblk "${_dev_disk_name_str}" -o TYPE |grep -c 'part')";
    _part_count="$(_cm2EchoIntFn "${_part_count}")";
    # TODO: Do we even need this check?
    # if ! [[ "${_selected_part}" =~ ^/dev/(sd[a-z]+|vd[a-z]+|xvd[a-z]+)$ ]] \
    #   && ! [[ "${_selected_part}" =~ ^/dev/nvme[0-9]+n[0-9]$ ]]; then
    #   _cm2ErrStrFn "_selectDiskFn echoed invalid device info |${_dev_info_str}|!";
    #   exit 1;
    # fi
  fi

  if (( _part_count == 0 )); then
    # This is a partitionless disk, prompt to reformat
    _confirmFormatSafeMsg="${_confirmFormatSafeMsg/XXX_SELECTED_PART_XXX/${_selected_part}}";
    _full_prepare_yn="$(_cm2PromptUserFn "${_confirmFormatSafeMsg}" \
      "${_winTitle}" 'o')";
    [ "${_full_prepare_yn}" = 'n' ] && exit;
  elif (( _part_count > 1 )); then
    # This is not an old extra disk and can't be reused, prompt to wipe
    _confirmFormatDangerMsg="${_confirmFormatDangerMsg/XXX_SELECTED_PART_XXX/${_selected_part}}";
    _full_prepare_yn="$(_cm2PromptUserFn "${_confirmFormatDangerMsg}" \
      "${_winTitle}" 'o')";
    [ "${_full_prepare_yn}" = 'n' ] && exit;
  else
    # This is likely an old extra disk or a spare partition on the main
    #   disk, prompt to reuse or reformat
    _part_incompat_yn='n';

    # Check if partition is encrypted
    _encrypted_yn="$(
      grep -q 'crypto_LUKS' < <(
        lsblk -ndo fstype "${_selected_part}"
      ) && echo 'y' || echo 'n'
    )"

    # Cannot use encrypted partition with unencrypted root disk
    if [ "${_encrypted_yn}" = 'y' ]; then
      if [ "${_isMainLuks}" = 'n' ]; then
        _part_incompat_yn='y';
      fi
    fi

    # If partitions are incompatible, prompt to reformat
    if [ "${_part_incompat_yn}" = 'y' ]; then
      _confirmFormatHighDangerMsg="${_confirmFormatHighDangerMsg//XXX_SELECTED_PART_XXX/${_selected_part}}";
      _confirmFormatHighDangerMsg="${_confirmFormatHighDangerMsg//XXX_INCOMPAT_REASON_XXX/Cannot use an encrypted disk with unencrypted root.}";
      _full_prepare_yn="$(_cm2PromptUserFn "${_confirmFormatHighDangerMsg}" \
        "${_winTitle}" 'o')";
      [ "${_full_prepare_yn}" = 'n' ] && exit;
    else
      # If partition is encrypted, prompt for passphrase
      if [ "${_encrypted_yn}" = 'y' ]; then
        while true; do
          _queryPassphraseMsg="${_queryPassphraseMsg//XXX_SELECTED_PART_XXX/${_selected_part}}";
          _crypt_passphrase_str="$(kdialog --title "${_winTitle}" \
            --password "${_queryPassphraseMsg}")";
          if ! "${_cryptsetupExe}" luksOpen --test-passphrase "${_selected_part}" \
            <<< "${_crypt_passphrase_str}" 1>&2 2>/dev/null; then
            if [ "$(_cm2PromptUserFn "${_badPassphraseMsg}" "${_winTitle}" \
              'a')" = 'n' ];
              then _crypt_passphrase_str=''; break;
            fi
          else
            break;
          fi
        done
      fi

      # If partition is encrypted and the passphrase is not provided, prompt
      #   to reformat
      if [ "${_encrypted_yn}" = 'y' ] \
        && [ -z "${_crypt_passphrase_str}" ]; then
        _confirmFormatHighDangerMsg="${_confirmFormatHighDangerMsg//XXX_SELECTED_PART_XXX/${_selected_part}}";
        _confirmFormatHighDangerMsg="${_confirmFormatHighDangerMsg//XXX_INCOMPAT_REASON_XXX/Disk passphrase not provided.}";
        _full_prepare_yn="$(_cm2PromptUserFn "${_confirmFormatHighDangerMsg}" \
          "${_winTitle}" 'o')";
        [ "${_full_prepare_yn}" = 'n' ] && exit;
      else
        # If partition has a filesystem, show contents and prompt to reuse
        #   or reformat
        _reuse_part_msg="$(_getPartContentStrFn "${_selected_part}" \
          "${_crypt_passphrase_str}")";
        _exit_code="$?";
        # BEGIN check _getPartContentStrFn exit code
        if (( _exit_code == 0 )); then
          _full_prepare_yn="$(_cm2PromptUserFn "${_reuse_part_msg}" \
            "${_winTitle}" 'd' \
            'n' 'Reuse the existing partition' 'on' \
            'y' 'Wipe and reformat the partition' 'off')";
          [ -z "${_full_prepare_yn}" ] && exit;

        # If partition has no FS, prompt to reformat
        elif (( _exit_code == 2 )); then
          _confirmFormatBlankPartMsg="${_confirmFormatBlankPartMsg//XXX_SELECTED_PART_XXX/${_selected_part}}";
          _full_prepare_yn="$(_cm2PromptUserFn \
            "${_confirmFormatBlankPartMsg}" "${_winTitle}" 'o')";
          [ "${_full_prepare_yn}" = 'n' ] && exit;
        else
          _cm2PromptUserFn "${_contentListFailureMsg}" "${_winTitle}" 's';
          exit 1;
        fi
      fi
    fi
  fi

  # Prompt for extra partition type
  _setup_opt_list=();
  _next_data_part_path="$(_getDataPartPathFn)";
  if ! _isHomeSetUpFn; then
    _setup_opt_list+=( '/home' 'Set up as a HOME partition (/home)' 'on' );
    _setup_opt_list+=( "${_next_data_part_path}" \
      "Set up as a DATA partition (${_next_data_part_path})" 'off' );
  else
    _setup_opt_list+=( "${_next_data_part_path}" \
      "Set up as a DATA partition (${_next_data_part_path})" 'on' );
  fi
  _chooseMountMsg="${_chooseMountMsg/XXX_SELECTED_PART_XXX/${_selected_part}}";
  _target_mount_point="$(_cm2PromptUserFn "${_chooseMountMsg}" \
    "${_winTitle}" 'd' "${_setup_opt_list[@]}")";
  [ -z "${_target_mount_point}" ] && exit;

  # Show overview of partition setup changes
  _confirmOverviewMsg="${_confirmOverviewMsg//XXX_EXTRA_PART_XXX/${_selected_part}}";
  _confirmOverviewMsg="${_confirmOverviewMsg//XXX_MOUNT_POINT_XXX/${_target_mount_point}}";
  if [ "${_full_prepare_yn}" = 'y' ]; then
    [ "${_isMainLuks}" = 'y' ] \
      && _confirmOverviewMsg="${_confirmOverviewMsg//XXX_ENCRYPTED_XXX/Yes}" \
      || _confirmOverviewMsg="${_confirmOverviewMsg//XXX_ENCRYPTED_XXX/No}";
    _confirmOverviewMsg="${_confirmOverviewMsg//XXX_REFORMAT_XXX/Yes}";
  else
    [ -n "${_crypt_passphrase_str}" ] \
      && _confirmOverviewMsg="${_confirmOverviewMsg//XXX_ENCRYPTED_XXX/Yes}" \
      || _confirmOverviewMsg="${_confirmOverviewMsg//XXX_ENCRYPTED_XXX/No}";
    _confirmOverviewMsg="${_confirmOverviewMsg//XXX_REFORMAT_XXX/No}";
  fi
  _confirm_str="$(_cm2PromptUserFn "${_confirmOverviewMsg}" "${_winTitle}" \
    'o')";
  [ "${_confirm_str}" = 'n' ] && exit;

  # Show final confirmation prompt
  if [ "${_full_prepare_yn}" = 'y' ]; then
    _prompt_msg="${_finalReformatMsg//XXX_SELECTED_PART_XXX/${_selected_part}}";
  else
    _prompt_msg="${_finalConfirmMsg//XXX_SELECTED_PART_XXX/${_selected_part}}";
  fi
  _prompt_msg="${_prompt_msg//XXX_MOUNT_POINT_XXX/${_target_mount_point}}";
  _confirm_str="$(
    _cm2PromptUserFn "${_prompt_msg}" "${_winTitle}" 'o'
  )";
  [ "${_confirm_str}" = 'n' ] && exit;

  # Populate success message placeholders
  _configSuccessMsg="${_configSuccessMsg//XXX_SELECTED_PART_XXX/${_selected_part}}";
  _configSuccessMsg="${_configSuccessMsg//XXX_MOUNT_POINT_XXX/${_target_mount_point}}";

  # Prompt for authorization and call disk preparation script
  if [ "${_full_prepare_yn}" = 'y' ]; then
    if [ -n "${_dev_disk_name_str}" ]; then
      _cm2RunLongCmdFn 'Preparing disk' "${_fullPrepareDiskExe}" \
        "${_target_mount_point}" "${_isMainLuks}" 'format_disk' "${_selected_part}";
    else
      _cm2RunLongCmdFn 'Preparing disk' "${_fullPrepareDiskExe}" \
        "${_target_mount_point}" "${_isMainLuks}" 'format_part' "${_selected_part}";
    fi
    _exit_code="$?";
    case "${_exit_code}" in
      '0')
        _cm2PromptUserFn "${_configSuccessMsg}" "${_winTitle}";
        ;;
      '1')
        _cm2PromptUserFn "${_configSoftFailureMsg}" "${_winTitle}";
        ;;
      '2')
        _cm2PromptUserFn "${_configHardFailureMsg}" "${_winTitle}" 'e';
        ;;
    esac
  else
    if [ "${_encrypted_yn}" = 'n' ]; then
      _cm2RunLongCmdFn 'Preparing disk' "${_reuseDiskExe}" \
        "${_target_mount_point}" "${_selected_part}";
      _exit_code="$?";
      case "${_exit_code}" in
        '0')
          _cm2PromptUserFn "${_configSuccessMsg}" "${_winTitle}";
          ;;
        '1')
          _cm2PromptUserFn "${_configSoftFailureMsg}" "${_winTitle}";
          exit 1;
          ;;
        '2')
          _cm2PromptUserFn "${_configLuksOverflowFailureMsg}" "${_winTitle}";
          exit 2;
          ;;
        '3')
          _cm2PromptUserFn "${_configHardFailureMsg}" "${_winTitle}" 'e';
          exit 3;
          ;;
      esac
    else
      _cm2RunLongCmdFn 'Preparing disk' "${_reuseDiskExe}" \
        "${_target_mount_point}" "${_selected_part}" "${_crypt_passphrase_str}";
      _exit_code="$?";
      case "${_exit_code}" in
        '0')
          _cm2PromptUserFn "${_configSuccessMsg}" "${_winTitle}";
          ;;
        '1')
          _cm2PromptUserFn "${_configSoftFailureMsg}" "${_winTitle}";
          exit 1;
          ;;
        '2')
          _cm2PromptUserFn "${_configLuksOverflowFailureMsg}" "${_winTitle}";
          exit 2;
          ;;
        '3')
          _cm2PromptUserFn "${_configHardFailureMsg}" "${_winTitle}" 'e';
          exit 3;
          ;;
      esac
    fi
  fi

  _donePartList+=( "${_target_mount_point}|${_selected_part}" );
  for _part_info_idx in "${!_partInfoList[@]}"; do
    if [[ "${_partInfoList[_part_info_idx]}" =~ ^"${_selected_part}"| ]]; then
      unset "_partInfoList[${_part_info_idx}]";
      break;
    fi
  done
  _partInfoList=( "${_partInfoList[@]}" );
}
## . END _selectAndSetupDiskFn }

## BEGIN _mainFn {
_mainFn () {
  declare _root_part_str;

  # Prep variables
  _quietExitStr="${1:-}";

  # If one extra partition has already been set up, don't launch
  #   automatically (but do allow manual launch)
  if grep -q '# KFOCUS.*is on.*' '/etc/fstab' \
    && [ "${_quietExitStr}" = 'quietExit' ]; then
    exit;
  fi

  # Find root device
  _root_part_str="$(findmnt --noheadings --output=SOURCE --nofsroot \
    --target /)";
  if [[ "${_root_part_str}" =~ ^/dev/mapper/luks- ]]; then
    _isMainLuks='y';
  fi

  # Populate the list of possible secondary disks and partitions on the system
  _populatePartInfoListFn "${_root_part_str}";

  while true; do
    # This function handles exiting the script for us
    _selectAndSetupDiskFn;
  done
}
## . END _mainFn }

