## BEGIN _checkDevAndEchoMbFn {
_checkDevAndEchoMbFn () {
  declare _byte_int _mib_int _trans_key _dev_file _disk_basename \
    _disk_part_list _disk_part _disk_part_path _is_partition _holders_dir;

  # Process arguments
  _dev_file="${1:-}";
  _is_partition="${2:-}";
  [ -z "${_dev_file}" ] && return 1;
  [ -z "${_is_partition}" ] && return 1;
  [ "${_is_partition}" != 'y' ] && [ "${_is_partition}" != 'n' ] && return 1;

  # Get disk/partition info
  _byte_int="$(blockdev --getsize64 "${_dev_file}")";
  _mib_int=$(( _byte_int / 1048576 ));
  _trans_key="$(lsblk -ndo tran "${_dev_file}")";

  # Ensure the device is part of an internal drive
  # TODO: Add the _trans_key used by Xen virtual disk devices
  if ! [[ "${_trans_key}" =~ ^(sata|nvme|virtio)$ ]]; then
    return 1;
  fi

  # Ensure the device is at least 64 GB in size
  (( "${_mib_int}" < 65536 )) && return 1;

  # For partitions, ensure the partition is not mounted or open as a
  #   device-mapper device
  # For whole disks, ensure neither the disk nor any partition on the disk is
  #   mounted or open as a device-mapper device
  if findmnt "${_dev_file}" >/dev/null 2>&1; then
    return 1;
  fi
  if [ "${_is_partition}" = 'y' ]; then
    _disk_part="$(basename "${_dev_file}")";
    if [[ "${_disk_part}" =~ ^(sd[a-z]+|vd[a-z]+|xvd[a-z]+)[0-9]+$ ]]; then
      _disk_basename="${BASH_REMATCH[1]}";
    elif [[ "${_disk_part}" =~ ^nvme[0-9]+n[0-9]+p[0-9]+$ ]]; then
      _disk_basename="${_disk_part%p*}";
    else
      return 1;
    fi
    _holders_dir="/sys/block/${_disk_basename}/${_disk_part}/holders";
    [ -d "${_holders_dir}" ] || return 1;
    [ -n "$(_cm2LsFn "${_holders_dir}")" ] && return 1;
  else
    _disk_basename="$(basename "${_dev_file}")"
    _holders_dir="/sys/block/${_disk_basename}/holders";
    [ -d "${_holders_dir}" ] || return 1;
    [ -n "$(_cm2LsFn "${_holders_dir}")" ] && return 1;
    readarray -t _disk_part_list < <(find "${_dev_file}"* \
      | grep -v "^${_dev_file}$");
    for _disk_part_path in "${_disk_part_list[@]}"; do
      if findmnt "${_disk_part_path}" >/dev/null 2>&1; then
        return 1;
      fi
      _disk_part="$(basename "${_disk_part_path}")";
      _holders_dir="/sys/block/${_disk_basename}/${_disk_part}/holders";
      [ -d "${_holders_dir}" ] || return 1;
      [ -n "$(_cm2LsFn "${_holders_dir}")" ] && return 1;
    done
  fi

  # Output the size of the device in megabytes if it passes all checks
  echo "${_mib_int}";
  return 0;
}
## . END _checkDevAndEchoMbFn }

## BEGIN _selectDiskFn {
_selectDiskFn () {
  declare _found_name_list _found_size_list _mount_str _block_list _dev_file \
    _mib_int _option_list _idx _onoff_state _ans_str;

  # Prepare variables
  _found_name_list=();
  _found_size_list=();
  _mount_str="$(cat /proc/mounts)";
  IFS=$'\n' read -r -d '' -a _block_list <<< "$(
    find /dev/ -maxdepth 1 -type b \
      | grep -E '^/dev/(sd[a-z]+|nvme[0-9]+n[0-9]+|vd[a-z]+|xvd[a-z]+)$' \
      | sort
  )";

  # Find suitable disks and retrieve their sizes
  for _dev_file in "${_block_list[@]}"; do
    _mib_int="$(_checkDevAndEchoMbFn "${_dev_file}" 'n')" || continue;
    _found_name_list+=( "${_dev_file}" );
    _found_size_list+=( "${_mib_int}" );
  done

  # If no disks are found, bail out
  if [ "${#_found_name_list[@]}" = '0' ]; then
    if [ "${_quietExitStr}" != 'quietExit' ]; then
      _cm2PromptUserFn "${_noExtraDisksMsg}" "${_winTitle}";
    fi
    return;
  fi

  # Generate list of disks for UI combo box
  _option_list=();
  for (( _idx=0; _idx < "${#_found_name_list[@]}"; _idx++ )); do
    if [ "${_idx}" = '0' ]; then
      _onoff_state='on';
    else
      _onoff_state='off';
    fi
    _option_list+=(
      "${_idx}"
      "Disk: ${_found_name_list[_idx]} - Size: ${_found_size_list[_idx]} MiB"
      "${_onoff_state}"
    );
  done

  # Prompt the user to choose a disk to prepare
  _ans_str="$(_cm2PromptUserFn "${_chooseDiskMsg}" "${_winTitle}" 'd' \
    "${_option_list[@]}")";

  # Return the selected disk, if any
  if [ -n "${_ans_str}" ]; then
    echo "${_found_name_list[_ans_str]}";
  fi
}
## . END _selectDiskFn }

## BEGIN _getPartSizeStr {
_getPartSizeStr () {
  declare _df_str _disk_size_kib _disk_used_kib _disk_size_gib _disk_used_gib;

  _df_str="$(LC_ALL='C' df '/part_scan' | tail -n1)";
  _disk_size_kib="$(awk '{ print $2 }' <<< "${_df_str}")";
  _disk_used_kib="$(awk '{ print $3 }' <<< "${_df_str}")";
  _disk_size_gib="$(bc <<< "scale=2; ${_disk_size_kib}/1024/1024")";
  _disk_used_gib="$(bc <<< "scale=2; ${_disk_used_kib}/1024/1024")";

  echo "The entire disk has ${_disk_used_gib} of ${_disk_size_gib} GiB used.";
}
## . END _getPartSizeStr }

## BEGIN _getPartContentStrFn {
#
# Shellcheck doesn't understand that I need full regex capability in the sed
# commands here, which ${variable//search/replace} does not provide.
#
# shellcheck disable=SC2001
_getPartContentStrFn () {
  declare _part_tgt _crypt_passphrase_str _mount_str _crypt_name \
    _item_list_str _item_list_count _threshold_val _part_size_str \
    _max_main_count _output_str _disk_crypt_id;

  # Avoid cluttering up the user interface when fstab has changed before this
  #   function runs
  systemctl daemon-reload;

  # Process arguments
  _part_tgt="${1:-}";
  [ -z "${_part_tgt}" ] && return 1;
  _crypt_passphrase_str="${2:-}";

  # Output format:
  # item1 <br>
  # item2 <br>
  # itemN <br> # up to 10 items can be shown
  # ... (list truncated)
  # X directories, Y files
  # Z.A Gib of B.C GiB used.

  # Prepare to list partition contents
  _output_str='';
  mkdir -p '/part_scan'

  # Decrypt disk if needed
  if [ -n "${_crypt_passphrase_str}" ]; then
    # Try to use the volume UUID if possible, fall back to the device name
    #   if needed
    _disk_crypt_id="$(blkid -s UUID -o value "${_part_tgt}")";
    [ -z "${_disk_crypt_id}" ] && _disk_crypt_id="$(basename "${_part_tgt}")";
    _crypt_name="luks-${_disk_crypt_id}";
    echo "${_crypt_passphrase_str}" | "${_cryptsetupExe}" luksOpen \
      "${_part_tgt}" "${_crypt_name}" || {
      rmdir '/part_scan';
      return 1;
    }
    _mount_str="/dev/mapper/${_crypt_name}";
  else
    _mount_str="${_part_tgt}";
  fi

  # Bail if LUKS volume contains no filesystem
  if [ -z "$(lsblk -no fstype "${_mount_str}")" ]; then
    if [ -n "${_crypt_passphrase_str}" ]; then
      # Give the kernel some breathing room before closing the volume
      sleep 1;
      "${_cryptsetupExe}" luksClose "/dev/mapper/${_crypt_name}";
    fi
    rmdir '/part_scan';
    return 2;
  fi

  # Get files, directories, and size info from volume
  "${_mountExe}" "${_mount_str}" '/part_scan' || {
    rmdir '/part_scan';
    return 2;
  }
  cd '/part_scan' || return 1;
  _item_list_str="$(LC_ALL='C' tree -L 1)";
  # If there are only three lines in the list string, no non-hidden files or
  # directories exist.
  if [ "$(wc -l <<< "${_item_list_str}")" = '3' ]; then
    _item_list_str="$(LC_ALL='C' tree -a -L 1)";
  fi
  _part_size_str="$(_getPartSizeStr)";

  # Pre-process file and directory list
  _threshold_val=13; # ten items plus header and footer of tree
  _max_main_count=11; # ten items plus header of tree
  _item_list_count="$(wc -l <<< "${_item_list_str}")";
  if (( _item_list_count < _threshold_val )); then
    (( _max_main_count -= (_threshold_val - _item_list_count) )) || true;
  fi
  _item_list_str="$(sed 's/$/ <br>/' <<< "${_item_list_str}")";

  # Unmount volume and clean up
  cd '/' || return 1;
  "${_umountExe}" '/part_scan';
  rmdir '/part_scan';
  [ -n "${_crypt_passphrase_str}" ] && {
    # Give the kernel some breathing room before closing the volume
    sleep 1;
    "${_cryptsetupExe}" 'luksClose' "/dev/mapper/${_crypt_name}";
  }

  # Format the output string
  _output_str="$(head "-n${_max_main_count}" <<< "${_item_list_str}" \
    | tail "-n+2")";
  # Trim the last `<br>` from the string, note this does not remove `<br>`s
  # from the middle of the string
  _output_str="$(sed '$ s/ <br>//' <<< "${_output_str}")";
  if (( _item_list_count > _threshold_val )); then
    _output_str+="$(echo -e ' <br>\n... (list truncated)')";
  fi
  if [ -z "${_output_str}" ]; then
    _output_str='No files or directories.';
  fi

  # Insert partition info into _chooseReusePartMsg
  _chooseReusePartMsg="${_chooseReusePartMsg//XXX_PART_USAGE_XXX/"${_part_size_str}"}";
  _chooseReusePartMsg="${_chooseReusePartMsg//XXX_CONTENT_LIST_XXX/"${_output_str}"}";
}
## . END _getPartContentStrFn }

## BEGIN _findSystemDiskExtraPartFn {
_findSystemDiskExtraPartFn () {
  declare _root_part_str _dm_id_str _slave_dev_str _main_dev_str \
    _main_dev_part_list _main_dev_part _free_part _mib_int;

  # Process arguments
  _root_part_str="${1:-}";
  [ -z "${_root_part_str}" ] && return 1;

  # If the root device is a device-mapper device, find the underlying
  #   hardware device
  if [[ "${_root_part_str}" =~ ^/dev/mapper/ ]]; then
    _root_part_str="$(readlink -f "${_root_part_str}")";
  fi
  if [[ "${_root_part_str}" =~ ^/dev/dm- ]]; then
    _dm_id_str="$(basename "${_root_part_str}")";
    _slave_dev_str="$(_cm2LsFn "/sys/block/${_dm_id_str}/slaves")";
    # Root devices with more than one underlying device are not supported
    if [ "$(wc -l <<< "${_slave_dev_str}")" != '1' ]; then
      return 1;
    fi
    _root_part_str="/dev/${_slave_dev_str}";
  fi

  # Get the disk device underlying the root partition device
  if [[ "${_root_part_str}" =~ ^/dev/(sd[a-z]+|vd[a-z]+|xvd[a-z]+)[0-9]+ ]]; then
    _main_dev_str="/dev/${BASH_REMATCH[1]}";
  elif [[ "${_root_part_str}" =~ ^/dev/nvme[0-9]+n[0-9]+p[0-9]+$ ]]; then
    _main_dev_str="${_root_part_str%p*}";
  else
    return 1;
  fi
  [ -b "${_main_dev_str}" ] || return 1;

  # Bail if the main disk device has more than four partitions (we only
  #   support three partitions for the OS + one data partition)
  readarray -t _main_dev_part_list < <(find "${_main_dev_str}"* \
    | grep -v "^${_main_dev_str}$");
  if [ "${#_main_dev_part_list[@]}" != '4' ]; then
    return 1;
  fi

  # Check if one and only one partition on the main disk is unused and
  #   suitable as a data partition
  _free_part='';
  for _main_dev_part in "${_main_dev_part_list[@]}"; do
    if _mib_int="$(_checkDevAndEchoMbFn "${_main_dev_part}" 'y')"; then
      if [ -z "${_free_part}" ]; then
        _free_part="${_main_dev_part}";
      else
        # Multiple free partitions aren't expected, bail
        return 1;
      fi
    fi
  done

  # If there are no suitable partitions, bail
  if [ -z "${_free_part}" ]; then
    return 1;
  fi

  # Output partition path and size
  echo "${_free_part}|${_mib_int}";
}
## . END _findSystemDiskExtraPartFn }

## BEGIN _isHomeSetUpFn {
_isHomeSetUpFn () {
  if grep '^# KFOCUS Replaced /home btrfs with extra disk$' \
    /etc/fstab; then
    return 0;
  fi
  return 1;
}
## . END _isHomeSetUpFn }

## BEGIN _mainFn {
_mainFn () {
  declare _disk_str _target_mount_type _root_part_str _luks_yn \
    _part_count _full_prepare_yn _selected_part _part_incompat_yn \
    _encrypted_yn _crypt_passphrase_str _confirm_str _prompt_msg \
    _exit_code _extra_part_info _use_extra_part_yn _bit_list \
    _extra_part_mb_int _setup_opt_list _extra_part_gb_str;

  # Prep variables
  _quietExitStr="${1:-}";
  _encrypted_yn='n';
  _crypt_passphrase_str='';
  _disk_str='';
  _selected_part='';

  # If one extra partition has already been set up, don't launch
  #   automatically (but do allow manual launch)
  if grep -q '# KFOCUS.*is on.*' '/etc/fstab' \
    && [ "${_quietExitStr}" = 'quietExit' ]; then
    exit;
  fi

  # Find root device
  _root_part_str="$(findmnt --noheadings --output=SOURCE --nofsroot \
    --target /)";
  if [[ "${_root_part_str}" =~ ^/dev/mapper/ ]]; then
    _luks_yn='y';
  else
    _luks_yn='n';
  fi

  # Look for an extra partition on the main disk
  if _extra_part_info="$(_findSystemDiskExtraPartFn "${_root_part_str}")"; then
    IFS='|' read -r -a _bit_list <<< "${_extra_part_info}";
    _selected_part="${_bit_list[0]}";
    _extra_part_mb_int="${_bit_list[1]}";
    _extra_part_gb_str="$(bc <<< "scale=2; ${_extra_part_mb_int}/1024")";
    _setupExtraPartMsg="${_setupExtraPartMsg/XXX_EXTRA_PART_XXX/${_selected_part}}";
    _setupExtraPartMsg="${_setupExtraPartMsg/XXX_PART_SIZE_XXX/${_extra_part_gb_str}}";
    _use_extra_part_yn="$(_cm2PromptUserFn "${_setupExtraPartMsg}" "${_winTitle}" 'o')";
    if [ "${_use_extra_part_yn}" = 'y' ]; then
      # Signal to later code that we're reusing a partition
      _part_count=1;
    else
      _cm2PromptUserFn "${_warnExtraPartSkipMsg}" "${_winTitle}";
      _selected_part='';
    fi
  fi

  # If not setting up an extra partition, look for candidate extra disks
  if [ -z "${_selected_part}" ]; then
    _disk_str="$(_selectDiskFn)";
    [ -z "${_disk_str}" ] && exit;
    # Get count of partitions only from selected disk
    _part_count="$(lsblk "${_disk_str}" -o TYPE |grep -c 'part')";
    _part_count="$(_cm2EchoIntFn "${_part_count}")";
    if [[ "${_disk_str}" =~ ^/dev/(sd[a-z]+|vd[a-z]+|xvd[a-z]+)$ ]]; then
      _selected_part="${_disk_str}1";
    elif [[ "${_disk_str}" =~ ^/dev/nvme[0-9]+n[0-9]$ ]]; then
      _selected_part="${_disk_str}p1";
    else
      _cm2ErrStrFn "_selectDiskFn echoed invalid disk |${_disk_str}|!";
      exit 1;
    fi
  fi

  if (( _part_count == 0 )); then
    # This is a partitionless disk, prompt to reformat
    _confirmFormatSafeMsg="${_confirmFormatSafeMsg/XXX_SELECTED_DISK_XXX/${_disk_str}}";
    _full_prepare_yn="$(_cm2PromptUserFn "${_confirmFormatSafeMsg}" \
      "${_winTitle}" 'o')";
    [ "${_full_prepare_yn}" = 'n' ] && exit;
  elif (( _part_count > 1 )); then
    # This is not an old extra disk and can't be reused, prompt to wipe
    _confirmFormatDangerMsg="${_confirmFormatDangerMsg/XXX_SELECTED_DISK_XXX/${_disk_str}}";
    _full_prepare_yn="$(_cm2PromptUserFn "${_confirmFormatDangerMsg}" \
      "${_winTitle}" 'o')";
    [ "${_full_prepare_yn}" = 'n' ] && exit;
  else
    # This is likely an old extra disk or a spare partition on the main
    #   disk, prompt to reuse or reformat
    _part_incompat_yn='n';

    # Check if partition is encrypted
    _encrypted_yn="$(
      grep -q 'crypto_LUKS' < <(
        lsblk -ndo fstype "${_selected_part}"
      ) && echo 'y' || echo 'n'
    )"

    # Cannot use encrypted partition with unencrypted root disk
    if [ "${_encrypted_yn}" = 'y' ]; then
      if [ "${_luks_yn}" = 'n' ]; then
        _part_incompat_yn='y';
      fi
    fi

    # If partitions are incompatible, prompt to reformat
    if [ "${_part_incompat_yn}" = 'y' ]; then
      _confirmFormatHighDangerMsg="${_confirmFormatHighDangerMsg//XXX_SELECTED_PART_XXX/${_selected_part}}";
      _confirmFormatHighDangerMsg="${_confirmFormatHighDangerMsg//XXX_INCOMPAT_REASON_XXX/Cannot use an encrypted disk with unencrypted root.}";
      _full_prepare_yn="$(_cm2PromptUserFn "${_confirmFormatHighDangerMsg}" \
        "${_winTitle}" 'o')";
      [ "${_full_prepare_yn}" = 'n' ] && exit;
    else
      # If partition is encrypted, prompt for passphrase
      if [ "${_encrypted_yn}" = 'y' ]; then
        while true; do
          _queryPassphraseMsg="${_queryPassphraseMsg//XXX_SELECTED_PART_XXX/${_selected_part}}";
          _crypt_passphrase_str="$(kdialog --title "${_winTitle}" \
            --password "${_queryPassphraseMsg}")";
          if ! "${_cryptsetupExe}" luksOpen --test-passphrase "${_selected_part}" \
            <<< "${_crypt_passphrase_str}" 1>&2 2>/dev/null; then
            if [ "$(_cm2PromptUserFn "${_badPassphraseMsg}" "${_winTitle}" \
              'a')" = 'n' ];
              then _crypt_passphrase_str=''; break;
            fi
          else
            break;
          fi
        done
      fi

      # If partition is encrypted and the passphrase is not provided, prompt
      #   to reformat
      if [ "${_encrypted_yn}" = 'y' ] \
        && [ -z "${_crypt_passphrase_str}" ]; then
        _confirmFormatHighDangerMsg="${_confirmFormatHighDangerMsg//XXX_SELECTED_PART_XXX/${_selected_part}}";
        _confirmFormatHighDangerMsg="${_confirmFormatHighDangerMsg//XXX_INCOMPAT_REASON_XXX/Disk passphrase not provided.}";
        _full_prepare_yn="$(_cm2PromptUserFn "${_confirmFormatHighDangerMsg}" \
          "${_winTitle}" 'o')";
        [ "${_full_prepare_yn}" = 'n' ] && exit;
      else
        # If partition has a filesystem, show contents and prompt to reuse
        #   or reformat
        _getPartContentStrFn "${_selected_part}" "${_crypt_passphrase_str}";
        _exit_code="$?";
        # BEGIN check _getPartContentStrFn exit code
        if (( _exit_code == 0 )); then
          _chooseReusePartMsg="${_chooseReusePartMsg//XXX_SELECTED_PART_XXX/${_selected_part}}";
          _full_prepare_yn="$(_cm2PromptUserFn "${_chooseReusePartMsg}" \
            "${_winTitle}" 'd' \
            'n' 'Reuse the existing partition' 'on' \
            'y' 'Wipe and reformat the partition' 'off')";
          [ -z "${_full_prepare_yn}" ] && exit;

        # If partition has no FS, prompt to reformat
        elif (( _exit_code == 2 )); then
          _confirmFormatBlankPartMsg="${_confirmFormatBlankPartMsg//XXX_SELECTED_PART_XXX/${_selected_part}}";
          _full_prepare_yn="$(_cm2PromptUserFn \
            "${_confirmFormatBlankPartMsg}" "${_winTitle}" 'o')";
          [ "${_full_prepare_yn}" = 'n' ] && exit;
        else
          _cm2PromptUserFn "${_contentListFailureMsg}" "${_winTitle}" 's';
          exit 1;
        fi
      fi
    fi
  fi

  # Prompt for extra partition type
  _setup_opt_list=();
  if ! _isHomeSetUpFn; then
    _setup_opt_list+=( 'home' 'Set up as a HOME disk (/home)' 'on' );
    _setup_opt_list+=( 'data' 'Set up as a DATA disk (/srv/data*)' 'off' );
  else
    _setup_opt_list+=( 'data' 'Set up as a DATA disk (/srv/data*)' 'on' );
  fi
  _chooseMountMsg="${_chooseMountMsg/XXX_SELECTED_PART_XXX/${_selected_part}}";
  _target_mount_type="$(_cm2PromptUserFn "${_chooseMountMsg}" \
    "${_winTitle}" 'd' "${_setup_opt_list[@]}")";
  [ -z "${_target_mount_type}" ] && exit;

  # Show overview of partition setup changes
  _confirmOverviewMsg="${_confirmOverviewMsg//XXX_EXTRA_PART_XXX/${_selected_part}}";
  _confirmOverviewMsg="${_confirmOverviewMsg//XXX_MOUNT_TYPE_XXX/${_target_mount_type}}";
  if [ "${_full_prepare_yn}" = 'y' ]; then
    [ "${_luks_yn}" = 'y' ] \
      && _confirmOverviewMsg="${_confirmOverviewMsg//XXX_ENCRYPTED_XXX/Yes}" \
      || _confirmOverviewMsg="${_confirmOverviewMsg//XXX_ENCRYPTED_XXX/No}";
    _confirmOverviewMsg="${_confirmOverviewMsg//XXX_REFORMAT_XXX/Yes}";
  else
    [ -n "${_crypt_passphrase_str}" ] \
      && _confirmOverviewMsg="${_confirmOverviewMsg//XXX_ENCRYPTED_XXX/Yes}" \
      || _confirmOverviewMsg="${_confirmOverviewMsg//XXX_ENCRYPTED_XXX/No}";
    _confirmOverviewMsg="${_confirmOverviewMsg//XXX_REFORMAT_XXX/No}";
  fi
  _confirm_str="$(_cm2PromptUserFn "${_confirmOverviewMsg}" "${_winTitle}" \
    'o')";
  [ "${_confirm_str}" = 'n' ] && exit;

  # Show final confirmation prompt
  if [ "${_full_prepare_yn}" = 'y' ]; then
    _prompt_msg="${_finalReformatMsg//XXX_SELECTED_PART_XXX/${_selected_part}}";
  else
    _prompt_msg="${_finalConfirmMsg//XXX_SELECTED_PART_XXX/${_selected_part}}";
  fi
  _prompt_msg="${_prompt_msg//XXX_MOUNT_TYPE_XXX/${_target_mount_type}}";
  _confirm_str="$(
    _cm2PromptUserFn "${_prompt_msg}" "${_winTitle}" 'o'
  )";
  [ "${_confirm_str}" = 'n' ] && exit;

  # Populate success message placeholders
  _configSuccessMsg="${_configSuccessMsg//XXX_SELECTED_PART_XXX/${_selected_part}}";
  _configSuccessMsg="${_configSuccessMsg//XXX_MOUNT_TYPE_XXX/${_target_mount_type}}";

  # Prompt for authorization and call disk preparation script
  if [ "${_full_prepare_yn}" = 'y' ]; then
    if [ -n "${_disk_str}" ]; then
      _cm2RunLongCmdFn 'Preparing disk' "${_fullPrepareDiskExe}" \
        "${_target_mount_type}" "${_luks_yn}" 'format_disk' "${_selected_part}";
    else
      _cm2RunLongCmdFn 'Preparing disk' "${_fullPrepareDiskExe}" \
        "${_target_mount_type}" "${_luks_yn}" 'format_part' "${_selected_part}";
    fi
    _exit_code="$?";
    case "${_exit_code}" in
      '0')
        _cm2PromptUserFn "${_configSuccessMsg}" "${_winTitle}";
        ;;
      '1')
        _cm2PromptUserFn "${_configSoftFailureMsg}" "${_winTitle}";
        ;;
      '2')
        _cm2PromptUserFn "${_configHardFailureMsg}" "${_winTitle}" 'e';
        ;;
    esac
  else
    if [ "${_encrypted_yn}" = 'n' ]; then
      _cm2RunLongCmdFn 'Preparing disk' "${_reuseDiskExe}" \
        "${_target_mount_type}" "${_selected_part}";
      _exit_code="$?";
      case "${_exit_code}" in
        '0')
          _cm2PromptUserFn "${_configSuccessMsg}" "${_winTitle}";
          ;;
        '1')
          _cm2PromptUserFn "${_configSoftFailureMsg}" "${_winTitle}";
          ;;
        '2')
          _cm2PromptUserFn "${_configLuksOverflowFailureMsg}" "${_winTitle}";
          ;;
        '3')
          _cm2PromptUserFn "${_configHardFailureMsg}" "${_winTitle}" 'e';
          ;;
      esac
    else
      _cm2RunLongCmdFn 'Preparing disk' "${_reuseDiskExe}" \
        "${_target_mount_type}" "${_selected_part}" "${_crypt_passphrase_str}";
      _exit_code="$?";
      case "${_exit_code}" in
        '0')
          _cm2PromptUserFn "${_configSuccessMsg}" "${_winTitle}";
          ;;
        '1')
          _cm2PromptUserFn "${_configSoftFailureMsg}" "${_winTitle}";
          ;;
        '2')
          _cm2PromptUserFn "${_configLuksOverflowFailureMsg}" "${_winTitle}";
          ;;
        '3')
          _cm2PromptUserFn "${_configHardFailureMsg}" "${_winTitle}" 'e';
          ;;
      esac
    fi
  fi
}
## . END _mainFn }

