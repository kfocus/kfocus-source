# wslu causes all sorts of problems when installed on KFocus systems,
# including sound issues, desktop shortcut issues, and syslog errors. Don't
# prevent the user from intentionally installing it, but keep it from being
# unintentionally installed.
Package: wslu
Pin: release o=*
Pin-Priority: 50

# Use Thunderbird from the Mozilla Team PPA.
Package: thunderbird
Pin: release o=LP-PPA-mozillateam
Pin-Priority: 1000

Package: thunderbird
Pin: release o=Ubuntu
Pin-Priority: 50

# Use Firefox from the official Mozilla repositories.
Package: *
Pin: origin packages.mozilla.org
Pin-Priority: 1000

Package: firefox
Pin: release o=Ubuntu
Pin-Priority: 50

# Make sure dkms comes from Ubuntu, not some other source
Package: dkms
Pin: release o=Ubuntu
Pin-Priority: 1001

# Prohibit the installation of Debian's CUDA packages, these are unsupported
# and will likely cause issues with NVIDIA's CUDA packages. These are here
# because these packages should be avoided even if kfocus-nvidia is not
# installed.
Package: nvidia-cuda-toolkit
Pin: release o=*
Pin-Priority: -1

Package: nvidia-cuda-samples
Pin: release o=*
Pin-Priority: -1
