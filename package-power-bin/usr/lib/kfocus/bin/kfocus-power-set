set -u;

# TODO: Add standard documentation headers to all functions

_optionHeader='Name;Frequency GHz;Mode;Turbo;LEDs;';

_optionTable=(
  # _label;up_ratio;down_ratio;gov_key;noturbo_int;kbdled_int
  'High;1;X;performance;0;1;'
  'Normal;1;X;powersave;0;1;'
  'Studio;0;X;performance;1;1;'
  'Low;X;1;powersave;1;0;'
  'Minimal;X;.5;powersave;1;0;'

  # These can be added back if desired
  # 'Medium;.5;X;powersave;0;1;'
  # 'Frugal;X;.666666666;powersave;1;0;'
);

# TODO: Add all remaining frequency tables here
declare -A _freqCanonicalMap;
_freqCanonicalMap['Intel Core i9-14900HX']='High;5800000|4100000;
Normal;5800000|4100000;
Studio;2200000|1600000;
Low;2200000|1600000;
Minimal;1500000|1200000;';
_freqCanonicalMap['11th Gen Intel Core i5-1135G7 @ 2.40GHz']='High;4200000;
Normal;4200000;
Studio;2400000;
Low;2400000;
Minimal;1400000;';
# TODO: Ensure minimum freq for Core Ultra 9 275HX is 800 MHz, otherwise
#   minimal values will be wrong
_freqCanonicalMap['Intel Core Ultra 9 275HX']='High;5400000|4600000;
Normal;5400000|4600000;
Studio;2700000|2100000;
Low;2700000|2100000;
Minimal;1750000|1450000;';
# TODO: Ensure minimum freq for Core Ultra 7 255H is 700 MHz, otherwise
#   minimal values will be wrong
_freqCanonicalMap['Intel Core Ultra 7 255H']='High;5100000|4400000;
Normal;5100000|4400000;
Studio;2000000|1500000;
Low;2000000|1500000;
Minimal;1350000|1100000;';
# TODO: Ensure minimum freq for Core Ultra 5 225H is 700 MHz, otherwise
#   minimal values will be wrong
_freqCanonicalMap['Intel Core Ultra 5 225H']='High;4900000|4300000;
Normal;4900000|4300000;
Studio;1700000|1300000;
Low;1700000|1300000;
Minimal;1200000|1000000;';

## BEGIN _importCommonFn {
# Summary   : _importCommonFn
# Purpose   : Load common routines, prefer relative dir
#           : Run ls-common-symbols.sh to get the list of symbols used here.
# Example   : _importCommonFn;
# Arguments : none
# Globals   : Package vars _baseDir _baseName
# Outputs   : none
# Returns   : none
#
_importCommonFn () {
  declare _lib_list _is_loaded _lib_file;
  _lib_list=(
    "${_baseDir}/lib/common.2.source"
    '/usr/lib/kfocus/lib/common.2.source'
  );
  _is_loaded='n';
  for _lib_file in "${_lib_list[@]}"; do
    if [ -r "${_lib_file}" ]; then
      # shellcheck source=../lib/common.2.source
      if source "${_lib_file}"; then
        _is_loaded='y';
        break;
      fi
    fi
  done

  if [ "${_is_loaded}" = 'n' ]; then
    echo 1>&2 "${_baseName}: ABORT - Cannot source common lib";
    exit 202;
  fi
}
## . END _importCommonFn }

_checkSetFlockFn () {
  declare _did_get_lock _idx;

  _did_get_lock='n;'
  if ! [ -e "${_currentModeFile}" ]; then
    install -m 644 /dev/null "${_currentModeFile}" || {
      _logWrapFn 'err' "Could not install |${_currentModeFile}|!";
      return 2;
    }
  fi

  exec 211>>"${_currentModeFile}" || {
    _logWrapFn 'err' 'Lock file permission denied!';
    return 2;
  };
  for (( _idx=0; _idx < 11; _idx++ )); do
    if flock -n -e 211; then
      _did_get_lock='y';
      break;
    elif (( _idx < 10 )); then
      sleep 1;
    fi
  done

  if [ "${_did_get_lock}" = 'n' ]; then
    _cm2WarnStrFn 'Could not get lock file after ten seconds!'
    return 1;
  fi
}

_printIntFn () { printf '%.0f' "$*"; }
_printMaxIntFn () {
  declare _hw_base_int _hw_min_int _hw_max_int _up_ratio \
    _down_ratio _calc_str;

  _hw_base_int="$1";
  _hw_min_int="$2";
  _hw_max_int="$3";
  _up_ratio="$4";
  _down_ratio="$5";

  _calc_str='';
  if [ "${_up_ratio}" != 'X' ]; then
    _calc_str="${_hw_base_int}+((${_hw_max_int}-${_hw_base_int})*${_up_ratio})";
  elif [ "${_down_ratio}" != 'X' ]; then
    _calc_str="${_hw_min_int}+((${_hw_base_int}-${_hw_min_int})*${_down_ratio})";
  fi

  if [ -n "${_calc_str}" ]; then
    _printIntFn "$(bc <<< "${_calc_str}")";
  else
    _cm2WarnStrFn 'No up or down ratio is provided.';
    _printIntFn "${_hw_base_int}";
  fi
}

_setNoTurboFn () {
  declare _int;
  _int="$1";
  if ! [[ "${_int}" =~ ^[01]$ ]]; then
    _cm2WarnStrFn "Invalid noturbo value |${_int}|";
    return 1;
  fi

  if [ -f "${_noTurboFile}" ]; then
    if ! echo "${_int}" > "${_noTurboFile}"; then
      _cm2WarnStrFn "Could not write |${_int}| noturbo file";
      return 1;
    fi
  else
    _cm2WarnStrFn "Missing |${_noTurboFile}|";
  fi
  return 0;
}

_readNoTurboFn () {
  declare _noturbo_int;

  if [ -f "${_noTurboFile}" ]; then
    _noturbo_int="$(cat "${_noTurboFile}")";
    if [[ "${_noturbo_int}" =~ ^[01]$ ]]; then
      echo "${_noturbo_int}";
    else
      echo '';
    fi
  else
    _cm2WarnStrFn "Missing |${_noTurboFile}|";
    echo '';
  fi
}

_setKbdEnableFn () {
  # Only if tool found
  if [ -x "${_kbdColorSetExe}" ]; then
    # Only if model has LEDs
    if [ "$(_cm2EchoModelStrFn 'has_kb_led')" = 'y' ]; then
      "${_kbdColorSetExe}" -E "${1:-}";
    fi
  fi
}

_intInRangeFn () {
  declare _current_int _range_bottom_int _range_top_int;

  _current_int="${1:-}";
  _range_bottom_int="${2:-}";
  _range_top_int="${3:-}";
  if [ -z "${_current_int}" ] \
    || [ -z "${_range_bottom_int}" ] \
    || [ -z "${_range_top_int}" ]; then
    _cm2ErrStrFn 'Missing arguments to _intInRangeFn!';
    return 2;
  fi

  _current_int="$(_cm2EchoIntFn "${_current_int}")";
  _range_bottom_int="$(_cm2EchoIntFn "${_range_bottom_int}")";
  _range_top_int="$(_cm2EchoIntFn "${_range_top_int}")";
  if (( _current_int >= _range_bottom_int )) \
    && (( _current_int <= _range_top_int )); then
    return 0;
  fi
  return 1;
}

_scanFn () {
  declare _match_line _mode_key _bit_list _label _up_ratio _down_ratio  \
    _gov_key _noturbo_int _kbdled_int _avail_gov_list _proc_count       \
    _proc_idx _set_max_int _hw_freq_list _hw_min_int _hw_max_int        \
    _hw_base_file _hw_base_int _param_list _solve_line \
    _current_pcore_max_int _current_ecore_max_int _psave_key _msg;

  _match_line="${1:-}";
  _mode_key="${2:-}";

  IFS=';' read -r -a _bit_list <<< "${_match_line}";

  if [ "${#_bit_list[@]}" -ne 6 ]; then
    _cm2ErrStrFn "Bad element count |${#_bit_list[@]}|";
    return 1;
  fi

  # _label;up_ratio;down_ratio;gov_key;noturbo_int;kbdled_int
  _label="${_bit_list[0]}";
  _up_ratio="${_bit_list[1]}";
  _down_ratio="${_bit_list[2]}";
  _gov_key="${_bit_list[3]}";
  _noturbo_int="${_bit_list[4]}";
  _kbdled_int="${_bit_list[5]}";
  read -r -a _avail_gov_list < <("${_cpufreqInfoExe}" -g);

  _psave_key='powersave';
  case "${_mode_key}" in
    read) true;;
    set)
      _setNoTurboFn "${_noturbo_int}";
      _setKbdEnableFn "${_kbdled_int}";
      # shellcheck disable=SC2076
      if [[ " ${_avail_gov_list[*]} " =~ " ${_altPsaveKey} " ]]; then
        _psave_key="${_altPsaveKey}";
      fi
      ;;
    *) _cm2ErrStrFn "Unsupported mode |${_mode_key}|. Abort.";
      return 1;
      ;;
  esac;

  _proc_count="$("${_nprocExe}")";
  _current_pcore_max_int=0;
  _current_ecore_max_int=0;
  _solve_line='';

  for (( _proc_idx=0; _proc_idx < "${_proc_count}"; _proc_idx++ )); do
    _set_max_int='';
    read -r -a _hw_freq_list \
      < <("${_cpufreqInfoExe}" -c "${_proc_idx}" -l);
    if [ "${#_hw_freq_list[@]}" = 0 ]; then continue; fi
    _hw_min_int="$(_printIntFn "${_hw_freq_list[0]}")";
    _hw_max_int="$(_printIntFn "${_hw_freq_list[1]}")";

    _hw_base_file="${_rootDir}/sys/devices/system/cpu/cpu";
    _hw_base_file+="${_proc_idx}/cpufreq/base_frequency";
    _hw_base_int="$(_printIntFn "$(cat "${_hw_base_file}")")";

    _param_list=(
      "${_hw_base_int}"
      "${_hw_min_int}"
      "${_hw_max_int}"
      "${_up_ratio}"
      "${_down_ratio}"
    );
    _set_max_int="$(_printMaxIntFn "${_param_list[@]}")";

    # `_scanFn 'read'` is typically called only if we don't have a canonical
    #   frequency table defined for the CPU in use.
    if [ "${_mode_key}" = 'read' ]; then
      if [ "${_isHybridCpu}" = 'y' ]; then
        if _intInRangeFn "${_proc_idx}" "${_pcoreRangeList[@]}"; then
          if (( _set_max_int > _current_pcore_max_int )); then
            _current_pcore_max_int="${_set_max_int}";
          fi
        else
          if ! _intInRangeFn "${_proc_idx}" "${_ecoreRangeList[@]}"; then
            _msg="CPU |${_proc_idx}| not in P-core or E-core range, ";
            _msg+="treating as E core.";
            _cm2WarnStrFn "${_msg}";
          fi
          if (( _set_max_int > _current_ecore_max_int )); then
            _current_ecore_max_int="${_set_max_int}";
          fi
        fi
      else
        if (( _set_max_int > _current_pcore_max_int )); then
          _current_pcore_max_int="${_set_max_int}";
        fi
      fi
    elif [ "${_mode_key}" = 'set' ]; then
      if [ "${_gov_key}" = "powersave" ]; then
        _gov_key="${_psave_key}";
      fi
      if ! "${_cpufreqSetExe}" -c "${_proc_idx}" -g "${_gov_key}"; then
        _cm2WarnStrFn "Bad governor set |${_gov_key}| on core |${_proc_idx}|";
      fi
      if [ -n "${_set_max_int}" ]; then
        if (( _set_max_int < _hw_min_int )); then
          _cm2EchoFn "|${_set_max_int}| below minimum |${_hw_min_int}|";
          _cm2WarnStrFn 'Value discarded';
        elif (( _set_max_int > _hw_max_int )); then
          _cm2EchoFn "|${_set_max_int}| above maximum |${_hw_max_int}|";
          _cm2WarnStrFn 'Value discarded';
        else
          "${_cpufreqSetExe}" -c "${_proc_idx}" -u "${_set_max_int}";
        fi
      fi
    fi
  done

  if [ "${_mode_key}" = 'read' ]; then
    if [ "${_isHybridCpu}" = 'y' ]; then
      _solve_line="${_label};";
      _solve_line+="${_current_pcore_max_int}|${_current_ecore_max_int};";
      _solve_line+="${_gov_key};${_noturbo_int};${_kbdled_int};";
    else
      _solve_line="${_label};${_current_pcore_max_int};${_gov_key};";
      _solve_line+="${_noturbo_int};${_kbdled_int};";
    fi
    echo "${_solve_line}";
  fi
}

_chkInitCpuFn () {
  declare _success_flag _delay_int _delay_fib_one_int _delay_fib_two_int \
    _proc_count _proc_idx;

  _success_flag='y';
  _delay_fib_one_int='1';
  _delay_fib_two_int='1';
  _delay_int='1';

  # This drop file should clear on every boot
  if [ -f "${_cpuDropFile}" ]; then
    _cm2SucStrFn 'CPU init completed';
    return 0;
  fi

  # Skip if not the m2g5 or m2g5p model (both share config_code m2g5)
  if [ "$(_cm2EchoModelStrFn 'config_code')" != 'm2g5' ]; then
    touch "${_cpuDropFile}" || _cm2WarnStrFn 'Could not add a drop file';
    return 0;
  fi

  # Enable turbo boost, this takes about 16 seconds on the m2g5 but
  # could take longer in theory. The 8th fibonacci number is 21, so
  # max total delay time is 54 seconds.
  while (( _delay_int <= 21 )); do
    if _setNoTurboFn 0; then
      break;
    else
      sleep "${_delay_int}";
      (( _delay_int = _delay_fib_one_int + _delay_fib_two_int )) || true;
      _delay_fib_one_int="${_delay_fib_two_int}";
      _delay_fib_two_int="${_delay_int}";
    fi
  done

  if ! _setNoTurboFn 0; then
    _cm2WarnStrFn 'Could NOT set noturbo flag to |0|';
    _success_flag='n';
  fi

  # Put intel_pstate in passive mode
  _delay_fib_one_int='1';
  _delay_fib_two_int='1';
  _delay_int='1';
  while (( _delay_int <= 21 )); do
    if echo 'passive' > "${_cpuStatusFile}" \
      && [ "$(cat "${_cpuStatusFile}")" = 'passive' ]; then
      break;
    else
      sleep "${_delay_int}";
      (( _delay_int = _delay_fib_one_int + _delay_fib_two_int )) || true;
      _delay_fib_one_int="${_delay_fib_two_int}";
      _delay_fib_two_int="${_delay_int}";
    fi
  done

  if ! echo 'passive' > "${_cpuStatusFile}" \
    || [ "$(cat "${_cpuStatusFile}")" != 'passive' ]; then
    _cm2WarnStrFn 'Could NOT set pstate flag to |passive|';
    _success_flag='n';
  else
    # Set the default governor on all cores
    _proc_count="$("${_nprocExe}")";

    for (( _proc_idx=0; _proc_idx < "${_proc_count}"; _proc_idx++ )); do
      if ! "${_cpufreqSetExe}" -c "${_proc_idx}" -g "${_altPsaveKey}"; then
        _cm2WarnStrFn "Governor |${_altPsaveKey}| NOT set for core |${_proc_idx}";
        _success_flag='n';
      fi
    done
  fi

  if [ "${_success_flag}" = 'y' ]; then
    touch "${_cpuDropFile}" || _cm2WarnStrFn 'Could not add a drop file';
    _cm2SucFn;
  else
    _cm2WarnFn;
  fi
}

_calcWriteOptionFilesFn () {
  declare _computed_table_str _pretty_computed_table_str;

  if [ -f "${_computedTableFile}" ] \
    && [ -f "${_prettyComputedTableFile}" ]; then
    return 0;
  fi

  _cm2SetMsgFn 'Generate CPU frequency tables';
  #_setModeFn 'Normal';
  _setNoTurboFn '0';
  if _computed_table_str="$(_calcOptionsFn)"; then
    _pretty_computed_table_str="$(_calcPrettyOptionsFn "${_computed_table_str}")";
  else
    _pretty_computed_table_str="${_computed_table_str}";
  fi

  echo "${_computed_table_str}"        > "${_computedTableFile}";
  echo "${_pretty_computed_table_str}" > "${_prettyComputedTableFile}";
  _cm2SucFn;
}

_setModeFn () {
  declare _arg_str _mode_list _opt_line _match_line _key;

  _arg_str="${1:-}";
  _match_line='';
  _mode_list=();

  for _opt_line in "${_optionTable[@]}"; do
    _key="$(cut -f1 -d';' <<< "${_opt_line}")";
    if [ "${_arg_str}" = "${_key}" ]; then
      _match_line="${_opt_line}";
      break;
    fi
    _mode_list+=("${_key}");
  done

  if [ -z "${_match_line}" ]; then
    _cm2ErrStrFn "Mode |${_arg_str}| not supported. Abort.";
    ( IFS='|'; _cm2EchoFn "  ${_mode_list[*]}" );
    return 1;
  fi

  _scanFn "${_match_line}" 'set';
  echo "${_arg_str}" > "${_currentModeFile}";
}

_calcCanonicalFreqsFn() {
  declare _canonical_table_str _canonical_table_list _out_list _opt_line \
    _opt_parts _canonical_line _canonical_match_line _canonical_parts \
    _out_str;

  _canonical_table_str="${1:-}";
  [ -z "${_canonical_table_str}" ] && return 1;

  readarray -t _canonical_table_list <<< "${_canonical_table_str}";
  _out_list=();

  for _opt_line in "${_optionTable[@]}"; do
    IFS=';' read -r -a _opt_parts <<< "${_opt_line}";

    _canonical_match_line='';
    for _canonical_line in "${_canonical_table_list[@]}"; do
      if [[ "${_canonical_line}" =~ ^${_opt_parts[0]} ]]; then
        _canonical_match_line="${_canonical_line}";
        break;
      fi
    done

    if [ -z "${_canonical_match_line}" ]; then
      _cm2ErrStrFn \
        "No canonical frequency match for option line |${_opt_line}|!"
      return 1;
    fi

    IFS=';' read -r -a _canonical_parts <<< "${_canonical_match_line}";
    _out_str="${_opt_parts[0]};${_canonical_parts[1]};${_opt_parts[3]};";
    _out_str+="${_opt_parts[4]};${_opt_parts[5]};";
    _out_list+=( "${_out_str}" );
  done

  if [ "${#_out_list[@]}" = '0' ]; then
    _cm2ErrStrFn 'Could not calculate canonical freq table!'
    return 1;
  fi
  printf '%s\n' "${_out_list[@]}";
}

_calcOptionsFn () {
  declare _opt_line _out_list _out_str _title _model_msg _normal_cpu_freq \
    _low_cpu_freq _opt_parts _out_parts _cpu_str _return_val \
    _canonical_table_str _canonical_freqs_list;

  _out_list=();
  _cpu_str="$(
    lscpu \
      | grep 'Model name:' \
      | grep -v 'BIOS Model name:' \
      | awk -F':' '{ print $2 }' \
      | sed 's/^ *//; s/(\(R\|TM\))//g'
  )";
  _normal_cpu_freq='';
  _low_cpu_freq='';
  _return_val='0';
  _canonical_table_str="${_freqCanonicalMap["${_cpu_str}"]:-}";

  _out_list+=( "$(_cm2EchoModelStrFn 'label');${_cpu_str};${_isHybridCpu};" );

  for _opt_line in "${_optionTable[@]}"; do
    # Calculate frequencies for normal and low modes even if a hardcoded
    #   table exists, for checking turbo boost
    if [ -n "${_canonical_table_str}" ] \
      && ! [[ "${_opt_line}" =~ ^(Normal|Low)\; ]]; then
      continue;
    fi
    _out_str="$(_scanFn "${_opt_line}" 'read' )";
    if [[ "${_out_str:-}" =~ ^[[:space:]]*$ ]]; then
      continue;
    else
      if [ -z "${_canonical_table_str}" ]; then
        _out_list+=( "${_out_str}" );
      fi
      IFS=';' read -r -a _opt_parts <<< "${_opt_line}";
      if [ "${_opt_parts[0]}" = 'Normal' ]; then
        IFS=';' read -r -a _out_parts <<< "${_out_str}";
        _normal_cpu_freq="${_out_parts[1]}";
      elif [ "${_opt_parts[0]}" = 'Low' ]; then
        IFS=';' read -r -a _out_parts <<< "${_out_str}";
        _low_cpu_freq="${_out_parts[1]}";
      fi
    fi
  done

  # This occurs when Turbo Boost is disabled on kernels >= 6.11
  if [ "${_normal_cpu_freq:-}" = "${_low_cpu_freq:-}" ]; then
    _cm2ErrStrFn \
      'CPU init failed, max CPU freq for normal and low power profiles are the same!';
  fi

  if [ -n "${_canonical_table_str}" ]; then
    readarray -t _canonical_freqs_list <<< "$(_calcCanonicalFreqsFn \
      "${_canonical_table_str}")";
    _out_list+=( "${_canonical_freqs_list[@]}" );
  fi

  ## TODO 2023-03-27 Add per-cpu messages where appropriate
  if [ "${#_out_list[@]}" = '1' ]; then
    _title='Frequency Profile';
    _model_msg="$(cat << EOH
<b>We do not have a frequency profile for this CPU</b>.
 If you would like to contribute a frequency profile, please
 provide a pull request to kfocus-source on GitHub.com.
EOH
    )";
    _out_list+=( "title:${_title}|message:${_cm2HtmPStr}${_model_msg}</p>" );
    _return_val='1';
  fi

  if [ -n "${_normal_cpu_freq}" ] \
    && [ -n "${_low_cpu_freq}" ] \
    && [ "${_normal_cpu_freq}" == "${_low_cpu_freq}" ]; then
    _cm2ErrStrFn \
      'CPU init failed, max CPU freq for normal and low power profiles are the same!';
  fi

  ( IFS=$'\n'; echo "${_out_list[*]}" );
  return "${_return_val}";
}

_calcPrettyOptionsFn() {
  declare _orig_computed_table_str _bit_list _label _frequency _governor \
    _turbo _leds _header_line _orig_computed_table _out_computed_table_str \
    _idx _line _freq_parts _pcore_freq _ecore_freq;

  _orig_computed_table_str="${1:-}";
  [ -z "${_orig_computed_table_str}" ] && {
    _cm2ErrStrFn 'The original computed table string was not provided';
    return 1;
  }

  readarray -t _orig_computed_table <<< "${_orig_computed_table_str}";
  # Pass through the CPU info line unchanged
  _out_computed_table_str="${_orig_computed_table[0]}";

  IFS=';' read -r -a _bit_list <<< "${_optionHeader}";
  _label="${_bit_list[0]}";
  _frequency="${_bit_list[1]}";
  _governor="${_bit_list[2]}";
  _turbo="${_bit_list[3]}";
  _leds="${_bit_list[4]}";
  _header_line="${_label};${_frequency};${_governor};${_turbo};";
  if [ "$(_cm2EchoModelStrFn 'has_kb_led')" = 'y' ]; then
    _header_line+="${_leds};";
  fi
  _out_computed_table_str+=$'\n'"${_header_line}";

  for (( _idx = 1; _idx < ${#_orig_computed_table[@]}; _idx++ )); do
    IFS=';' read -r -a _bit_list <<< "${_orig_computed_table[_idx]}";
    if (( ${#_bit_list[@]} < 5 )); then
      _out_computed_table_str+=$'\n'"${_orig_computed_table[_idx]}";
      continue;
    fi

    _label="${_bit_list[0]}";
    _frequency="${_bit_list[1]}";
    _governor="${_bit_list[2]}";
    _turbo="${_bit_list[3]}";
    _leds="${_bit_list[4]}";

    if [ "${_governor}" = 'performance' ]; then
      _governor='PERF'; else _governor='psave';
    fi
    if [ "${_turbo}" = '0' ]; then
      _turbo='Yes'; else _turbo='No';
    fi
    if [ "${_leds}" = '0' ]; then
      _leds='Off'; else _leds='On';
    fi

    if [ "${_isHybridCpu}" = 'y' ]; then
      IFS='|' read -r -a _freq_parts <<< "${_frequency}";
      _pcore_freq="$(bc <<< "scale=2; ${_freq_parts[0]} / 1000000")";
      _ecore_freq="$(bc <<< "scale=2; ${_freq_parts[1]} / 1000000")";
      _frequency="P${_pcore_freq}  E${_ecore_freq}";
    else
      _frequency="$(bc <<< "scale=2; ${_frequency} / 1000000")";
    fi

    _line="${_label};${_frequency};${_governor};${_turbo};";
    if [ "$(_cm2EchoModelStrFn 'has_kb_led')" = 'y' ]; then
      _line+="${_leds};";
    fi
    _out_computed_table_str+=$'\n'"${_line}";
  done

  echo "${_out_computed_table_str}";
}

_printOptionsFn () {
  declare _mode_str;

  _mode_str="${1:-}";
  [ -f "${_computedTableFile}" ] || {
    _cm2ErrStrFn 'CPU frequency table file not found';
    return 1;
  }
  [ -f "${_prettyComputedTableFile}" ] || {
    _cm2ErrStrFn 'CPU pretty frequency table file not found';
    return 1;
  }

  case "${_mode_str}" in
    p) cat "${_computedTableFile}";;
    x) cat "${_prettyComputedTableFile}";;
    *) _cm2ErrStrFn "Unrecognized mode string |${_mode_str}|";
      return 1;
      ;;
  esac
}
## . END _printOptionsFn }

## BEGIN _readModeFn {
#
_readModeFn () {
  declare _current_mode_str _opt_line _msg;

  # TODO: Consider setting the mode to "Normal" if no mode is found
  if ! [ -f "${_currentModeFile}" ]; then
    _cm2WarnStrFn 'Current mode file does not exist!';
    echo 'Unknown';
    return 0;
  fi

  _current_mode_str="$(cat "${_currentModeFile}")";
  for _opt_line in "${_optionTable[@]}"; do
    if [[ "${_opt_line}" =~ ^${_current_mode_str}\; ]]; then
      echo "${_current_mode_str}";
      return 0;
    fi
  done

  _msg="Unsupported mode |${_current_mode_str}| read from ";
  _msg+="|${_currentModeFile}|!";
  _cm2WarnStrFn "${_msg}";
  echo 'Unknown';
  return 0;
}
## . END _readModeFn }

## BEGIN _chkIfHybridCpuFn {
_chkIfHybridCpuFn () {
  if [ -f "${_pcoreRangeFile}" ] && [ -f "${_ecoreRangeFile}" ]; then
    _isHybridCpu='y';
    IFS='-' read -r -a _pcoreRangeList <<< "$(cat "${_pcoreRangeFile}")";
    IFS='-' read -r -a _ecoreRangeList <<< "$(cat "${_ecoreRangeFile}")";
  fi
}
## . END _chkIfHybridCpuFn }

_mainFn () {
  declare _arg_str;
  _arg_str="${1:-}";

  _chkIfHybridCpuFn;
  _chkInitCpuFn; # Set CPUFreq for 2023+ CPUs
  _calcWriteOptionFilesFn;
  case "${_arg_str}" in
    '-p') _printOptionsFn 'p';;
    '-x') _printOptionsFn 'x';;
    '-r') _readModeFn;;
    '-i') true;; # does CPU init only, and that's already done
      '') _cm2ErrStrFn 'Argument or flag required'; exit 1;;
       *)
         _checkSetFlockFn || exit "$?";
         _setModeFn "${_arg_str}";
         ;;
  esac
}

## BEGIN Declare and assign global vars {
declare _binName _binDir _baseDir _baseName _rootDir \
  _cpuDropFile _noTurboFile _cpuStatusFile _altPsaveKey \
  _cpufreqSetExe _cpufreqInfoExe _nprocExe _kbdColorSetExe \
  _currentModeFile _pcoreRangeFile _ecoreRangeFile _isHybridCpu;

_rootDir='';
_cpuDropFile='/run/kfocus-cpu-init';
_noTurboFile='/sys/devices/system/cpu/intel_pstate/no_turbo';
_cpuStatusFile='/sys/devices/system/cpu/intel_pstate/status';
_altPsaveKey='ondemand'; # schedutil has lower gb5 scores
_computedTableFile='/run/kfocus-power-computed-table';
_prettyComputedTableFile='/run/kfocus-power-pretty-computed-table';
_currentModeFile='/run/kfocus-power-current-mode';
_pcoreRangeFile='/sys/bus/event_source/devices/cpu_core/cpus';
_ecoreRangeFile='/sys/bus/event_source/devices/cpu_atom/cpus';
_isHybridCpu='n';
_pcoreRangeList=();
_ecoreRangeList=();
## . END Declare and assign global vars }

## BEGIN Run main if the script is not sourced {
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  _binName="$(readlink -f "$0")"        || exit 101;
  _binDir="$(dirname "${_binName}")"    || exit 101;
  _baseDir="$(dirname "${_binDir}")"    || exit 101;
  _baseName="$(basename "${_binName}")" || exit 101;

  # Import libs and assign more global vars
  _importCommonFn;
  _assignList=(
    "_kbdColorSetExe|${_binDir}/kfocus-kb-color-set,/usr/lib/kfocus/bin/kfocus-kb-color-set||optional"
    '_cpufreqSetExe|cpufreq-set'
    '_cpufreqInfoExe|cpufreq-info'
    '_nprocExe|nproc'
  );
  if ! _cm2AssignExeVarsFn "${_assignList[@]}"; then
    _cm2WarnStrFn 'ABORT: Required commands not found';
    exit 1;
  fi

  _mainFn "$@"; # >> /tmp/kfocus-power-set-debug.txt 2>&1
fi
## . END Run main if the script is not sourced }
