#!/bin/bash
#
# Copyright 2019-2025 MindShare Inc.
# Written for Kubuntu Focus by:
# Michael Mikowski, Aaron Rainbolt, Erich Eickmeyer
#
# Name    : kfocus-fan-set
# Purpose : Run-as-root utility to set fan profile
# License : GPL v2
# Run By  : kfocus-power-bin
# Spec    : 2617, 3050
# Test    : 00710
#
set -u;

_optionTable=(
  # label|desc|profile_code
  'None|fan control disabled|' # this element MUST be first
  'Quiet|Quieter but warmer|quiet'
  'Balanced|Cool, performs well|balanced'
  'Performance|Best performance|performance'
);

_importCommonFn () {
  declare _lib_file;
  _lib_file="${_baseDir}/lib/common.2.source";
  if [ -r "${_lib_file}" ]; then
    # shellcheck source=../lib/common.2.source
    source "${_lib_file}" || exit 202;
  else
    echo 1>&2 "${_baseName}: ABORT - Cannot source lib |${_lib_file}|";
    exit 202;
  fi
}

_setFanControlFn () {
  declare _fan_control_mode;
  _fan_control_mode="${1:-}";

  echo "${_fan_control_mode}" > "${_fanProfileFile}";
  systemctl start  kfocus-fand || true;
  systemctl reload kfocus-fand || true;
}

_setModeFn () {
  declare _pick_key _match_line _mode_list _opt_line _loop_key _bit_list;

  _pick_key="$(cut -d' ' -f1 <<< "${1:-}")";
  _match_line='';
  _mode_list=();

  for _opt_line in "${_optionTable[@]}"; do
    _loop_key="$(cut -d'|' -f1 <<< "${_opt_line}")";
    if [ "${_pick_key}" = "${_loop_key}" ]; then
      _match_line="${_opt_line}";
      break;
    fi
    _mode_list+=("${_loop_key}");
  done

  if [ -z "${_match_line}" ]; then
    _cm2EchoFn "ABORT: Mode |${_pick_key}| not supported.";
    ( IFS='|'; _cm2EchoFn "  ${_mode_list[*]}" );
    return 1;
  fi

  IFS='|' read -r -a _bit_list <<< "${_match_line}";
  _setFanControlFn "${_bit_list[2]:-}";
}

_chkReportFanSupportFn () {
  declare _model_label _model_code _model_msg \
  _is_tuxedo_io_present;

  _model_label="$(_cm2EchoModelStrFn 'label')";
  _model_code="$(_cm2EchoModelStrFn 'code')";

  if [ -c /dev/tuxedo_io ]; then
    _is_tuxedo_io_present='y';
    # This can be used if we want more detail:
    # <br><br>The kfocus-power-fan package is installed but
    # not used. We recommend you remove it.
  else
    _is_tuxedo_io_present='n';
  fi

  case "${_model_code}" in
    ir14*|ir16*)
      _model_msg="$(cat <<_EOH010
<b>Select a fan profile in the BIOS</b>.
 Press <code>F2</code> during boot and select <code>BIOS &gt;
 Advanced &gt; Operating Mode &gt; Balanced</code> or
 another mode.
_EOH010
      )";;

    m1*|m2g1*|m2g2*|m2g3*|m2g4*|m2g5*|m2g6*|xe*|zr*)
      if [ "${_is_tuxedo_io_present}" = 'y' ]; then return 0; fi
      _model_msg="$(cat <<_EOH020
<b>Custom fan profiles are available</b>. Please install
 <code>kfocus-keyboard</code>, then reboot and rerun this app to see
 the controls.
_EOH020
      )";;

    nxg1*)
      _model_msg="$(cat <<_EOH040
<b>Select a fan profile in the BIOS</b>. Press <code>F2</code>
 during boot and select <code>BIOS &gt; Cooling &gt; Fan Control
 &gt; Balanced</code> or other mode.
_EOH040
      )";;

    nxg2*)
      _model_msg="$(cat <<_EOH050
<b>Select a fan profile in the BIOS</b>.
 Press <code>F2</code> during boot and select <code>BIOS &gt;
 Power, Performance, and Cooling &gt; Fan Control &gt;
 Balanced</code> or another mode.
_EOH050
      )";;

    nxg3*)
      _model_msg="$(cat <<_EOH060
<b>Select a fan profile in the BIOS</b>.
 Press <code>F2</code> during boot and select <code>BIOS &gt;
 Cooling &gt; Fan Mode</code> and then pick <code>Whisper</code>,
 <code>Standard</code>, or <code>Performance</code>.
_EOH060
      )";;

   *)
     _model_msg="$(cat <<_EOH080
<b>Fan profile not found for this device</b>. You may be able
 to adjust the fans in the BIOS or with a device-specific tool.
_EOH080
      )";;
  esac

  echo "message:${_cm2HtmPStr}${_model_msg}</p>"
  return 1;
}

_printOptionsFn () {
  declare _arg_str _opt_line _bit_list;

  # -x mode prints alternate messages if fan control not found
  _arg_str="${1:-}";
  if [ "${_arg_str}" = 'x' ]; then
    if ! _chkReportFanSupportFn; then
      return 0;
    fi
  fi

  for _opt_line in "${_optionTable[@]}"; do
    IFS='|' read -r -a _bit_list <<< "${_opt_line}";
    echo "${_bit_list[0]} ( ${_bit_list[1]} )";
  done
}

_readModeFn () {
  declare _fan_profile_str _opt_line _bit_list;

  if ! [ -f "${_fanProfileFile}" ]; then
    _fan_profile_str='none';
  else
  _fan_profile_str="$(head -n1 "${_fanProfileFile}")";
  fi

  for _opt_line in "${_optionTable[@]}"; do
    IFS='|' read -r -a _bit_list <<< "${_opt_line}";
    if [ "${_bit_list[2]:-}" = "${_fan_profile_str}" ]; then
      echo "${_bit_list[0]} ( ${_bit_list[1]} )";
      return 0;
    fi
  done;

  echo "Custom (${_fan_profile_str})";
}

_mainFn () {
  declare _arg_str;
  _arg_str="${1:-}";
  case "${_arg_str}" in
    '-p') _printOptionsFn;;
    '-x') _printOptionsFn 'x';;
    '-r') _readModeFn;;
      '') _cm2EchoFn 'Argument or flag required'; exit 1;;
       *) _setModeFn "${_arg_str}";
  esac
}

## BEGIN Set global vars {
_rootDir='';
_fanProfileFile="${_rootDir}/var/lib/kfocus/fan_state"
## . END Set global vars }

## BEGIN Run main if the script is not sourced {
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  _binName="$(readlink -f "$0")"        || exit 101;
  _binDir="$(dirname "${_binName}")"    || exit 101;
  _baseDir="$(dirname "${_binDir}")"    || exit 101;
  _baseName="$(basename "${_binName}")" || exit 101;
  _importCommonFn;
  _mainFn "$@";
fi
## . END Run main if the script is not sourced }
