## . END INITIALIZATION AND EXIT FUNCTIONS ==============================

## BEGIN PRIVATE FUNCTIONS ==================================================
## BEGIN private _balanceBootFn {
# Summary   : _balanceBootFn
# Purpose   : Unconditionally balances the boot filesystem.
# Example   : _balanceBootFn
# Arguments : none
# Globals   : none
# Outputs   : none
# Returns   : none
# Throws    : none
#
_balanceBootFn () {
  # Unconditionally balance boot space
  "${_btrfsBalanceExe}" -u 85 "${_rb2BootDir}" || {
    _logWrapFn 'err' 'Failed to balance boot filesystem!';
    return 1;
  }

  _logWrapFn 'notice' 'Boot filesystem balanced.';
}
## . END private _balanceBootFn }

## BEGIN private _balanceMainFn {
# Summary   : _balanceMainFn doForce
# Purpose   : Checks to see if the main filesystem needs balanced, and does so
#             if necessary.
# Example   : _balanceMainFn 'n'
# Arguments :
#   doForce - Whether to force a balance or not. Argument must be one of
#     either 'y' or 'n'. Defaults to 'n'.
# Globals   : none
# Outputs   : none
# Returns   : none
# Throws    : none
#
_balanceMainFn () {
  declare _do_force_balance _main_report _main_unalloc_int _main_free_int \
    _last_unalloc_int _last_free_int _trigger_threshold _balance_percent \
    _do_balance;

  _do_force_balance="${1:-n}";
  _do_balance='n';
  _trigger_threshold=5368709120; # 5 GiB

  # Extract unallocated and free space from main fs report
  _main_report="$(_getMainUsageReportFn)" || {
    _logWrapFn 'err' 'Could not balance main filesystem, could not get main usage report!';
    return 1;
  }
  _main_unalloc_int="$(grep $'Device unallocated:\t' <<< "${_main_report}" \
    | awk '{ print $3 }')";
  _main_free_int="$(grep $'Free (estimated):\t' <<< "${_main_report}" \
    | awk '{ print $3 }')";

  # Read previous space values from snapshot metadb
  _last_unalloc_int="$(_readMetadbFn 'global' 'lastUnallocInt')" || {
    _logWrapFn 'err' 'Could not balance main filesystem, could not read lastUnallocInt from metadb!';
    return 1;
  }
  _last_free_int="$(_readMetadbFn 'global' 'lastFreeInt')" || {
    _logWrapFn 'err' 'Could not balance main filesystem, could not read lastFreeInt from metadb!';
    return 1;
  }
  if [ -z "${_last_unalloc_int}" ] \
    || [ -z "${_last_free_int}" ]; then
    _last_unalloc_int=-1;
    _last_free_int=0;
  fi

  # Always balance if forced, and balance more intensively
  if [ "${_do_force_balance}" = 'y' ]; then
    _balance_percent='85';
    _do_balance='y'
  # Else, balance if free space growth or unallocated space shrinkage exceeds
  # threshold
  elif (( (_last_unalloc_int - _main_unalloc_int) >= "${_trigger_threshold}" )) \
    || (( (_main_free_int - _last_free_int) >= "${_trigger_threshold}" )); then
    _balance_percent='70';
    _do_balance='y';
  fi

  # Balance if conditions met
  if [ "${_do_balance}" = 'y' ]; then
    # Balance main fs
    "${_btrfsBalanceExe}" -u "${_balance_percent}" "${_rb2MainDir}" \
      || _logExitFn 'alert' '2' 'Could not balance main BTRFS filesystem!';

    # Save new unallocated and free space data to state file
    _main_report="$(_getMainUsageReportFn)" || {
      _logWrapFn 'err' 'Could not balance main filesystem, could not get main usage report!';
      return 1;
    }
    _main_unalloc_int="$(grep $'Device unallocated:\t' <<< "${_main_report}" \
      | awk '{ print $3 }')";
    _main_free_int="$(grep $'Free (estimated):\t' <<< "${_main_report}" \
      | awk '{ print $3 }')";

    _writeMetadbFn 'global' 'lastUnallocInt' "${_main_unalloc_int}";
    _writeMetadbFn 'global' 'lastFreeInt' "${_main_free_int}";

    _logWrapFn 'notice' "Main filesystem balanced.";
  else
    _logWrapFn 'notice' \
      "Main filesystem not balanced: not forced and threshold not met.";
  fi
}
## . END private _balanceMainFn }

## BEGIN private _checkBootUnallocSpaceFn {
_checkBootUnallocSpaceFn () {
  declare _boot_min_unalloc _boot_unalloc;

  _boot_min_unalloc="$(_getBootMinUnallocFn)";
  _boot_unalloc="$(_getBootUnallocSpaceFn)";

  # Warn all users if boot unallocated space is below minimum
  if (( _boot_unalloc < _boot_min_unalloc )); then
    _logWrapFn 'err' 'Boot filesystem space is low!';
    return 1;
  else
    return 0;
  fi
}
## . END private _checkBootUnallocSpaceFn }

## BEGIN private _checkBtrfsStatusFn {
# Summary   : _checkBtrfsStatusFn
# Purpose   : Determines the state of the system's BTRFS setup and outputs an
#             easily manageable code corresponding to the BTRFS status. This
#             is mainly used for determining whether the system is able to
#             use rollback snapshots, and whether automatic snapshotting is
#             enabled.
# Example   : _checkBtrfsStatusFn
# Arguments : none
# Globals   : _btrfsStatus
# Outputs   :
#   'UNSUPPORTED' - the system does not support rollback snapshots.
#   'SUPPORTED, MANUAL' - the system supports rollback snapshots. Do NOT take
#     automatic snapshots.
#   'SUPPORTED, AUTO' - the system supports rollback snapshots. Take automatic
#     snapshots.
#   'SUPPORTED, NOT SET UP' - the system can support rollback snapshots, but
#     it has not yet gone through the initial setup process.
#   'INCONSISTENT' - the system supported rollback snapshots at one point, but
#     is damaged and cannot support them now. This should only ever happen if
#     the disk becomes corrupted or the user does something wrong.
# Returns   : none
# Throws    : none
#
_checkBtrfsStatusFn () {
  declare _main_fs _boot_fs _idx _good_count _check_str \
    _main_subvols_str _boot_subvols_str _switch_str;
  # The presence of /var/lib/portables or /var/lib/machines subvolumes will
  # interfere with snapshotting. These subvolumes may be created automatically
  # by systemd if it is not configured otherwise.
  if grep -q 'var/lib/portables' < <("${_btrfsExe}" subvolume list /) || \
     grep -q 'var/lib/machines' < <("${_btrfsExe}" subvolume list /); then
    if [ -n "$(ls -A /var/lib/portables)" ] || \
       [ -n "$(ls -A /var/lib/machines )" ]; then
      _btrfsStatus='UNSUPPORTED';
      return;
    fi
  fi

  # Gauntlet for INCONSISTENT, UNSUPPORTED, SUPPORTED
  _main_fs="$(_readMainFsFn)";
  _boot_fs="$(_readBootFsFn)";
  for _idx in {1..1}; do
    # Check top directories
    _good_count=$(_checkDirListFn "${_rb2MainDir}|${_rb2BootDir}");

    # Only one directory means INCONSISTENT
    [ "${_good_count}" = '1' ] && {
      _btrfsStatus='INCONSISTENT'; break;
    }

    # No directories mean we should CHECK_SETUP
    [ "${_good_count}" = '0' ] && {
      _btrfsStatus='CHECK_CAN_SETUP'; break;
    }

    # Unless 4 dirs exist, means UNSUPPORTED
    _check_str="${_rb2MainDir}/@|${_rb2MainSnapshotDir}";
    _check_str+="|${_rb2BootDir}/@boot|${_rb2BootSnapshotDir}";
    _good_count=$(_checkDirListFn "${_check_str}");
    [ "${_good_count}" != 4 ] && {
      _btrfsStatus='UNSUPPORTED'; break;
    }

    # Unless main, boot fs exists and distinct, means UNSUPPORTED
    [ -z "${_main_fs}" ] || [ -z "${_boot_fs}" ] \
      || [ "${_main_fs}" = "${_boot_fs}" ] && {
      _btrfsStatus='UNSUPPORTED'; break;
    }

    # Gauntlet passed.
    _btrfsStatus='SUPPORTED';
  done

  # Append MANUAL, AUTO, NOT SETUP to SUPPORTED condition
  if [ "${_btrfsStatus}" = 'SUPPORTED' ]; then
    # This may exit non-zero but if it does, we also won't get any mode
    # switch state string, so it's easier to interpret that.
    _switch_str="$(_getManualSwitchStateFn)";
    if [ "${_switch_str}" = 'MANUAL' ]; then
      _btrfsStatus+=', MANUAL';
    elif [ "${_switch_str}" = 'AUTO' ]; then
      _btrfsStatus+=', AUTO';
    else
      _btrfsStatus='UNSUPPORTED';
    fi
  fi

  # Bail if btrfsStatus is already set
  if [ "${_btrfsStatus}" != 'CHECK_CAN_SETUP' ]; then return; fi

  # Gauntlet to run on CHECK_CAN_SETUP condition,
  #   where _main_fs, _boot_fs are not setup per above
  for _idx in {1..1}; do

    # Unless main, boot fs exists and distinct, means UNSUPPORTED
    if [ -z "${_main_fs}" ] || [ -z "${_boot_fs}" ] \
      || [ "${_main_fs}" = "${_boot_fs}" ]; then
      _btrfsStatus='UNSUPPORTED'; break;
    fi
    _main_subvols_str="$(
      "${_btrfsExe}" subvolume list / | awk '{ print $9 }' | sort
    )";
    _boot_subvols_str="$(
      "${_btrfsExe}" subvolume list /boot | awk '{ print $9 }' | sort
    )";

    # If root subvol is misnamed or absent, means UNSUPPORTED
    if ! grep -qE '^@$' <<< "${_main_subvols_str}"; then
      _btrfsStatus='UNSUPPORTED'; break;
    fi

    # If /home mount is not found, means UNSUPPORTED
    if ! LC_ALL='C' mount | grep -q ' on /home '; then
      _btrfsStatus='UNSUPPORTED'; break;
    fi

    # If main_subvols_str is not empty, means UNSUPPORTED
    if [ -n "${_boot_subvols_str}" ]; then
      _btrfsStatus='UNSUPPORTED'; break;
    fi

    # If snapshots are found, means INCONSISTENT
    if grep -qE '^@kfocus-rollback-snapshots$' \
      <<< "${_main_subvols_str}"; then
      _btrfsStatus='INCONSISTENT'; break;
    fi

    # Gauntlet passed
    _btrfsStatus='SUPPORTED, NOT SET UP';
  done
}
## . END private _checkBtrfsStatusFn }

## BEGIN private _checkBtrfsStatusSetUpFn {
# Summary   : _checkBtrfsStatusSetUpFn
# Purpose   : Ensures that the BTRFS status is either 'SUPPORTED, AUTO' or
#             'SUPPORTED, MANUAL'. Exits the script immediately if not. This
#             function will only behave as intended if _checkBtrfsStatusFn is
#             called first.
# Example   : _checkBtrfsStatusSetUpFn
# Arguments : none
# Globals   : _btrfsStatus
# Outputs   : none
# Returns   : none
# Throws    :
#   0 - The BTRFS status is not 'SUPPORTED, AUTO' or 'SUPPORTED, MANUAL'.
#
_checkBtrfsStatusSetUpFn () {
  if [ "${_btrfsStatus}" != 'SUPPORTED, AUTO' ] \
    && [ "${_btrfsStatus}" != 'SUPPORTED, MANUAL' ]; then
    return 1;
  fi
}
## . END private _checkBtrfsStatusSetUpFn }

## BEGIN private _createCheckMetadbFn {
_checkCreateMetadbFn () {
  # Confirm this is regular, existing file with correct perms
  if [ -f "${_snapshotMetaDb}" ]; then
    if [ "$(stat -c '%a' "${_snapshotMetaDb}")" != '644' ]; then
      chmod '0644' "${_snapshotMetaDb}" || {
        _logWrapFn 'err' 'Failed to fix permissions on snapshot metadb!';
        return 1;
      }
    fi
    return;
  fi

  # Error if not a file
  if [ -e "${_snapshotMetaDb}" ]; then
    _logWrapFn 'warn' "Metadb is not a regular file.";
    return 1;
  fi

  # Create file if needed
  touch "${_snapshotMetaDb}" || {
    _logWrapFn 'err' 'Could not create snapshot metadb!';
    return 1;
  }
  chmod '0644' "${_snapshotMetaDb}" || {
    _logWrapFn 'err' 'Failed to set permissions on snapshot metadb!';
    return 1;
  }
}
## . END private _createCheckMetadbFn }

## BEGIN private _checkDirListFn {
_checkDirListFn () {
  declare _good_count _dir_list _loop_dir;
  _good_count=0;
  readarray -t -d'|' _dir_list < <(echo -n "${1:-}");
  for _loop_dir in "${_dir_list[@]}"; do
    if [ -d "${_loop_dir}" ]; then (( _good_count++ )); fi
  done
  echo "${_good_count}";
}
## . END private _checkDirListFn }

## BEGIN private _checkMainUnallocSpaceFn {
_checkMainUnallocSpaceFn () {
  declare _main_min_unalloc _main_unalloc;

  _main_min_unalloc="$(_getMainMinUnallocFn)";
  _main_unalloc="$(_getMainUnallocSpaceFn)";

  # Warn all users if main unallocated space is below minimum
  if (( _main_unalloc < _main_min_unalloc )); then
    _logWrapFn 'err' 'Main filesystem space is low!';
    return 1;
  else
    return 0;
  fi
}
## . END private _checkMainUnallocSpaceFn }

## BEGIN private _checkRootFn {
_checkRootFn () {
  [ "$(id -u)" = 0 ] || return 1;
}
## . END private _checkRootFn }

## BEGIN private _checkSetFlockFn {
# Summary   : _checkSetFlockFn;
# Purpose   : Set file lock for this executable.
#   Use this to prevent multiple instances from running.
# Example   : while ! _checkSetFlockFn; sleep 1; done
# Arguments : none
# Globals   : _lockDir, lockFile, _trapExitFn
# Outputs   : Messages to STDERR
# Returns   : 1 - Cannot get lock; recoverable by waiting
#           : 2 - Unrecoverable error
#           : 0 - Success
# Throws    : none
#
_checkSetFlockFn () {
  # Create the lock dir if possible. If this fails, it's almost certainly
  # because something already created the lock dir, so we can ignore the
  # failure. No checking is done in advance because it wouldn't make any
  # functional difference and wouldn't be reliable because of an unavoidable
  # time-of-check-to-time-of-use condition.
  install -m 777 -d "${_lockDir}" 2>/dev/null || true
  if ! [ -e "${_lockFile}" ]; then
    install -m 666 /dev/null "${_lockFile}" || {
      _logWrapFn 'err' "Could not install |${_lockFile}|!";
      return 2;
    }
  fi
  exec 211>"${_lockFile}" || {
    _logWrapFn 'err' 'Lock file permission denied!';
    return 2;
  };
  flock -n -e 211 || {
    _logWrapFn 'info' "Cannot get lock on |${_lockFile}|!";
    return 1;
  }
  # Trap unexpected exits to show warnings if needed
  trap _trapExitFn EXIT;
}
## . END private _checkSetFlockFn }

## BEGIN private _createSnapshotFn {
_createSnapshotFn () {
  declare _snapshot_event_type _timestamp_str _prev_timestamp_str \
    _snapshot_path _boot_snapshot_path _hour_seconds _week_seconds;

  _snapshot_event_type="${1:-}"
  _hour_seconds=3600;
  _week_seconds=604800;

  # If a pre-existing snapshot ID is generated, sleep one second and retry
  while true; do
    _timestamp_str="$(date +%s)";
    _snapshot_path="${_rb2MainSnapshotDir}/@${_timestamp_str}";
    _boot_snapshot_path="${_rb2BootSnapshotDir}/@${_timestamp_str}";

    if [ -e "${_snapshot_path}" ] || [ -e "${_boot_snapshot_path}" ]; then
      sleep 1;
      continue;
    fi
    break;
  done

  # Get timestamp of most recent existing snapshot
  _prev_timestamp_str="$(
    _cm2LsFn "${_rb2MainSnapshotDir}" \
      | sed 's/@//' | sort -n | tail -n1
  )";

  # Disallow automatic snapshots when insufficient time has passed, OEM
  # configuration mode is active, or automatic snapshots are turned off
  case "${_snapshot_event_type}" in
    'Apt')
      if (( ( _timestamp_str - _prev_timestamp_str ) < _hour_seconds )); then
        _logWrapFn 'notice' 'Too little time has elapsed for another snapshot.';
        return 0;
      fi
      if [ -d '/oem' ]; then
        _logWrapFn 'notice' 'Cannot create apt snapshot in OEM configuration mode.';
        return 0;
      fi
      if [ "${_btrfsStatus}" = 'SUPPORTED, MANUAL' ]; then
        _logWrapFn 'notice' 'Cannot create apt snapshot in manual snapshot mode.';
        return 0;
      fi
      ;;
    'Timed')
      if (( ( _timestamp_str - _prev_timestamp_str ) < _week_seconds )); then
        _logWrapFn 'notice' 'Too little time has elapsed for another snapshot.';
        return 0;
      fi
      if [ -d '/oem' ]; then
        _logWrapFn 'notice' 'Cannot create timed snapshot in OEM configuration mode.';
        return 0;
      fi
      if [ "${_btrfsStatus}" = 'SUPPORTED, MANUAL' ]; then
        _logWrapFn 'notice' 'Cannot create timed snapshot in manual snapshot mode.';
        return 0;
      fi
      ;;
  esac

  # Save snapshot creation reason in the metadata database.
  _writeMetadbFn "@${_timestamp_str}" 'reason' "${_snapshot_event_type}";

  # Snapshot and sync main and boot filesystems
  "${_btrfsExe}" subvolume snapshot -r "${_rb2MainDir}/@" "${_snapshot_path}" || {
    _logWrapFn 'emerg' "Could not create snapshot |${_snapshot_path}|";
    return 2;
  }
  "${_btrfsExe}" filesystem sync "${_rb2MainDir}" || {
    _logWrapFn 'emerg' 'Failed to sync main filesystem!';
    return 2;
  }
  "${_btrfsExe}" subvolume snapshot -r "${_rb2BootDir}/@boot" "${_boot_snapshot_path}" || {
    _logWrapFn 'emerg' "Could not create boot snapshot |${_boot_snapshot_path}|";
    return 2;
  }
  "${_btrfsExe}" filesystem sync "${_rb2BootDir}" || {
    _logWrapFn 'emerg' 'Failed to sync boot filesystem!';
    return 2;
  }
  sync;

  _logWrapFn 'notice' "Snapshot |@${_timestamp_str}| created.";
}
## . END private _createSnapshotFn }

## BEGIN private _defragmentFn {
# Summary   : _defragmentFn
# Purpose   : Defragments heavily fragmented files on the main filesystem,
#             improving performance and reclaiming unreachable space.
# Example   : _defragmentFn
# Arguments : none
# Globals   : none
# Outputs   : none
# Returns   : none
# Throws    : none
#
_defragmentFn () {
  declare _frag_report _frag_count_list _target_frag_list _frag_file_list \
    _defrag_file_list _report_idx _btdu_report _btdu_val_list \
    _btdu_file_list _file_size _unreachable_size _clean_file_list \
    _defrag_list_idx _merge_yn _clean_list_idx _current_file;

  # Get report of file fragmentation on main filesystem, sorted by excessive
  # fragments
  _frag_report="$(_getMainFragReportFn)" || {
    _logWrapFn 'err' 'Defragment operation halted, could not get main frag report!';
    return;
  }
  _frag_report="$(sort -nr <<< "${_frag_report}")";

  # Split fragmentation report into frag count, ideal frag count, and files
  readarray -t _frag_count_list  < <(cut -d'|' -f2 <<< "${_frag_report}");
  readarray -t _target_frag_list < <(cut -d'|' -f3 <<< "${_frag_report}");
  readarray -t _frag_file_list   < <(cut -d'|' -f4 <<< "${_frag_report}");

  # Get list of all files with more fragments than ideal
  _defrag_file_list=();
  for (( _report_idx=0; _report_idx < ${#_frag_file_list[@]}; \
    _report_idx++ )); do
    _current_file="${_frag_file_list[_report_idx]}";

    if [ -f "${_current_file}" ]; then
      if (( _frag_count_list[_report_idx] > \
        _target_frag_list[_report_idx] )); then
        _defrag_file_list+=( "${_current_file}" );
      fi
    fi
  done

  # Trim list count to 50
  if (( ${#_defrag_file_list[@]} > 50 )); then
    _defrag_file_list=( "${_defrag_file_list[@]:0:50}" );
  fi

  # Get report of unreachable space, sorted by quantity
  _btdu_report="$(_getMainBtduReportFn)" || {
    _logWrapFn 'err' 'Defragment operation halted, could not get main btdu report!';
    return;
  }
  _btdu_report="$(
      grep '<UNREACHABLE>' <<< "${_btdu_report}" \
      | sort -nr \
      | sed 's|/<SINGLE>/<DATA>/<UNREACHABLE>||; /<ERROR>/d'
  )";

  # Split report into unreachable space and files
  readarray -t _btdu_val_list < <(cut -f1 <<< "${_btdu_report}");
  readarray -t _btdu_file_list < <(cut -f2 <<< "${_btdu_report}");

  # Get list of all files with unreachable space greater than 15% of file size
  _clean_file_list=();
  for (( _report_idx=0; _report_idx < ${#_btdu_val_list[@]}; \
    _report_idx++ )); do
    _current_file="${_btdu_file_list[_report_idx]}";

    if [ -f "${_current_file}" ]; then
      _file_size="$(du -b "${_current_file}" | cut -f1)";
      (( _unreachable_size = _btdu_val_list[_report_idx] * 1024 ));

      if [ "$(bc -l <<< "scale=2; (${_unreachable_size} / ${_file_size}) > 0.15")" \
        = '1' ]; then
        _clean_file_list+=( "${_current_file}" );
      fi
    fi
  done

  # Trim list count to 50
  if (( ${#_clean_file_list[@]} > 50 )); then
    _clean_file_list=( "${_clean_file_list[@]:0:50}" );
  fi

  # Find all items in defrag list not in clean list, and add to clean list
  for (( _defrag_list_idx=0; _defrag_list_idx < "${#_defrag_file_list[@]}"; \
    _defrag_list_idx++ )); do
    _current_file="${_defrag_file_list[_defrag_list_idx]}";
    _merge_yn='y';
    for (( _clean_list_idx=0; _clean_list_idx < "${#_clean_file_list[@]}"; \
      _clean_list_idx++ )); do
      if [ "${_current_file}" = "${_clean_file_list[_clean_list_idx]}" ]; then
        _merge_yn='n';
        break;
      fi
    done

    if [ "${_merge_yn}" = 'y' ]; then
      _clean_file_list+=( "${_current_file}" );
    fi
  done

  # Defragment all files in clean list, use lzo compression
  if (( ${#_defrag_file_list[@]} > 0 )); then
    "${_btrfsExe}" filesystem defragment -clzo "${_clean_file_list[@]}" || {
      _logWrapFn 'emerg' 'Defragment operation failed!';
      return 2;
    }
  fi

  _logWrapFn 'notice' \
    "Defragmented |${#_defrag_file_list[@]}| files on main filesystem.";
}
## . END private _defragmentFn }

## BEGIN private _deleteAllSnapshotsFn {
# Summary   : _deleteAllSnapshotsFn
# Purpose   : Deletes all rollback snapshots on the system, including pinned
#             snapshots.
# Example   : _deleteAllSnapshotsFn
# Arguments : none
# Globals   : none
# Outputs   : none
# Returns   : 0 on success, 1 on failure
# Throws    : none
#
_deleteAllSnapshotsFn () {
  declare _snapshot_list _current_snapshot _is_pinned;

  # Get list of snapshots
  readarray -t _snapshot_list < <(
    _cm2LsFn "${_rb2MainSnapshotDir}" 2>/dev/null
  );

  # Return if no snapshots exist
  if [ "${#_snapshot_list[@]}" = '0' ] || [ -z "${_snapshot_list[0]}" ]; then
    _logWrapFn 'warn' 'No snapshots found.';
    return 0;
  fi

  # Delete each snapshot, unpinning if needed
  for _current_snapshot in "${_snapshot_list[@]}"; do
    # Read failure here is almost impossible: It will succeed even if missing
    # file, group, or key. Only weird edge cases should trigger a return.
    _is_pinned="$(_readMetadbFn "${_current_snapshot}" 'pinned')" || {
      _logWrapFn 'err' 'Could not delete all snapshots, failed to read pin status!';
      return 1;
    }
    if [ "${_is_pinned}" = 'y' ]; then
      # Write failure here is almost impossible similar to _writeMetadbFn.
      # See note there.
      _writeMetadbFn "${_current_snapshot}" 'pinned' 'n';
    fi
    _deleteSnapshotFn "${_current_snapshot}" || {
      _logWrapFn 'alert' "Could not delete all snapshots, failed to delete snasphot |${_current_snapshot}|!";
      return 2;
    }
  done

  _logWrapFn 'notice' 'All snapshots deleted.';
}
## . END private _deleteAllSnapshotsFn }

## BEGIN private _deleteSnapshotFn {
_deleteSnapshotFn () {
  declare _target_snapshot_id _snapshot_dir _boot_snapshot_dir _is_pinned;

  # Ensure target snapshot exists
  _target_snapshot_id="${1:-}";
  if [ -z "${_target_snapshot_id}" ]; then
    _logWrapFn 'err' 'No snapshot ID provided to delete!';
    return 1;
  fi

  # This intentionally does not have the @ before ${_target_snapshot_id} because
  # the function is passed a snapshot name, not just a timestamp.
  _snapshot_dir="${_rb2MainSnapshotDir}/${_target_snapshot_id}";
  _boot_snapshot_dir="${_rb2BootSnapshotDir}/${_target_snapshot_id}";

  # Ensure that either the main or boot or both BTRFS snapshots are present
  if ! [ -e "${_snapshot_dir}" ] && ! [ -e "${_boot_snapshot_dir}" ]; then
    _logWrapFn 'err' 'Snapshot deletion request points to a non-existent snapshot!';
    return 1;
  fi

  # Refuse deleting a pinned snapshot
  _is_pinned="$(_readMetadbFn "${_target_snapshot_id}" 'pinned')" || {
    _logWrapFn 'err' 'Failed to delete snapshot, could not read pin status from metadb!';
    return 1;
  }
  if [ "${_is_pinned}" = 'y' ]; then
    _logWrapFn 'err' 'Cannot delete a pinned snapshot!';
    return 1;
  fi

  # Delete both BTRFS snapshots, taking into account there may only be one
  if [ -e "${_snapshot_dir}" ]; then
    "${_btrfsExe}" subvolume delete --commit-after "${_snapshot_dir}" || {
      _logWrapFn 'emerg' \
        "Failed to delete main BTRFS snapshot |${_snapshot_dir}|!";
      return 2;
    }
  fi
  if [ -e "${_boot_snapshot_dir}" ]; then
    "${_btrfsExe}" subvolume delete --commit-after "${_boot_snapshot_dir}" || {
      _logWrapFn 'emerg' \
        "Failed to delete boot BTRFS snapshot |${_boot_snapshot_dir}|!";
      return 2;
    }
  fi

  # Ensure any and all snapshot metadata is deleted
  _writeMetadbFn "${_target_snapshot_id}" 'name' '';
  _writeMetadbFn "${_target_snapshot_id}" 'desc' '';
  _writeMetadbFn "${_target_snapshot_id}" 'pinned' '';
  _writeMetadbFn "${_target_snapshot_id}" 'reason' '';

  _logWrapFn 'notice' "Deleted snapshot |${_target_snapshot_id}|.";
}
## . END private _deleteSnapshotFn }

## BEGIN private _exitCleanFn {
# Summary   : _exitCleanFn <_int>;
# Purpose   : Unset traps for exit and then do so.
# Example   : _exitCleanFn 1;
# Arguments : <_int>
# Globals   : _cm2*
# Outputs   : none
# Returns   : Exit code <_int>
# Throws    : none
#
_exitCleanFn () {
  declare _int;
  _int="$(_cm2EchoIntFn "${1:-0}")";
  trap '' EXIT;
  # If the lock file is deleted after a parallel kfocus-rollback-backend
  # process opens it, but before it locks it, this will cause two parallel
  # kfocus-rollback-backend processes to be able to execute, which is very
  # bad.
  # rm "${_lockFile}" || true;
  exit "${_int}";
}
## . END private _exitCleanFn }

## BEGIN private _getBootMinUnallocFn {
_getBootMinUnallocFn () {
  # Return number of bytes in 1 GiB
  echo 1073741824;
}
## . END private _getBootMinUnallocFn }

## BEGIN private _getBootUnallocSpaceFn {
_getBootUnallocSpaceFn () {
  # Extract unallocated space from boot filesystem report
  LC_ALL=C "${_btrfsExe}" filesystem usage -b "${_rb2BootDir}" \
    | awk '/Device unallocated/{ print $3 }';
}
## . END private _getBootUnallocSpaceFn }

## BEGIN private _getBootUsageReportFn {
_getBootUsageReportFn () {
  _checkBtrfsStatusSetUpFn || _logExitFn 'notice' '0' \
    'BTRFS status is incompatible with getting a boot usage report.';
  LC_ALL='C' "${_btrfsExe}" filesystem usage -b "${_rb2BootDir}";
}
## . END private _getBootUsageReportFn }

## BEGIN private _getMainBtduReportFn {
_getMainBtduReportFn () {
  _checkBtrfsStatusSetUpFn || _logExitFn 'notice' '0' \
    'BTRFS status is incompatible with getting a main btdu report.';
  LC_ALL='C' "${_btduExe}" --du --min-resolution=1M --headless "${_rb2MainDir}"
}
## . END private _getMainBtduReportFn }

## BEGIN private _getMainFragReportFn {
_getMainFragReportFn () {
  _checkBtrfsStatusSetUpFn || _logExitFn 'notice' '0' \
    'BTRFS status is incompatible with getting a main file fragmentation report.';
  "${_filefragExe}" "${_rb2MainDir}/@";
}
## . END private _getMainFragReportFn }

## BEGIN private _getMainMinUnallocFn {
_getMainMinUnallocFn () {
  # Calculate main filesystem size, return 15% of that
  echo "$(( $(LC_ALL=C "${_btrfsExe}" filesystem usage -b "${_rb2MainDir}" \
    | grep $'Device size:\t' \
    | awk '{ print $3 }' \
    ) * 15 / 100 ))";
}
## . END private _getMainMinUnallocFn }

## BEGIN private _getMainUnallocSpaceFn {
_getMainUnallocSpaceFn () {
  # Extract unallocated space from main filesystem report
  LC_ALL=C "${_btrfsExe}" filesystem usage -b "${_rb2MainDir}" \
    | awk '/Device unallocated/{ print $3 }';
}
## . END private _getMainUnallocSpaceFn }

## BEGIN private _getMainUsageReportFn {
_getMainUsageReportFn () {
  _checkBtrfsStatusSetUpFn || _logExitFn 'notice' '0' \
    'BTRFS status is incompatible with getting a main usage report.';
  LC_ALL='C' "${_btrfsExe}" filesystem usage -b "${_rb2MainDir}";
}
## . END private _getMainUsageReportFn }

## BEGIN private _getManualSwitchStateFn {
# Summary   : _getManualSwitchStateFn
# Purpose   : This internal call is used by the public methods
#             _getManualSwitchStatePublicFn and _checkBtrfsStatusFn.
#
_getManualSwitchStateFn () {
  declare _manual_state_str;

  _manual_state_str="$(_readMetadbFn 'global' 'manualSwitchState')" || {
    _logWrapFn 'err' 'Could not read manual switch state from metadb!';
    return 1;
  }

  if [ -z "${_manual_state_str}" ]; then
    _manual_state_str='MANUAL';
  fi

  if [ "${_manual_state_str}" != 'MANUAL' ] \
    && [ "${_manual_state_str}" != 'AUTO' ]; then
    _logWrapFn 'err' 'Manual switch state is not auto or manual!';
    return 1;
  fi

  echo "${_manual_state_str}";
}
## . END private _getManualSwitchStateFn }

## BEGIN private _getSnapshotReasonFn {
_getSnapshotReasonFn () {
  declare _snapshot_id _snapshot_reason_file _snapshot_reason_raw \
    _snapshot_reason;

  _snapshot_id="${1:-}";
  _snapshot_reason_file="${_rb2MainSnapshotDir}/${_snapshot_id}";
  _snapshot_reason_file+='/var/lib/kfocus/rollback_snapshot_reason';

  if [ -z "${_snapshot_id}" ]; then
    _logWrapFn 'warn' 'Invalid argument, cannot get snapshot reason';
    return 1;
  fi

  _snapshot_reason_raw="$(_readMetadbFn "${_snapshot_id}" 'reason')" || {
    _logWrapFn 'err' 'Could not read snapshot reason from metadb!'
    return 1;
  }

  # Migrate reason to metadb if stored old-style inside the snapshot
  if [ -z "${_snapshot_reason_raw}" ]; then
    if [ -f "${_snapshot_reason_file}" ]; then
      _snapshot_reason_raw="$(cat "${_snapshot_reason_file}")";
    else
      _snapshot_reason_raw='';
    fi
    _writeMetadbFn "${_snapshot_id}" 'reason' "${_snapshot_reason_raw}" || {
      _logWrapFn 'err' 'Could not migrate snapshot reason to metadb!';
      return 1;
    }
  fi

  case "${_snapshot_reason_raw}" in
    'Apt')
      _snapshot_reason='Before Package Change';
      ;;
    'Timed')
      _snapshot_reason='System Schedule';
      ;;
    'Pre-Rollback')
      _snapshot_reason='Pre-Rollback';
      ;;
    *) # must be user-generated
      _snapshot_reason="User Snapshot (${_snapshot_reason_raw})";
      ;;
  esac

  echo "${_snapshot_reason}";
}
## . END private _getSnapshotReasonFn }

## BEGIN private _logExitFn {
# Summary   : _logExitFn _log_level _exit_int _msg
# Purpose   : Logs information to the syslog and then immediately exits.
# Example   : _logExitFn 'ERR' 'Something went wrong!'
# Arguments :
#   _log_level - A string representing the log level to use. One of 'debug',
#                'info', 'notice', 'warning', 'err', 'crit', 'alert', or
#                'emerg'. See `man 3 syslog` for information on the meanings
#                of these codes.
#   _exit_int  - The code to exit with.
#   _msg       - The message to log.
# Globals   : _cm2*
# Outputs   : Writes to syslog
# Returns   : none, exits the script with the code given in _exit_int
# Throws    : none
#
_logExitFn () {
  declare _log_level _exit_int _msg _do_call_stack _stack_str

  _log_level="${1:-}";
  _exit_int="$(_cm2EchoIntFn "${2:-0}")";
  _msg="${3:-}";
  _do_call_stack='n';

  if [ "$$" != "$BASHPID" ]; then
    _logWrapFn 'alert' '_logExitFn was called from a subshell!';
    _do_call_stack='y';
  elif [ "${_exit_int}" != '0' ]; then
    _do_call_stack='y';
  fi

  if [ -n "${_msg}" ]; then
  _logWrapFn "${_log_level}" "${_msg}";
  fi

  if [ "${_do_call_stack}" = 'y' ]; then
    _stack_str="$(_cm2EchoStackFn 2>&1)";
    _logWrapFn "${_log_level}" "Call Stack: |${_stack_str}|";
  fi

  _exitCleanFn "${_exit_int}";
}
## . END private _logExitFn }

## BEGIN private _logWrapFn {
# Purpose : Log to syslog if available, or stderr otherwise
_logWrapFn () {
  declare _priority_key _message;
  _priority_key="${1:-warn}";
  _message="${2:-Unspecified issue}";
  if [ "$(type -t '_cm2LogFn')" = 'function' ]; then
    # We assume this will echo to STDERR and syslog
    _cm2LogFn "${_priority_key}" "${_message}";
  else
    1>&2 echo "${_baseName} - ${_priority_key}: ${_message}";
  fi
}
## . END private _logWrapFn }

## BEGIN private _promptAllUsersFn {
# Summary   : _promptAllUsersFn _mode_str _msg_str
# Purpose   : Displays a graphical message to all users with an active
#             graphical login
# Example   : _promptAllUsersFn 'error' 'An error has occurred!'
# Arguments :
#   _mode_str - What kind of message to display, see package-main ->
#     kfocus-focusrx-dbus-dispatch for accepted values. Examples
#     at time of writing include info, warning, error,
#     rollbackLowMainSpace, and rollbackLowBootSpace.
#   _msg_str - The message to display to the user.
# Globals   : DISPLAY, DBUS_SESSION_BUS_ADDRESS
# Outputs   : none
# Returns   : 0 - success
# Throws    : none
#
# See https://stackoverflow.com/a/49533938
_promptAllUsersFn () {
  declare _mode _msg _xserver_id _user_name;
  _mode="${1:-info}";
  _msg="${2:-blank}";

  # Get all running X servers
  while read -r _xserver_id; do
    # Determine username of one graphically logged-in user
    _user_name="$(
      who | grep "(:${_xserver_id})" | head -n1 | awk '{ print $1 }'
    )";
    if [ -z "${_user_name}" ]; then continue; fi

    # Switch to the user and send a D-Bus message to their corresponding
    # kfocus-focusrx-dbus-dispatch process
    sudo -u "${_user_name}" \
      DISPLAY="${_xserver_id}" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "${_user_name}")/bus" \
      qdbus org.kfocus.FocusRxDispatch.launcher / "${_mode}" "${_msg}";
  done < <(_cm2LsFn '/tmp/.X11-unix/' | sed 's?X??');
}
## . END private _promptAllUsersFn }

## BEGIN private _readBootFsFn {
_readBootFsFn () {
  LC_ALL='C' mount | grep btrfs | grep ' on /boot ' \
    | cut -d' ' -f1;
}
## . END private _readBootFsFn }

## BEGIN private _readMainFsFn {
_readMainFsFn () {
  LC_ALL='C' mount | grep btrfs | grep ' on / ' \
    | cut -d' ' -f1;
}
## . END private _readMainFsFn }

## BEGIN private _readMetadbFn {
# Summary   : _readMetadbFn _group_str _key_str
# Purpose   : Reads a value from the kfocus-rollback snapshot metadata
#             database (metadb).
# Example   : _readMetadbFn '@1234' 'name'
# Arguments :
#   _group_str - The data group in which the value should be found.
#      Often, our groups are named after snapshot IDs, e.g. '@1234'.
#   _key_str - The key associated with the desired data.
#   IMPORTANT: If either a group or key does not exist, an empty string
#     is returned. It is NOT an error condition. This routine also
#     creates an empty metadb file if it does not already exist.
# Globals   : _snapshotMetaDb
# Outputs   : A string representing the desired data. Note that for data
#             representing user-defined strings, this will always be
#             base64-encoded.
# Returns   : 0 on success, 2 on failure (meaning metadb error)
# Throws    : none
#
_readMetadbFn () {
  declare _group_str _key_str _err_msg;

  _group_str="${1:-}";
  _key_str="${2:-}";
  _err_msg='Cannot read metadb: ';

  if ! [ -d "${_rb2MainDir}" ]; then
    _logWrapFn 'err' "${_err_msg} No main dir |${_rb2MainDir}|";
    return 2;
  fi

  [ -n "${_group_str}" ] || {
    _logWrapFn 'err' "${_err_msg} No group string provided.";
    return 2;
  }

  [ -n "${_key_str}" ] || {
    _logWrapFn 'err' "${_err_msg} No key string provided.";
    return 2;
  }

  if ! _checkCreateMetadbFn; then
    _logWrapFn 'err' "${_err_msg} Metadb is not a valid file.";
    return 2;
  fi

  # Read failure here is almost impossible: It will succeed even if
  # the file cannot be created, or group or key is bad.
  # Only weird edge cases like perhaps a bad value can trigger exit.
  "${_kreadconfig5Exe}" \
    --file "${_snapshotMetaDb}" \
    --group "${_group_str}" \
    --key "${_key_str}" || {
      _logWrapFn 'err' "${_err_msg} |${_group_str}:${_key_str}|";
      return 2;
    }
}
## . END private _readMetadbFn }

## BEGIN private _trapExitFn {
_trapExitFn () {
  1>&2 echo "${_baseName} was interrupted";
  if [ "${_isPreparingSystem}" = 'y' ]; then
    _promptAllUsersFn 'error' "${_prepareFailMsg}";
  fi
  # If the lock file is deleted after a parallel kfocus-rollback-backend
  # process opens it, but before it locks it, this will cause two parallel
  # kfocus-rollback-backend processes to be able to execute, which is very
  # bad.
  # rm "${_lockFile}" || true;
}
## . END private _trapExitFn }

## BEGIN private _writeMetadbFn {
# Summary   : _writeMetadbFn _group_str _key_str _val_str
# Purpose   : Writes a value to or deletes a value from the kfocus-rollback
#             snapshot metadata database (metadb).
# Example   : _writeMetadbFn '@1234' 'name' 'bmV3IG5hbWU='
# Arguments :
#   _group_str - The data group in which the value should be written.
#      Often, our groups are named after snapshot IDs, e.g. '@1234'.
#   _key_str   - The key to associate with the provided data.
#   _val_str   - The string to be stored. If blank, delete the key.
# Globals   : _snapshotMetaDb
# Outputs   : none
# Returns   : 0 on success, 2 on failure (meaning metadb error)
# Throws    : none
#
_writeMetadbFn () {
  declare _group_str _key_str _val_str _err_msg _fail_msg _cmd_list;

  _group_str="${1:-}";
  _key_str="${2:-}";
  _val_str="${3:-}";
  _err_msg='Cannot write to metadb: ';

  if ! [ -d "${_rb2MainDir}" ]; then
    _wrapLogFn 'err' "${_err_msg} No main dir |${_rb2MainDir}|";
    return 2;
  fi

  if [ -z "${_group_str}" ]; then
    _wrapLogFn 'err' "${_err_msg} No group string provided.";
    return 2;
  fi

  if [ -z "${_key_str}" ]; then
    _wrapLogFn 'err' "${_err_msg} No key string provided.";
    return 2;
  fi

  if ! _checkCreateMetadbFn; then
    _logWrapFn 'err' "${_err_msg} Metadb is not a valid file.";
    return 2;
  fi

  _cmd_list=( "${_kwriteconfig5Exe}"
    '--file'  "${_snapshotMetaDb}"
    '--group' "${_group_str}"
    '--key'    "${_key_str}"
  );

  if [ -z "${_val_str}" ]; then
    _cmd_list+=( '--delete' );
    _fail_msg="Failed to delete key |${_key_str}|";
  else
    _cmd_list+=( "${_val_str}" );
    _fail_msg="Failed to write |${_key_str}:${_val_str}|";
  fi

  # Write to metadb. Since we already checked for file and permissions,
  #   and non-existent key or groups are supported, failure here should
  #   be nearly impossible.
  "${_cmd_list[@]}" || {
    _logWrapFn 'err' "${_err_msg} ${_fail_msg}";
    return 2;
  }
}
## . END private _writeMetadbFn }
