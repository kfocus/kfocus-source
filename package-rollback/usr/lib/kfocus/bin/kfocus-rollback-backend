## BEGIN _getManualSwitchStatePublicFn {
# Summary   : _getManualSwitchStatePublicFn
# Purpose   : Reads the manual switch state from the snapshot metadb. This
#             value indicates whether kfocus-rollback is taking automatic
#             snapshots or not.
# Example   : _getManualSwitchStatePublicFn
# Arguments : none
# Globals   : _snapshotMetaDb
# Outputs   :
#   If automatic snapshotting is enabled, outputs 'AUTO'.
#   If automatic snapshotting is NOT enabled, outputs 'MANUAL'.
# Returns   : none
# Throws    : 0 - _checkBtrfsStatusSetUpFn check failed.
#             1 - _getManualSwitchStateFn state not MANUAL or AUTO.
#
_getManualSwitchStatePublicFn () {
  # Both exit on failure per "Throws", above.
  _checkBtrfsStatusSetUpFn || _logExitFn 'notice' '0' \
    'BTRFS status is incompatible with getting the manual switch state.';
  _getManualSwitchStateFn || _logExitFn 'err' '1' \
    'Could not get manual switch state!';
}
