## BEGIN _btrfsDeepCleanPublicFn {
# Summary   : _btrfsDeepCleanPublicFn
# Purpose   : Runs an intensive BTRFS optimization routine. Currently, this
#             balances main and boot filesystems (forcing a balance on the
#             main FS), and defragments the main filesystem.
# Example   : _btrfsDeepCleanPublicFn
# Arguments : none
# Globals   : none
# Outputs   : none
# Returns   : none
# Throws    :
#   0 - _checkRootFn check failed, or _checkBtrfsStatusSetUpFn check failed.
#   2 - Main or boot filesystem balance failed, or main filesystem defrag
#     failed.
#
#
_btrfsDeepCleanPublicFn () {
  _checkRootFn             || _logExitFn 'notice' '0' \
    'BTRFS deep cleaning requires root permissions.';
  _checkBtrfsStatusSetUpFn || _logExitFn 'notice' '0' \
    'BTRFS status prevents BTRFS deep cleaning.';

  _logWrapFn 'notice' "BTRFS deep clean operation started.";
  _deleteAllSnapshotsFn    || _logExitFn 'alert' '2' \
    'Failed to delete all snapshots during BTRFS deep cleaning!';
  _balanceMainFn 'y'       || _logExitFn 'alert' '2' \
    'Failed to balance main filesystem during BTRFS deep cleaning!!';
  _balanceBootFn           || _logExitFn 'alert' '2' \
    'Failed to balance boot filesystem during BTRFS deep cleaning!';
  _defragmentFn            || _logExitFn 'alert' '2' \
    'Failed to defragment files during BTRFS deep cleaning!';
  _logWrapFn 'notice' "BTRFS deep clean operation complete.";
}
## . END _btrfsDeepCleanPublicFn }

## BEGIN _btrfsMaintainPublicFn {
# Summary   : _btrfsMaintainPublicFn
# Purpose   : Runs routine snapshot maintenance. Currently, this simply
#             balances main and boot filesystems.
# Example   : _btrfsMaintainPublicFn
# Arguments : none
# Globals   : none
# Outputs   : none
# Returns   : none
# Throws    :
#   0 - _checkRootFn check failed, or _checkBtrfsStatusSetUpFn check failed.
#   2 - Main or boot filesystem balance failed.
#
_btrfsMaintainPublicFn () {
  _checkRootFn             || _logExitFn 'notice' '0' \
    'BTRFS maintenance requires root permissions.';
  _checkBtrfsStatusSetUpFn || _logExitFn 'notice' '0' \
    'BTRFS status prevents BTRFS maintenance.';

  _logWrapFn 'notice' "Routine BTRFS maintenance started.";
  _balanceMainFn 'n'       || _logExitFn 'alert' '2' \
    'Failed to balance main filesystem!';
  _balanceBootFn           || _logExitFn 'alert' '2' \
    'Failed to balance boot filesystem!';
  _logWrapFn 'notice' "Routine BTRFS maintenance complete.";
}
## . END _btrfsMaintainPublicFn }

## BEGIN _checkBootUnallocSpacePublicFn {
# Summary   : _checkBootUnallocSpacePublicFn
# Purpose   : Same as _checkMainUnallocSpacePublicFn, but for the boot
#             filesystem rather than the main filesystem.
# Example   : _checkBootUnallocSpacePublicFn;
# Arguments : none
# Globals   : _lowBootMsg
# Outputs   : none
# Returns   : none
# Throws    :
#   0 - _checkBtrfsStatusSetUpFn check failed.
#   1 - Boot unallocated space is low.
#
_checkBootUnallocSpacePublicFn () {
  _checkBtrfsStatusSetUpFn || _logExitFn 'notice' '0' \
    'BTRFS status is not compatible with checking boot unallocated space.';
  if ! _checkBootUnallocSpaceFn; then
    _promptAllUsersFn 'rollbackLowBootSpace' "${_lowBootMsg}";
    _logExitFn 'err' '1' 'Low boot space detected.';
  fi
}
## . END _checkBootUnallocSpacePublicFn }

## BEGIN _checkMainUnallocSpacePublicFn {
# Summary   : _checkMainUnallocSpacePublicFn
# Purpose   : Ensures that the amount of unallocated space on the main
#             filesystem is greater than a minimum threshold. Exits the script
#             and displays a warning to all graphically logged-in users if the
#             check fails.
# Example   : _checkMainUnallocSpacePublicFn
# Arguments : none
# Globals   : _lowDiskMsg
# Outputs   : none
# Returns   : none
# Throws    :
#   0 - _checkBtrfsStatusSetUpFn check failed.
#   1 - Main unallocated space is low.
#
_checkMainUnallocSpacePublicFn () {
  _checkBtrfsStatusSetUpFn || _logExitFn 'notice' '0' \
    'BTRFS status is not compatible with checking main unallocated space.';

  if ! _checkMainUnallocSpaceFn; then
    _promptAllUsersFn 'rollbackLowMainSpace' "${_lowDiskMsg}";
    _logExitFn 'err' '1' 'Low disk space detected.';
  fi
}
## . END _checkMainUnallocSpacePublicFn }

## BEGIN _clearRestorePublicFn {
# Summary   : _clearRestorePublicFn
# Purpose   : Deletes a flag file indicating that the system has rebooted
#             after a successful snapshot restore
# Example   : clearRestoreFn
# Arguments : none
# Globals   : _cm2*
# Outputs   : none
# Returns   : none
# Throws    :
#   0 - Success
#   1 - Cannot remove restore-complete drop file
#
_clearRestorePublicFn () {
  rm -f "${_rb2RestoreCompleteFile}" \
    || _logExitFn 'err' '1' "Could not remove |${_rb2RestoreCompleteFile}|";
  _logWrapFn 'notice' 'Restore flag cleared.';
}
## . END _clearRestorePublicFn }

## BEGIN _compareStatePublicFn {
# Summary   : _compareSnapshotsFn dir1 dir2
# Purpose   : Compares two directories to each other using `diff -r --brief`.
#             Intended to be used for comparing two snapshots, or a snapshot
#             and the actively running system.
# Example   : _compareSnapshotsFn \
#             "${_rb2MainDir}/@kfocus-rollback-snapshots/@1234" \
#             "${_rb2MainDir}/@";
# Arguments :
#   dir1 - The directory containing the 'source' system state. This will
#     usually (but not always) be the path to a snapshot.
#   dir2 - The directory containing the 'target' system state. This will
#     usually (but not always) be the path to a newer snapshot or the current
#     system state.
#   Note that dir1 and dir2 could point to any two directories - dir1 may
#   point to a newer system state than dir2, or theoretically they could even
#   point to typical directories rather than system state directories.
# Globals   : none
# Outputs   : The `diff -r --brief` output resulting from diffing dir1 and
#             dir2.
# Returns   : none
# Throws    :
#   0 - Success
#   0? - _checkBtrfsStatusSetUpFn check failed, or _checkRootFn check
#     failed.
#   1 - One or both arguments are blank, or one of the specified
#     directories does not exist or is not a directory.
#
_compareStatePublicFn () {
  declare _source_state_dir _target_state_dir;

  _checkBtrfsStatusSetUpFn || _logExitFn 'notice' '0' \
    'BTRFS status prevents state comparison.';
  _checkRootFn || _logExitFn 'notice' '0' \
    'State comparison requires root permissions.';

  # Ensure source and target dirs actually exist
  _source_state_dir="${1:-}";
  [ -z "${_source_state_dir}" ] && _logExitFn 'err' '1' \
    'No source state dir provided to compare.';
  ! [ -d "${_source_state_dir}" ] && _logExitFn 'err' '1' \
    'Specified source state dir does not exist or is not a dir.';
  _target_state_dir="${2:-}";
  [ -z "${_target_state_dir}" ] && _logExitFn 'err' '1' \
    'No target state dir provided to compare.';
  ! [ -d "${_target_state_dir}" ] && _logExitFn 'err' '1' \
    'Specified target state dir does not exist or is not a dir.';

  # Diff directories, return filenames only
  "${_diffExe}" -r --brief "${_source_state_dir}" "${_target_state_dir}";
}
## . END _compareStatePublicFn }

## BEGIN _createSnapshotPublicFn {
# Summary   : _createSnapshotPublicFn snapshotReason
# Purpose   : Creates a rollback snapshot if necessary.
# Example   : _createSnapshotPublicFn 'Apt'
# Arguments :
#   snapshotReason - The "reason" to assign to the snapshot. This reason
#     indicates why the snapshot was taken, and is also used to determine
#     whether a snapshot actually should be taken or not. Possible values for
#     snapshotReason are:
#     Apt - The snapshot is being automatically created because the apt
#       packages on the system are being modified. The snapshot should not be
#       created if it has been less than an hour since the last snapshot, or
#       if the system is in OEM configuration mode.
#     Timed - The snapshot is being automatically created because a
#       maintenance timer has triggered. The snapshot should not be created if
#       it has been less than a week since the last snapshot, or if the system
#       is in OEM configuration mode.
#     Pre-Rollback - The snapshot is being created immediately before
#       restoring an existing snapshot.
#     Anything else - The snapshot is being created manually by the user. The
#       snapshot "reason" is assumed to be the username of the user taking the
#       snapshot.
# Globals   : _btrfsStatus
# Outputs   : none
# Returns   : none
# Throws    :
#   0 - checkBtrfsStatusSetUpFn check failed, or an automatic snapshot
#     creation request was denied due to insufficient elapsed time or OEM
#     configuration mode being active,
#   1 - _checkMainUnallocSpaceFn check failed, or _checkBootUnallocSpaceFn
#     check failed.
#   2 - One of the BTRFS snapshot creation commands failed, indicating
#     filesystem corruption or disk failure.
#
_createSnapshotPublicFn () {
  declare _return_code;

  _checkBtrfsStatusSetUpFn || _logExitFn 'notice' '0' \
    'BTRFS status prevents creating a snapshot.';
  _checkMainUnallocSpaceFn || _logExitFn 'err' '1' \
    'Main disk space is too low to take a snapshot.';
  _checkBootUnallocSpaceFn || _logExitFn 'err' '1' \
    'Boot disk space is too low to take a snapshot.';

  _createSnapshotFn "$@";
  _return_code="$?";

  if [ "${_return_code}" = '1' ]; then
    _logWrapFn 'notice' 'Coult not take a snapshot!';
  else
    _logExitFn 'alert' '2' 'A critical error occurred while taking a snapshot!';
  fi
}
## . END _createSnapshotPublicFn }

## BEGIN _deleteSnapshotPublicFn {
# Summary   : _deleteSnapshotPublicFn snapshotId
# Purpose   : Deletes a rollback snapshot from the system.
# Example   : _deleteSnapshotPublicFn '@1234'
# Arguments : snapshotId - The ID of the snapshot to delete.
# Globals   : none
# Outputs   : none
# Returns   : none
# Throws    :
#   0 - _checkBtrfsStatusSetUpFn check failed.
#   1 - No snapshot ID provided, specified snapshot does not exist, or
#     specified snapshot is pinned.
#   2 - One of the BTRFS snapshot deletion commands failed, suggesting
#     filesystem corruption or disk failure.
#
_deleteSnapshotPublicFn () {
  declare _return_code;

  _checkBtrfsStatusSetUpFn || _logExitFn 'notice' '0' \
    'BTRFS status is incompatible with deleting a snapshot.';

  _deleteSnapshotFn "$@";
  _return_code="$?";

  if [ "${_return_code}" = '1' ]; then
    _logExitFn 'err' '1' 'Could not delete snapshot!';
  elif [ "${_return_code}" = '2' ]; then
    _logExitFn 'alert' '2' 'A critical error occurred while deleting a snapshot!';
  fi
}
## . END _deleteSnapshotPublicFn }

## BEGIN _finalizeRestorePublicFn {
# Summary   : _finaliseRestoreFn
# Purpose   : Cleans up leftover subvolumes after a snapshot restore. The
#             restoration process leaves two subvolumes behind that are needed
#             during snapshot restoration, but that are unnecessary
#             once the system is rebooted after the restore is complete.
# Example   : _finalizeRestorePublicFn
# Arguments : none
# Globals   : none
# Outputs   : none
# Returns   : none
# Throws    :
#   0 - _checkBtrfsStatusSetUpFn check failed.
#   1 - The system has not been rebooted after a restore operation was
#     done, thus the "leftover" subvolumes are actually still in use and
#     cannot be deleted. 1 may also be thrown if one of the BTRFS snapshot
#     deletion commands failed, suggesting filesystem corruption or disk
#     failure.
#
_finalizeRestorePublicFn () {
  _checkBtrfsStatusSetUpFn || _logExitFn 'notice' '0' \
    'BTRFS status is incompatible with finalizing a restore process.';

  # Ensure system is not in post-restore pre-reboot state
  if ! mount | grep 'btrfs' | grep -q '@kfocus-rollback-working' \
    && ! mount | grep 'btrfs' | grep -q '@kfocus-rollback-working-boot'; then

    # Delete obsolete main working subvol made during restore
    if [ -d "${_rb2MainWorkingDir}" ]; then
      "${_btrfsExe}" subvolume delete \
        --commit-after "${_rb2MainWorkingDir}" \
        || _logExitFn 'emerg' '2' 'Failed to finalize restore for main filesystem!';
    fi

    # Delete obsolete boot working subvol made during restore
    if [ -d "${_rb2BootWorkingDir}" ]; then
      "${_btrfsExe}" subvolume delete \
        --commit-after "${_rb2BootWorkingDir}" \
        || _logExitFn 'emerg' '2' 'Failed to finalize restore for boot filesystem!';
    fi
  else
    _logExitFn 'err' '1' 'Cannot finalize restore, restore operation half-done!';
  fi
  _logWrapFn 'notice' 'Restore operation successfully finalized.';
}
## . END _finalizeRestorePublicFn }

