## BEGIN _getSnapshotListStrPublicFn {
# Summary   : _getSnapshotListStrPublicFn
# Purpose   : Gets a list of rollback snapshots on the system.
# Example   : _getSnapshotListStrPublicFn
# Arguments : none
# Globals   : _rb2MainSnapshotDir
# Outputs   : A newline-separated list of snapshot IDs formatted as '@1234',
#             where '1234' is the timestamp of the snapshot. The list is
#             sorted from newest to oldest.
# Returns   : none
# Throws    :
#   1 - BTRFS status is not SUPPORTED, AUTO or SUPPORTED, MANUAL.
#
_getSnapshotListStrPublicFn () {
  _checkBtrfsStatusSetUpFn || _logExitFn 'warn' '1' \
    'BTRFS status is incompatible with getting a list of snapshots!';

  # Return list of snapshots, sorted from newest to oldest
  _cm2LsFn "${_rb2MainSnapshotDir}" \
    | sed 's/@//' \
    | sort -nr \
    | sed 's/^/@/';
}
## . END _getSnapshotListStrPublicFn }

## BEGIN _getSnapshotMetadataPublicFn {
# Summary   : _getSnapshotMetadataPublicFn _snapshot_id _mode
# Purpose   : Gets metadata from a snapshot.
# Example   : _getSnapshotMetadataPublicFn '@1234' 'base'
# Arguments :
#   _snapshot_id - the ID of the snapshot to query.
#   _mode - Whether to get base or full metadata. Base snapshot metadata is
#     the snapshot's name, description, pin status, and reason. Full snapshot
#     metadata is the same as base metadata, but also includes snapshot size
#     in bytes.
# Globals   : none
# Outputs   :
#   Five newline-separated strings. Those strings are, in order output:
#     Name (base64-encoded)
#     Description (base64-encoded)
#     Pin status ('y' if pinned, 'n' otherwise)
#     Reason (plaintext)
#     Size (in bytes, value is blank if getting base snapshot metadata)
# Returns   : none
# Throws    :
#   1:
#     - BTRFS status is not SUPPORTED, AUTO or SUPPORTED, MANUAL,
#     - Insufficient arguments provided,
#     - Invalid mode argument provided,
#     - Specified snapshot does not exist,
#     - Failed to read snapshot metadb,
#     - Failed to get snapshot reason, or
#     - Failed to calculate snapshot size.
#
_getSnapshotMetadataPublicFn () {
  declare _snapshot_id _mode _item _metadata_str _snapshot_reason_str \
    _snapshot_size_report;

  _checkBtrfsStatusSetUpFn || _logExitFn 'warn' '1' \
    'BTRFS status is incompatible with getting snapshot metadata!';

  _snapshot_id="${1:-}";
  _mode="${2:-}";
  [ -z "${_snapshot_id}" ] && _logExitFn 'err' '1' 'No snapshot ID provided!';
  [ "${_mode}" != 'base' ] && [ "${_mode}" != 'full' ] \
    && _logExitFn 'err' '1' 'No mode or invalid mode provided!';
  [ -d "${_rb2MainSnapshotDir}/${_snapshot_id}" ] \
    || _logExitFn 'err' '1' 'The specified snapshot does not exist!'

  # Return snapshot name, description, pin status from snapshot metadb
  for _item in 'name' 'desc' 'pinned'; do
    _metadata_str="$(_readMetadbFn "${_snapshot_id}" "${_item}")" \
      || _logExitFn 'err' '1' 'Metadb read failure, could not get snapshot metadata!';
    echo "${_metadata_str}";
  done

  # Return human-readable snapshot reason
  _snapshot_reason_str="$(_getSnapshotReasonFn "${_snapshot_id}" \
    || _logExitFn 'err' '1' 'Could not get snapshot metadata, failed to get snapshot reason!')";
  if [ "${_snapshot_reason_str}" = 'Unknown (no reason found)' ]; then
    _logWrapFn 'warn' "Missing metadata entry for snapshot |${_snapshot_id}| in |${_snapshotMetaDb}|";
  fi
  echo "${_snapshot_reason_str}";

  # Calculate and return snapshot size if requested
  if [ "${_mode}" = 'full' ]; then
    _snapshot_size_report="$("${_btrfsExe}" 'filesystem' 'du' '--raw' '-s' \
      "${_rb2MainSnapshotDir}/${_snapshot_id}")" \
      || _logExitFn 'alert' '1' 'Could not calculate snapshot size!';
    tail -n1 <<< "${_snapshot_size_report}" | awk '{ print $2 }';
  else
    echo '';
  fi
}
## . END _getSnapshotMetadataPublicFn }

## BEGIN _getSnapshotReasonPublicFn {
# Summary   : _getSnapshotReasonPublicFn _snapshot_id
# Purpose   : A public wrapper around _getSnapshotReasonFn.
# Example   : _getSnapshotReasonPublicFn @1234
# Arguments : Same as _getSnapshotReasonFn
# Globals   : none
# Outputs   : Same as _getSnapshotReasonFn
# Returns   : none
# Throws    :
#   1:
#     - _getSnapshotReasonFn failed.
#
_getSnapshotReasonPublicFn () {
  _getSnapshotReasonFn "$@" \
    || _logExitFn 'err' '1' 'Could not get snapshot reason!';
}
## . END _getSnapshotReasonPublicFn }

## BEGIN _makeSnapshotDispIdPublicFn {
# Summary   : _makeSnapshotDispIdPublicFn _snapshot_id
# Purpose   : Generates a human-readable string that can be used to identify a
#             particular snapshot.
# Example   : _makeSnapshotDispIdPublicFn '@1234'
# Arguments : _snapshot_id - the ID of the snapshot to query.
# Globals   : _rb2MainSnapshotDir
# Outputs   :
#   A human-readable snapshot ID string, in the format
#     'snapshotName - Day YYYY-MM-DD 23:45'
# Returns   : none
# Throws    :
#   1:
#     - Insufficient arguments provided,
#     - Snapshot does not exist,
#     - Could not get snapshot name, or
#     - Could not get snapshot reason.
#
_makeSnapshotDispIdPublicFn () {
  declare _snapshot_id _snapshot_name _snapshot_datetime _snapshot_disp_id;

  _snapshot_id="${1:-}";

  if [ -z "${_snapshot_id}" ]; then
    _logExitFn 'err' '1' 'Invalid arguments, cannot generate snapshot display ID!';
  fi

  if ! [ -d "${_rb2MainSnapshotDir}/${_snapshot_id}" ]; then
    _logExitFn 'err' '1' 'Specified snapshot does not exist!';
  fi

  _snapshot_name="$(_readMetadbFn "${_snapshot_id}" 'name')" \
    || _logExitFn 'err' '1' 'Failed to make snapshot disp id, could not get snapshot name!';
  if [ -z "${_snapshot_name}" ]; then
    _snapshot_name="$(_getSnapshotReasonFn "${_snapshot_id}")" \
      || _logExitFn 'err' '1' 'Failed to make snapshot disp id, could not get snapshot reason!';
  else
    _snapshot_name="$(base64 -d <<< "${_snapshot_name}")";
  fi

  _snapshot_datetime="$(date -d "${_snapshot_id}" '+%a %F %H:%M')";
  _snapshot_disp_id="${_snapshot_name} — ${_snapshot_datetime}";
  echo "${_snapshot_disp_id}";
}
## . END _makeSnapshotDispIdPublicFn }

## BEGIN _prepareSystemPublicFn {
# Summary   : _prepareSystemPublicFn
# Purpose   : Prepares a system for rollback snapshots. The system must start
#             in the 'SUPPORTED, NOT SET UP' state, and will be transitioned
#             to the 'SUPPORTED, MANUAL' state.
# Example   : _prepareSystemPublicFn
# Arguments : none
# Globals   : _btrfsStatus, _rb2BootDir, _rb2MainDir, _rb2BootSNapshotDir,
#             _rb2MainSnapshotDir
# Outputs   : Log info
# Returns   : none
# Throws    :
#   1:
#     - Calling user is not root, or
#     - System cannot be safely prepared for snapshotting.
#   2:
#     - Something went wrong that prevents the setup process from
#       continuing. Changes have already been made to the system's
#       configuration.
#
_prepareSystemPublicFn () {
  declare _root_mount_id _boot_mount_id _btrfs_defaults_str \
    _dir _subvolume_list _subvolume_id _path;

  _checkRootFn || _logPrepareExitFn 'warn' '1' \
    'Preparing the system for snapshotting requires root permissions!';

  ## Begin STAGE 1: Check and prep filesystem {
  if [ "${_btrfsStatus}" = 'SUPPORTED, AUTO' ] \
    || [ "${_btrfsStatus}" = 'SUPPORTED, MANUAL' ]; then
    _logPrepareExitFn 'notice' '0' 'This system already appears snapshot-enabled.';
  fi

  if [ "${_btrfsStatus}" = 'UNSUPPORTED' ]; then
    _logPrepareExitFn 'err' '1' 'This system does not support snapshotting!';
  fi

  # Check libvirt dirs, if they have content do not proceed
  if [ -d '/etc/libvirt' ] || [ -d '/var/lib/libvirt' ]; then
    if [ -n "$(ls -A /etc/libvirt     2>/dev/null)" ] || \
       [ -n "$(ls -A /var/lib/libvirt 2>/dev/null)" ]; then
      _logPrepareExitFn 'err' '1' 'Cannot create libvirt subvols, libvirt is installed!';
    fi
  fi

  # systemd may create /var/lib/portables and /var/lib/machines BTRFS
  # subvolumes of its own accord if not configured otherwise. Ensure that
  # these are not present.
  "${_btrfsExe}" subvolume delete --commit-after '/var/lib/portables' || true;
  "${_btrfsExe}" subvolume delete --commit-after '/var/lib/machines'  || true;

  # Create directories
  for _dir in "${_rb2BootDir}" "${_rb2MainDir}" \
    '/etc/libvirt' '/var/lib/libvirt'; do
    mkdir -p "${_dir}" || _logPrepareExitFn 'crit' '2' "Cannot create directory |${_dir}|!";
  done;
  ## . End STAGE 1: Check and prep filesystem }

  ## Begin STAGE 2: Adjust fstab {
  _root_mount_id="$(LC_ALL=C mount | grep ' on / ' | cut -d' ' -f1)";
  _root_mount_id="UUID=$(LC_ALL=C lsblk -o NAME,FSTYPE,UUID,MOUNTPOINTS \
    "${_root_mount_id}" | sed -n '2p' | awk '{ print $3 }')";
  _boot_mount_id="UUID=$(LC_ALL=C lsblk -o NAME,FSTYPE,UUID,MOUNTPOINTS \
    | grep -P '/boot$' | awk '{ print $3 }')";
  _btrfs_defaults_str="defaults,noatime,autodefrag 0 0";

  echo "${_root_mount_id} ${_rb2MainDir} btrfs subvolid=5,${_btrfs_defaults_str}" \
    >> /etc/fstab || _logPrepareExitFn 'crit' '2' "Cannot create fstab line for |${_rb2MainDir}|!";
  echo "${_boot_mount_id} ${_rb2BootDir} btrfs subvolid=5,${_btrfs_defaults_str}" \
    >> /etc/fstab || _logPrepareExitFn 'crit' '2' "Cannot create fstab line for |${_rb2BootDir}|!";
  echo "${_root_mount_id} /etc/libvirt btrfs subvol=@libvirt-machines/@etc-libvirt,${_btrfs_defaults_str}" \
    >> /etc/fstab || _logPrepareExitFn 'crit' '2' 'Cannot create fstab line for |/etc/libvirt|!';
  echo "${_root_mount_id} /var/lib/libvirt btrfs subvol=@libvirt-machines/@var-lib-libvirt,${_btrfs_defaults_str}" \
    >> /etc/fstab || _logPrepareExitFn 'crit' '2' 'Cannot create fstab line for |/var/lib/libvirt|!';
  ## . End STAGE 2: Adjust fstab }

  ## Begin STAGE 3: Prepare /boot {
  # Unmount boot-related directories, so we can rearrange their contents
  umount /boot/efi || _logPrepareExitFn 'alert' '2' 'Failed to unmount |/boot/efi|!';
  umount /boot     || _logPrepareExitFn 'alert' '2' 'Failed to unmount |/boot|!';

  # Point fstab at a soon-to-be-created @boot subvolume
  sed -i '/\/boot /s/defaults/subvol=\/@boot,defaults/' /etc/fstab \
    || _logPrepareExitFn 'alert' '2' 'Failed to update fstab for |@boot|!';

  # Reload fstab changes
  systemctl daemon-reload;

  # Morph the layout of the boot partition
  mount "${_rb2BootDir}" || _logPrepareExitFn 'alert' '2' "Failed to mount |${_rb2BootDir}|!";
  "${_btrfsExe}" subvolume create "${_rb2BootDir}/@boot" \
    || _logPrepareExitFn 'emerg' '2' 'Failed to create |@boot|!';

  while read -r _path; do
    if [ "${_path}" != "${_rb2BootDir}/@boot" ]; then
      mv "${_path}" "${_rb2BootDir}/@boot/" \
        || _logPrepareExitFn 'alert' '2' "Failed to move |${_path}| to |${_rb2BootDir}/@boot|!";
    fi
  done < <(find "${_rb2BootDir}" -maxdepth 1 -mindepth 1)

  # Mount /boot again after successful rearrange
  mount /boot     || _logPrepareExitFn 'alert' '2' 'Failed to mount |/boot|!';
  mount /boot/efi || _logPrepareExitFn 'alert' '2' 'Failed to mount |/boot/efi|!';

  # Point the primary grub.cfg at the new boot files
  update-grub || _logPrepareExitFn 'alert' '2' 'Failed to update GRUB configuration!';

  # Make sure GRUB can find the primary grub.cfg at its new location
  sed -i "s/'\/grub'/'\/@boot\/grub'/" /boot/efi/EFI/ubuntu/grub.cfg \
    || _logPrepareExitFn 'alert' '2' 'Failed to point GRUB to the proper config location!';
  ## . End STAGE 3: Prepare /boot }

  ## Begin STAGE 4: Create subvolumes {
  # ${_rb2BootDir} (/btrfs_boot) is already mounted at this point
  mount "${_rb2MainDir}" || _logPrepareExitFn 'alert' '2' "Failed to mount |${_rb2MainDir}|!";
  _subvolume_list=(
    "${_rb2BootSnapshotDir}"
    "${_rb2MainSnapshotDir}"
    "${_rb2MainDir}/@libvirt-machines"
    "${_rb2MainDir}/@libvirt-machines/@etc-libvirt"
    "${_rb2MainDir}/@libvirt-machines/@var-lib-libvirt"
  );

  for _subvolume_id in "${_subvolume_list[@]}"; do
    "${_btrfsExe}" subvolume create "${_subvolume_id}" \
      || _logPrepareExitFn 'emerg' '2' "Failed to create |${_subvolume_id}|!";
  done
  ## . END Stage 4: Create subvolumes }

  ## Begin STAGE 5: Finish additional mounts {
  # At this point, /boot, /boot/efi, ${_rb2MainDir} (/btrfs_main), and
  # ${_rb2BootDir} (/btrfs_boot) are mounted.
  # /etc/libvirt and /var/lib/libvirt are not mounted.
  mount /etc/libvirt     || _logPrepareExitFn 'alert' '2' 'Failed to mount |/etc/libvirt|!';
  mount /var/lib/libvirt || _logPrepareExitFn 'alert' '2' 'Failed to mount |/var/lib/libvirt|!';
  ## . END STAGE 5: Finish additional mounts }

  _logWrapFn 'notice' 'System successfully prepared for snapshotting.';
}
## . END _prepareSystemPublicFn }

## BEGIN _restoreSnapshotPublicFn {
# Summary   : _restoreSnapshotPublicFn _snapshot_id
# Purpose   : Restores a rollback snapshot, writing metadata for a
#             post-restore handler to use and trimming excess snapshots once
#             the restore is complete.
# Example   : _restoreSnapshotPublicFn '@1234'
# Arguments : _snapshot_id - the ID of the snapshot to restore.
# Globals   : none
# Outputs   : Log info
# Returns   : none
# Throws    :
#   1:
#     - Calling user is not root,
#     - BTRFS status is not SUPPORTED, AUTO or SUPPORTED, MANUAL,
#     - Main unallocated space is dangerously low,
#     - Boot unallocated space is dangerously low,
#     - Insufficient arguments provided,
#     - A restore operation is already in progress and the system needs
#       rebooted,
#     - Snapshot is damaged and cannot be restored,
#     - EFI system partition can't be unmounted,
#     - Snapshot name of target snapshot could not be read, or
#     - Snapshot reason of target snapshot could not be read.
#   2:
#     - Failed to create a pre-rollback snapshot,
#     - Failed to relocate, restore, or sync a BTRFS subvolume,
#     - Failted to write the post-restore flag file, or
#     - Failed to trim snapshots after the restore process.
#
_restoreSnapshotPublicFn () {
  declare _target_snapshot_id _snapshot_path \
    _boot_snapshot_path _snapshot_name _snapshot_date _snapshot_reason \
    _umount_cnt _efi_umount_yn;

  _checkRootFn || _logExitFn 'warn' '1' \
    'Restoring a snapshot requires root permissions!';
  _checkBtrfsStatusSetUpFn || _logExitFn 'warn' '1' \
    'BTRFS status is incompatible with restoring a snapshot!';
  _checkMainUnallocSpaceFn || {
    _promptAllUsersFn 'rollbackLowMainSpace' "${_lowDiskMsg}";
    _logExitFn 'err' '1' \
      'Main disk space is too low to restore a snapshot!';
  }
  _checkBootUnallocSpaceFn || {
    _promptAllUsersFn 'rollbackLowBootSpace' "${_lowBootMsg}";
    _logExitFn 'err' '1' \
      'Boot disk space is too low to restore a snapshot!';
  }

  _target_snapshot_id="${1:-}";

  if [ -z "${_target_snapshot_id}" ]; then
    _logExitFn 'err' '1' 'No snapshot name provided to restore!';
  fi

  # Do not restore again if in post-restore, pre-reboot state
  if [ -e "${_rb2MainWorkingDir}" ] \
    || [ -e "${_rb2BootWorkingDir}" ]; then
    _logWrapFn 'err' 'Temporary restore subvols found, cannot continue.';
    _logWrapFn 'err' 'Please reboot the system to finish the pending restore operation.';
    _logExitFn 'err' '1' 'Restore already in progress!';
  fi

  _snapshot_path="${_rb2MainSnapshotDir}/${_target_snapshot_id}";
  _boot_snapshot_path="${_rb2BootSnapshotDir}/${_target_snapshot_id}";

  # Ensure both main and boot BTRFS snapshots exist
  if ! [ -e "${_snapshot_path}" ] || ! [ -e "${_boot_snapshot_path}" ]; then
    _logExitFn 'err' '1' \
      "Part or all of snapshot |${_target_snapshot_id}| does not exist!";
  fi

  # Retrieve relevant metadata from snapshot being restored
  _snapshot_name="$(_readMetadbFn "${_target_snapshot_id}" 'name')" \
    || _logExitFn 'err' '1' 'Snapshot restore halted, could not get snapshot name!';
  _snapshot_date="${_target_snapshot_id//@/}";
  _snapshot_reason="$(_getSnapshotReasonFn "${_target_snapshot_id}")" \
    || _logExitFn 'err' '1' 'Snapshot restore halted, could not get snapshot reason!';

  # Failing to unmount /boot/efi before attempting to move the old subvol
  # will result in the subvol not being moved, which will result in the
  # whole @boot subvol being nuked except for the contents of /boot/efi.
  #
  # Unmount EFI System Partition
  _efi_umount_yn='n';
  for (( _umount_cnt=0; _umount_cnt < 3; _umount_cnt++)); do
    if ! umount /boot/efi ; then
      sleep 1;
    else
      _efi_umount_yn='y';
      break;
    fi
  done

  if [ "${_efi_umount_yn}" = 'n' ]; then
    _logExitFn 'err' '1' 'Unable to unmount EFI system partition!';
  fi

  # Create pre-rollback snapshot for safety
  _createSnapshotFn 'Pre-Rollback' \
    || _logExitFn 'alert' '2' 'Snapshot restore halted, pre-rollback snapshot creation failed!';

  # Move existing main and boot subvols, restore new ones
  mv "${_rb2MainDir}/@" "${_rb2MainWorkingDir}" \
    || _logExitFn 'crit' '2' 'Unable to move root filesystem subvolume for restore!';
  "${_btrfsExe}" subvolume snapshot "${_snapshot_path}" "${_rb2MainDir}/@" \
    || _logExitFn 'emerg' '2' 'Unable to restore root filesystem snapshot!';
  "${_btrfsExe}" filesystem sync "${_rb2MainDir}" \
    || _logExitFn 'emerg' '2' 'Unable to sync main filesystem!';
  mv "${_rb2BootDir}/@boot" "${_rb2BootDir}/@kfocus-rollback-working-boot" \
    || _logExitFn 'alert' '2' 'Unable to move boot filesystem subvolume for restore!';
  "${_btrfsExe}" subvolume snapshot "${_boot_snapshot_path}" "${_rb2BootDir}/@boot" \
    || _logExitFn 'emerg' '2' 'Unable to restore boot filesystem snapshot!';
  "${_btrfsExe}" filesystem sync "${_rb2BootDir}" \
    || _logExitFn 'emerg' '2' 'Unable to sync boot filesystem!';
  sync;

  # Save relevant snapshot metadata for post-reboot handler retrieval
  {
    echo "${_snapshot_name}";
    echo "${_snapshot_date}";
    echo "${_snapshot_reason}";
  } > "${_rb2MainDir}/@${_rb2RestoreCompleteFile}" \
    || _logExitFn 'alert' '2' 'Unable to prepare system for post-snapshot cleanup!';

  # Trim older snapshots
  _trimSnapshotsFn || _logExitFn 'alert' '2' 'Unable to trim snapshots post-restore!';

  # Remount EFI System Partition
  mount /boot/efi || _logWrapFn 'notice' 'Unable to remount EFI system partition, ignoring.';

  _logWrapFn 'notice' "Restored snapshot |${_target_snapshot_id}|.";
}
## . END _restoreSnapshotPublicFn }

## BEGIN _setManualSwitchStatePublicFn {
# Summary   : _setManualSwitchStatePublicFn _state_str
# Purpose   : Sets the manual switch state in the snapshot metadb. This is
#             used to turn automatic snapshots on or off.
# Example   : _setManualSwitchStatePublicFn 'auto'
# Arguments :
#   _state_str - One of 'auto' or 'manual'. Sets the manual switch state to
#     the desired value. Note that this MUST be passed in as a *lowercase*
#     string.
# Globals   : _snapshotMetaDb
# Outputs   : Log info
# Returns   : none
# Throws    :
#   1:
#     - Calling user is not root,
#     - BTRFS status is not SUPPORTED, AUTO or SUPPORTED, MANUAL,
#     - Insufficient arguments provided,
#     - Could not get current manual switch state,
#     - Failed to change manual switch state, or
#     - Invalid state string provided.
#
_setManualSwitchStatePublicFn () {
  declare _state_str _current_state_str;

  _checkRootFn || _logExitFn 'warn' '1' \
    'Changing the manual switch state requires root permissions!';
  _checkBtrfsStatusSetUpFn || _logExitFn 'warn' '1' \
    'BTRFS status prevents changing the manual switch state!';

  # Get new and current switch states
  _state_str="${1:-}";
  if [ -z "${_state_str}" ]; then
    _logExitFn 'err' '1' 'Empty state string provided!';
  fi
  # Exit with code from subshell if non-zero
  _current_state_str="$(_getManualSwitchStateFn)" \
    || _logExitFn 'err' '1' 'Could not get existing manual switch state!';

  case "${_state_str}" in
    'auto')
      # Prohibit changing state to already existing state
      if [ "${_current_state_str}" = 'AUTO' ]; then
        _logWrapFn 'notice' 'Keeping manual switch state of |auto|.';
        return;
      else
        _writeMetadbFn 'global' 'manualSwitchState' 'AUTO' \
          || _logExitFn 'err' '1' 'Failed to set manual switch state to |auto|!';
      fi
      ;;
    'manual')
      # Prohibit changing state to already existing state
      if [ "${_current_state_str}" = 'MANUAL' ]; then
        _logWrapFn 'notice' 'Keeping manual switch state of |manual|.';
        return;
      else
        _writeMetadbFn 'global' 'manualSwitchState' 'MANUAL' \
          || _logExitFn 'err' '1' 'Failed to set switch state to |manual|!';
      fi
      ;;
    *)
      _logExitFn 'err' '1' 'Invalid state string provided!';
      ;;
  esac
}
## . END _setManualSwitchStatePublicFn }

## BEGIN _setSnapshotMetadataPublicFn {
# Summary   : _setSnapshotMetadataPublicFn _snapshot_id _name _desc _pin
# Purpose   : Sets the name, description, and pin status of a snapshot.
# Example   : _setSnapshotMetadataPublicFn '@1234' 'dGVzdE5hbWU=' 'dGVzdERlc2M=' 'y'
# Arguments :
#   _snapshot_id - the ID of the snapshot to modify.
#   _name - the base64-encoded name to assign to the snapshot.
#   _desc - the base64-encoded description to assign to the snapshot.
#   _pin - One of either 'y' or 'n'. Sets whether the snapshot is pinned ('y')
#     or it is not pinned ('n').
# Globals   : _rb2MainSnapshotDir, _lowDiskMsg, _lowBootMsg
# Outputs   : Log info
# Returns   : none
# Throws    :
#   1:
#     - Calling user is not root,
#     - BTRFS status is not SUPPORTED, AUTO or SUPPORTED, MANUAL,
#     - Insufficient or invalid arguments provided,
#     - Specified snapshot does not exist,
#     - Metadb read failure,
#     - Trying to pin a snapshot, but main or boot unallocated space is
#       dangerously low, or
#     - Metadb write failure.
#
_setSnapshotMetadataPublicFn () {
  declare _snapshot_id _name_str _desc_str _is_pinned _was_pinned;

  _checkRootFn || _logExitFn 'warn' '1' \
    'Setting snapshot metadata requires root permissions!';
  _checkBtrfsStatusSetUpFn || _logExitFn 'warn' '1' \
    'BTRFS status prevents setting snapshot metadata!';

  _snapshot_id="${1:-}";
  _name_str="${2:-}";
  _desc_str="${3:-}";
  _is_pinned="${4:-}";

  [ -z "${_snapshot_id}" ] && _logExitFn 'err' '1' 'No snapshot ID provided!';
  [ -z "${_is_pinned}" ] && _logExitFn 'err' '1' 'No pinning information provided!';
  [ -d "${_rb2MainSnapshotDir}/${_snapshot_id}" ] \
    || _logExitFn 'err' '1' 'The specified snapshot does not exist!'
  [[ "${_is_pinned}" =~ ^[yn]$ ]] || _logExitFn 'err' '1' 'Pinning data is not boolean!';

  # If pinning an unpinned snapshot, check disk space
  if [ "${_is_pinned}" = 'y' ]; then
    _was_pinned="$(_readMetadbFn "${_snapshot_id}" 'pinned')" \
      || _logExitFn 'err' '1' 'Could not determine if snapshot is pinned, metadb read failure!';
    if [ "${_was_pinned}" != 'y' ]; then
      _checkMainUnallocSpaceFn || {
        _promptAllUsersFn 'rollbackLowMainSpace' "${_lowDiskMsg}";
        _logExitFn 'err' '1' \
          'Main disk space is too low to pin a snapshot!';
      }
      _checkBootUnallocSpaceFn || {
        _promptAllUsersFn 'rollbackLowBootSpace' "${_lowBootMsg}";
        _logExitFn 'err' '1' \
          'Boot disk space is too low to pin a snapshot!';
      }
    fi
  fi

  # Write snapshot name, description, pin status to snapshot metadb
  _writeMetadbFn "${_snapshot_id}" 'name' "${_name_str}" \
    || _logExitFn 'err' '1' 'Could not set snapshot name, metadb write failed!';
  _writeMetadbFn "${_snapshot_id}" 'desc' "${_desc_str}" \
    || _logExitFn 'err' '1' 'Could not set snapshot description, metadb write failed!';
  _writeMetadbFn "${_snapshot_id}" 'pinned' "${_is_pinned}" \
    || _logExitFn 'err' '1' 'Could not set snapshot pin status, metadb write failed!';
}
## . END _setSnapshotMetadataPublicFn }

## BEGIN _systemSnapshotPublicFn {
# Summary   : _systemSnapshotPublicFn _reason
# Purpose   : Wraps _createSnapshotFn with safety checks and post-creation
#             trimming. Used when the end-user creates a snapshot.
# Example   : _systemSnapshotPublicFn 'user'
# Arguments : _reason - the snapshot reason to use when creating the snapshot.
# Globals   : _lowDiskMsg, _lowBootMsg
# Outputs   : Log info
# Returns   : none
# Throws    :
#   1:
#     - Calling user is not root,
#     - BTRFS status is not SUPPORTED, AUTO or SUPPORTED, MANUAL
#     - Main or boot unallocated space is dangerously low, or
#     - _createSnapshotFn returned 1.
#   2:
#     - _createSnapshotFn returned 2, or
#     - _trimSnapshotsFn returned 2.
#
_systemSnapshotPublicFn () {
  declare _return_code;

  _checkRootFn || _logExitFn 'warn' '1' \
    'Creating a snapshot requires root permissions!';
  _checkBtrfsStatusSetUpFn   || _logExitFn 'warn' '1' \
    'BTRFS status prevents creating a snapshot!';
  _checkMainUnallocSpaceFn   || {
    _promptAllUsersFn 'rollbackLowMainSpace' "${_lowDiskMsg}";
    _logExitFn 'err' '1' \
      'Main disk space is too low to take a snapshot!';
  }
  _checkBootUnallocSpaceFn   || {
    _promptAllUsersFn 'rollbackLowBootSpace' "${_lowBootMsg}";
    _logExitFn 'err' '1' \
      'Boot disk space is too low to take a snapshot!';
  }

  _createSnapshotFn "${1:-}";
  _return_code="$?";
  if [ "${_return_code}" = '1' ]; then
    _logWrapFn 'notice' 'Could not take a snapshot.';
  elif [ "${_return_code}" = '2' ]; then
    _logExitFn 'alert' '2' 'A critical error occurred while taking a snapshot!';
  fi

  _trimSnapshotsFn;
  _return_code="$?";
  if [ "${_return_code}" = '2' ]; then
    _logExitFn 'alert' '2' 'A critical error occurred while trimming snapshots!';
  fi
}
## . END _systemSnapshotPublicFn }

## BEGIN _trimSnapshotsPublicFn {
# Summary   : _trimSnapshotsPublicFn
# Purpose   : A public wrapper around _trimSnapshotsFn.
# Example   : _trimSnapshotsPublicFn
# Arguments : none
# Globals   : none
# Outputs   : Log info
# Returns   : none
# Throws    :
#   1:
#     - Calling user is not root,
#     - BTRFS status is not SUPPORTED, AUTO or SUPPORTED, MANUAL, or
#     - _trimSnapshotsFn returned 1.
#   2:
#     - _trimSnapshotsFn returned 2.
#
_trimSnapshotsPublicFn () {
  declare _return_code;

  _checkRootFn || _logExitFn 'warn' '1' \
    'Trimming snapshots requires root permissions!';
  _checkBtrfsStatusSetUpFn || _logExitFn 'warn' '1' \
    'BTRFS status is incompatible with trimming snapshots!';

  _trimSnapshotsFn;
  _return_code="$?";

  if [ "${_return_code}" = '1' ]; then
    _logWrapFn 'notice' 'Could not trim snapshots.';
  elif [ "${_return_code}" = '2' ]; then
    _logExitFn 'alert' '2' 'A critical error occurred while trimming snapshots!';
  fi
}
## . END _trimSnapshotsPublicFn }
## . END PUBLIC FUNCTIONS ===================================================

## BEGIN _mainFn {
_mainFn () {
  declare _mode_str _sleep_int;
  _mode_str="${1:-}";
  shift;

  ## Begin retry to acquire lock file
  _sleep_int=1;
  while true; do
    _checkSetFlockFn;
    case "$?" in
      0) break ;;
      1) sleep "${_sleep_int}" ;;
      *) _logExitFn 'err' '1' 'Irrecoverable error getting lock file!' ;;
    esac
    if (( _sleep_int < 10 )); then
      (( _sleep_int++ ));
    fi
  done
  ## . End retry to acquire lock file

  _checkBtrfsStatusFn;
  if [ "${_btrfsStatus}" = 'INCONSISTENT' ]; then
    _promptAllUsersFn 'warning' "${_inconsistentMsg}";
    if [ "${_mode_str}" != 'getBtrfsStatus' ]; then
      _logExitFn 'err' '1' 'BTRFS status is inconsistent!';
    fi
  fi

  case "${_mode_str}" in
    'btrfsDeepClean')          _btrfsDeepCleanPublicFn;;
    'btrfsMaintain')           _btrfsMaintainPublicFn;;
    'checkBootUnallocSpace')   _checkBootUnallocSpacePublicFn;;
    'checkMainUnallocSpace')   _checkMainUnallocSpacePublicFn;;
    'clearRestore')            _clearRestorePublicFn;;
    'compareState')            _compareStatePublicFn         "$@";;
    'createSnapshot')          _createSnapshotPublicFn       "${1:-}";;
    'deleteSnapshot')          _deleteSnapshotPublicFn       "${1:-}";;
    'finalizeRestore')         _finalizeRestorePublicFn;;
    'getBaseSnapshotMetadata') _getSnapshotMetadataPublicFn  "${1:-}"   'base';;
    'getBootMinUnalloc')       _getBootMinUnallocPublicFn;;
    'getBootUnallocSpace')     _getBootUnallocSpacePublicFn;;
    'getBtrfsStatus')          echo "${_btrfsStatus}";;
    'getFullSnapshotMetadata') _getSnapshotMetadataPublicFn  "${1:-}"   'full';;
    'getMainMinUnalloc')       _getMainMinUnallocPublicFn;;
    'getMainUnallocSpace')     _getMainUnallocSpacePublicFn;;
    'getManualSwitchState')    _getManualSwitchStatePublicFn;;
    'getSnapshotList')         _getSnapshotListStrPublicFn;;
    'getSnapshotReason')       _getSnapshotReasonPublicFn    "${1:-}";;
    'makeSnapshotDispId')      _makeSnapshotDispIdPublicFn   "${1:-}";;
    'prepareSystem')           _prepareSystemPublicFn;;
    'restoreSnapshot')         _restoreSnapshotPublicFn      "${1:-}";;
    'setManualSwitchState')    _setManualSwitchStatePublicFn "${1:-}";;
    'setSnapshotMetadata')     _setSnapshotMetadataPublicFn  "$@";;
    'systemSnapshot')          _systemSnapshotPublicFn       "${1:-}";;
    'trimSnapshots')           _trimSnapshotsPublicFn;;
    *)
      _logExitFn 'err' '1' 'Invalid mode specified.';
      ;;
  esac

  _exitCleanFn;
}
## . END _mainFn }

## BEGIN Declare and assign global vars {
declare _binName _binDir _baseName _baseDir \
  _lockFile _btrfsStatus _snapshotMetaDb \
  _libTable _browStr _erowStr _tableStr _prepareFailMsg \
  _lowDiskMsg _lowBootMsg _inconsistentMsg _btrfsExe _btduExe _filefragExe \
  _btrfsBalanceExe _kwriteconfig5Exe _kreadconfig5Exe _diffExe \
  _legacySnapshotReasonFile;

_btrfsStatus='';

# WARNING: Do NOT change the name of the lock file no matter what the name of
# this script changes to. If kfocus-rollback-set from Rollback v1 is running
# when Rollback v2 is installed, and then kfocus-rollback-backend from
# Rollback v2 is launched before the v1 process terminates, they will run
# simultaneously and potentially cause data loss.
_lockDir='/tmp/kfocus-rollback';
_lockFile="${_lockDir}/kfocus-rollback-set.lock"; # See WARNING

_legacySnapshotReasonFile='/var/lib/kfocus/rollback_snapshot_reason';
## . END Declare and assign global vars }

## BEGIN Run mainFn when script is NOT sourced {
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  _binName="$(  readlink -f "$0"       )" || exit 101;
  _binDir="$(   dirname  "${_binName}" )" || exit 101;
  _baseDir="$(  dirname  "${_binDir}"  )" || exit 101;
  _baseName="$( basename "${_binName}" )" || exit 101;

  # Import libs and assign more global vars
  _libTable=(
    "${_baseDir}/lib/common.2.source"
    "${_baseDir}/lib/rollback.2.source"
  );
  _loadLibTableFn "${_libTable[@]}" || exit 1;

  # Assign global vars that rely on lib variables
  _snapshotMetaDb="${_rb2MainDir}/kfocus-rollback-snapshot-metadb";

  _assignList=(
    '_btrfsExe|/usr/bin/btrfs'
    '_btrfsBalanceExe|/usr/bin/btrfs-balance-least-used'
    '_btduExe|/usr/bin/btdu'
    '_diffExe|/usr/bin/diff'
    "_filefragExe|${_binDir}/kfocus-report-filefrag"
    '_kwriteconfig5Exe|/usr/bin/kwriteconfig5'
    '_kreadconfig5Exe|/usr/bin/kreadconfig5'
  );

  if ! _cm2AssignExeVarsFn "${_assignList[@]}"; then
    _logWrapFn 'err' 'Could not assign variables';
    exit 1;
  fi

  _cm2SetLogLevelFn 'notice'; # Syslog all issues notice or greater
  _cm2SetLogTagFn "${_baseName}";
  _assignGlobalUiVarsFn;

  _mainFn "$@";
fi
## . END Run mainFn when script is NOT sourced }
