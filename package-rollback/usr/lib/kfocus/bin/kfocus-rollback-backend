## . END INITIALIZATION AND EXIT FUNCTIONS ==============================

## BEGIN PRIVATE FUNCTIONS ==================================================
## BEGIN private _balanceBootFn {
# Summary   : _balanceBootFn
# Purpose   : Unconditionally balances the boot filesystem.
# Example   : _balanceBootFn
# Arguments : none
# Globals   : none
# Outputs   : Log info
# Returns   : 0 on success, 1 on failure
# Throws    : none
#
_balanceBootFn () {
  # Unconditionally balance boot space
  "${_btrfsBalanceExe}" -u 85 "${_rb2BootDir}" || {
    _logWrapFn 'err' 'Could not balance boot filesystem!';
    return 1;
  }

  _logWrapFn 'notice' 'Boot filesystem balanced.';
}
## . END private _balanceBootFn }

## BEGIN private _balanceMainFn {
# Summary   : _balanceMainFn [doForce]
# Purpose   : Checks to see if the main filesystem needs balanced, and does so
#             if necessary.
# Example   : _balanceMainFn 'n'
# Arguments :
#   doForce - Whether to force a balance or not. Argument must be one of
#     either 'y' or 'n'. Defaults to 'n'.
# Globals   : _rb2MainDir
# Outputs   : Log info
# Returns   : 0 on success, 1 on failure, 2 on critical failure
# Throws    : none
#
_balanceMainFn () {
  declare _do_force_balance _main_report _main_unalloc_int _main_free_int \
    _last_unalloc_int _last_free_int _trigger_threshold _balance_percent \
    _do_balance;

  _do_force_balance="${1:-n}";
  _do_balance='n';
  _trigger_threshold=5368709120; # 5 GiB

  # Extract unallocated and free space from main fs report
  _main_report="$(_getMainUsageReportFn)" || {
    _logWrapFn 'err' 'Could not balance main filesystem, could not get main usage report!';
    return 1;
  }
  _main_unalloc_int="$(grep $'Device unallocated:\t' <<< "${_main_report}" \
    | awk '{ print $3 }')";
  _main_free_int="$(grep $'Free (estimated):\t' <<< "${_main_report}" \
    | awk '{ print $3 }')";

  # Read previous space values from snapshot metadb
  _last_unalloc_int="$(_readMetadbFn 'global' 'lastUnallocInt')" || {
    _logWrapFn 'err' 'Could not balance main filesystem, could not read lastUnallocInt from metadb!';
    return 1;
  }
  _last_free_int="$(_readMetadbFn 'global' 'lastFreeInt')" || {
    _logWrapFn 'err' 'Could not balance main filesystem, could not read lastFreeInt from metadb!';
    return 1;
  }
  if [ -z "${_last_unalloc_int}" ] \
    || [ -z "${_last_free_int}" ]; then
    _last_unalloc_int=-1;
    _last_free_int=0;
  fi

  # Always balance if forced, and balance more intensively
  if [ "${_do_force_balance}" = 'y' ]; then
    _balance_percent='85';
    _do_balance='y'
  # Else, balance if free space growth or unallocated space shrinkage exceeds
  # threshold
  elif (( (_last_unalloc_int - _main_unalloc_int) >= "${_trigger_threshold}" )) \
    || (( (_main_free_int - _last_free_int) >= "${_trigger_threshold}" )); then
    _balance_percent='70';
    _do_balance='y';
  fi

  # Balance if conditions met
  if [ "${_do_balance}" = 'y' ]; then
    # Balance main fs
    "${_btrfsBalanceExe}" -u "${_balance_percent}" "${_rb2MainDir}" || {
      _logWrapFn 'alert' 'Could not balance main filesystem!';
      return 2;
    }

    # Save new unallocated and free space data to state file
    _main_report="$(_getMainUsageReportFn)" || {
      _logWrapFn 'err' 'Could not balance main filesystem, could not get main usage report!';
      return 1;
    }
    _main_unalloc_int="$(grep $'Device unallocated:\t' <<< "${_main_report}" \
      | awk '{ print $3 }')";
    _main_free_int="$(grep $'Free (estimated):\t' <<< "${_main_report}" \
      | awk '{ print $3 }')";

    _writeMetadbFn 'global' 'lastUnallocInt' "${_main_unalloc_int}" || {
      _logWrapFn 'err' 'Failed to save lastUnallocInt to metadb!';
      return 1;
    }
    _writeMetadbFn 'global' 'lastFreeInt' "${_main_free_int}" || {
      _logWrapFn 'err' 'Failed to save lastFreeInt to metadb!';
      return 1;
    }

    _logWrapFn 'notice' 'Main filesystem balanced.';
  else
    _logWrapFn 'notice' \
      'Main filesystem not balanced: not forced and threshold not met.';
  fi
}
## . END private _balanceMainFn }

## BEGIN private _checkBootUnallocSpaceFn {
# Summary   : _checkBootUnallocSpaceFn
# Purpose   : Checks unallocated space on the main subvolume to ensure it is
#             above a certain threshold.
# Example   : _checkBootUnallocSpaceFn;
# Arguments : none
# Globals   : none
# Outputs   : Log info
# Returns   : 0 if boot space is considered sufficient, 1 otherwise
# Throws    : none
#
_checkBootUnallocSpaceFn () {
  declare _boot_min_unalloc _boot_unalloc;

  _boot_min_unalloc="$(_getBootMinUnallocFn)";
  _boot_unalloc="$(_getBootUnallocSpaceFn)";

  # Warn all users if boot unallocated space is below minimum
  if (( _boot_unalloc < _boot_min_unalloc )); then
    _logWrapFn 'err' 'Boot filesystem space is low!';
    return 1;
  else
    return 0;
  fi
}
## . END private _checkBootUnallocSpaceFn }

# NOTE: All functions above this point have had their documentation checked
# and redone. PICK UP HERE!

## BEGIN private _checkBtrfsStatusFn {
# Summary   : _checkBtrfsStatusFn
# Purpose   : Determines the state of the system's BTRFS setup, and saves a
#             code describing the system state to the global _btrfsStatus
#             variable. This is mainly used for determining whether the system
#             is able to use rollback snapshots, and whether automatic
#             snapshotting is enabled.
# Example   : _checkBtrfsStatusFn
# Arguments : none
# Globals   : _btrfsStatus
# Outputs   :
#   'UNSUPPORTED' - the system does not support rollback snapshots.
#   'SUPPORTED, MANUAL' - the system supports rollback snapshots. Do NOT take
#     automatic snapshots.
#   'SUPPORTED, AUTO' - the system supports rollback snapshots. Take automatic
#     snapshots.
#   'SUPPORTED, NOT SET UP' - the system can support rollback snapshots, but
#     it has not yet gone through the initial setup process.
#   'INCONSISTENT' - the system supported rollback snapshots at one point, but
#     is damaged and cannot support them now. This should only ever happen if
#     the disk becomes corrupted or the user does something wrong.
# Returns   : 0 on success, this function can not fail
# Throws    : none
#
_checkBtrfsStatusFn () {
  declare _main_fs _boot_fs _idx _good_count _check_str \
    _main_subvols_str _boot_subvols_str _switch_str;
  # The presence of /var/lib/portables or /var/lib/machines subvolumes will
  # interfere with snapshotting. These subvolumes may be created automatically
  # by systemd if it is not configured otherwise.
  if grep -q 'var/lib/portables' < <("${_btrfsExe}" subvolume list /) || \
     grep -q 'var/lib/machines' < <("${_btrfsExe}" subvolume list /); then
    if [ -n "$(ls -A /var/lib/portables)" ] || \
       [ -n "$(ls -A /var/lib/machines )" ]; then
      _btrfsStatus='UNSUPPORTED';
      return 0;
    fi
  fi

  # Gauntlet for INCONSISTENT, UNSUPPORTED, SUPPORTED
  _main_fs="$(_getMainPartitionFn)";
  _boot_fs="$(_getBootPartitionFn)";
  for _idx in {1..1}; do
    # Check top directories
    _good_count=$(_checkDirListFn "${_rb2MainDir}|${_rb2BootDir}");

    # Only one directory means INCONSISTENT
    [ "${_good_count}" = '1' ] && {
      _btrfsStatus='INCONSISTENT'; break;
    }

    # No directories mean we should CHECK_SETUP
    [ "${_good_count}" = '0' ] && {
      _btrfsStatus='CHECK_CAN_SETUP'; break;
    }

    # Unless 4 dirs exist, means UNSUPPORTED
    _check_str="${_rb2MainDir}/@|${_rb2MainSnapshotDir}";
    _check_str+="|${_rb2BootDir}/@boot|${_rb2BootSnapshotDir}";
    _good_count=$(_checkDirListFn "${_check_str}");
    [ "${_good_count}" != 4 ] && {
      _btrfsStatus='UNSUPPORTED'; break;
    }

    # Unless main, boot fs exists and distinct, means UNSUPPORTED
    [ -z "${_main_fs}" ] || [ -z "${_boot_fs}" ] \
      || [ "${_main_fs}" = "${_boot_fs}" ] && {
      _btrfsStatus='UNSUPPORTED'; break;
    }

    # Gauntlet passed.
    _btrfsStatus='SUPPORTED';
  done

  # Append MANUAL, AUTO, NOT SETUP to SUPPORTED condition
  if [ "${_btrfsStatus}" = 'SUPPORTED' ]; then
    # This may exit non-zero but if it does, we also won't get any mode
    # switch state string, so it's easier to interpret that.
    _switch_str="$(_getManualSwitchStateFn)";
    if [ "${_switch_str}" = 'MANUAL' ]; then
      _btrfsStatus+=', MANUAL';
    elif [ "${_switch_str}" = 'AUTO' ]; then
      _btrfsStatus+=', AUTO';
    else
      _btrfsStatus='UNSUPPORTED';
    fi
  fi

  # Bail if btrfsStatus is already set
  if [ "${_btrfsStatus}" != 'CHECK_CAN_SETUP' ]; then return 0; fi

  # Gauntlet to run on CHECK_CAN_SETUP condition,
  #   where _main_fs, _boot_fs are not setup per above
  for _idx in {1..1}; do

    # Unless main, boot fs exists and distinct, means UNSUPPORTED
    if [ -z "${_main_fs}" ] || [ -z "${_boot_fs}" ] \
      || [ "${_main_fs}" = "${_boot_fs}" ]; then
      _btrfsStatus='UNSUPPORTED'; break;
    fi
    _main_subvols_str="$(
      "${_btrfsExe}" subvolume list / | awk '{ print $9 }' | sort
    )";
    _boot_subvols_str="$(
      "${_btrfsExe}" subvolume list /boot | awk '{ print $9 }' | sort
    )";

    # If root subvol is misnamed or absent, means UNSUPPORTED
    if ! grep -qE '^@$' <<< "${_main_subvols_str}"; then
      _btrfsStatus='UNSUPPORTED'; break;
    fi

    # If /home mount is not found, means UNSUPPORTED
    if ! LC_ALL='C' mount | grep -q ' on /home '; then
      _btrfsStatus='UNSUPPORTED'; break;
    fi

    # If main_subvols_str is not empty, means UNSUPPORTED
    if [ -n "${_boot_subvols_str}" ]; then
      _btrfsStatus='UNSUPPORTED'; break;
    fi

    # If snapshots are found, means INCONSISTENT
    if grep -qE '^@kfocus-rollback-snapshots$' \
      <<< "${_main_subvols_str}"; then
      _btrfsStatus='INCONSISTENT'; break;
    fi

    # Gauntlet passed
    _btrfsStatus='SUPPORTED, NOT SET UP';
  done
}
## . END private _checkBtrfsStatusFn }

## BEGIN private _checkBtrfsStatusSetUpFn {
# Summary   : _checkBtrfsStatusSetUpFn
# Purpose   : Ensures that the BTRFS status is either 'SUPPORTED, AUTO' or
#             'SUPPORTED, MANUAL'. This function will only behave as intended
#             if _checkBtrfsStatusFn is called first.
# Example   : _checkBtrfsStatusSetUpFn
# Arguments : none
# Globals   : _btrfsStatus
# Outputs   : none
# Returns   : 0 if BTRFS status is 'SUPPORTED, AUTO' or 'SUPPORTED, MANUAL', 1
#             otherwise.
# Throws    : none
#
_checkBtrfsStatusSetUpFn () {
  if [ "${_btrfsStatus}" != 'SUPPORTED, AUTO' ] \
    && [ "${_btrfsStatus}" != 'SUPPORTED, MANUAL' ]; then
    return 1;
  fi
}
## . END private _checkBtrfsStatusSetUpFn }

## BEGIN private _createCheckMetadbFn {
# Summary   : _checkCreateMetadbFn
# Purpose   : Ensures that the snapshot metadb exists, is a regular file, and
#             has sensible permissions set (read for everyone. write for root
#             only).
# Example   : _checkCreateMetadbFn
# Arguments : none
# Globals   : _snapshotMetaDb
# Outputs   : none
# Returns   : 0 on success, 1 on failure
# Throws    : none
#
_checkCreateMetadbFn () {
  # Confirm this is regular, existing file with correct perms
  if [ -f "${_snapshotMetaDb}" ]; then
    if [ "$(stat -c '%a' "${_snapshotMetaDb}")" != '644' ]; then
      chmod '0644' "${_snapshotMetaDb}" || {
        _logWrapFn 'err' 'Failed to fix permissions on snapshot metadb!';
        return 1;
      }
    fi
    if [ "$(stat -c '%u' "${_snapshotMetaDb}")" != '0' ]; then
      chown root:root "${_snapshotMetaDb}" || {
        _logWrapFn 'err' 'Failed to fix ownership on snapshot metadb!';
        return 1;
      }
    fi
    return 0;
  fi

  # Error if not a file
  if [ -e "${_snapshotMetaDb}" ]; then
    _logWrapFn 'warn' "Metadb is not a regular file.";
    return 1;
  fi

  # Create file if needed
  touch "${_snapshotMetaDb}" || {
    _logWrapFn 'err' 'Could not create snapshot metadb!';
    return 1;
  }
  chmod '0644' "${_snapshotMetaDb}" || {
    _logWrapFn 'err' 'Failed to set permissions on snapshot metadb!';
    return 1;
  }
}
## . END private _createCheckMetadbFn }

## BEGIN private _checkDirListFn {
# Summary   : _checkDirListFn dirList
# Purpose   : Checks for the existence of a list of directories.
# Example   :
#   if [ "$(_checkDirListFn /btrfs_main/@|/btrfs_boot/@boot)" = '2' ]; then
#     ...;
#   fi
# Arguments :
#   dirList - A pipe-separated list of directories.
# Globals   : none
# Outputs   : An integer specifying the number of listed directories that
#             exist.
# Returns   : none
# Throws    : none
#
_checkDirListFn () {
  declare _good_count _dir_list _loop_dir;

  _good_count=0;

  readarray -t -d'|' _dir_list < <(echo -n "${1:-}");
  for _loop_dir in "${_dir_list[@]}"; do
    if [ -d "${_loop_dir}" ]; then (( _good_count++ )); fi
  done

  echo "${_good_count}";
}
## . END private _checkDirListFn }

## BEGIN private _checkMainUnallocSpaceFn {
# Summary   : _checkMainUnallocSpaceFn
# Purpose   : Ensures that the amount of unallocated space on the main
#             filesystem is greater than a minimum threshold.
# Example   : _checkMainUnallocSpaceFn
# Arguments : none
# Globals   : none
# Outputs   : Log info
# Returns   : 0 if main filesystem space is sufficient, 1 otherwise
# Throws    : none
_checkMainUnallocSpaceFn () {
  declare _main_min_unalloc _main_unalloc;

  _main_min_unalloc="$(_getMainMinUnallocFn)";
  _main_unalloc="$(_getMainUnallocSpaceFn)";

  # Warn all users if main unallocated space is below minimum
  if (( _main_unalloc < _main_min_unalloc )); then
    _logWrapFn 'err' 'Main filesystem space is low!';
    return 1;
  else
    return 0;
  fi
}
## . END private _checkMainUnallocSpaceFn }

## BEGIN private _checkRootFn {
_checkRootFn () {
  [ "$(id -u)" = 0 ] || return 1;
}
## . END private _checkRootFn }

## BEGIN private _checkSetFlockFn {
# Summary   : _checkSetFlockFn;
# Purpose   : Set file lock for this executable. Use this to prevent multiple
#             instances from running.
# Example   : while ! _checkSetFlockFn; sleep 1; done
# Arguments : none
# Globals   : _lockDir, lockFile, _trapExitFn
# Outputs   : Messages to STDERR
# Returns   :
#   1 - Cannot get lock; recoverable by waiting
#   2 - Unrecoverable error
#   0 - Success
# Throws    : none
#
_checkSetFlockFn () {
  # Create the lock dir if possible. If this fails, it's almost certainly
  # because something already created the lock dir, so we can ignore the
  # failure. No checking is done in advance because it wouldn't make any
  # functional difference and wouldn't be reliable because of an unavoidable
  # time-of-check-to-time-of-use condition.
  install -m 777 -d "${_lockDir}" 2>/dev/null || true
  if ! [ -e "${_lockFile}" ]; then
    install -m 666 /dev/null "${_lockFile}" || {
      _logWrapFn 'err' "Could not install |${_lockFile}|!";
      return 2;
    }
  fi
  exec 211>"${_lockFile}" || {
    _logWrapFn 'err' 'Lock file permission denied!';
    return 2;
  };
  flock -n -e 211 || {
    _logWrapFn 'info' "Cannot get lock on |${_lockFile}|!";
    return 1;
  }
  # Trap unexpected exits to show warnings if needed
  trap _trapExitFn EXIT;
}
## . END private _checkSetFlockFn }

## BEGIN private _createSnapshotFn {
# Summary   : _createSnapshotFn _snapshot_reason
# Purpose   : Creates a new automatic or manual snapshot. Automatic snapshots
#             are only taken if certain conditions are met.
# Example   : _createSnapshotFn user
# Arguments :
#   _snapshot_reason - The "reason" to assign to the snapshot. This reason
#     indicates why the snapshot was taken, and is also used to determine
#     whether a snapshot actually should be taken or not. Possible values for
#     snapshotReason are:
#     Apt - The snapshot is being automatically created because the apt
#       packages on the system are being modified. The snapshot should not be
#       created if it has been less than an hour since the last snapshot, or
#       if the system is in OEM configuration mode.
#     Timed - The snapshot is being automatically created because a
#       maintenance timer has triggered. The snapshot should not be created if
#       it has been less than a week since the last snapshot, or if the system
#       is in OEM configuration mode.
#     Pre-Rollback - The snapshot is being created immediately before
#       restoring an existing snapshot.
#     Anything else - The snapshot is being created manually by the user. The
#       snapshot "reason" is assumed to be the username of the user taking the
#       snapshot.
# Globals   : _rb2MainSnapshotDir, _btrfsStatus, _legacySnapshotReasonFile,
#   _rb2MainDir, _rb2BootDir
# Outputs   : Log info
# Returns   :
#    1 - Snapshot could not be fully created (metadb write failure)
#    2 - Snapshot creation failed (disk I/O failure or other unexpected issue)
#    0 - Snapshot successfully created, or automatic snapshot doesn't need to
#      be created
# Throws    : none
#
_createSnapshotFn () {
  declare _snapshot_event_type _timestamp_str _prev_timestamp_str \
    _snapshot_path _boot_snapshot_path _hour_seconds _week_seconds;

  _snapshot_event_type="${1:-}"
  _hour_seconds=3600;
  _week_seconds=604800;

  # If a pre-existing snapshot ID is generated, sleep one second and retry
  while true; do
    _timestamp_str="$(date +%s)";
    _snapshot_path="${_rb2MainSnapshotDir}/@${_timestamp_str}";
    _boot_snapshot_path="${_rb2BootSnapshotDir}/@${_timestamp_str}";

    if [ -e "${_snapshot_path}" ] || [ -e "${_boot_snapshot_path}" ]; then
      sleep 1;
      continue;
    fi
    break;
  done

  # Get timestamp of most recent existing snapshot
  _prev_timestamp_str="$(
    _cm2LsFn "${_rb2MainSnapshotDir}" \
      | sed 's/@//' | sort -n | tail -n1
  )";

  # Disallow automatic snapshots when insufficient time has passed, OEM
  # configuration mode is active, or automatic snapshots are turned off
  case "${_snapshot_event_type}" in
    'Apt')
      if (( ( _timestamp_str - _prev_timestamp_str ) < _hour_seconds )); then
        _logWrapFn 'notice' 'Too little time has elapsed for another snapshot.';
        return 0;
      fi
      if [ -d '/oem' ]; then
        _logWrapFn 'notice' 'Cannot create apt snapshot in OEM configuration mode.';
        return 0;
      fi
      if [ "${_btrfsStatus}" = 'SUPPORTED, MANUAL' ]; then
        _logWrapFn 'notice' 'Cannot create apt snapshot in manual snapshot mode.';
        return 0;
      fi
      ;;
    'Timed')
      if (( ( _timestamp_str - _prev_timestamp_str ) < _week_seconds )); then
        _logWrapFn 'notice' 'Too little time has elapsed for another snapshot.';
        return 0;
      fi
      if [ -d '/oem' ]; then
        _logWrapFn 'notice' 'Cannot create timed snapshot in OEM configuration mode.';
        return 0;
      fi
      if [ "${_btrfsStatus}" = 'SUPPORTED, MANUAL' ]; then
        _logWrapFn 'notice' 'Cannot create timed snapshot in manual snapshot mode.';
        return 0;
      fi
      ;;
  esac

  # Delete the obsolete rollback_snapshot_reason file if it exists
  if [ -f "${_legacySnapshotReasonFile}" ]; then
    rm -f "${_legacySnapshotReasonFile}";
  fi

  # Snapshot and sync main and boot filesystems
  "${_btrfsExe}" subvolume snapshot -r "${_rb2MainDir}/@" "${_snapshot_path}" || {
    _logWrapFn 'emerg' "Could not create snapshot |${_snapshot_path}|";
    return 2;
  }
  "${_btrfsExe}" filesystem sync "${_rb2MainDir}" || {
    _logWrapFn 'emerg' 'Failed to sync main filesystem!';
    return 2;
  }
  "${_btrfsExe}" subvolume snapshot -r "${_rb2BootDir}/@boot" "${_boot_snapshot_path}" || {
    _logWrapFn 'emerg' "Could not create boot snapshot |${_boot_snapshot_path}|";
    return 2;
  }
  "${_btrfsExe}" filesystem sync "${_rb2BootDir}" || {
    _logWrapFn 'emerg' 'Failed to sync boot filesystem!';
    return 2;
  }
  sync;

  _logWrapFn 'notice' "Snapshot |@${_timestamp_str}| created.";

  # Save snapshot creation reason in the metadata database.
  _writeMetadbFn "@${_timestamp_str}" 'reason' "${_snapshot_event_type}" || {
    _logWrapFn 'err' "Could not save snapshot reason for snapshot |@${_timestamp_str}| to metadb!"
    return 1;
  }
}
## . END private _createSnapshotFn }

## BEGIN private _defragmentFn {
# Summary   : _defragmentFn
# Purpose   : Defragments heavily fragmented files on the main filesystem,
#             improving performance and reclaiming unreachable space.
# Example   : _defragmentFn
# Arguments : none
# Globals   : none
# Outputs   : Log info
# Returns   :
#   1 - Defragment operation failed (couldn't retrieve needed data)
#   2 - Defragment operation failed (btrfs defragment command failed)
#   0 - Success
# Throws    : none
#
_defragmentFn () {
  declare _frag_report _frag_count_list _target_frag_list _frag_file_list \
    _defrag_file_list _report_idx _btdu_report _btdu_val_list \
    _btdu_file_list _file_size _unreachable_size _clean_file_list \
    _defrag_list_idx _merge_yn _clean_list_idx _current_file;

  # Get report of file fragmentation on main filesystem, sorted by excessive
  # fragments
  _frag_report="$(_getMainFragReportFn)" || {
    _logWrapFn 'err' 'Defragment operation halted, could not get main frag report!';
    return 1;
  }
  _frag_report="$(sort -nr <<< "${_frag_report}")";

  # Split fragmentation report into frag count, ideal frag count, and files
  readarray -t _frag_count_list  < <(cut -d'|' -f2 <<< "${_frag_report}");
  readarray -t _target_frag_list < <(cut -d'|' -f3 <<< "${_frag_report}");
  readarray -t _frag_file_list   < <(cut -d'|' -f4 <<< "${_frag_report}");

  # Get list of all files with more fragments than ideal
  _defrag_file_list=();
  for (( _report_idx=0; _report_idx < ${#_frag_file_list[@]}; \
    _report_idx++ )); do
    _current_file="${_frag_file_list[_report_idx]}";

    if [ -f "${_current_file}" ]; then
      if (( _frag_count_list[_report_idx] > \
        _target_frag_list[_report_idx] )); then
        _defrag_file_list+=( "${_current_file}" );
      fi
    fi
  done

  # Trim list count to 50
  if (( ${#_defrag_file_list[@]} > 50 )); then
    _defrag_file_list=( "${_defrag_file_list[@]:0:50}" );
  fi

  # Get report of unreachable space, sorted by quantity
  _btdu_report="$(_getMainBtduReportFn)" || {
    _logWrapFn 'err' 'Defragment operation halted, could not get main btdu report!';
    return 1;
  }
  _btdu_report="$(
      grep '<UNREACHABLE>' <<< "${_btdu_report}" \
      | sort -nr \
      | sed 's|/<SINGLE>/<DATA>/<UNREACHABLE>||; /<ERROR>/d'
  )";

  # Split report into unreachable space and files
  readarray -t _btdu_val_list < <(cut -f1 <<< "${_btdu_report}");
  readarray -t _btdu_file_list < <(cut -f2 <<< "${_btdu_report}");

  # Get list of all files with unreachable space greater than 15% of file size
  _clean_file_list=();
  for (( _report_idx=0; _report_idx < ${#_btdu_val_list[@]}; \
    _report_idx++ )); do
    _current_file="${_btdu_file_list[_report_idx]}";

    if [ -f "${_current_file}" ]; then
      _file_size="$(du -b "${_current_file}" | cut -f1)";
      (( _unreachable_size = _btdu_val_list[_report_idx] * 1024 ));

      if [ "$(bc -l <<< "scale=2; (${_unreachable_size} / ${_file_size}) > 0.15")" \
        = '1' ]; then
        _clean_file_list+=( "${_current_file}" );
      fi
    fi
  done

  # Trim list count to 50
  if (( ${#_clean_file_list[@]} > 50 )); then
    _clean_file_list=( "${_clean_file_list[@]:0:50}" );
  fi

  # Find all items in defrag list not in clean list, and add to clean list
  for (( _defrag_list_idx=0; _defrag_list_idx < "${#_defrag_file_list[@]}"; \
    _defrag_list_idx++ )); do
    _current_file="${_defrag_file_list[_defrag_list_idx]}";
    _merge_yn='y';
    for (( _clean_list_idx=0; _clean_list_idx < "${#_clean_file_list[@]}"; \
      _clean_list_idx++ )); do
      if [ "${_current_file}" = "${_clean_file_list[_clean_list_idx]}" ]; then
        _merge_yn='n';
        break;
      fi
    done

    if [ "${_merge_yn}" = 'y' ]; then
      _clean_file_list+=( "${_current_file}" );
    fi
  done

  # Defragment all files in clean list, use lzo compression
  if (( ${#_defrag_file_list[@]} > 0 )); then
    "${_btrfsExe}" filesystem defragment -clzo "${_clean_file_list[@]}" || {
      _logWrapFn 'emerg' 'Defragment operation failed!';
      return 2;
    }
  fi

  _logWrapFn 'notice' \
    "Defragmented |${#_defrag_file_list[@]}| files on main filesystem.";
}
## . END private _defragmentFn }

## BEGIN private _deleteAllSnapshotsFn {
# Summary   : _deleteAllSnapshotsFn
# Purpose   : Deletes all rollback snapshots on the system, including pinned
#             snapshots.
# Example   : _deleteAllSnapshotsFn
# Arguments : none
# Globals   : _rb2MainSnapshotDir
# Outputs   : none
# Returns   :
#   1 - General failure
#   2 - Snapshot deletion call failed
#   0 - Success
# Throws    : none
#
_deleteAllSnapshotsFn () {
  declare _sect_str _snapshot_list _snapshot_id _is_pinned;

  _sect_str='Delete all snapshots';
  _logSectBeginFn "${_sect_str}";

  # Remove snapshots that do not have matched main and boot components
  _scrubSnapshotsFn || {
    _logWrapFn 'alert' 'Trouble scrubbing snapshots';
    _logSectEndFn "${_sect_str}";
    return 2;
  }

  # Get list of snapshots
  readarray -t _snapshot_list < <(
    _cm2LsFn "${_rb2MainSnapshotDir}" 2>/dev/null
  );

  # Return if no snapshots exist
  if [ "${#_snapshot_list[@]}" = '0' ] \
    || [ -z "${_snapshot_list[0]:-}" ]; then
    _logWrapFn 'warn' 'No snapshots found.';
    _logSectEndFn "${_sect_str}";
    return 0;
  fi

  # Delete each snapshot, unpinning if needed
  for _snapshot_id in "${_snapshot_list[@]}"; do
    # Read failure here is almost impossible: It will succeed even if missing
    # file, group, or key. Only weird edge cases should trigger a return.
    _is_pinned="$(_readMetadbFn "${_snapshot_id}" 'pinned')" || {
      _logWrapFn 'err' "Could not read pin status of |${_snapshot_id}|!";
      _logSectAbortFn "${_sect_str}";
      return 1;
    }
    if [ "${_is_pinned}" = 'y' ]; then
      # Write failure here is almost impossible similar to _writeMetadbFn.
      # See note there.
      _writeMetadbFn "${_snapshot_id}" 'pinned' 'n' || {
        _logWrapFn 'err' "Could not write pin status of |${_snapshot_id}|!";
        _logSectAbortFn "${_sect_str}";
        return 1;
      }
    fi
    _deleteSnapshotFn "${_snapshot_id}" || {
      _logWrapFn 'alert' "Could not delete snapshot |${_snapshot_id}|!";
      _logSectAbortFn "${_sect_str}";
      return 2;
    }
  done
  _logSectEndFn "${_sect_str}";
}
## . END private _deleteAllSnapshotsFn }

## BEGIN private _deleteSnapshotMetaFn {
# Summary   : _deleteSnapshotMetaFn snapshot_id
# Purpose   : Deletes all metadata corresponding to a particular snapshot.
# Example   : _deleteSnapshotMetaFn @1234
# Arguments :
#   snapshot_id - The ID of the snapshot who's metadata is to be wiped.
# Globals   : none
# Outputs   : Log info
# Returns   : 0 on success, 1 on failure
# Throws    : none
#
_deleteSnapshotMetaFn () {
  declare _return_code _snapshot_id _key_list _key _msg;

  _snapshot_id="${1:-}";
  if [ -z "${_snapshot_id}" ]; then
    _logWrapFn 'warn' 'Empty snapshot_id!';
    return 0;
  fi

  _key_list=( 'name' 'desc' 'pinned' 'reason' );
  _return_code=0;
  for _key in "${_key_list[@]}"; do
    if [ "${_key}" = '' ]; then continue; fi
    _writeMetadbFn "${_snapshot_id}" "${_key}" '' || {
      _msg="Failed to deleted key |${_key}| of snapshot |${_snapshot_id}|";
      _logWrapFn 'err' "${_msg}";
      _return_code=1;
    }
  done
  return "${_return_code}";
}
## . END private _deleteSnapshotMetaFn }

## BEGIN private _deleteSnapshotDirsFn {
# Summary   : _deleteSnapshotDirsFn snapshot_id
# Purpose   : Deletes the BTRFS snapshots corresponding to a particular
#             snapshot.
# Example   : _deleteSnapshotDirsFn @1234
# Arguments :
#   snapshot_id - The ID of the snapshot who's underlying BTRFS snapshots are
#     to be deleted.
# Globals   : _rb2MainSnapshotDir, _rb2BootSnapshotDir
# Returns   :
#   2 - btrfs subvolume delete command failed.
#   0 - Success
# Throws    : none
#
_deleteSnapshotDirsFn () {
  declare _snapshot_id _main_snapshot_dir _boot_snapshot_dir;

  _snapshot_id="${1:-}";

  # This intentionally does not have the @ before ${_snapshot_id} because
  # the function is passed a snapshot name, not just a timestamp.
  _main_snapshot_dir="${_rb2MainSnapshotDir}/${_snapshot_id}"
  _boot_snapshot_dir="${_rb2BootSnapshotDir}/${_snapshot_id}"

  # Ensure that either the main or boot or both BTRFS snapshots are present
  # if ! [ -e "${_main_snapshot_dir}" ] \
  #   && ! [ -e "${_boot_snapshot_dir}" # ]; then
  #   _logWrapFn 'err' "Snapshot |${_snapshot_id}| does not exist!"
  #   _logSectAbortFn "${_sect_str}"
  #   return 1
  # fi

  # Delete main snapshot dir if it exists
  if [ -e "${_main_snapshot_dir}" ]; then
    "${_btrfsExe}" subvolume delete --commit-after "${_main_snapshot_dir}" || {
      _logWrapFn 'emerg' \
        "Failed to delete main snapshot dir |${_main_snapshot_dir}|!";
      return 2;
    }
  fi

  # Delete boot snapshot dir if it exists
  if [ -e "${_boot_snapshot_dir}" ]; then
    "${_btrfsExe}" subvolume delete --commit-after "${_boot_snapshot_dir}" || {
      _logWrapFn 'emerg' \
        "Failed to delete boot snapshot dir |${_boot_snapshot_dir}|!";
      return 2;
    }
  fi
}
## . END private _deleteSnapshotDirsFn }

## BEGIN private _deleteSnapshotFn {
# Summary   : _deleteSnapshotFn _snapshot_id
# Purpose   : Deletes a rollback snapshot from the system.
# Example   : _deleteSnapshotFn @1234
# Arguments : _snapshot_id - The ID of the snapshot to delete.
# Globals   : none
# Outputs   : Log info
# Returns   :
#   1 - Failed to delete snapshot
#   2 - Unexpected error occurred while deleting snapshot
#   0 - Success
# Throws    : none
#
_deleteSnapshotFn () {
  declare _sect_str _target_snapshot_id _is_pinned _msg _return_code;

  _sect_str='Delete snapshot';
  _logSectBeginFn "${_sect_str}";

  _target_snapshot_id="${1:-}";
  if [ -z "${_target_snapshot_id}" ]; then
    _logWrapFn 'err' "No snapshot ID provided to ${_sect_str}!";
    _logSectAbortFn "${_sect_str}";
    return 1;
  fi

  # Get pinned status, abort if cannot read
  _is_pinned="$(_readMetadbFn "${_target_snapshot_id}" 'pinned')" || {
    _msg='Could not read pin status for snapshot ';
    _msg+="|${_target_snapshot_id}| from metadb!";
    _logWrapFn 'err' "${_msg}";
    _logSectAbortFn "${_sect_str}";
    return 1;
  }

  # Refuse to delete a pinned snapshot
  if [ "${_is_pinned}" = 'y' ]; then
    _msg='Refusing to delete pinned snapshot ';
    _msg+="|${_target_snapshot_id}|";
    _logWrapFn 'err' "${_msg}";
    _logSectAbortFn "${_sect_str}";
    return 1;
  fi

  _deleteSnapshotDirsFn "${_target_snapshot_id}" || {
    _return_code="$?";
    _logWrapFn 'alert' 'Trouble deleting snapshot directories';
    return "${_return_code}";
  }

  _deleteSnapshotMetaFn "${_target_snapshot_id}" || {
    _return_code="$?";
    _logSectAbortFn;
    return "${_return_code}";
  }
  _logSectEndFn "${_sect_str}";
}
## . END private _deleteSnapshotFn }

## BEGIN private _exitCleanFn {
# Summary   : _exitCleanFn _int;
# Purpose   : Unset traps for exit and then do so.
# Example   : _exitCleanFn 1;
# Arguments : _int
# Globals   : _cm2*
# Outputs   : none
# Returns   : Exit code <_int>
# Throws    : none
#
_exitCleanFn () {
  declare _int;
  _int="$(_cm2EchoIntFn "${1:-0}")";
  trap '' EXIT;
  # If the lock file is deleted after a parallel kfocus-rollback-backend
  # process opens it, but before it locks it, this will cause two parallel
  # kfocus-rollback-backend processes to be able to execute, which is very
  # bad.
  # rm "${_lockFile}" || true;
  exit "${_int}";
}
## . END private _exitCleanFn }

## BEGIN private _getBootMinUnallocFn {
# Summary   : _getBootMinUnallocFn
# Purpose   : Gets the minimum unallocated space that the boot filesystem must
#             have to be safe.
# Example   : _getBootMinUnallocFn
# Arguments : none
# Globals   : none
# Outputs   : Needed unallocated space, in bytes
# Returns   : none
# Throws    : none
#
_getBootMinUnallocFn () {
  # Return number of bytes in 1 GiB
  echo 1073741824;
}
## . END private _getBootMinUnallocFn }

## BEGIN private _getBootPartitionFn {
# Summary   : _getBootPartitionFn
# Purpose   : Gets the boot partition device file.
# Example   : _getBootPartitionFn
# Arguments : none
# Globals   : none
# Outputs   : The path to the device file corresponding to the boot partition.
# Returns   : none
# Throws    : none
#
_getBootPartitionFn () {
  LC_ALL='C' mount | grep btrfs | grep ' on /boot ' \
    | cut -d' ' -f1;
}
## . END private _getBootPartitionFn }

## BEGIN private _getBootUnallocSpaceFn {
# Summary   : _getBootUnallocSpaceFn
# Purpose   : Gets the amount of unallocated space on the boot filesystem.
# Example   : _getBootUnallocSpaceFn
# Arguments : none
# Globals   : none
# Outputs   : Available unallocated space, in bytes
# Returns   : 0 on success, 1 on failure
# Throws    : none
#
_getBootUnallocSpaceFn () {
  declare _boot_usage_report;

  # Extract unallocated space from boot filesystem report
  _boot_usage_report="$(_getBootUsageReportFn)" || return 1;
  awk '/Device unallocated/{ print $3 }' <<< "${_boot_usage_report}" \
    || return 1;
}
## . END private _getBootUnallocSpaceFn }

## BEGIN private _getBootUsageReportFn {
# Summary   : _getBootUsageReportFn
# Purpose   : Gets a report about space usage on the boot filesystem.
# Example   : _getBootUsageReportFn
# Arguments : none
# Globals   : _rb2BootDir
# Outputs   : The report generated by 'btrfs filesystem usage -b'
# Returns   : 0 on success, 1 on failure
# Throws    : none
#
_getBootUsageReportFn () {
  LC_ALL='C' "${_btrfsExe}" filesystem usage -b "${_rb2BootDir}" || return 1;
}
## . END private _getBootUsageReportFn }

## BEGIN private _getMainBtduReportFn {
# Summary   : _getMainBtduReportFn
# Purpose   : Gets a detailed report on the disk usage of individual files on
#             the main filesystem.
# Example   : _getMainBtduReportFn
# Arguments : none
# Globals   : _rb2MainDir
# Outputs   : The report generated by btdu.
# Returns   : 0 on success, 1 on failure
# Throws    : none
#
_getMainBtduReportFn () {
  LC_ALL='C' "${_btduExe}" --du --min-resolution=1M --headless \
    "${_rb2MainDir}" || return 1;
}
## . END private _getMainBtduReportFn }

## BEGIN private _getMainFragReportFn {
# Summary   : _getMainFragReportFn
# Purpose   : Gets a detailed report on the file fragmentation state of
#             individual files on the root subvolume of the main filesystem.
# Example   : _getMainFragReportFn
# Arguments : none
# Globals   : _rb2MainDir
# Outputs   : The report generated by kfocus-report-filefrag.
# Returns   : 0 on success, 1 on failure
# Throws    : none
#
_getMainFragReportFn () {
  "${_filefragExe}" "${_rb2MainDir}/@" || return 1;
}
## . END private _getMainFragReportFn }

## BEGIN private _getMainMinUnallocFn {
# Summary   : _getMainMinUnallocFn
# Purpose   : Gets the minimum unallocated space that the main filesystem must
#             have to be safe.
# Example   : _getMainMinUnallocFn
# Arguments : none
# Globals   : _rb2MainDir
# Outputs   : Needed unallocated space, in bytes
# Returns   : 0 if needed space can be calculated successfully, non-zero otherwise
# Throws    : none
#
_getMainMinUnallocFn () {
  declare _main_usage_report

  _main_usage_report="$(_getMainUsageReportFn)" || return 1;
  # Calculate main filesystem size, return 15% of that
  echo "$(( $(grep $'Device size:\t' <<< "${_main_usage_report}" \
    | awk '{ print $3 }' \
    ) * 15 / 100 ))";
}
## . END private _getMainMinUnallocFn }

## BEGIN private _getMainPartitionFn {
# Summary   : _getMainPartitionFn
# Purpose   : Gets the main partition device file.
# Example   : _getMainPartitionFn
# Arguments : none
# Globals   : none
# Outputs   : The path to the device file corresponding to the main partition.
# Returns   : none
# Throws    : none
_getMainPartitionFn () {
  LC_ALL='C' mount | grep btrfs | grep ' on / ' \
    | cut -d' ' -f1;
}
## . END private _getMainPartitionFn }

## BEGIN private _getMainUnallocSpaceFn {
# Summary   : _getMainUnallocSpaceFn
# Purpose   : Gets the amount of unallocated space on the main filesystem.
# Example   : _getMainUnallocSpaceFn
# Arguments : none
# Globals   : none
# Outputs   : Available unallocated space, in bytes
# Returns   : 0 on success, 1 on failure
# Throws    : none
#
_getMainUnallocSpaceFn () {
  declare _main_usage_report;

  # Extract unallocated space from main filesystem report
  _main_usage_report="$(_getMainUsageReportFn)" || return 1;
  awk '/Device unallocated/{ print $3 }' <<< "${_main_usage_report}" \
    || return 1;
}
## . END private _getMainUnallocSpaceFn }

## BEGIN private _getMainUsageReportFn {
# Summary   : _getMainUsageReportFn
# Purpose   : Gets a report about space usage on the main filesystem.
# Example   : _getMainUsageReportFn
# Arguments : none
# Globals   : _rb2MainDir
# Outputs   : The report generated by 'btrfs filesystem usage -b'
# Returns   : 0 on success, 1 on failure
# Throws    : none
#
_getMainUsageReportFn () {
  LC_ALL='C' "${_btrfsExe}" filesystem usage -b "${_rb2MainDir}" || return 1;
}
## . END private _getMainUsageReportFn }

## BEGIN private _getManualSwitchStateFn {
# Summary   : _getManualSwitchStateFn
# Purpose   : Reads the manual switch state from the snapshot metadb. This
#             value indicates whether kfocus-rollback is taking automatic
#             snapshots or not.
# Example   : _getManualSwitchStateFn
# Arguments : none
# Globals   : none
# Outputs   :
#   If automatic snapshotting is enabled, outputs 'AUTO'.
#   If automatic snapshotting is NOT enabled, outputs 'MANUAL'.
#   Log info goes to stderr.
# Returns   : 0 on success, 1 on failure
# Throws    : none
#
_getManualSwitchStateFn () {
  declare _manual_state_str;

  _manual_state_str="$(_readMetadbFn 'global' 'manualSwitchState')" || {
    _logWrapFn 'err' 'Could not read manual switch state from metadb!';
    return 1;
  }

  if [ -z "${_manual_state_str}" ]; then
    _manual_state_str='MANUAL';
  fi

  if [ "${_manual_state_str}" != 'MANUAL' ] \
    && [ "${_manual_state_str}" != 'AUTO' ]; then
    _logWrapFn 'err' 'Manual switch state is not auto or manual!';
    return 1;
  fi

  echo "${_manual_state_str}";
}
## . END private _getManualSwitchStateFn }

## BEGIN private _getSnapshotReasonFn {
# Summary   : _getSnapshotReasonFn _snapshot_id
# Purpose   : Gets a snapshot's 'reason' and outputs it.
# Example   : _getSnapshotReasonFn @1234
# Arguments : _snapshot_id - the ID of the snapshot to query.
# Globals   : _rb2MainSnapshotDir, _legacySnapshotReasonFile
# Outputs   : A human-readable string specifying the snapshot reason. The
#             string is one of 'Before Package Change', 'System Schedule',
#             'Pre-Rollback', 'Unknown (no reason found)', or 'User Snapshot
#             (username)' where 'username' is replaced with the name of the
#             user who took the snapshot. Log info goes to stderr.
# Returns   : 0 on success, 1 on failure
# Throws    : none
#
_getSnapshotReasonFn () {
  declare _snapshot_id _snapshot_reason_file _snapshot_reason_raw \
    _snapshot_reason;

  _snapshot_id="${1:-}";
  _snapshot_reason_file="${_rb2MainSnapshotDir}/${_snapshot_id}";
  _snapshot_reason_file+="${_legacySnapshotReasonFile}";

  if [ -z "${_snapshot_id}" ]; then
    _logWrapFn 'warn' 'Invalid argument, cannot get snapshot reason';
    return 1;
  fi

  _snapshot_reason_raw="$(_readMetadbFn "${_snapshot_id}" 'reason')" || {
    _logWrapFn 'err' 'Could not read snapshot reason from metadb!'
    return 1;
  }

  # Migrate reason to metadb if stored old-style inside the snapshot
  if [ -z "${_snapshot_reason_raw}" ]; then
    if [ -f "${_snapshot_reason_file}" ]; then
      _snapshot_reason_raw="$(cat "${_snapshot_reason_file}")";
    else
      _snapshot_reason_raw='';
    fi
    if [ -n "${_snapshot_reason_raw}" ]; then
      _writeMetadbFn "${_snapshot_id}" 'reason' "${_snapshot_reason_raw}" || {
        _logWrapFn 'err' 'Could not migrate snapshot reason to metadb!';
        return 1;
      }
    fi
  fi

  case "${_snapshot_reason_raw}" in
    'Apt')
      _snapshot_reason='Before Package Change';
      ;;
    'Timed')
      _snapshot_reason='System Schedule';
      ;;
    'Pre-Rollback')
      _snapshot_reason='Pre-Rollback';
      ;;
    '')
      _snapshot_reason="Unknown (no reason found)"
      ;;
    *) # must be user-generated
      _snapshot_reason="User Snapshot (${_snapshot_reason_raw})";
      ;;
  esac

  echo "${_snapshot_reason}";
}
## . END private _getSnapshotReasonFn }

## BEGIN private _logExitFn {
# Summary   : _logExitFn _log_level _exit_int _msg
# Purpose   : Logs information to the syslog and then immediately exits.
# Example   : _logExitFn 'err' '1' 'Something went wrong!'
# Arguments :
#   _log_level - A string representing the log level to use. One of 'debug',
#     'info', 'notice', 'warning', 'err', 'crit', 'alert', or 'emerg'. See
#     `man 3 syslog` for information on the meanings of these codes.
#   _exit_int  - The code to exit with.
#   _msg       - The message to log.
# Globals   : _cm2*
# Outputs   : Log info
# Returns   : none, exits the script with the code given in _exit_int
# Throws    : none
#
_logExitFn () {
  declare _log_level _exit_int _msg _do_call_stack _stack_str

  _log_level="${1:-}";
  _exit_int="$(_cm2EchoIntFn "${2:-0}")";
  _msg="${3:-}";
  _do_call_stack='n';

  if [ "$$" != "$BASHPID" ]; then
    _logWrapFn 'alert' '_logExitFn was called from a subshell!';
    _do_call_stack='y';
  elif [ "${_exit_int}" != '0' ]; then
    _do_call_stack='y';
  fi

  if [ -n "${_msg}" ]; then
    _logWrapFn "${_log_level}" "${_msg}";
  fi

  if [ "${_do_call_stack}" = 'y' ]; then
    _stack_str="$(_cm2EchoStackFn 2>&1)";
    _logWrapFn "${_log_level}" "Call Stack: |${_stack_str}|";
  fi

  _exitCleanFn "${_exit_int}";
}
## . END private _logExitFn }

## BEGIN private _logPrepareExitFn {
# Summary   : _logPrepareExitFn _log_level _exit_int _msg
# Purpose   : Handles exits by _prepareSystemPublicFn, including displaying an
#             error to all logged-in users.
# Example   : _logPrepareExitFn 'err' '1' 'Something went wrong!'
# Arguments : Same as _logExitFn
# Globals   : _prepareFailMsg
# Outputs   : Log info
# Returns   : none, exits the script with the code given in _exit_int
# Throws    : none
#
_logPrepareExitFn () {
  _promptAllUsersFn 'error' "${_prepareFailMsg}";
  _logExitFn "$@";
}
## . END private _logPrepareExitFn }

## BEGIN private Special begin-end-abort log wrappers {
_logSectAbortFn () {
  _logWrapFn 'notice' "== ABORT : ${1:-Section}";
}
_logSectBeginFn () {
  _logWrapFn 'notice' "== BEGIN : ${1:-Section}";
}
_logSectEndFn () {
  _logWrapFn 'notice' "== . END : ${1:-Section}";
}
## . END private Special begin-end-abort log wrappers }

## BEGIN private _logWrapFn {
# Summary   : _logWrapFn _log_level _msg
# Purpose   : Log to syslog if available, or stderr otherwise
# Example   : _logWrapFn 'err' 'Something went wrong!'
# Arguments :
#   _log_level - A string representing the log level to use. One of 'debug',
#     'info', 'notice', 'warning', 'err', 'crit', 'alert', or 'emerg'. See
#     `man 3 syslog` for information on the meanings of these codes.
#   _msg       - The message to log.
# Globals   : _cm2*
# Outputs   : Log info
# Returns   : none
# Throws    : none
#
_logWrapFn () {
  declare _priority_key _message;
  _priority_key="${1:-warn}";
  _message="${2:-Unspecified issue}";
  if [ "$(type -t '_cm2LogFn')" = 'function' ]; then
    # We assume this will echo to STDERR and syslog
    # On non-zero exit, we fall back to logging to STDERR.
    _cm2LogFn "${_priority_key}" "${_message}" && return;
  fi

  1>&2 echo "${_baseName} - ${_priority_key}: ${_message}";
}
## . END private _logWrapFn }

## BEGIN private _promptAllUsersFn {
# Summary   : _promptAllUsersFn _mode_str _msg_str
# Purpose   : Displays a graphical message to all users with an active
#             graphical login.
# Example   : _promptAllUsersFn 'error' 'An error has occurred!'
# Arguments :
#   _mode_str - What kind of message to display, see package-main ->
#     kfocus-focusrx-dbus-dispatch for accepted values. Examples
#     at time of writing include 'info', 'warning', 'error',
#     'rollbackLowMainSpace', and 'rollbackLowBootSpace'.
#   _msg_str - The message to display to the user.
# Globals   : DISPLAY, DBUS_SESSION_BUS_ADDRESS
# Outputs   : none
# Returns   : none
# Throws    : none
#
# See https://stackoverflow.com/a/49533938
_promptAllUsersFn () {
  declare _mode _msg _xserver_id _user_name;
  _mode="${1:-info}";
  _msg="${2:-blank}";

  # Get all running X servers
  while read -r _xserver_id; do
    # Determine username of one graphically logged-in user
    _user_name="$(
      who | grep "(:${_xserver_id})" | head -n1 | awk '{ print $1 }'
    )";
    if [ -z "${_user_name}" ]; then continue; fi

    # Switch to the user and send a D-Bus message to their corresponding
    # kfocus-focusrx-dbus-dispatch process
    sudo -u "${_user_name}" \
      DISPLAY="${_xserver_id}" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "${_user_name}")/bus" \
      qdbus org.kfocus.FocusRxDispatch.launcher / "${_mode}" "${_msg}";
  done < <(_cm2LsFn '/tmp/.X11-unix/' | sed 's?X??');
}
## . END private _promptAllUsersFn }

## BEGIN private _readMetadbFn {
# Summary   : _readMetadbFn _group_str _key_str
# Purpose   : Reads a value from the kfocus-rollback snapshot metadata
#             database (metadb).
# Example   : _readMetadbFn @1234 name
# Arguments :
#   _group_str - The data group in which the value should be found.
#      Often, our groups are named after snapshot IDs, e.g. '@1234'.
#   _key_str - The key associated with the desired data.
#   IMPORTANT: If either a group or key does not exist, an empty string
#     is returned. It is NOT an error condition. This routine also
#     creates an empty metadb file if it does not already exist.
# Globals   : _rb2MainDir, _snapshotMetaDb
# Outputs   : A string representing the desired data. Note that for data
#             representing user-defined strings, this will always be
#             base64-encoded.
# Returns   : 0 on success, 2 on failure (meaning metadb error)
# Throws    : none
#
_readMetadbFn () {
  declare _group_str _key_str _err_msg _result_str;

  _group_str="${1:-}";
  _key_str="${2:-}";
  _err_msg='Cannot read metadb: ';

  if ! [ -d "${_rb2MainDir}" ]; then
    _logWrapFn 'err' "${_err_msg} No main dir |${_rb2MainDir}|";
    return 2;
  fi

  [ -n "${_group_str}" ] || {
    _logWrapFn 'err' "${_err_msg} No group string provided.";
    return 2;
  }

  [ -n "${_key_str}" ] || {
    _logWrapFn 'err' "${_err_msg} No key string provided.";
    return 2;
  }

  if ! _checkCreateMetadbFn; then
    _logWrapFn 'err' "${_err_msg} Metadb is not a valid file.";
    return 2;
  fi

  # Read failure here is almost impossible: It will succeed even if
  # the file cannot be created, or group or key is bad.
  # Only weird edge cases like perhaps a bad value can trigger exit.
  _result_str="$("${_kreadconfig5Exe}" \
    --file "${_snapshotMetaDb}" \
    --group "${_group_str}" \
    --key "${_key_str}")" || {
      _logWrapFn 'err' "${_err_msg} |${_group_str}:${_key_str}|";
      return 2;
    }

  # TODO: Use more sophisticated defaults handling than this, ideally we'd
  # have a master list of allowable keys and default values we could use here.
  if [ "${_key_str}" = 'pinned' ] \
    && [ -z "${_result_str}" ]; then
    echo 'n';
  else
    echo "${_result_str}";
  fi
}
## . END private _readMetadbFn }

## BEGIN private _trapExitFn {
# Summary   : _trapExitFn
# Purpose   : Catches unexpected exits and logs them.
# Example   : trap _trapExitFn EXIT
# Arguments : none
# Globals   : _baseName
# Outputs   : Log info
# Returns   : none
# Throws    : none
#
_trapExitFn () {
  _logWrapFn 'warn' "${_baseName} was interrupted";

  # If the lock file is deleted after a parallel kfocus-rollback-backend
  # process opens it, but before it locks it, this will cause two parallel
  # kfocus-rollback-backend processes to be able to execute, which is very
  # bad.
  # rm "${_lockFile}" || true;
}
## . END private _trapExitFn }

## BEGIN private _scrubSnapshotsFn () {
# Summary   : _scrubSnapshotsFn
# Purpose   : Remove snapshots that do not have matched main and boot
#             directories.
# Example   : _scrubSnapshotsFn
# Arguments : none
# Globals   : _rb2MainSnapshotDir, _rb2BootSnapshotDir
# Outputs   : Log info
# Returns   : 0 on success, 2 if a BTRFS snapshot deletion fails.
#
_scrubSnapshotsFn () {
  declare _main_snapshot_list _boot_snapshot_list _snapshot_id;
  # Get main and boot snapshot lists
  readarray -t _main_snapshot_list <<< "$(
    _cm2LsFn "${_rb2MainSnapshotDir}" | sed 's/@//' | sort -n | sed 's/^/@/'
  )";
  readarray -t _boot_snapshot_list <<< "$(
    _cm2LsFn "${_rb2BootSnapshotDir}" | sed 's/@//' | sort -n | sed 's/^/@/'
  )";

  # Remove main snapshots with no corresponding boot snapshots
  if (( ${#_main_snapshot_list[@]} > 0 )) \
   && [ -n "${_main_snapshot_list[0]}" ]; then
    for _snapshot_id in "${_main_snapshot_list[@]}"; do
      if ! [[ " ${_boot_snapshot_list[*]} " \
        =~ [[:space:]]${_snapshot_id}[[:space:]] ]]; then
        _deleteSnapshotDirsFn "${_snapshot_id}" || {
          _logWrapFn 'alert' \
            "Failed to delete unpaired main snapshot |${_snapshot_id}|!";
          return 2;
        }
        # Remove any metadata
         _deleteSnapshotMetaFn "${_snapshot_id}";

        _logWrapFn 'warn' \
          "Mismatched snapshot |${_snapshot_id}| trimmed from main.";
      fi
    done
  fi

  # Remove boot snapshots with no corresponding main snapshots
  if (( ${#_boot_snapshot_list[@]} > 0 )) \
    && [ -n "${_boot_snapshot_list[0]}" ]; then
    for _snapshot_id in "${_boot_snapshot_list[@]}"; do
      if ! [[ " ${_main_snapshot_list[*]} " \
        =~ [[:space:]]${_snapshot_id}[[:space:]] ]]; then
        _deleteSnapshotDirsFn "${_snapshot_id}" || {
          _logWrapFn 'alert' \
            "Failed to delete unpaired main snapshot |${_snapshot_id}|!";
          return 2;
        }
        # Remove any metadata
         _deleteSnapshotMetaFn "${_snapshot_id}";

        _logWrapFn 'warn' \
          "Mismatched snapshot |${_snapshot_id}| trimmed from boot.";
      fi
    done
  fi
}
## . END private _scrubSnapshotsFn }

## BEGIN private _trimSnapshotsFn {
# Summary   : _trimSnapshotsFn
# Purpose   : Finds old unpinned snapshots, and deletes them. All pinned
#             snapshots will be preserved regardless of age, and the five
#             newest unpinned snapshots will also be preserved. All other
#             snapshots are deleted.
# Example   : _trimSnapshotsPublicFn
# Arguments : none
# Globals   : _rb2SnapshotMainDir
# Outputs   : Log output
# Returns   : 0 on success, 2 on snapshot deletion failure
# Throws    : none
#
_trimSnapshotsFn () {
  declare _sect_str _main_list _main_count _remove_count \
    _snapshot_id _is_pinned _unpinned_list _unpinned_count _idx;

  _sect_str='Trim snapshots';
  _logSectBeginFn "${_sect_str}";

  # Remove snapshots that do not have matched main and boot components
  _scrubSnapshotsFn || _logWrapFn 'warn' 'Trouble scrubbing snapshots';

  # Read list of main snapshots
  readarray -t _main_list <<< "$(
    _cm2LsFn "${_rb2MainSnapshotDir}" | sed 's/@//' | sort -n | sed 's/^/@/'
  )";

  _main_count="${#_main_list[@]}";
  if (( _main_count < 1 )) || [ -z "${_main_list[0]}" ]; then
    _logWrapFn 'notice' 'No snapshots to trim.';
    _logSectEndFn "${_sect_str}";
    return 0;
  fi

  _unpinned_list=();
  for _snapshot_id in "${_main_list[@]}"; do
    _is_pinned="$(_readMetadbFn "${_snapshot_id}" 'pinned')" || {
      _logWrapFn 'alert' 'Snapshot trim halted, metadb read failure!';
      _logSectAbortFn "${_sect_str}";
      return 2;
    }
    if [ "${_is_pinned}" != 'y' ]; then
      _unpinned_list+=("${_snapshot_id}");
    fi
  done

  # Trim unpinned snapshots down to no more than 5
  _unpinned_count="${#_unpinned_list[@]}";
  _remove_count='0';
  if (( _unpinned_count > 5 )); then
    _remove_count=$(( _unpinned_count - 5 ));
    for (( _idx = 0; _idx < _remove_count; _idx++ )); do
      _snapshot_id="${_unpinned_list[_idx]}";
      _deleteSnapshotFn "${_snapshot_id}" || {
        _logWrapFn 'alert' "Failed to delete snapshot |${_snapshot_id}|!";
        _logSectAbortFn "${_sect_str}";
        return 2;
      }
    done
  fi

  _logWrapFn 'notice' "Snapshots trimmed, removed |${_remove_count}|.";
  _logSectEndFn "${_sect_str}";
}
## . END private _trimSnapshotsFn }

## BEGIN private _writeMetadbFn {
# Summary   : _writeMetadbFn _group_str _key_str _val_str
# Purpose   : Writes a value to or deletes a value from the kfocus-rollback
#             snapshot metadata database (metadb).
# Example   : _writeMetadbFn '@1234' 'name' 'bmV3IG5hbWU='
# Arguments :
#   _group_str - The data group in which the value should be written.
#      Often, our groups are named after snapshot IDs, e.g. '@1234'.
#   _key_str   - The key to associate with the provided data.
#   _val_str   - The string to be stored. If blank, delete the key.
# Globals   : _rb2MainDir, _snapshotMetaDb
# Outputs   : none
# Returns   : 0 on success, 2 on failure (meaning metadb error)
# Throws    : none
#
_writeMetadbFn () {
  declare _group_str _key_str _val_str _err_msg _fail_msg _cmd_list;

  _group_str="${1:-}";
  _key_str="${2:-}";
  _val_str="${3:-}";
  _err_msg='Cannot write to metadb: ';

  if ! [ -d "${_rb2MainDir}" ]; then
    _wrapLogFn 'err' "${_err_msg} No main dir |${_rb2MainDir}|";
    return 2;
  fi

  if [ -z "${_group_str}" ]; then
    _wrapLogFn 'err' "${_err_msg} No group string provided.";
    return 2;
  fi

  if [ -z "${_key_str}" ]; then
    _wrapLogFn 'err' "${_err_msg} No key string provided.";
    return 2;
  fi

  if ! _checkCreateMetadbFn; then
    _logWrapFn 'err' "${_err_msg} Metadb is not a valid file.";
    return 2;
  fi

  _cmd_list=( "${_kwriteconfig5Exe}"
    '--file'  "${_snapshotMetaDb}"
    '--group' "${_group_str}"
    '--key'    "${_key_str}"
  );

  if [ -z "${_val_str}" ]; then
    _cmd_list+=( '--delete' );
    _fail_msg="Failed to delete key |${_key_str}|";
  else
    _cmd_list+=( "${_val_str}" );
    _fail_msg="Failed to write |${_key_str}:${_val_str}|";
  fi

  # Write to metadb. Since we already checked for file and permissions,
  #   and non-existent key or groups are supported, failure here should
  #   be nearly impossible.
  "${_cmd_list[@]}" || {
    _logWrapFn 'err' "${_err_msg} ${_fail_msg}";
    return 2;
  }
}
## . END private _writeMetadbFn }
## . END PRIVATE FUNCTIONS ==================================================

## BEGIN PUBLIC FUNCTIONS ===================================================
## BEGIN _btrfsDeepCleanPublicFn {
# Summary   : _btrfsDeepCleanPublicFn
# Purpose   : Runs an intensive BTRFS optimization routine. Currently, this
#             deletes all snapshots, balances main and boot filesystems
#             (forcing a balance on the main FS), and defragments highly
#             fragmented files on the main filesystem.
# Example   : _btrfsDeepCleanPublicFn
# Arguments : none
# Globals   : none
# Outputs   : Log info
# Returns   : none
# Throws    :
#   1:
#     - Calling user is not root, or
#     - BTRFS status is not SUPPORTED, AUTO or SUPPORTED, MANUAL.
#   2:
#     - Could not delete all snapshots,
#     - Could not balance main filesystem,
#     - Could not balance boot filesystem, or
#     - Could not defragment files on the main filesystem.
#
_btrfsDeepCleanPublicFn () {
  _checkRootFn             || _logExitFn 'warn' '1' \
    'BTRFS deep cleaning requires root permissions!';
  _checkBtrfsStatusSetUpFn || _logExitFn 'warn' '1' \
    'BTRFS status prevents BTRFS deep cleaning!';

  _logWrapFn 'notice' "BTRFS deep clean operation started.";
  _deleteAllSnapshotsFn    || _logExitFn 'alert' '2' \
    'Failed to delete all snapshots during BTRFS deep cleaning!';
  _balanceMainFn 'y'       || _logExitFn 'alert' '2' \
    'Issues encountered balancing main filesystem during BTRFS deep cleaning!';
  _balanceBootFn           || _logExitFn 'alert' '2' \
    'Issues encountered balancing boot filesystem during BTRFS deep cleaning!';
  _defragmentFn            || _logExitFn 'alert' '2' \
    'Failed to defragment files during BTRFS deep cleaning!';
  _logWrapFn 'notice' "BTRFS deep clean operation complete.";
}
## . END _btrfsDeepCleanPublicFn }

## BEGIN _btrfsMaintainPublicFn {
# Summary   : _btrfsMaintainPublicFn
# Purpose   : Runs routine snapshot maintenance. Currently, this simply
#             balances main and boot filesystems.
# Example   : _btrfsMaintainPublicFn
# Arguments : none
# Globals   : none
# Outputs   : Log info
# Returns   : none
# Throws    :
#   1:
#     - Calling user is not root, or
#     - BTRFS status is not SUPPORTED, AUTO or SUPPORTED, MANUAL.
#   2:
#     - Could not balance main filesystem, or
#     - Could not balance boot filesystem.
#
_btrfsMaintainPublicFn () {
  _checkRootFn             || _logExitFn 'warn' '1' \
    'BTRFS maintenance requires root permissions!';
  _checkBtrfsStatusSetUpFn || _logExitFn 'warn' '1' \
    'BTRFS status prevents BTRFS maintenance!';

  _logWrapFn 'notice' "Routine BTRFS maintenance started.";
  _balanceMainFn 'n'       || _logExitFn 'alert' '2' \
    'Issues encountered balancing main filesystem!';
  _balanceBootFn           || _logExitFn 'alert' '2' \
    'Issues encountered balancing boot filesystem!';
  _logWrapFn 'notice' "Routine BTRFS maintenance complete.";
}
## . END _btrfsMaintainPublicFn }

## BEGIN _checkBootUnallocSpacePublicFn {
# Summary   : _checkBootUnallocSpacePublicFn
# Purpose   : A public wrapper around _checkBootUnallocSpaceFn. Shows an error
#             message to all graphically logged-in users if boot filesystem
#             space is found to be low.
# Example   : _checkBootUnallocSpacePublicFn
# Arguments : none
# Globals   : _lowBootMsg
# Outputs   : Log info
# Returns   : none
# Throws    :
#   1:
#     - BTRFS status is not SUPPORTED, AUTO or SUPPORTED, MANUAL, or
#     - Unallocated space on the boot partition is dangerously low.
#
_checkBootUnallocSpacePublicFn () {
  _checkBtrfsStatusSetUpFn || _logExitFn 'warn' '1' \
    'BTRFS status is not compatible with checking boot unallocated space!';
  if ! _checkBootUnallocSpaceFn; then
    _promptAllUsersFn 'rollbackLowBootSpace' "${_lowBootMsg}";
    _logExitFn 'err' '1' 'Low boot space detected!';
  fi
}
## . END _checkBootUnallocSpacePublicFn }

## BEGIN _checkMainUnallocSpacePublicFn {
# Summary   : _checkMainUnallocSpacePublicFn
# Purpose   : A public wrapper around _checkMainUnallocSpaceFn. Shows an error
#             message to all graphically logged-in users if main filesystem
#             space is found to be low.
# Example   : _checkMainUnallocSpacePublicFn
# Arguments : none
# Globals   : _lowDiskMsg
# Outputs   : Log info
# Returns   : none
# Throws    :
#   1:
#     - BTRFS status is not SUPPORTED, AUTO or SUPPORTED, MANUAL, or
#     - Unallocated space on the main partition is dangerously low.
#
_checkMainUnallocSpacePublicFn () {
  _checkBtrfsStatusSetUpFn || _logExitFn 'warn' '1' \
    'BTRFS status is not compatible with checking main unallocated space!';

  if ! _checkMainUnallocSpaceFn; then
    _promptAllUsersFn 'rollbackLowMainSpace' "${_lowDiskMsg}";
    _logExitFn 'err' '1' 'Low disk space detected!';
  fi
}
## . END _checkMainUnallocSpacePublicFn }

## BEGIN _clearRestorePublicFn {
# Summary   : _clearRestorePublicFn
# Purpose   : Deletes a flag file indicating that the system has rebooted
#             after a successful snapshot restore.
# Example   : _clearRestorePublicFn
# Arguments : none
# Globals   : _rb2RestoreCompleteFile
# Outputs   : Log info
# Returns   : none
# Throws    :
#   1:
#     - Calling user is not root, or
#     - Could not remove restore complete flag.
#
_clearRestorePublicFn () {
  _checkRootFn || _logExitFn 'warn' '1' \
    'Clearing the restore flag requires root permissions!';
  rm -f "${_rb2RestoreCompleteFile}" \
    || _logExitFn 'err' '1' "Could not remove |${_rb2RestoreCompleteFile}|!";
  _logWrapFn 'notice' 'Restore flag cleared.';
}
## . END _clearRestorePublicFn }

## BEGIN _compareStatePublicFn {
# Summary   : _compareStatePublicFn _source_state_dir _target_state_dir
# Purpose   : Compares two directories to each other using `diff -r --brief`.
#             Intended to be used for comparing two snapshots, or a snapshot
#             and the actively running system.
# Example   : _compareStatePublicFn \
#             "${_rb2MainDir}/@kfocus-rollback-snapshots/@1234" \
#             "${_rb2MainDir}/@";
# Arguments :
#   _source_state_dir - The directory containing the 'source' system state.
#     This will usually (but not always) be the path to a snapshot.
#   _target_state_dir - The directory containing the 'target' system state.
#     This will usually (but not always) be the path to a newer snapshot or the
#     current system state.
#   Note that _source_state_dir and _target_state_dir could point to any two
#   directories - dir1 may point to a newer system state than dir2, or
#   theoretically they could even point to typical directories rather than
#   system state directories.
# Globals   : none
# Outputs   : The `diff -r --brief` output resulting from diffing the two
#             directories.
# Returns   : none
# Throws    :
#   1:
#     - Calling user is not root,
#     - BTRFS status is not SUPPORTED, AUTO or SUPPORTED, MANUAL,
#     - Insufficient number of arguments provided,
#     - Source or target dir does not exist or is not actually a directory.
#
_compareStatePublicFn () {
  declare _source_state_dir _target_state_dir;

  _checkRootFn || _logExitFn 'warn' '1' \
    'State comparison requires root permissions!';
  _checkBtrfsStatusSetUpFn || _logExitFn 'warn' '1' \
    'BTRFS status prevents state comparison!';

  # Ensure source and target dirs actually exist
  _source_state_dir="${1:-}";
  [ -z "${_source_state_dir}" ] && _logExitFn 'err' '1' \
    'No source state dir provided to compare!';
  ! [ -d "${_source_state_dir}" ] && _logExitFn 'err' '1' \
    'Specified source state dir does not exist or is not a dir!';
  _target_state_dir="${2:-}";
  [ -z "${_target_state_dir}" ] && _logExitFn 'err' '1' \
    'No target state dir provided to compare!';
  ! [ -d "${_target_state_dir}" ] && _logExitFn 'err' '1' \
    'Specified target state dir does not exist or is not a dir!';

  # Diff directories, return filenames only
  "${_diffExe}" -r --brief "${_source_state_dir}" "${_target_state_dir}";
}
## . END _compareStatePublicFn }

## BEGIN _createSnapshotPublicFn {
# Summary   : _createSnapshotPublicFn _snapshot_reason
# Purpose   : A public wrapper around _createSnapshotFn.
# Example   : _createSnapshotPublicFn 'Apt'
# Arguments : Same as _createSnapshotFn
# Globals   : _lowDiskMsg
# Outputs   : Log info
# Returns   : none
# Throws    :
#   1:
#     - Calling user is not root,
#     - BTRFS status is not SUPPORTED, AUTO or SUPPORTED, MANUAL,
#     - Main unallocated space is dangerously low,
#     - Boot unallocated space is dangerously low, or
#     - _createSnapshotFn returned 1.
#   2:
#     - _createSnapshotFn returned 2.
#
_createSnapshotPublicFn () {
  declare _return_code;

  _checkRootFn || _logExitFn 'warn' '1' \
    'Creating a snapshot requires root permissions!';
  _checkBtrfsStatusSetUpFn || _logExitFn 'warn' '1' \
    'BTRFS status prevents creating a snapshot!';
  _checkMainUnallocSpaceFn || {
    _promptAllUsersFn 'rollbackLowMainSpace' "${_lowDiskMsg}";
    _logExitFn 'err' '1' \
      'Main disk space is too low to take a snapshot!';
  }
  _checkBootUnallocSpaceFn || {
    _promptAllUsersFn 'rollbackLowBootSpace' "${_lowBootMsg}";
    _logExitFn 'err' '1' \
      'Boot disk space is too low to take a snapshot!';
  }

  _createSnapshotFn "$@";
  _return_code="$?";

  if [ "${_return_code}" = '1' ]; then
    _logWrapFn 'notice' 'Could not take a snapshot.';
  elif [ "${_return_code}" = '2' ]; then
    _logExitFn 'alert' '2' 'A critical error occurred while taking a snapshot!';
  fi
}
## . END _createSnapshotPublicFn }

## BEGIN _deleteSnapshotPublicFn {
# Summary   : _deleteSnapshotPublicFn _snapshot_id
# Purpose   : A public wrapper around _deleteSnapshotFn.
# Example   : _deleteSnapshotPublicFn @1234
# Arguments : Same as _deleteSnapshotFn
# Globals   : none
# Outputs   : Log info
# Returns   : none
# Throws    :
#   1:
#     - Calling user is not root,
#     - BTRFS status is not SUPPORTED, AUTO or SUPPORTED, MANUAL, or
#     - _deleteSnapshotFn returned 1.
#   2:
#     - _deleteSnapshotFn returned 2.
#
_deleteSnapshotPublicFn () {
  declare _return_code;

  _checkRootFn || _logExitFn 'warn' '1' \
    'Deleting a snapshot requires root permissions!';
  _checkBtrfsStatusSetUpFn || _logExitFn 'warn' '1' \
    'BTRFS status is incompatible with deleting a snapshot!';

  _deleteSnapshotFn "${1:-}";
  _return_code="$?";

  if [ "${_return_code}" = '1' ]; then
    _logExitFn 'err' '1' 'Could not delete snapshot!';
  elif [ "${_return_code}" = '2' ]; then
    _logExitFn 'alert' '2' 'A critical error occurred while deleting a snapshot!';
  fi
}
## . END _deleteSnapshotPublicFn }

## BEGIN _finalizeRestorePublicFn {
# Summary   : _finaliseRestorePublicFn
# Purpose   : Cleans up leftover subvolumes after a snapshot restore. The
#             restoration process leaves two subvolumes behind that are needed
#             during snapshot restoration, but that are unnecessary
#             once the system is rebooted after the restore is complete, so
#             this cleans them up.
# Example   : _finalizeRestorePublicFn
# Arguments : none
# Globals   : _rb2MainWorkingDir, _rb2BootWorkingDir
# Outputs   : Log info
# Returns   : none
# Throws    :
#   1:
#     - Calling user is not root,
#     - BTRFS status is not SUPPORTED, AUTO or SUPPORTED, MANUAL, or
#     - Restore operation is half-done.
#   2:
#     - Deleting either the main or the boot leftover subvolume failed.
#
_finalizeRestorePublicFn () {
  _checkRootFn || _logExitFn 'warn' '1' \
    'Finalizing restoration requires root permissions!';
  _checkBtrfsStatusSetUpFn || _logExitFn 'warn' '1' \
    'BTRFS status is incompatible with finalizing a restore process!';

  # Ensure system is not in post-restore pre-reboot state
  if ! mount | grep 'btrfs' | grep -q '@kfocus-rollback-working' \
    && ! mount | grep 'btrfs' | grep -q '@kfocus-rollback-working-boot'; then

    # Delete obsolete main working subvol made during restore
    if [ -d "${_rb2MainWorkingDir}" ]; then
      "${_btrfsExe}" subvolume delete \
        --commit-after "${_rb2MainWorkingDir}" \
        || _logExitFn 'emerg' '2' 'Failed to finalize restore for main filesystem!';
    fi

    # Delete obsolete boot working subvol made during restore
    if [ -d "${_rb2BootWorkingDir}" ]; then
      "${_btrfsExe}" subvolume delete \
        --commit-after "${_rb2BootWorkingDir}" \
        || _logExitFn 'emerg' '2' 'Failed to finalize restore for boot filesystem!';
    fi
  else
    _logExitFn 'err' '1' 'Cannot finalize restore, restore operation half-done!';
  fi
  _logWrapFn 'notice' 'Restore operation successfully finalized, if needed.';
}
## . END _finalizeRestorePublicFn }

## BEGIN _getBootMinUnallocPublicFn {
