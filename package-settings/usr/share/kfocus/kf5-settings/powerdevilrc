[AC][Display]
DisplayBrightness=75
UseProfileSpecificDisplayBrightness=true

[AC][Keyboard]
KeyboardBrightness=40
UseProfileSpecificKeyboardBrightness=true

[AC][Performance]
PowerProfile=balanced

[AC][RunScript]
ProfileLoadCommand=/usr/lib/kfocus/bin/kfocus-pstate -s AC

[AC][SuspendAndShutdown]
AutoSuspendAction=0
AutoSuspendIdleTimeoutSec=600
InhibitLidActionWhenExternalMonitorPresent=false

[Battery][Display]
DisplayBrightness=33
UseProfileSpecificDisplayBrightness=true

[Battery][Keyboard]
KeyboardBrightness=0
UseProfileSpecificKeyboardBrightness=true

[Battery][Performance]
PowerProfile=power-saver

[Battery][RunScript]
ProfileLoadCommand=/usr/lib/kfocus/bin/kfocus-pstate -s Battery

[Battery][SuspendAndShutdown]
InhibitLidActionWhenExternalMonitorPresent=false

[LowBattery][Display]
DisplayBrightness=20

[LowBattery][Keyboard]
KeyboardBrightness=0
UseProfileSpecificKeyboardBrightness=true

[LowBattery][Performance]
PowerProfile=power-saver

[LowBattery][RunScript]
ProfileLoadCommand=/usr/lib/kfocus/bin/kfocus-pstate -s LowBattery

[LowBattery][SuspendAndShutdown]
InhibitLidActionWhenExternalMonitorPresent=false

