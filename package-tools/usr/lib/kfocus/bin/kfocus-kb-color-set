#!/bin/bash
#
# Copyright 2020-2025 MindShare Inc.
# Written for Kubuntu Focus by:
# Michael Mikowski, Erich Eickmeyer, Aaron Rainbolt
#
# Name    : kfocus-kb-color-set
# Purpose : Run-as-root utility to set keyboard LEDs
# License : GPL v2
# Run By  : kfocus-kb-color
# Spec    : 615
#
set -u;

## == BEGIN private functions ========================================= {
## BEGIN _importCommonFn {
# Summary   : _importCommonFn
# Purpose   : Load common routines, prefer relative dir
# Example   : _importCommonFn;
# Arguments : none
# Globals   : Package vars _baseDir _baseName
# Outputs   : none
# Returns   : none
#
_importCommonFn () {
  declare _lib_list _is_loaded _lib_file;
  _lib_list=(
    "${_baseDir}/lib/common.2.source"
    '/usr/lib/kfocus/lib/common.2.source'
  );
  _is_loaded='n';
  for _lib_file in "${_lib_list[@]}"; do
    if [ -r "${_lib_file}" ]; then
      # shellcheck source=/usr/lib/kfocus/lib/common.2.source
      if source "${_lib_file}"; then
        _is_loaded='y';
        break;
      fi
    fi
  done

  if [ "${_is_loaded}" = 'n' ]; then
    echo 1>&2 "${_baseName}: ABORT - Cannot source common lib";
    exit 202;
  fi
}
## . END _importCommonFn }

## BEGIN Scrubbers for hex_str, bright_int, bright_byte, enable_int
_echoSafeHexStrFn () {
  declare _hex_str;
  _hex_str="${1:-}";
  if [[ ! "${_hex_str}" =~ ^[0-9a-fA-F]{6}$ ]]; then
    _cm2WarnStrFn "Invalid hex_str |${_hex_str}| set to |${_defaultHexStr}|";
    _hex_str="${_defaultHexStr}";
  fi
  echo "${_hex_str}";
}
_echoSafeBrightIntFn () {
  declare _bright_int;
  _bright_int="$(_cm2EchoIntFn "${1:-}")";
  if (( _bright_int < 0 || _bright_int > 10 )); then
    _cm2WarnStrFn "Invalid bright_int |${_bright_int}| set to |${_defaultBrightInt}|";
    _bright_int="${_defaultBrightInt}";
  fi
  echo "${_bright_int}";
}
_echoSafeByteFn () {
  declare _bright_byte;
  _bright_byte="$(_cm2EchoIntFn "${1:-}")";
  if (( _bright_byte < 0 || _bright_byte > 255 )); then
    _bright_byte="${_defaultBrightByte}";
    _cm2WarnStrFn "Invalid bright_byte |${_bright_byte}| set to |${_defaultBrightByte}|";
  fi
  echo "${_bright_byte}";
}
_echoSafeBoolIntFn () {
  declare _enable_int;
  _enable_int="$(_cm2EchoIntFn "${1:-}")";
  if (( _enable_int < 0 || _enable_int > 1 )); then
    _enable_int=1;
    _cm2WarnStrFn "Invalid enable_int |${_enable_int}| set to |1|";
  fi
  echo "${_enable_int}";
}
_slurpFileFn () {
  declare _file;
  _file="${1:-}";
  if [ -z "${_file}" ]; then 
    _cm2WarnStrFn "File argument cannot be empty";
    return 1;
  fi

  if [ ! -f "${_file}" ]; then
		_cm2WarnStrFn "Cannot read non-existent file |${_file}|";
    return 1;
	fi

  head -n1 "${_file}";
}
_writeRegisterFn () {
  declare _file _str _do_create;
  _file="${1:-}";
  _str="${2:-}";
  _do_create="${3:-}";
  if [ -z "${_file}" ]; then 
    _cm2WarnStrFn "File argument cannot be empty";
    return 1;
  fi

  if [ ! -f "${_file}" ] && [ -z "${_do_create}" ]; then
    _cm2WarnStrFn "Could not find register |${_file}|";
    return 1;
  fi

  if ! echo "${_str}" > "${_file}"; then
    _cm2WarnStrFn "Trouble writing |${_str}| to |${_file}|";
    return 1;
  fi
}
## . END Scrubbers for hex_str, bright_int, bright_byte, enable_int

## BEGIN _convertBrightIntToByteFn {
# Purpose: Convert value from range 0-10 to 0-255.
#
_convertBrightIntToByteFn () {
  declare _bright_byte;
  _bright_byte="$(_echoSafeByteFn "$(( ${1:-0} * 25 ))")";
  if (( _bright_byte > 237 )); then _bright_byte=255; fi
  echo "${_bright_byte}";
}
## . END _convertBrightIntToByteFn }

## BEGIN _convertBrightByteToIntFn {
# Purpose: Convert value from range 0-255 to 0-10.
#
_convertBrightByteToIntFn () {
  _echoSafeBrightIntFn "$(( "${1:-0}" / 25 ))";
}
## . END _convertBrightByteToIntFn }


## BEGIN _iteCalcKbdStateFn {
# Purpose: Calculate kbd state and save to _configStateList.
#
_iteCalcKbdStateFn () {
  declare _slurp_str _bright_int _rgb_file _hex_str _enable_int;

  _slurp_str="$(_slurpFileFn "${_iteBrightFile}")";
  _bright_int="$(_echoSafeBrightIntFn "${_slurp_str}")";

  _rgb_file="${_iteRgbDir}/rgb:kbd_backlight/multi_intensity";
  _slurp_str="$(_slurpFileFn "${_rgb_file}")";
  _hex_str="$(_convertRgbToHexFn "${_slurp_str}")";

  # If the kbd has brightness, then the user pressed keys.
  #   In this case, change enable_int to 1.
  [ "${_bright_int}" = '0' ] && _enable_int=0 || _enable_int=1;
  _configStateList=( "${_bright_int}" "${_hex_str}" "${_enable_int}" );
}
## . END _iteCalcKbdStateFn }

## BEGIN _iteReadFileListFn {
# Purpose: Read kbd state file into _configStateList.
#
_iteReadStateFileFn () {
  declare _calc_file _str _val_list _bright_int _hex_str _enable_int;
  [ -z "${1:-}" ] && _calc_file="${_iteStateFile}" || _calc_file="$1";

  # Create the state file if needed
  if [ ! -f "${_calc_file}" ]; then
    _iteCalcKbdStateFn;
    _iteWriteStateFileFn "${_calc_file}";
  fi

  # Read and process state file contents.
  _str="$(_slurpFileFn "${_calc_file}")";
  IFS=';' read -r -a _val_list <<< "${_str}";

  _bright_int="$(_echoSafeBrightIntFn "${_val_list[0]:-}")";
  _hex_str="$(   _echoSafeHexStrFn    "${_val_list[1]:-}")";
  _enable_int="$(_echoSafeBoolIntFn "${_val_list[2]:-}")";

  _configStateList=( "${_bright_int}" "${_hex_str}" "${_enable_int}" );
}
## . END _iteReadFileListFn }

## BEGIN _iteRestoreKbdFn {
# Purpose: Restores color and brightness from _configStateList.
#
_iteRestoreKbdFn () {
  declare _bright_int _rgb_str _rgb_file \
    _enable_int _line_dir _calc_bright_int;

  _bright_int="$(_echoSafeBrightIntFn "${_configStateList[0]:-}")";
  _rgb_str="$(   _convertHexToRgbFn   "${_configStateList[1]:-}")";
  _enable_int="$(_echoSafeBoolIntFn "${_configStateList[2]:-}")";

  if [ -d "${_iteRgbDir}" ]; then
    while read -r _line_dir; do
      _rgb_file="${_line_dir}/multi_intensity";
      _writeRegisterFn "${_rgb_file}" "${_rgb_str}";
    done < <(find "${_iteRgbDir}" -maxdepth 1 -mindepth 1 -type l \
      | grep 'rgb:kbd_backlight'
    );
  fi

  if [ -f "${_iteBrightFile}" ]; then
    if [ "${_enable_int}" = '1' ]; then
      _calc_bright_int="${_bright_int}";
    else
      _calc_bright_int=0;
    fi
    _writeRegisterFn "${_iteBrightFile}" "${_calc_bright_int}";
  fi
}
## . END _iteRestoreKbdFn }

## BEGIN _iteWriteStateFileFn {
# Purpose: Write _configStateList to the ITE file.
#
_iteWriteStateFileFn () {
  declare _calc_file _bright_int _hex_str _enable_int _config_str;
  [ -z "${1:-}" ] && _calc_file="${_iteStateFile}" || _calc_file="$1";

  _bright_int="$(_echoSafeBrightIntFn "${_configStateList[0]:-}")";
  _hex_str="$(   _echoSafeHexStrFn    "${_configStateList[1]:-}")";
  _enable_int="$(_echoSafeBoolIntFn "${_configStateList[2]:-}")";
  _config_str="${_bright_int};${_hex_str};${_enable_int}";

  _writeRegisterFn "${_calc_file}" "${_config_str}" '_do_create';
}
## . END _iteWriteStateFileFn }

## BEGIN _stdCalcKbdStateFn {
# Purpose: Calculate kbd state and save to _configStateList.
#
_stdCalcKbdStateFn () {
  declare _bright_file _bright_byte _bright_int \
  _hex_file _hex_str _enable_int;

  _bright_file="${_stdKeyDir}/brightness";
  _bright_byte="$(_slurpFileFn "${_bright_file}")";
  _bright_int="$(_convertBrightByteToIntFn "${_bright_byte}")";

  _hex_file="${_stdKeyDir}/color_center";
  _slurp_str="$(_slurpFileFn "${_hex_file}")";
  _hex_str="$(_echoSafeHexStrFn "${_slurp_str}")";

  _slurp_str="$(_slurpFileFn "${_stdEnableFile}")";
  _enable_int="$(_echoSafeBoolIntFn "${_slurp_str}")";

  _configStateList=( "${_bright_int}" "${_hex_str}" "${_enable_int}" );
}
## . END _stdCalcKbdStateFn }

## BEGIN _stdRestoreKbdFn {
# Purpose: Write color and brightness values to standard registers.
#
_stdRestoreKbdFn () {
  declare _bright_int _hex_str _enable_int _bright_byte \
    _bright_file _zonekb_file _zonekb_str _extra_file   \
    _section_list _section_str _section_str _section_file;

  if [ ! -d "${_stdKeyDir}" ]; then
    _cm2WarnStrFn 'Cannot restore keyboard state: no registers!';
    return;
  fi

  _bright_int="$(_echoSafeBrightIntFn "${_configStateList[0]:-}")";
  _hex_str="$(   _echoSafeHexStrFn    "${_configStateList[1]:-}")";
  _enable_int="$(_echoSafeBoolIntFn "${_configStateList[2]:-}")";
  _bright_byte="$(_convertBrightIntToByteFn "${_bright_int}")";

  # Toggle the "enable" register to wake up std keyboard to changes
  _bright_file="${_stdKeyDir}/brightness";
  if [ "${_enable_int}" = 0 ]; then
    _writeRegisterFn "${_bright_file}" 1;
    _writeRegisterFn "${_bright_file}" 0;
  fi

  # Handle zonekb API (m2g6)
  _zonekb_file="${_stdKeyDir}/zonekb";
  if [ -f "${_zonekb_file}" ]; then
    # ZoneKB API - set five color zones plus brightness in one call.
    _zonekb_str="$(cat <<EOF
LEFT_COLOR=0x${_hex_str}
CENTER_COLOR=0x${_hex_str}
RIGHT_COLOR=0x${_hex_str}
NUMPAD_COLOR=0x${_hex_str}
LIGHTBAR_COLOR=0x${_hex_str}
KB_BRIGHTNESS=${_bright_byte}
EOF
    )";
    _writeRegisterFn "${_zonekb_file}"   "${_zonekb_str}";
    _writeRegisterFn "${_stdEnableFile}" "${_enable_int}";
    return;
  fi

  # Handle Standard API:
  #   set three or four color sections and brightness in individual calls.
  #
  _section_list=( 'color_left' 'color_center' 'color_right' );
  _extra_file="${_stdKeyDir}/extra";
  if [ -f "${_extra_file}" ] && [ "$(cat "${_extra_file}")" = '1' ]; then
    _section_list+=( 'color_extra' );
  fi

  for _section_str in "${_section_list[@]}"; do
    _section_file="${_stdKeyDir}/${_section_str}";
   _writeRegisterFn "${_section_file}" "0x${_hex_str}";
  done;

  _writeRegisterFn "${_bright_file}" "${_bright_byte}";
  _writeRegisterFn "${_stdEnableFile}" "${_enable_int}";
}
## . END _stdRestoreKbdFn }

## BEGIN _stdReadStateFileFn {
# Purpose: Read the standard (modprobe) state file and populate
# _configStateList.
#
# shellcheck disable=SC2120
_stdReadStateFileFn () {
  declare _calc_file _line _slurp_str _bright_int _hex_str _enable_int;
  [ -z "${1:-}" ] && _calc_file="${_stdModprobeFile}" || _calc_file="$1";

  # Create the state file if needed
  if [ ! -f "${_calc_file}" ]; then
    _stdCalcKbdStateFn;
    _stdWriteStateFileFn "${_calc_file}";
  fi

  # Get config line
  _line='';
  if [ -f "${_calc_file}" ]; then
    _line="$(grep -Ei '^\s*options\s+tuxedo-keyboard' "${_calc_file}")";
  fi

  # Extract values from line or use defaults
  _slurp_str="$(sed -n 's/^.*\sbrightness=\([^ ]\+\).*$/\1/p' <<< "${_line}")";
  _bright_int="$(_convertBrightByteToIntFn "${_slurp_str}")";

  _slurp_str="$(sed -n 's/^.*\scolor_center=0x\([^ ]\+\).*$/\1/p' <<< "${_line}")";
  _hex_str="$(_echoSafeHexStrFn "${_slurp_str}")";

  # Carry forward enable_int
  _enable_int="$(_echoSafeBoolIntFn "${_configStateList[2]:-}")";

  # Convert and save
  _configStateList=( "${_bright_int}" "${_hex_str}" "${_enable_int}" );
}
## . END _stdReadStateFileFn }

## BEGIN _stdWriteStateFileFn {
# Purpose: Write standard (modprobe) state file from _configStateList.
#   The state=[0|1] value is ignored by the kbd module, but maybe some day
#   we will use it.
#
_stdWriteStateFileFn () {
  declare _calc_file _bright_byte _hex_str _state_str;
  [ -z "${1:-}" ] && _calc_file="${_stdModprobeFile}" || _calc_file="$1";

  _bright_byte="$(_convertBrightIntToByteFn "${_configStateList[0]:-}")";
  _hex_str="$(    _echoSafeHexStrFn         "${_configStateList[1]:-}")";
  # _enable_int="$( _echoSafeHexStrFn       "${_configStateList[2]:-}")";

  _state_str="options tuxedo-keyboard mode=0 ";
  _state_str+="brightness=${_bright_byte} color_left=0x${_hex_str} ";
  _state_str+="color_center=0x${_hex_str} ";
  _state_str+="color_right=0x${_hex_str} ";
  _state_str+="color_numpad=0x${_hex_str}";
  # _state_str+="state=${_enable_int}";

  _writeRegisterFn "${_calc_file}" "${_state_str}" '_do_create';
}
## . END _stdWriteStateFileFn }

## BEGIN _restoreKbdFromConfigFn {
# Purpose: Dispatches to set kbd from _configStateList.
#   This must be called after the config file is read-in.
#
_restoreKbdFromConfigFn () {
  if [ "${#_configStateList[@]}" -lt 2 ]; then
    _cm2WarnStrFn 'No valid config state available';
    return 202;
  fi

  if [ "${_isIte}" = 'y' ]; then
    _iteRestoreKbdFn;
  else
    _stdRestoreKbdFn;
  fi
}
## . END _restoreKbdFromConfigFn }
## == . END private functions ========================================= }

## == BEGIN functions run by mainFn =================================== {
## BEGIN _convertHexToRgbFn {
# Purpose: Converts hex value to RGB triple.
#
_convertHexToRgbFn () {
  declare _input_str _hex_list _bit_str _rgb_list;
  _input_str="$(_echoSafeHexStrFn "${1:-}")";

  mapfile -n3 -t _hex_list< <(fold -w 2 <<<"${_input_str}");

  if [ "${#_hex_list[@]}" != 3 ]; then
    _cm2WarnStrFn 'Bad input';
    return 1;
  fi

  _rgb_list=();
  for _bit_str in "${_hex_list[@]}"; do
    _rgb_list+=( $(( "16#${_bit_str}")) );
  done
  echo "${_rgb_list[*]}";
}
## . END _convertHexToRgbFn }

## BEGIN _convertRgbToHexFn {
# Purpose: Convert RGB triple to hex.
#
_convertRgbToHexFn () {
  declare _input_str _rgb_list _bit_str _byte_str _hex_str;
  _input_str="${1:-}";
  IFS=' ' read -r -a _rgb_list <<<"${_input_str}";

  if [ "${#_rgb_list[@]}" != 3 ]; then
    echo "${_defaultHexStr}";
    return 1;
  fi

  _hex_str='';
  for _bit_str in "${_rgb_list[@]}"; do
    _byte_str="$(_echoSafeByteFn "${_bit_str}")";
    _hex_str+="$(printf '%02x' "${_byte_str}")";
  done

  _echoSafeHexStrFn "${_hex_str}";
}
## . END _convertRgbToHexFn }

## BEGIN _simpleEnableKbdFn {
_simpleEnableKbdFn () {
  declare _set_int;
  _set_int="$(_echoSafeBoolIntFn "${1:-}")";
  if _readInStateFileFn; then
    _configStateList[2]="${_set_int}";
    _restoreKbdFromConfigFn;
  fi
}
## . END _simpleEnableKbdFn }

## BEGIN _enableKbdFn {
# Purpose: Enable or disable kbd. Do not change color-bright.
#
_enableKbdFn () {
  declare _set_int _old_list _enable_int;

  _set_int="$(_echoSafeBoolIntFn "${1:-}")";
  _readInStateFileFn;

  # Handle ITE logic
  if [ "${_isIte}" = 'y' ]; then
    _old_list=( "${_configStateList[@]}" );

    # If the user has made the kbd visible, keep the calculated state;
    #   otherwise, keep the old state.
    _iteCalcKbdStateFn;
    if (( _configStateList[0] == 0 )); then
      _configStateList=( "${_old_list[@]}" );
    fi

    # Set the enabled flag, update keyboard colors, write config
    _configStateList[2]="${_set_int}";
    _iteRestoreKbdFn;
    _iteWriteStateFileFn;
    return;
  fi

  # Handle STD logic
  _slurp_str="$(_slurpFileFn "${_stdEnableFile}")";
  _enable_int="$(_echoSafeBoolIntFn "${_slurp_str}")";

  # If the intent is to disable, and the current kbd is enabled,
  #  then calculate current settings.
  if [ "${_set_int}" = 0 ] && (( _enable_int == 1 )); then
    _stdCalcKbdStateFn;
  fi

  # Set and store
  if _writeRegisterFn "${_stdEnableFile}" "${_set_int}"; then
    _configStateList[2]="${_set_int}";
    _stdWriteStateFileFn;
  fi
}
## . END _enableKbdFn }

## BEGIN _keepStateFn {
# Purpose: Calculate keyboard state and store into default files
#
_keepStateFn () {
  if [ "${_isIte}" = 'y' ]; then
    _iteCalcKbdStateFn;
    _iteWriteStateFileFn;
  else
    _stdCalcKbdStateFn;
    _stdWriteStateFileFn;
  fi
}
## .END _keepStateFn }

## BEGIN _keepSuspendStateFn {
# Purpose: Calculate keyboard state and store into a suspend file
#
_keepSuspendStateFn () {
  if [ "${_isIte}" = 'y' ]; then
    _iteCalcKbdStateFn;
    _iteWriteStateFileFn "${_iteSuspendFile}";
  else
    _stdCalcKbdStateFn;
    # This is NOT a typo; we want to save the enabled state
    _iteWriteStateFileFn "${_stdSuspendFile}";
    # Also store it in the modprobe file so we can have color on boot
    _stdWriteStateFileFn;
  fi
}
## . END _keepSuspendStateFn }

## BEGIN _readInStateFileFn {
# Purpose: Read state from the default file to populate configStateList
#
_readInStateFileFn () {
  if [ "${_isIte}" = 'y' ]; then
    _iteReadStateFileFn;
  else
    # shellcheck disable=SC2119
    _stdReadStateFileFn;
  fi
}
## . END _readInStateFileFn }

## BEGIN _restoreStateFn {
# Purpose: Read state from the default file and restore to the keyboard
#
_restoreStateFn () {
  if [ "${_isIte}" = 'y' ]; then
    _iteReadStateFileFn;
  else
    _stdReadStateFileFn;
  fi
  _restoreKbdFromConfigFn;
}
## . END _restoreStateFn }

## BEGIN _restoreSuspendStateFn {
# Purpose: Read state from a suspend file and restore it to the keyboard
#
_restoreSuspendStateFn () {
  if [ "${_isIte}" = 'y' ]; then
    _iteReadStateFileFn "${_iteSuspendFile}";
    _iteRestoreKbdFn;
  else
    # This is NOT a typo; we want to read the enabled state
    _iteReadStateFileFn "${_stdSuspendFile}";
    _stdWriteStateFileFn;
    _stdRestoreKbdFn;
  fi
}
## . END _restoreSuspendStateFn }

## BEGIN _listActiveStateFn {
# Purpose: Print current kbd state to STDOUT.
#
_listActiveStateFn () {
  if [ "${_isIte}" = 'y' ]; then
    _iteCalcKbdStateFn; else _stdCalcKbdStateFn;
  fi
  ( IFS=';'; echo "${_configStateList[*]}"; )
}
## . END _listActiveStateFn }

## BEGIN _setKbdValsFn {
# Purpose: Set kbd brightness and color from the input string.
#
_setKbdValsFn () {
  declare _set_str _bit_list _bright_int _hex_str _enable_int;

  # Parse input
  _set_str="${1:-}";
  IFS=';' read -r -a _bit_list <<< "${_set_str}";

  # Update _configStateList.
  _bright_int="$(_echoSafeBrightIntFn "${_bit_list[0]:-}")";
  _hex_str="$(   _echoSafeHexStrFn    "${_bit_list[1]:-}")";
  _enable_int="$(_echoSafeBoolIntFn   "${_bit_list[2]:-}")";
  _configStateList=( "${_bright_int}" "${_hex_str}" "${_enable_int}" );

  # Restore and write
  if [ "${_isIte}" = 'y' ]; then
    if _iteRestoreKbdFn; then _iteWriteStateFileFn; fi
  else
    if _stdRestoreKbdFn; then _stdWriteStateFileFn; fi
  fi
}
## . END _setKbdValsFn }
## == . END functions run by mainFn =================================== }

## BEGIN _mainFn {
# Summary   : _mainFn <options>
# Purpose   : Dispatch per option to set kbd brightness and color.
#   This does nothing if _cm2EchoModelStrFn 'has_kb_led' echos 'n'.
# Examples  : See below.
# Arguments : Some options take values.
#   Hex colors have the form '<rrggbb>'.
#   Rgb colors have the form '<0-255> <0-255> <0-255>'.
# | -c <hex> : Convert hex color to rgb (debug).
# | -C <rgb> : Convert rgb color to hex (debug).
# | -E 0|1   : Enable kbd OFF or ON, use existing color stored.
# | -k       : Calculate keyboard start and write to the suspend file.
# | -K       : Restore keyboard state from the suspend file.
# | -l       : List active state from kbd <int:0-10>;<hex>;<0-1>.
# | -p       :
# | -s       : '<0-10>;<hex>' : Set brightness and color; enable is set to 1.
# | -r       : Read and apply state from the default file.
# | -w       : Calculate keyboard state and write to the default file.
# Globals    : OPTIND is reset to local for arg processing.
# Outputs    : Prints diagnostics to stderr.
# Returns    : 0 on success; no-zero on failure.
#
_mainFn () {
  declare _opt_str;

  # Skip any action if the model does not have kbd LEDs
  if [ "$(_cm2EchoModelStrFn 'has_kb_led')" = 'n' ]; then return; fi

  _opt_str="${1:-}"; shift;

  case "${_opt_str}" in
    '-c') _convertHexToRgbFn "$@";;
    '-C') _convertRgbToHexFn "$*";;
    '-E')
      if [ -f "${_dropFile}" ]; then
        _enableKbdFn "$@";
      else
        _simpleEnableKbdFn "$@";
        touch "${_dropFile}";
      fi
      ;;

    '-k') _keepSuspendStateFn;;
    '-K') _restoreSuspendStateFn;;
    '-r') _restoreStateFn;;
    '-w') _keepStateFn;;

    '-l') _listActiveStateFn;;
    '-s') _setKbdValsFn "$@";;
    *) _cm2EchoFn "Option ${_opt_str} not supported";;
  esac
}
## . END _mainFn }

## BEGIN Declare and assign global vars {
declare _binName _binDir _baseDir _baseName \
  _configStateList _defaultBrightInt _defaultHexStr \
  _dropFile _isIte _iteBrightFile _iteStateFile \
  _modelCode _stdEnableFile _stdKeyDir _stdModprobeFile;

_configStateList=();
_defaultBrightByte=175;
_defaultBrightInt=7;
_defaultHexStr='ffff00';
_dropFile='/run/kfocus-kb-color-set-enable';
_isIte='n';
_iteBrightFile='/sys/class/leds/rgb:kbd_backlight/brightness';
_iteRgbDir='/sys/class/leds';
_iteStateFile='/var/lib/kfocus/kbd_color_state';
_iteSuspendFile='/var/lib/kfocus/kbd_ite_suspend';
_stdEnableFile='/sys/devices/platform/tuxedo_keyboard/state';
_stdKeyDir='/sys/devices/platform/tuxedo_keyboard';
_stdModprobeFile='/etc/modprobe.d/tuxedo_keyboard.conf';
_stdSuspendFile='/var/lib/kfocus/kbd_std_suspend';
## . END Declare and assign global vars }

## BEGIN Run main if the script is not sourced {
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  _binName="$(  readlink -f "$0"       )" || exit 101;
  _binDir="$(   dirname  "${_binName}" )" || exit 101;
  _baseDir="$(  dirname  "${_binDir}"  )" || exit 101;
  _baseName="$( basename "${_binName}" )" || exit 101;

  # Import libs and assign more global vars
  _importCommonFn;

  # Get model code, skip unsupported models, set ITE mode if needed
  _modelCode="$(_cm2EchoModelStrFn 'code')";
  if ! [[ "${_modelCode}" =~ ^(m1|m2|zr) ]]; then exit 0; fi
  if [[ "${_modelCode}" =~ ^(m2g5p|zrg1)$ ]]; then _isIte='y'; fi

  ## Debug Code
  # declare _parent_name _debug_file;
  # _parent_name="$(ps -o comm= ${PPID:-})";
  # _debug_file='/tmp/kfocus-kb-set.log';
  # echo "|${_baseName} $*| called by ${_parent_name}" >> "${_debug_file}";
  # _mainFn "$@" |& tee -a "${_debug_file}";
  _mainFn "$@";
fi
## . END Run main if the script is not sourced }
