#!/bin/bash
#
# Copyright 2025-2025 MindShare Inc.
#
# Written for the Kubuntu Focus by A. Rainbolt.
#
# Name     : kfocus-recover-mount
# Summary  : kfocus-recover-mount
# Purpose  : Attempts to autodetect a Kubuntu Focus system root partition and
#            accompanying partitions, and mounts them to /mnt
# Example  : kfocus-recover-mount
# License  : GPLv2
# Run By   : End users
# Spec     : 5806
#
set -u

## BEGIN _importCommonFn {
# Summary   : _importCommonFn
# Purpose   : Load common routines, prefer relative dir
# Example   : _importCommonFn;
# Arguments : none
# Globals   : Package vars _baseDir _baseName
# Outputs   : none
# Returns   : none
#
_importCommonFn() {
  declare _lib_list _is_loaded _lib_file
  _lib_list=(
    "${_baseDir}/lib/common.2.source"
    '/usr/lib/kfocus/lib/common.2.source'
  )
  _is_loaded='n'
  for _lib_file in "${_lib_list[@]}"; do
    if [ -r "${_lib_file}" ]; then
      # shellcheck source=/usr/lib/kfocus/lib/common.2.source
      if source "${_lib_file}"; then
        _is_loaded='y'
        break
      fi
    fi
  done

  if [ "${_is_loaded}" = 'n' ]; then
    echo 1>&2 "${_baseName}: ABORT - Cannot source common lib"
    exit 202
  fi
}
## . END _importCommonFn }

## BEGIN _assignGlobalUiVarsFn {
_assignGlobalUiVarsFn() {
  # TODO:
  #   1, Identify and offer actions explicitly
  #   2. Only proceed on user agreement
  #   3. Report success or failure
  #     3,1. On failure, offer alternate solutions
  #     3.2. On failure, ensure interrupted processes are undone or suggest the
  #          user do a reboot, favor reboots if unwinding would be complex or
  #          unreliable
  #   4. Give a detailed report of what was done so that users know what they're
  #      doing going forward
  _offerMountMsg="$(
    cat <<EOF
The internal KFocus disk(s) are not currently mounted. Would you like to mount
them now
EOF
  )"

  _declineMountMsg="$(
    cat <<EOF
Exiting without mounting the internal KFocus disk(s), per user request.
EOF
  )"

  _confirmMountMsg="Is this the correct partition (if in doubt, answer Y)"

  _mountErrMsg="Could not mount the internal KFocus disk(s)!"

  _offerChrootBindMsg="$(
    cat <<EOF
If you intend to regenerate the initramfs or reinstall the bootloader, you
will need to chroot. Add bind mounts to enable chroot
EOF
  )"

  _mountDoneMsg="$(
    cat <<EOF
The internal KFocus disk(s) have been mounted to |${_sysMountPath}|. You can
make modifications to them there.
EOF
  )"

  _chrootBindErrMsg="$(
    cat <<EOF
Could not prepare the internal KFocus disk(s) for chroot! Please reboot and
try again.
EOF
  )"

  _chrootBindDoneMsg="$(
    cat <<EOF
The internal KFocus disk(s) have been mounted to |${_sysMountPath}| and can be
chrooted into. Be careful, as changes made to /dev, /dev/pts, /proc, and /sys
within |${_sysMountPath}| will affect the running system!
EOF
  )"

  _offerUnmountMsg="$(
    cat <<EOF
The internal KFocus disk(s) are currently mounted to |${_sysMountPath}|. Would
you like to unmount them
EOF
  )"

  _offerUnmountWithBindsMsg="$(
    cat <<EOF
The internal KFocus disk(s) are currently mounted to |${_sysMountPath}| and bind
mounts for chroot are set up. Would you like to unmount them
EOF
  )"

  _declineUnmountMsg="$(
    cat <<EOF
Exiting without unmounting the internal KFocus disk(s), per user request.
EOF
  )"

  _unmountErrMsg="$(
    cat <<EOF
Could not unmount the internal KFocus disk(s)! Close applications that are still
using files in |${_sysMountPath}| and then try again. You may also reboot,
if preferred.
EOF
  )"

  _unmountDoneMsg="$(
    cat <<EOF
The internal KFocus disk(s) have been unmounted successfully.
EOF
  )"

  _mountSummaryDisplayFailMsg="Failed to generate and display mount summary!"
}
## . END _assignGlobalUiVarsFn }

## BEGIN _readPromptFn {
# Summary   : _readPromptFn <prompt>
# Purpose   : Display prompt to user and read yes-or-no response
# Example   : _importCommonFn 'Do you want to continue';
# Arguments : <prompt>: The prompt to display to the user.
# Globals   : none
# Outputs   : 'y' or 'n' depending on user response
# Returns   : none
#
_readPromptFn() {
  declare _reply_str

  _reply_str="$(_cm2ReadPromptYnFn "$@")"
  _cm2EchoFn
  echo "${_reply_str}"
}
## . END _readPromptFn }

## BEGIN _getBlockDevListFn {
# Summary   : _getBlockDevListFn
# Purpose   : Gets all block devices visible to the system
# Example   : _getBlockDevListFn;
# Arguments : none
# Globals   : none
# Outputs   : Newline-separated block device list
# Returns   : 1 on critical failure
#
_getBlockDevListFn() {
  declare _dev_str

  _dev_str="$("${_lsblkExe}" --paths --raw --output=NAME | tail -n+2)"
  if [ -z "${_dev_str}" ]; then
    _cm2ErrStrFn 'No devices found!'
    return 1
  fi

  echo "${_dev_str}"
}
## . END _getBlockDevListFn }

## BEGIN _getUnmountedBlockDevListFn {
# Summary   : _getUnmountedBlockDevListFn
# Purpose   : Gets all unmounted block devices visible to the system
# Example   : _getUnmountedBlockDevListFn;
# Arguments : none
# Globals   : none
# Outputs   : Newline-separated block device list
# Returns   : 1 on critical failure
#
_getUnmountedBlockDevListFn() {
  declare _block_device_list _init_mountpoint_list _ignore_device_list \
    _disk_id_regex _ignore_device_str _idx

  # Create list of all block devices and where they are mounted
  readarray -t _block_device_list < <(
    "${_lsblkExe}" --paths --raw --output=NAME | tail -n+2
  ) || return 1
  readarray -t _init_mountpoint_list < <(
    "${_lsblkExe}" --paths --raw --output=MOUNTPOINTS | tail -n+2
  ) || return 1
  if [ "${#_block_device_list[@]}" != "${#_init_mountpoint_list[@]}" ]; then
    _cm2ErrStrFn \
      'Block device list length does not equal mountpoint list length!'
    return 1
  fi

  ## Begin loop through block devices and mark devices to be ignored {
  _ignore_device_list=()
  _disk_id_regex='(sd[a-z]+|hd[a-z]+|vd[a-z]+|xvd[a-z]+|nvme[0-9]+n[0-9]+'
  _disk_id_regex+='|mmcblk[0-9]+)'
  for _idx in "${!_block_device_list[@]}"; do
    # Ignore any devices that don't look like a normal disk device.
    if ! [[ "${_block_device_list[_idx]}" =~ ^/dev/${_disk_id_regex} ]]; then
      _ignore_device_list+=("${_block_device_list[_idx]}")
      continue
    fi

    if [ -n "${_init_mountpoint_list[_idx]}" ]; then
      # Ignore whole disk devices that happen to be mounted
      if [[ "${_block_device_list[_idx]}" =~ ${_disk_id_regex}$ ]]; then
        _ignore_device_list+=("${_block_device_list[_idx]}")

      # Mark disks that have at least one mounted partition as "to be
      #   ignored"
      else
        if [[ "${_block_device_list[_idx]}" =~ (nvme[0-9]+n[0-9]+p[0-9]+|mmcblk[0-9]+p[0-9]+)$ ]]; then
          _ignore_device_list+=("${_block_device_list[_idx]%p*}")
        else
          [[ "${_block_device_list[_idx]}" =~ (.*[a-z]*)[0-9]+ ]]
          _ignore_device_list+=("${BASH_REMATCH[1]}")
        fi
      fi
    fi
  done
  ## . End loop through block devices and mark devices to be ignored }

  # Ignore all devices that are marked as "to be ignored", including partitions
  #   on those devices
  for _ignore_device_str in "${_ignore_device_list[@]}"; do
    for _idx in "${!_block_device_list[@]}"; do
      if [[ "${_block_device_list[_idx]}" =~ ^"${_ignore_device_str}" ]]; then
        unset "_block_device_list[${_idx}]"
      fi
    done
  done

  # Remove deleted elements from array
  _block_device_list=("${_block_device_list[@]}")
  printf '%s\n' "${_block_device_list[@]}"
}
## . END _getUnmountedBlockDevListFn }

## BEGIN _extractBlkidFieldStrFn {
# Summary   : _extractBlkidFieldStrFn <blkid_report> <target_dev> <field_name>
# Purpose   : Extracts a metadata field for a disk from blkid data
# Example   : _extractBlkidFieldStrFn "${_blkid_report}" '/dev/sda1' 'uuid'
# Arguments :
#   <blkid_report> : Raw output from `blkid`
#   <target_dev>   : Path to target block device
#   <field_name>   : Name of the field to extract
# Globals   : none
# Outputs   : Requested metadata field
# Returns   : 1 on critical error
#
_extractBlkidFieldStrFn() {
  declare _blkid_report _target_dev _field_name _blkid_field_str

  # Process arguments
  _blkid_report="${1:-}"
  _target_dev="${2:-}"
  _field_name="${3:-}"
  [ -z "${_blkid_report}" ] && {
    _cm2ErrStrFn 'No blkid report provided!'
    return 1
  }
  [ -z "${_target_dev}" ] && {
    _cm2ErrStrFn 'No target device specified!'
    return 1
  }
  [ -z "${_field_name}" ] && {
    _cm2ErrStrFn 'No data type specified!'
    return 1
  }

  # Find the blkid line corresponding to the target device, and extract the
  #   desired field from it
  _blkid_field_str="$(grep "^${_target_dev}: " <<<"${_blkid_report}" \
    | head -n1 | sed "s/.* ${_field_name^^}=\"\([^\"]*\)\".*/\1/")"
  echo "${_blkid_field_str}"
}
## . END _extractBlkidFieldStrFn }

## BEGIN _getBlockDevByFsUuid {
# Summary   : _getBlockDevByFsUuid <fs_uuid> <blkid_report> <dev_list...>
# Purpose   : Search through a list of block devices and return the one with a
#  matching fs UUID
# Example   :
#   _getBlockDevByFsUuid '1234....' "${_blkid_report}" "${_dev_list[@]}"
# Arguments :
#   <fs_uuid>      : UUID of the desired filesystem
#   <blkid_report> : Raw output from `blkid`
#   <dev_list...>  : Remaining args are block devices to search through
# Globals   : none
# Outputs   : Path to desired block device
# Returns   : 1 on critical error
#
_getBlockDevByFsUuid() {
  declare _fs_uuid _blkid_report _dev_list _dev_str _check_fs_uuid

  # Process arguments
  _fs_uuid="${1:-}"
  _blkid_report="${2:-}"
  shift 2
  _dev_list=("$@")
  [ -z "${_fs_uuid}" ] && {
    _cm2ErrStrFn 'No FS UUID provided!'
    return 1
  }
  [ -z "${_blkid_report}" ] && {
    _cm2ErrStrFn 'No blkid report provided!'
    return 1
  }
  if [ "${#_dev_list[@]}" = '0' ] \
    || [ -z "${_dev_list[0]}" ]; then
    _cm2ErrStrFn 'No device list provided!'
    return 1
  fi

  # Loop through device list and print the device with the specified UUID
  for _dev_str in "${_dev_list[@]}"; do
    _check_fs_uuid="$(_extractBlkidFieldStrFn "${_blkid_report}" \
      "${_dev_str}" 'uuid')" || return 1
    if [ "${_check_fs_uuid}" = "${_fs_uuid}" ]; then
      echo "${_dev_str}"
      return 0
    fi
  done
}
## . END _getBlockDevByFsUuid }

## BEGIN _getKubuntuRootMountDataFn {
# Summary   : _getKubuntuRootMountDataFn <target_dev>
# Purpose   : Search through the grub.cfg file on a device, looking for
#   Kubuntu installations. When one is found, extract the root device UUID,
#   encrypted volume UUID, encrypted volume name, and BTRFS subvolume from the
#   config file.
# Example   : _getKubuntuRootMountDataFn /dev/sda2
# Arguments : <target_dev>: Device to search for grub.cfg under
# Outputs   : A pipe-delimited string containing the values necessary to mount
#   the root device pointed to by the grub.cfg file:
#   <root_fs_UUID>|<crypt_vol_UUID>|<crypt_vol_name>|<btrfs_subvol>. Fields that
#   are not applicable for a device are left empty. If the values cannot be
#   found, returns an empty string.
# Returns   : 1 on critical error
#
_getKubuntuRootMountDataFn() {
  declare _target_dev _grub_cfg_search_path _grub_cfg_str _grub_cfg_path \
    _grub_kubuntu_sect_str _grub_linux_cmdline_str _mount_fs_uuid \
    _mount_crypt_uuid _mount_subvol_str _mount_crypt_name

  # Process arguments
  _target_dev="${1:-}"
  _grub_cfg_path=''
  [ -z "${_target_dev}" ] && {
    _cm2ErrStrFn 'No target device specified!'
    return 1
  }

  # Mount the specified device and look for a grub.cfg file under it
  if ! "${_mountExe}" "${_target_dev}" "${_sysMountPath}" 2>/dev/null; then
    return 0
  fi
  for _grub_cfg_search_path in "${_grubCfgPathList[@]}"; do
    if [ -f "${_grub_cfg_search_path}" ]; then
      _grub_cfg_path="${_grub_cfg_search_path}"
      break
    fi
  done
  if [ -z "${_grub_cfg_path}" ]; then
    "${_umountExe}" "${_sysMountPath}" || return 1
    return 0
  fi

  # Extract a Kubuntu boot menu entry from grub.cfg
  _grub_cfg_str="$(cat "${_grub_cfg_path}")"
  _grub_kubuntu_sect_str="$(sed -nz \
    "s/.*\(menuentry 'Kubuntu' [^{]\+{[^}]\+}\).*/\1/p" \
    <<<"${_grub_cfg_str}")"
  if [ -z "${_grub_kubuntu_sect_str}" ]; then
    "${_umountExe}" "${_sysMountPath}" || return 1
    return 0
  fi

  # Extract the "linux" line from the Kubuntu boot menu entry
  _grub_linux_cmdline_str="$(grep '^\s*linux' \
    <<<"${_grub_kubuntu_sect_str}")"
  if [ -z "${_grub_linux_cmdline_str}" ]; then
    "${_umountExe}" "${_sysMountPath}" || return 1
    return 0
  fi

  # Extract the root fs UUID from the kernel command line
  # shellcheck disable=SC2001
  _mount_fs_uuid="$(sed -n 's/.*root=UUID=\([^ ]\+\).*/\1/p' \
    <<<"${_grub_linux_cmdline_str}")"
  if [ -z "${_mount_fs_uuid}" ]; then
    "${_umountExe}" "${_sysMountPath}" || return 1
    return 0
  fi

  # Extract the LUKS volume UUID if available
  # shellcheck disable=SC2001
  _mount_crypt_uuid="$(sed -n 's/.*cryptdevice=UUID=\([^:]\+\):.*/\1/p' \
    <<<"${_grub_linux_cmdline_str}")"
  if [ -z "${_mount_crypt_uuid}" ]; then
    _mount_crypt_uuid=''
  fi

  # Extract the LUKS volume name if available
  # shellcheck disable=SC2001
  _mount_crypt_name="$(sed -n 's/.*cryptdevice=UUID=[^:]\+:\([^ ]\+\).*/\1/p' \
    <<<"${_grub_linux_cmdline_str}")"
  if [ -z "${_mount_crypt_name}" ]; then
    _mount_crypt_name=''
  fi

  # Extract the root filesystem BTRFS subvolume if available
  # shellcheck disable=SC2001
  _mount_subvol_str="$(sed -n 's/.*rootflags=subvol=\([^ ]\+\).*/\1/p' \
    <<<"${_grub_linux_cmdline_str}")"
  if [ -z "${_mount_subvol_str}" ]; then
    _mount_subvol_str=''
  fi

  # Echo the root filesystem data, then unmount the boot partition
  echo "${_mount_fs_uuid}|${_mount_crypt_uuid}|${_mount_crypt_name}|${_mount_subvol_str}"
  "${_umountExe}" "${_sysMountPath}" || return 1
}
## . END _getKubuntuRootMountDataFn }

## BEGIN _tryKfocusMountFn {
# Summary   : _tryKfocusMountFn <mount_data_str>
# Purpose   : Checks to see if a device contains a KFocus installation or
#   not, and leaves the device mounted at /mnt if it does.
# Example   : _tryKfocusMountFn '1234|||@'
# Arguments : <mount_data_str>: Raw output of _getKubuntuRootMountDataFn
# Globals   : Appends to _chosenCryptList, _chosenMountList
# Outputs   : none
# Returns   : 2 on critical error, 1 if the device could not be mounted or
#   is not a KFocus root partition, 0 on success.
#
_tryKfocusMountFn() {
  declare _mount_data_str _bit_list _mount_fs_uuid _mount_crypt_uuid \
    _mount_crypt_name _mount_subvol_str _blkid_report _target_dev \
    _dev_list _is_crypt_opened _calc_mount_cmd _target_crypt_dev \
    _mounted_fs_type _msg

  # Process arguments
  _mount_data_str="${1:-}"
  [ -z "${_mount_data_str}" ] && {
    _cm2ErrStrFn 'No mount data provided!'
    return 2
  }

  # Initialize variables
  readarray -t _dev_list < <(_getBlockDevListFn) || return 2
  _blkid_report="$("${_blkidExe}")" || return 1
  _is_crypt_opened='n'
  _target_dev=''
  _target_crypt_dev=''
  _mount_crypt_name=''

  # Split mount data string
  IFS='|' read -r -a _bit_list <<<"${_mount_data_str}"
  _mount_fs_uuid="${_bit_list[0]:-}"
  [ -z "${_mount_fs_uuid}" ] && {
    _cm2ErrStrFn 'Malformed mount data provided!'
    return 2
  }
  _mount_crypt_uuid="${_bit_list[1]:-}"
  _mount_crypt_name="${_bit_list[2]:-}"
  _mount_subvol_str="${_bit_list[3]:-}"

  # Decrypt root device if needed
  if [ -n "${_mount_crypt_uuid}" ]; then
    _target_crypt_dev="$(_getBlockDevByFsUuid "${_mount_crypt_uuid}" \
      "${_blkid_report}" "${_dev_list[@]}")" || return 2
    if [ -z "${_target_crypt_dev}" ]; then
      return 1
    fi

    if ! "${_cryptsetupExe}" luksOpen "${_target_crypt_dev}" \
      "${_mount_crypt_name}"; then
      return 1
    fi

    _is_crypt_opened='y'
    _blkid_report="$("${_blkidExe}")" || return 1
    readarray -t _dev_list < <(_getBlockDevListFn) || return 2
  fi

  # Ensure root device UUID exists
  _target_dev="$(_getBlockDevByFsUuid "${_mount_fs_uuid}" \
    "${_blkid_report}" "${_dev_list[@]}")" || return 2
  if [ -z "${_target_dev}" ]; then
    if [ "${_is_crypt_opened}" = 'y' ]; then
      "${_cryptsetupExe}" luksClose "${_mount_crypt_name}" \
        || _cm2WarnStrFn \
          "Cannot close encrypted volume |${_mount_crypt_name}|. Skipped."
    fi
    return 1
  fi

  # Mount root device
  _calc_mount_cmd=("${_mountExe}")
  if [ -n "${_mount_subvol_str}" ]; then
    _calc_mount_cmd+=('-o' "subvol=${_mount_subvol_str}")
  fi
  _calc_mount_cmd+=("${_target_dev}" "${_sysMountPath}")
  if ! "${_calc_mount_cmd[@]}"; then
    if [ "${_is_crypt_opened}" = 'y' ]; then
      "${_cryptsetupExe}" luksClose "${_mount_crypt_name}" \
        || _cm2WarnStrFn \
          "Cannot close encrypted volume |${_mount_crypt_name}|. Skipped."
    fi
    return 1
  fi

  # Ensure the mounted device contains a KFocus installation
  if [ -f "${_checkKfocusFile}" ]; then
    # The mounted device contains a KFocus installation, return and leave
    #   the device mounted.
    if [ "${_is_crypt_opened}" = 'y' ]; then
      _chosenCryptList+=(
        "/dev/mapper/${_mount_crypt_name}|${_target_crypt_dev}"
      )
    fi

    # Append information about the root device to _chosenMountList
    _mounted_fs_type="$(_extractBlkidFieldStrFn "${_blkid_report}" \
      "${_target_dev}" 'type')" || return 2
    _chosenMountList+=("/mnt|${_mounted_fs_type}|${_target_dev}")
    _msg="Internal KFocus root filesystem detected at |${_target_dev}|,"
    _msg+=" mounted to |${_sysMountPath}|."
    _cm2EchoFn "${_msg}"
    return 0
  fi

  # This device does not contain a KFocus installation, unmount it.
  "${_umountExe}" "${_target_dev}" || return 2
  if [ "${_is_crypt_opened}" = 'y' ]; then
    "${_cryptsetupExe}" luksClose "${_mount_crypt_name}" \
      || _cm2WarnStrFn \
        "Cannot close encrypted volume |${_mount_crypt_name}|. Skipped."
  fi
  return 1
}
## . END _tryKfocusMountFn }

## BEGIN _loadCrypttabListFn {
# Summary   : _loadCrypttabListFn
# Purpose   : Load data from /mnt/etc/crypttab into _sysCrypttabList.
# Example   : _loadCrypttabListFn;
# Arguments : none
# Globals   : _sysCrypttabList is populated
# Outputs   : none
# Returns   : none
#
_loadCrypttabListFn() {
  declare _line _crypttab_bit_list

  if ! [ -f "${_sysCrypttabPath}" ]; then
    return 0
  fi

  while read -r _line; do
    if [[ "${_line}" =~ ^[[:space:]]*# ]]; then
      continue
    fi

    IFS=' ' read -r -a _crypttab_bit_list < <(xargs <<<"${_line}")
    if [ -z "${_crypttab_bit_list[0]:-}" ] \
      || [ -z "${_crypttab_bit_list[1]:-}" ] \
      || [ -z "${_crypttab_bit_list[2]:-}" ]; then
      continue
    fi

    # See comments in global variable declaration block for details on the
    #   format of items in _sysCrypttabList
    _sysCrypttabList+=("$(
      IFS='|'
      echo "${_crypttab_bit_list[*]:0:3}"
    )")
  done <"${_sysCrypttabPath}"
}
## . END _loadCrypttabListFn }

## BEGIN _loadFstabListFn {
# Summary   : _loadFstabListFn
# Purpose   : Load data from /mnt/etc/fstab into _sysFstabList, sorted by
#   path depth.
# Example   : _loadFstabListFn;
# Arguments : none
# Globals   : _sysFstabList is populated
# Outputs   : none
# Returns   : none
#
_loadFstabListFn() {
  declare _line _fstab_bit_list _fstab_tgt_slash_count _fstab_data_sort_str \
    _fstab_mount_src _fstab_mount_tgt _fstab_fs_type _fstab_fs_opt

  if ! [ -f "${_sysFstabPath}" ]; then
    return 0
  fi

  # Ensure the items in _sysFstabList end up sorted such that filesystems
  #   mounted into less deeply nested directories appear earlier in the list
  #   than filesystems mounted into more deeply nested directories. This allows
  #   us to mount all filesystems by just walking down the list and mounting
  #   every item.
  _fstab_data_sort_str=''

  ## Begin loop through fstab lines {
  while read -r _line; do
    if [[ "${_line}" =~ ^[[:space:]]*# ]]; then
      continue
    fi

    IFS=' ' read -r -a _fstab_bit_list < <(xargs <<<"${_line}")
    _fstab_mount_src="${_fstab_bit_list[0]:-}"
    _fstab_mount_tgt="${_fstab_bit_list[1]:-}"
    _fstab_fs_type="${_fstab_bit_list[2]:-}"
    _fstab_fs_opt="${_fstab_bit_list[3]:-}"

    if [ -z "${_fstab_mount_src}" ] \
      || [ -z "${_fstab_mount_tgt}" ] \
      || [ -z "${_fstab_fs_type}" ] \
      || [ -z "${_fstab_fs_opt}" ]; then
      continue
    fi

    _fstab_tgt_slash_count="$(sed -n 's/[^/]//gp' <<<"${_fstab_mount_tgt}" \
      | wc -c)"
    # `wc -c` counts the newline at the end, remove that
    ((_fstab_tgt_slash_count--)) || true

    _fstab_data_sort_str+="${_fstab_tgt_slash_count}|${_fstab_mount_src}|"
    _fstab_data_sort_str+="${_fstab_mount_tgt}|${_fstab_fs_type}|"
    _fstab_data_sort_str+="${_fstab_fs_opt}"$'\n'
  done <"${_sysFstabPath}"
  ## . End loop through fstab lines }

  _fstab_data_sort_str="$(sort -n <<<"${_fstab_data_sort_str}")"

  while read -r _line; do
    # See comments in global variable declaration block for details on the
    #   format of items in _sysFstabList
    _sysFstabList+=("$(cut -d'|' -f2- <<<"${_line}")")
  done <<<"${_fstab_data_sort_str}"
}
## . END _loadFstabListFn }

## BEGIN _mountFstabEntriesFn {
# Summary   : _mountFstabEntriesFn
# Purpose   : For the KFocus installation mounted at /mnt, decrypt filesystems in
#   /mnt/etc/crypttab, and mount filesystems from /mnt/etc/fstab. Network
#   filesystems are excluded.
# Example   : _mountFstabEntriesFn;
# Arguments : none
# Globals   : Appends to _chosenCryptList, _chosenMountList
# Outputs   : none
# Returns   : 1 on critical error
#
_mountFstabEntriesFn() {
  declare _fstab_bit_list _fstab_line _fstab_mount_src _fstab_mount_tgt \
    _fstab_fs_type _fstab_fs_opt _crypttab_line _crypttab_bit_list \
    _crypttab_vol_name _crypttab_raw_dev _crypttab_dev _crypttab_uuid \
    _blkid_report _dev_list _fstab_dev _fstab_uuid _true_mount_tgt \
    _mounted_fs_type _crypttab_key_file _idx

  # Get info to mount filesystems under /mnt
  _loadCrypttabListFn
  _loadFstabListFn

  # If fstab is empty, return without trying to mount anything
  if [ "${#_sysFstabList[@]}" = '0' ]; then
    return 0
  fi

  # Create a list of all OS-visible devices with metadata
  _blkid_report="$("${_blkidExe}")" || return 1
  readarray -t _dev_list < <(_getBlockDevListFn) || return 1
  _crypttab_dev=''
  if [ "${#_dev_list[@]}" = '0' ] \
    || [ -z "${_dev_list[0]}" ]; then
    _cm2ErrStrFn 'Could not get device list!'
    return 1
  fi

  ## Begin decrypt all disks in crypttab if needed {
  if [ "${#_sysCrypttabList[@]}" != '0' ]; then
    ## Begin loop through crypttab entries {
    for _crypttab_line in "${_sysCrypttabList[@]}"; do
      IFS='|' read -r -a _crypttab_bit_list <<<"${_crypttab_line}"
      _crypttab_vol_name="${_crypttab_bit_list[0]:-}"
      _crypttab_raw_dev="${_crypttab_bit_list[1]:-}"
      _crypttab_key_file="${_crypttab_bit_list[2]:-}"

      # Skip already-decrypted volumes
      if [ -b "/dev/mapper/${_crypttab_vol_name}" ]; then
        continue
      fi

      # Locate the block device associated with the volume
      if [[ "${_crypttab_raw_dev}" =~ ^/dev/ ]]; then
        _crypttab_dev="${_crypttab_raw_dev}"
      elif [[ "${_crypttab_raw_dev}" =~ ^UUID= ]]; then
        _crypttab_uuid="$(cut -d'=' -f2 <<<"${_crypttab_raw_dev}")"
        if [ -z "${_crypttab_uuid}" ]; then continue; fi
        _crypttab_dev="$(_getBlockDevByFsUuid "${_crypttab_uuid}" \
          "${_blkid_report}" "${_dev_list[@]}")" || return 1
        if [ -z "${_crypttab_dev}" ]; then continue; fi
      else
        # Volume ID does not start with '/dev/' or 'UUID=', skip
        # TODO: Should we support 'LABEL=' also?
        continue
      fi

      # Skip block devices that do not exist
      if [ -z "${_crypttab_dev}" ] || ! [ -b "${_crypttab_dev}" ]; then
        continue
      fi

      ## Begin gauntlet for attempting to open encrypted volume {
      # shellcheck disable=SC2043
      for _idx in 1; do
        # If a key file exists for this volume, try to use it
        if [ "${_crypttab_key_file}" != 'none' ] \
          && [ -f "${_crypttab_key_file}" ]; then
          _cm2EchoFn "Open encrypted vol |${_crypttab_vol_name}| with key file"
          if "${_cryptsetupExe}" luksOpen --key-file \
            "${_sysMountPath}${_crypttab_key_file}" "${_crypttab_dev}" \
            "${_crypttab_vol_name}"; then
            _chosenCryptList+=(
              "/dev/mapper${_crypttab_vol_name}|${_crypttab_dev}"
            )
            break
          fi
          _cm2EchoFn 'Key file failed to open volume.'
        fi

        # Fall back to a passphrase
        _cm2EchoFn "Open encrypted vol |${_crypttab_vol_name}| with passphrase"
        if "${_cryptsetupExe}" luksOpen "${_crypttab_dev}" \
          "${_crypttab_vol_name}"; then
          _chosenCryptList+=(
            "/dev/mapper${_crypttab_vol_name}|${_crypttab_dev}"
          )
          break
        fi
        _cm2WarnStrFn 'Incorrect passphrase for volume. Skipped.'
      done
      ## . End gauntlet for attempting to open encrypted volume }
    done
    ## . End loop through crypttab entries }

    # Re-create OS-visible device and metadata list. Because this includes
    #   system-generated UUIDs, this is the simplest way.
    _blkid_report="$("${_blkidExe}")" || return 1
    readarray -t _dev_list < <(_getBlockDevListFn) || return 1
  fi
  ## . End decrypt all disks in crypttab if needed }

  ## Begin loop through fstab list {
  for _fstab_line in "${_sysFstabList[@]}"; do
    # Extract fields
    IFS='|' read -r -a _fstab_bit_list <<<"${_fstab_line}"
    _fstab_mount_src="${_fstab_bit_list[0]:-}"
    _fstab_mount_tgt="${_fstab_bit_list[1]:-}"
    _fstab_fs_type="${_fstab_bit_list[2]:-}"
    _fstab_fs_opt="${_fstab_bit_list[3]:-}"
    _true_mount_tgt="${_sysMountPath}${_fstab_mount_tgt}"

    # Do not try to mount the root device twice
    if [ "${_fstab_mount_tgt}" = '/' ]; then
      continue
    fi

    # Locate the block device associated with the filesystem
    if [[ "${_fstab_mount_src}" =~ ^/dev/ ]]; then
      _fstab_dev="${_fstab_mount_src}"
    elif [[ "${_fstab_mount_src}" =~ ^UUID= ]]; then
      _fstab_uuid="$(cut -d'=' -f2 <<<"${_fstab_mount_src}")"
      if [ -z "${_fstab_uuid}" ]; then continue; fi
      _fstab_dev="$(_getBlockDevByFsUuid "${_fstab_uuid}" \
        "${_blkid_report}" "${_dev_list[@]}")" || return 1
      if [ -z "${_fstab_dev}" ]; then continue; fi
    else
      continue
    fi

    # Mount the block device, record fs info for later reporting
    if "${_mountExe}" -t "${_fstab_fs_type}" -o "${_fstab_fs_opt}" \
      "${_fstab_dev}" "${_true_mount_tgt}" 2>/dev/null; then
      _mounted_fs_type="$(_extractBlkidFieldStrFn "${_blkid_report}" \
        "${_fstab_dev}" 'type')" || return 1
      _chosenMountList+=(
        "${_true_mount_tgt}|${_mounted_fs_type}|${_fstab_dev}"
      )
    fi
  done
  ## . End loop through fstab list }
}
## . END _mountFstabEntriesFn }

## BEGIN _getFieldWidthsStrFn {
# Summary   : _getFieldWidthsStrFn <header_len_str> <disp_table...>
# Purpose   : Determines the width each column in a table needs to be
# Example   : _getFieldWidthsStrFn '5|8' 'abc|def' 'ghijklmnopqr|s'
# Arguments :
#   <header_len_str> : Pipe-delimited string indicating the length of each cell
#     in the table's header row
#   <disp_table...>  : Remaining arguments are pipe-separated strings that make
#     up the rest of the table
# Globals   : none
# Outputs   : Pipe-separated string containing field widths
# Returns   : 1 on critical error
#
_getFieldWidthsStrFn() {
  declare _header_len_str _disp_table _field_len_list _bit_list \
    _line _idx _cell_len

  # Process arguments
  _header_len_str="${1:-}"
  shift 1
  _disp_table=("$@")
  if [ -z "${_header_len_str}" ] \
    || [ "${#_disp_table}" = '0' ] \
    || [ -z "${_disp_table[0]}" ]; then
    _cm2ErrStrFn 'Missing table or header data!'
    return 1
  fi

  ## Begin loop through fields and calculate maximum width {
  IFS='|' read -r -a _field_len_list <<<"${_header_len_str}"
  for _line in "${_disp_table[@]}"; do
    IFS='|' read -r -a _bit_list <<<"${_line}"
    for _idx in "${!_bit_list[@]}"; do
      if ((_idx >= ${#_field_len_list[@]})); then
        break
      fi
      _cell_len="${#_bit_list[_idx]}"
      if ((_cell_len > _field_len_list[_idx])); then
        _field_len_list[_idx]="${_cell_len}"
      fi
    done
  done
  ## . End loop through fields and calculate maximum width }

  # Echo pipe-delimited list of field lengths, trimming off the final pipe
  printf '%s|' "${_field_len_list[@]}" | head -c-1
}
## . END _getFieldWidthsStrFn }

## BEGIN _printTableFn {
# Summary   : _printTableFn <table_name> <header_list_str> <disp_table...>
# Purpose   : Display a table to the user.
# Example   :
#   _printTableFn 'Mounted directories:' 'Location|Type|Source' \
#     '...|...|...' '...|...|...'
# Arguments :
#   <table_name>      : Name to print above the table.
#   <header_list_str> : Pipe-separated string containing strings to display in
#     the header row
#   <disp_table...>   : Remaining arguments are pipe-separated strings that make
#     up the rest of the table
# Globals   : none
# Outputs   : none
# Returns   : 1 on critical error
#
_printTableFn() {
  declare _table_name _header_list_str _disp_table _header_list \
    _header_len_list _item_str _field_size_list _printf_row_str \
    _printf_row_len _field_size_list_idx _header_len_str _bit_list

  # Process arguments
  _table_name="${1:-}"
  _header_list_str="${2:-}"
  shift 2
  _disp_table=("$@")
  if [ -z "${_table_name}" ] \
    || [ -z "${_header_list_str}" ] \
    || [ "${#_disp_table}" = '0' ] \
    || [ -z "${_disp_table[0]:-}" ]; then
    _cm2ErrStrFn 'Missing table or header data!'
    return 1
  fi

  # Calculate the field widths for the table. Each field must be long enough
  #   to display the length of its longest element. The length of the headers
  #   must be taken into account.
  IFS='|' read -r -a _header_list <<<"${_header_list_str}"
  _header_len_list=()
  for _item_str in "${_header_list[@]}"; do
    _header_len_list+=("${#_item_str}")
  done
  _header_len_str="$(printf '%s|' "${_header_len_list[@]}" | head -c-1)"

  # Calculate field width list
  IFS='|' read -r -a _field_size_list < <(_getFieldWidthsStrFn \
    "${_header_len_str}" "${_disp_table[@]}")

  # Calculate the table row template for use with printf
  _printf_row_str=""
  ((_printf_row_len = 0)) || true
  for _field_size_list_idx in "${!_field_size_list[@]}"; do
    if [ "${_field_size_list_idx}" != '0' ]; then
      _printf_row_str+=' | '
      ((_printf_row_len += 3)) || true
    fi
    _printf_row_str+="%-${_field_size_list[_field_size_list_idx]}s"
    ((_printf_row_len += _field_size_list[_field_size_list_idx])) || true
  done
  _printf_row_str+='\n'

  # Print table name, header, separator
  _cm2EchoFn "${_table_name}"
  # shellcheck disable=SC2059
  printf "${_printf_row_str}" "${_header_list[@]}" 1>&2
  printf "%${_printf_row_len}s\n" '' | tr ' ' '=' 1>&2

  # Print table rows
  for _line in "${_disp_table[@]}"; do
    IFS='|' read -r -a _bit_list <<<"${_line}"
    # shellcheck disable=SC2059
    printf "${_printf_row_str}" "${_bit_list[@]}" 1>&2
  done

  _cm2EchoFn
}
## . END _printTableFn }

## BEGIN _mountSystemDisksFn {
# Summary   : _mountSystemDisksFn
# Purpose   : Mounts the partitions that form a KFocus installation to /mnt.
# Example   : _mountSystemDisksFn;
# Arguments : none
# Globals   : Uses _sysMountPath, _confirmMountMsg
# Outputs   : none
# Returns   : 1 on failure
#
_mountSystemDisksFn() {
  declare _unmounted_block_dev_list _kubuntu_root_mount_data_str \
    _is_root_mounted _unmounted_block_dev_str _try_mount_retcode

  # Get all unmounted devices on the system. One of these will be the boot
  #   partition for the KFocus installation, and will provide us the data we
  #   need to mount the rest of the installation partitions.
  readarray -t _unmounted_block_dev_list < <(_getUnmountedBlockDevListFn) \
    || return 1
  _is_root_mounted='n'

  ## Begin loop to find and mount root partition {
  for _unmounted_block_dev_str in "${_unmounted_block_dev_list[@]}"; do
    # Look for a boot partition containing mount info for the KFocus root
    #   partition, and extract it
    _kubuntu_root_mount_data_str="$(_getKubuntuRootMountDataFn \
      "${_unmounted_block_dev_str}")" || return 1
    if [ -z "${_kubuntu_root_mount_data_str}" ]; then
      continue
    fi

    # Mount the root partition and verify it contains a KFocus installation
    _tryKfocusMountFn "${_kubuntu_root_mount_data_str}"
    _try_mount_retcode="$?"
    case "${_try_mount_retcode}" in
      0) # Prompt the user to confirm the right partition has been mounted
        if [ "$(_readPromptFn "${_confirmMountMsg}")" = 'y' ]; then
          _is_root_mounted='y'
          break
        else
          if ! "${_umountExe}" "${_sysMountPath}"; then
            _cm2ErrStrFn "Could not unmount |${_sysMountPath}|!"
            return 1
          fi
        fi
        ;;
      1) # Partition was invalid, move onto the next one
        continue
        ;;
      2) # Critical error, bail out
        _cm2ErrStrFn \
          'Critical error encountered trying to mount root filesystem!'
        return 1
        ;;
    esac
  done
  ## . End loop to find and mount root partition }

  # Bail if no root partition mounted
  if [ "${_is_root_mounted}" = 'n' ]; then
    _cm2ErrStrFn \
      'Could not find any Kubuntu Focus installation on this system!'
    return 1
  fi

  # Mount remaining filesystems for the KFocus installation
  _mountFstabEntriesFn || {
    _cm2ErrStrFn 'Trouble mounting filesystems from fstab!'
    return 1
  }
}
## . END _mountSystemDisksFn }

## BEGIN _chrootBindFn {
# Summary   : _chrootBindFn
# Purpose   : Bind-mount /dev, /dev/pts, /proc, and /sys
#   into directories under /mnt.
# Example   : _chrootBindFn;
# Arguments : none
# Globals   : Uses _sysMountPath, _chrootMountList
# Outputs   : none
# Returns   : 1 on critical error
#
_chrootBindFn() {
  declare _chroot_mount_str _found_existing_binds _msg

  # Bail if /mnt has no fs mounted to it
  if ! "${_mountpointExe}" "${_sysMountPath}" >/dev/null 2>/dev/null; then
    _cm2ErrStrFn "No system mounted at |${_sysMountPath}|!"
    return 1
  fi

  ## Begin loop through dirs and check for mounts {
  _found_existing_binds='n'
  for _chroot_mount_str in "${_chrootMountList[@]}"; do
    if "${_mountpointExe}" "${_sysMountPath}${_chroot_mount_str}" \
      >/dev/null 2>/dev/null; then
      _cm2ErrStrFn \
        "Directory |${_chroot_mount_str}| is already mounted!"
      _found_existing_binds='y'
      # Don't return yet so that we can tell the user about all of the existing
      #   bind mounts
    fi
  done
  ## . End loop through dirs and check for mounts }

  # Bail if existing bind mounts were found
  if [ "${_found_existing_binds}" = 'y' ]; then
    return 1
  fi

  ## Begin loop through dirs and create bind mounts {
  for _chroot_mount_str in "${_chrootMountList[@]}"; do
    if ! "${_mountExe}" --bind "${_chroot_mount_str}" \
      "${_sysMountPath}${_chroot_mount_str}"; then
      _msg="Failed to bind-mount |${_chroot_mount_str}| to "
      _msg+="|${_sysMountPath}${_chroot_mount_str}|"
      _cm2ErrStrFn "${_msg}"
      return 1
    fi
    _chosenMountList+=(
      "${_sysMountPath}${_chroot_mount_str}|bind|${_chroot_mount_str}"
    )
  done
  ## . End loop through dirs and create bind mounts }
}
## . END _chrootBindFn }

## BEGIN _displayMountSummaryFn {
# Summary   : _displayMountSummaryFn
# Purpose   : Display a summary of all decrypted and mounted disks, displayed as
#   a pair of tables.
# Example   : _displayMountSummaryFn;
# Arguments : none
# Globals   : Uses _chosenCryptList, _chosenMountList
# Outputs   : none
# Returns   : 1 on critical error
#
_displayMountSummaryFn() {
  if [ "${#_chosenCryptList}" != '0' ]; then
    _printTableFn 'Decrypted volumes:' 'Volume|Source Device' \
      "${_chosenCryptList[@]}" || return 1
  fi
  if [ "${#_chosenMountList}" != '0' ]; then
    _printTableFn 'Mounted directories:' 'Location|Type|Source' \
      "${_chosenMountList[@]}" || return 1
  fi
}
## . END _displayMountSummaryFn }

## BEGIN _unmountSystemDisksFn {
# Summary   : _unmountSystemDisksFn
# Purpose   : Unmounts all filesystems under /mnt and closes
#   unneeded encrypted volumes.
# Example   : _unmountSystemDisksFn;
# Arguments : none
# Globals   : Uses _sysCrypttabList
# Outputs   : none
# Returns   : 1 on critical error
#
_unmountSystemDisksFn() {
  declare _crypttab_str _bit_list _crypttab_vol_str _mount_list \
    _mount_data_sort_str _mount_tgt_slash_count _mount_line _mount_item \
    _mapper_vol_list _found_mapper_match _mapper_vol_str

  _loadCrypttabListFn

  # Similar sorting logic as used for _loadFstabListFn is used here, except we
  #   want more deeply nested mounts to appear earlier than less deeply nested
  #   ones. This allows us to unmount all the devices by just walking down the
  #   list and unmounting every item.
  _mount_data_sort_str=''
  while read -r _mount_line; do
    if [ -z "${_mount_line}" ]; then
      continue
    fi

    _mount_tgt_slash_count="$(sed -n 's/[^/]//gp' <<<"${_mount_line}" \
      | wc -c)"
    # `wc -c` counts the newline at the end, remove that
    ((_mount_tgt_slash_count--)) || true
    if [ "${_mount_tgt_slash_count}" = '0' ]; then
      continue
    fi

    _mount_data_sort_str+="${_mount_tgt_slash_count}|${_mount_line}"
    _mount_data_sort_str+=$'\n'
  done < <(grep '^[^ ]\+ /mnt' </proc/self/mounts | cut -d' ' -f2 2>/dev/null)

  _mount_data_sort_str="$(sort -nr <<<"${_mount_data_sort_str}")"

  # Unmount everything in the sorted list. Bail out if an unmount fails.
  readarray -t _mount_list < <(cut -d'|' -f2 <<<"${_mount_data_sort_str}")
  for _mount_item in "${_mount_list[@]}"; do
    if ! "${_umountExe}" "${_mount_item}"; then
      _cm2EchoFn "Failed to unmount |${_mount_item}|!"
      return 1
    fi
  done

  # Find unused encrypted volumes that were part of the internal KFocus disks
  #   and close them
  if [ "${#_sysCrypttabList[@]}" = '0' ]; then
    return 0
  fi

  readarray -t _mapper_vol_list < <(cut -d' ' -f1 </proc/self/mounts \
    | grep '^/dev/mapper' | sed 's?/dev/mapper??')

  for _crypttab_str in "${_sysCrypttabList[@]}"; do
    IFS='|' read -r -a _bit_list <<<"${_crypttab_str}"
    _crypttab_vol_str="${_bit_list[0]}"
    _found_mapper_match='n'

    if ! [ -b "/dev/mapper/${_crypttab_vol_str}" ]; then
      continue
    fi

    for _mapper_vol_str in "${_mapper_vol_list[@]}"; do
      if [ "${_crypttab_vol_str}" = "${_mapper_vol_str}" ]; then
        _found_mapper_match='y'
        break
      fi
    done

    if [ "${_found_mapper_match}" = 'y' ]; then
      continue
    fi

    if ! "${_cryptsetupExe}" luksClose "/dev/mapper/${_crypttab_vol_str}"; then
      return 1
    fi
  done
}
## . END _unmountSystemDisksFn }

## BEGIN _mainFn {
_mainFn() {
  declare _chroot_mount_str _msg

  if [ "$(id -u)" != '0' ]; then
    _cm2ErrStrFn 'Must be run as root!'
    exit 1
  fi

  # If mounted, offer to unmount
  if "${_mountpointExe}" "${_sysMountPath}" >/dev/null 2>/dev/null; then
    _msg="${_offerUnmountWithBindsMsg}"
    for _chroot_mount_str in "${_chrootMountList[@]}"; do
      if ! "${_mountpointExe}" "${_chroot_mount_str}" >/dev/null 2>/dev/null; then
        _msg="${_offerUnmountMsg}"
        break
      fi
    done

    if [ "$(_readPromptFn "${_msg}")" = 'n' ]; then
      _cm2EchoFn "${_declineUnmountMsg}"
      exit 0
    fi

    if ! _unmountSystemDisksFn; then
      _cm2ErrStrFn "${_unmountErrMsg}"
      exit 1
    fi

    _cm2EchoFn "${_unmountDoneMsg}"
    exit 0

  # If not mounted, offer to mount
  else
    if [ "$(_readPromptFn "${_offerMountMsg}" 'n')" = 'n' ]; then
      _cm2EchoFn "${_declineMountMsg}"
      exit 0
    fi

    if ! _mountSystemDisksFn; then
      _cm2ErrStrFn "${_mountErrMsg}"
      exit 1
    fi
    _cm2EchoFn

    # Offer to prepare for chroot
    if [ "$(_readPromptFn "${_offerChrootBindMsg}" 'n')" = 'n' ]; then
      _displayMountSummaryFn || {
        _cm2ErrStrFn "${_mountSummaryDisplayFailMsg}"
        exit 1
      }
      _cm2EchoFn "${_mountDoneMsg}"
      exit 0
    fi

    if ! _chrootBindFn; then
      _cm2ErrStrFn "${_chrootBindErrMsg}"
      exit 1
    fi

    _displayMountSummaryFn || {
      _cm2ErrStrFn "${_mountSummaryDisplayFailMsg}"
      exit 1
    }
    _cm2EchoFn "${_chrootBindDoneMsg}"
    exit 0
  fi
}
## . END _mainFn }

## BEGIN Declare and assign global vars {
declare _binName _binDir _baseDir _baseName _assignList _mountExe \
  _umountExe _cryptsetupExe _mountpointExe _lsblkExe \
  _sysMountPath _chrootMountList _grubCfgPathList _offerMountMsg \
  _declineMountMsg _mountErrMsg _offerChrootBindMsg _mountDoneMsg \
  _chrootBindErrMsg _chrootBindDoneMsg _offerUnmountMsg _declineUnmountMsg \
  _unmountErrMsg _offerChrootUnbindMsg _chrootUnbindErrMsg _unmountDoneMsg \
  _checkKfocusFile _sysFstabPath _sysCrypttabPath _offerUnmountWithBindsMsg \
  _blkidExe _chosenCryptList _chosenMountList _mountSummaryDisplayFailMsg

_sysMountPath='/mnt'
_chrootMountList=('/dev' '/dev/pts' '/proc' '/sys')
_grubCfgPathList=(
  "${_sysMountPath}/grub/grub.cfg"
  "${_sysMountPath}/@boot/grub/grub.cfg"
)
_checkKfocusFile="${_sysMountPath}/usr/lib/kfocus/bin/kfocus-focusrx"
_sysFstabPath="${_sysMountPath}/etc/fstab"
_sysCrypttabPath="${_sysMountPath}/etc/crypttab"

# <mount_src>|<mount_tgt>|<fs_type>|<fs_opt>
_sysFstabList=()

# <volume_name>|<source_device>|<key_file>
_sysCrypttabList=()

# <vol_name>|<dev_name>
_chosenCryptList=()

# <mount_path>|<type>|<mount_src>
_chosenMountList=()
## . END Declare and assign global vars }

## BEGIN Run mainFn when script is NOT sourced {
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  _binName="$(readlink -f "$0")" || exit 101
  _binDir="$(dirname "${_binName}")" || exit 101
  _baseDir="$(dirname "${_binDir}")" || exit 101
  _baseName="$(basename "${_binName}")" || exit 101

  # Import libs and assign more global vars
  _importCommonFn

  _assignList=(
    '_mountExe|/usr/bin/mount'
    '_umountExe|/usr/bin/umount'
    '_cryptsetupExe|/usr/sbin/cryptsetup'
    '_mountpointExe|/usr/bin/mountpoint'
    '_lsblkExe|/usr/bin/lsblk'
    '_blkidExe|/usr/sbin/blkid'
  )
  if ! _cm2AssignExeVarsFn "${_assignList[@]}"; then
    _cm2ErrStrFn 'Could not assign variables'
    exit 1
  fi

  _assignGlobalUiVarsFn

  _mainFn "$@"
fi
## . END Run mainFn when script is NOT sourced }
