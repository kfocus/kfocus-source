#!/bin/bash
# Copyright 2026 MindShare Inc.
#
# Written for the Kubuntu Focus by M. Mikowski, A. Rainbolt
#
# Name    : kfocus-pl-gpuboost
# Purpose : GUI for enabling and disabling kfocus-pl-gpuboost.service.
# License : GPL v2
# Run By  : Users
# Spec    : 6789
#
set -u;

## BEGIN _importCommonFn {
# Summary   : _importCommonFn
# Purpose   : Load common routines, prefer relative dir
# Example   : _importCommonFn;
# Arguments : none
# Globals   : Package vars _baseDir _baseName
# Outputs   : none
# Returns   : none
#
_importCommonFn () {
  declare _lib_list _is_loaded _lib_file;
  _lib_list=(
    "${_baseDir}/lib/common.2.source"
    '/usr/lib/kfocus/lib/common.2.source'
  );
  _is_loaded='n';
  for _lib_file in "${_lib_list[@]}"; do
    if [ -r "${_lib_file}" ]; then
      # shellcheck source=/usr/lib/kfocus/lib/common.2.source
      if source "${_lib_file}"; then
        _is_loaded='y';
        break;
      fi
    fi
  done

  if [ "${_is_loaded}" = 'n' ]; then
    echo 1>&2 "${_baseName}: ABORT - Cannot source common lib";
    exit 202;
  fi
}
## . END _importCommonFn }

## BEGIN _assignGlobalUiVarsFn {
_assignGlobalUiVarsFn () {
  declare _bold_str _brow_str _erow_str _header_str _table_str;

  _bold_str='<b style="color:#f7941d">';
  _brow_str='<tr><td style="padding:8px 32px 8px 0">';
  _erow_str='</td></tr>';
  _header_str='<h3 style="color:#f7941d">';
  _table_str='<table style="width:100%;margin-right:32px">';

  _windowTitle='KFocus Panther Lake GPU Boost';
  _iconStr='kfocus-bug-gpuboost';

  _notSupportedMsg="$(cat <<EOF
${_cm2HtmBeginStr}${_table_str}
${_brow_str}${_header_str}System Not Supported</h3>${_erow_str}

${_brow_str}This tool is only useful on a Kubuntu Focus Ar GEN 1 system. <br>
Please uninstall the kfocus-pl-gpuboost package.${_erow_str}</table>
${_cm2HtmEndStr}
EOF
  )";

  _noAcMsg="$(cat <<EOF
${_cm2HtmBeginStr}${_table_str}
${_brow_str}${_header_str}No AC Power</h3>${_erow_str}

${_brow_str}GPU Boost cannot be enabled on battery, because it requires <br>
power only available when on AC power.${_erow_str}</table>
${_cm2HtmEndStr}
EOF
  )";

  _errorMsg="$(cat <<EOF
${_cm2HtmBeginStr}${_table_str}
${_brow_str}${_header_str}Error</h3>${_erow_str}

${_brow_str}An error was encountered:${_erow_str}

${_brow_str}XXX_ERROR_MSG_XXX${_erow_str}</table>
${_cm2HtmEndStr}
EOF
  )";

  _startMsg="$(cat <<EOF
${_cm2HtmBeginStr}${_table_str}
${_brow_str}${_header_str}Enable GPU Boost?</h3>${_erow_str}

${_brow_str}Kubuntu Focus provides this tool to raise power limits <br>
for the Panther Lake Xe GPU. In some cases, game frame <br>
rates can be increased by 50%, although it may have the <br>
opposite effect on CPU-intensive games.${_erow_str}

${_brow_str}Enable GPU Boost now?${_erow_str}</table>
${_cm2HtmEndStr}
EOF
  )";

  _runningMsg="$(cat <<EOF
${_cm2HtmBeginStr}${_table_str}
${_brow_str}${_header_str}GPU Boost Active</h3>${_erow_str}

${_brow_str}GPU Boost is currently active. You may run your <br>
GPU-intensive task now with maximum performance.${_erow_str}

${_brow_str}This tool will only run on AC. Unplugging the system or <br>
using KFocus Power & Fan to change the CPU frequency <br>
profile will end this mode and revert to standard power <br>
management. You may disable GPU Boost at any time by <br>
clicking the button below.${_erow_str}</table>
${_cm2HtmEndStr}
EOF
  )";
}
## . END _assignGlobalUiVarsFn }

## BEGIN _mainFn {
_mainFn () {
  declare _should_start_service _ac_online_file _alt_str _ac_online_int;

  if [ "$(_cm2EchoModelStrFn 'code')" != 'arg1' ]; then
    _cm2PromptUserFn -i "${_iconStr}" "${_notSupportedMsg}" "${_windowTitle}" 's';
    exit 0;
  fi

  _ac_online_file='/sys/class/power_supply/AC';
  for _alt_str in '' 0 1 2; do
    if [ -f "${_ac_online_file}${_alt_str}/online" ]; then
      _ac_online_file+="${_alt_str}/online";
      break;
    fi
  done
  _ac_online_int="$(cat "${_ac_online_file}")";
  if [ "${_ac_online_int}" != '1' ]; then
    _cm2PromptUserFn -i "${_iconStr}" "${_noAcMsg}" "${_windowTitle}" 's';
    exit 0;
  fi

  if [ "$(systemctl is-active kfocus-pl-gpuboost.service)" != 'active' ]; then
    _should_start_service="$(kdialog \
      --icon "${_iconStr}" \
      --title "${_windowTitle}" \
      --yesno "${_startMsg}" \
      --yes-label='Run Now' \
      --no-label='Cancel' && echo 'y' || echo 'n')";
    if [ "${_should_start_service}" = 'n' ]; then
      exit 0;
    fi

    pkexec "${_gpuboostSetExe}" 'on' || {
      _cm2PromptUserFn \
        -i "${_iconStr}" \
        "${_errorMsg//XXX_ERROR_MSG_XXX/Could not start GPU Boost service}" \
        "${_windowTitle}" \
        's';
      exit 1;
    }
  fi

  # NOTE: The backend may terminate this script if it terminates itself.

  kdialog \
    --icon "${_iconStr}" \
    --title "${_windowTitle}" \
    --msgbox "${_runningMsg}" \
    --ok-label='Stop Now';

  pkexec "${_gpuboostSetExe}" 'off' || {
    _cm2PromptUserFn \
      -i "${_iconStr}" \
      "${_errorMsg//XXX_ERROR_MSG_XXX/Could not stop GPU Boost service}" \
      "${_windowTitle}" \
      's';
    exit 1;
  }

  # Only reset power state if the state is still Low; if it isn't, the user
  #   most likely intentionally changed power state, and we should not
  #   override them.
  if [ "$("${_powerSetExe}" -r)" = 'Low' ]; then
    "${_pstateExe}";
  fi

  exit 0;
}
## . END _mainFn }

## BEGIN Declare global variables {
declare _binName _binDir _baseDir _baseName _assignList _gpuboostSetExe \
  _powerSetExe _pstateExe _windowTitle _iconStr _notSupportedMsg _noAcMsg \
  _errorMsg _startMsg _runningMsg;
## . END Declare global variables }

## BEGIN Run main if script is not sourced {
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  _binName="$(  readlink -f "$0"       )" || exit 101;
  _binDir="$(   dirname  "${_binName}" )" || exit 101;
  _baseDir="$(  dirname  "${_binDir}"  )" || exit 101;
  _baseName="$( basename "${_binName}" )" || exit 101;

  # Import libs and assign more global vars
  _importCommonFn;

  _assignList=(
    '_gpuboostSetExe|/usr/lib/kfocus/bin/kfocus-pl-gpuboost-set'
    '_powerSetExe|/usr/lib/kfocus/bin/kfocus-power-set'
    '_pstateExe|/usr/lib/kfocus/bin/kfocus-pstate'
  );

  if ! _cm2AssignExeVarsFn "${_assignList[@]}"; then
    _cm2ErrStrFn 'Could not assign variables';
    exit 1;
  fi

  _assignGlobalUiVarsFn;

  _mainFn "$@";
fi
## . END Run main if script is not sourced }
