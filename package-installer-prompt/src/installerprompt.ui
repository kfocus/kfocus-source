   <string notr="true">/*
Light theming, in case we need it later:

QWidget {
    color: #000000;
}

QPushButton {
    background-color: rgb(200, 200, 200);
    color: #ffffff;
    border-radius: 10px;
    padding: 10px 20px;
    margin: 10px;
}

QPushButton:hover {
    background-color: rgb(30, 144, 255);
}

QPushButton:disabled {
    background-color: rgb(169, 169, 169);
    color: #ffffff;
}

QComboBox, QLineEdit {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #dbe0ea, stop:1 #c5cddd);
    color: #4d4d4d;
    border: 1px solid #8d95a1;
    border-radius: 15px;
    padding: 6px 12px;
}

QComboBox:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #e5e9ef, stop:1 #d6dbe6); color: #16191d; border-color: #16191d;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    color: #4d4d4d;
    background-color: #dbe0ea;
}

QComboBox::down-arrow {
    image: url(:/arrow-down);
    width: 30px;
    padding-right: 10px;
}

QLabel {
    color: #16191d;
    margin-right: 8px;
}

QLabel#logoLabel {
    image: url(:/logo);
    background-color: transparent;
}

QPushButton {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #dbe0ea, stop:1 #c5cddd); color: #4d4d4d; border: 1px solid #8d95a1; border-radius: 15px;
}

QPushButton:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #e5e9ef, stop:1 #d6dbe6); color: #16191d; border-color: #16191d;
}

QPushButton:disabled {
    background-color: #b5c1d5; color: #6882ad; border: 1px solid #8ea2c2; border-radius: 15px;
}

QToolTip {
	background-color: rgba(229, 233, 239, 0.85); padding: 12px; border-radius: 15px; border: 1px solid #16191d; font: 12px 'IBM Plex Sans'; color: #16191d; line-height: 18px;
}

